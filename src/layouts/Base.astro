---
// Basic Layout for All Pages

import Footer from "@/components/Footer.astro";
// import LocaleHtmlHead from "@/components/i18n/LocaleHtmlHead.astro";
// import LocaleSuggest from "@/components/i18n/LocaleSuggest.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION, X_ACCOUNT } from "@/consts";
import { useTranslations, LOCALES, getLocalePaths, type Lang } from "@/i18n";
const t = useTranslations(Astro.currentLocale as Lang);
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
interface Props {
    title?: string;
    description?: string;
    frontmatter?: undefined;
}

const {
    title,
    description,
} = Astro.props.frontmatter || Astro.props;

const locale = Astro.currentLocale as Lang;
const localeTitle = title ? `${title} - ${t(SITE_TITLE)}` : t(SITE_TITLE);
const localeDescription = description || t(SITE_DESCRIPTION);
---


<html lang={LOCALES[locale].lang || locale} >
<head>
    <meta charset="UTF-8" />
    <title>{localeTitle}</title>
    <meta name="description" content={localeDescription} />
    <meta name="viewport" id="viewport-meta" content="width=device-width, initial-scale=1" />

    <script is:inline>
        (() => {
            const baseDPR = 1.5;

            const applyZoom = () => {
                const currentDPR = window.devicePixelRatio || 1;
                const scale = Math.abs(currentDPR - baseDPR) > 0.01 ? baseDPR / currentDPR : 1;
                document.documentElement.style.zoom = String(scale);
            };

            applyZoom();

            document.addEventListener("astro:page-load", applyZoom);
            window.addEventListener("resize", applyZoom);
        })();
    </script>


    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {
        getLocalePaths(Astro.url).map((props) => (
                <link
                        rel="alternate"
                        hreflang={LOCALES[props.lang].lang || props.lang}
                        href={Astro.site?.origin + props.path}
                />
        ))
    }

    <!-- icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"/>
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}/AvatarColored.ico`} />
    <meta name="color-scheme" content="light dark" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={localeTitle} />
    <meta property="og:site_name" content={localeTitle} />
    <meta property="og:description" content={localeDescription} />
    <meta property="og:image" content={Astro.site + "ogp.png"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={LOCALES[locale].lang || locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={t(X_ACCOUNT)} />
    <ClientRouter />
    <script is:inline>
        // 禁止浏览器自动滚动恢复，由我们全权接管
        history.scrollRestoration = 'manual';

        document.addEventListener('astro:before-preparation', function(e) {
            var fromProject = /\/projects\//.test(location.pathname);
            var toProject   = e.to && /\/projects\//.test(e.to.pathname);

            // 从非项目页进入项目页：保存当前滚动位置
            if (!fromProject && toProject) {
                sessionStorage.setItem('backScroll', String(Math.round(window.scrollY)));
                return;
            }

            // 在项目页点击 back-btn 离开：把滚动位置转为待恢复标记
            // sourceElement 是 Astro 提供的触发导航的元素，无需拦截 click 事件
            if (fromProject && !toProject && e.sourceElement && e.sourceElement.id === 'back-btn') {
                var saved = sessionStorage.getItem('backScroll');
                if (saved !== null) {
                    sessionStorage.setItem('restoreScrollTo', saved);
                    sessionStorage.removeItem('backScroll');
                }
            }
        });

        document.addEventListener('astro:page-load', function() {
            var target = sessionStorage.getItem('restoreScrollTo');
            if (target !== null) {
                sessionStorage.removeItem('restoreScrollTo');
                var y = parseInt(target, 10);
                requestAnimationFrame(function() {
                    setTimeout(function() {
                        window.scrollTo({ top: y, behavior: 'instant' });
                    }, 0);
                });
            }
        });
    </script>
    <!-- External Resource -->


</head>

<body>
<Header>

</Header>

<main class="l-main l-content">


    <slot />
</main>

<Footer />
<!--{ import.meta.env.DEV && <style>:root { scroll-behavior: auto }</style> }-->





</body>
</html>

