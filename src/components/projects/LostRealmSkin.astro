---
// Lost Realm 项目页专属皮肤（projects.json 里 skin: "lr" 时由 [id].astro 挂载）
//
// 视觉照着游戏本身走：长满青苔的遗迹场景当底，面板都是游戏 UI 用的 Franuka「RPG UI pack」。
// 两级面板：一级（hero、正文）统一用金边橙色面板（--lr-panel-1）；嵌在里面的二级（简介、徽章、外链）统一用
// 带蓝色角钉的蜜桃面板（--lr-panel-2）；只有外链按钮用它，徽章是扁平小标签、简介只有一道竖线，顶部不堆太多框。封面用金色角饰相框，H2 用宝石横幅，H3 用金色卷轴；正文图片不加边框。主题色取自一级面板：底色 #FFAE70、描边深色 #3D2936。
// - 面板、横幅、名牌、图标都是从 UI 包 1x 图集里按像素坐标裁出来、最近邻放大 3 倍的 9-slice（skin/*.png），
//   用 border-image 套上，1 个原始像素 = 3 个 CSS 像素，所以切片和边宽都是 3 的倍数。
// - 标题用 Google Fonts 的 Pixelify Sans，中日韩字回落到 Fusion Pixel 子集（和极速像素页共用那三个文件），
//   正文保持普通字体好读。
// - 场景图是游戏录屏（美术效果）里截的一帧遗迹，上面罩一层浅苔绿的雾，整体偏亮。
// - 所有规则都限定在 .skin-lr / html:has(.skin-lr) 下（样式表是整条路由共用的）。
import panelPeach from "@/assets/projects/game-project-lost-realm/skin/panel-peach.png";
import panelGold from "@/assets/projects/game-project-lost-realm/skin/panel-gold.png";
import panelOrange from "@/assets/projects/game-project-lost-realm/skin/panel-orange.png";
import plateHex from "@/assets/projects/game-project-lost-realm/skin/plate-hex.png";
import buttonPlum from "@/assets/projects/game-project-lost-realm/skin/button-plum.png";
import gem from "@/assets/projects/game-project-lost-realm/skin/gem.png";
import ribbon from "@/assets/projects/game-project-lost-realm/skin/ribbon.png";
import ribbonGold from "@/assets/projects/game-project-lost-realm/skin/ribbon-gold.png";
import panelOrnate from "@/assets/projects/game-project-lost-realm/skin/panel-ornate.png";
import icons from "@/assets/projects/game-project-lost-realm/skin/icons.png";
import scene from "@/assets/projects/game-project-lost-realm/skin/scene.webp";
import pixelSC from "@/assets/projects/game-project-speed-pixel/skin/fusion-pixel-sc.woff2?url";
import pixelJP from "@/assets/projects/game-project-speed-pixel/skin/fusion-pixel-jp.woff2?url";
import pixelKR from "@/assets/projects/game-project-speed-pixel/skin/fusion-pixel-kr.woff2?url";

interface Props {
    /** true 时只输出 hero 里的装饰层（样式由页面顶部那次挂载负责） */
    stickers?: boolean;
}
const { stickers = false } = Astro.props;

const vars = [
    `--lr-panel-1: url("${panelGold.src}")`,
    `--lr-panel-2: url("${panelPeach.src}")`,
    `--lr-panel-hero: url("${panelOrange.src}")`,
    `--lr-plate-hex: url("${plateHex.src}")`,
    `--lr-button-plum: url("${buttonPlum.src}")`,
    `--lr-gem: url("${gem.src}")`,
    `--lr-ribbon: url("${ribbon.src}")`,
    `--lr-ribbon-gold: url("${ribbonGold.src}")`,
    `--lr-panel-ornate: url("${panelOrnate.src}")`,
    `--lr-icons: url("${icons.src}")`,
    `--lr-scene: url("${scene.src}")`,
].join("; ");
const fontFace = [
    `@font-face { font-family: "LR Pixel SC"; src: url("${pixelSC}") format("woff2"); font-display: swap; }`,
    `@font-face { font-family: "LR Pixel JP"; src: url("${pixelJP}") format("woff2"); font-display: swap; }`,
    `@font-face { font-family: "LR Pixel KR"; src: url("${pixelKR}") format("woff2"); font-display: swap; }`,
].join(" ");
---

{stickers ? null : (
        <>
            {/* 拉丁字母用 Google Fonts 的 Pixelify Sans；中日韩字回落到 Fusion Pixel 子集 */}
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600;700&display=swap" />
            <style is:inline set:html={`${fontFace} html:has(.skin-lr) { ${vars}; }`} />
        </>
)}

<style is:global>
    /* ========================================================= */
    /* 调色板：UI 包的暖橙 / 蜜桃面板 + 遗迹场景的苔绿与夜色          */
    /* ========================================================= */
    html:has(.skin-lr) {
        --lr-night: #14201e;
        --lr-mist: #e6efd8;
        --lr-moss: #2c4634;
        --lr-leaf: #6aa84f;
        --lr-peach: #ffc2a1;   /* 面板底色 */
        --lr-orange: #f29d58;
        --lr-gold: #f3c44b;
        --lr-ink: #3d2936;     /* 面板描边的深色 */
        --lr-ink-soft: #8a5a5a;
        --lr-slate: #4d5a86;
        --lr-cjk: "LR Pixel SC";
        --lr-title: "Pixelify Sans", var(--lr-cjk), var(--theme-font-active), sans-serif;
        --lr-text: "Pixelify Sans", var(--lr-cjk), var(--theme-font-active), sans-serif;
    }
    html[lang="ja"]:has(.skin-lr) { --lr-cjk: "LR Pixel JP"; }
    html[lang="ko"]:has(.skin-lr) { --lr-cjk: "LR Pixel KR"; }

    /* ---- 整页背景：遗迹场景，罩一层浅苔绿的雾，越往下越淡 ---- */
    html:has(.skin-lr) body {
        background-color: var(--lr-mist);
        background-image:
            linear-gradient(180deg, rgba(30, 44, 36, .28) 0%, rgba(214, 226, 200, .5) 45%, rgba(214, 226, 200, .68) 100%),
            var(--lr-scene);
        background-size: cover, cover;
        background-position: center, center top;
        background-attachment: fixed, fixed;
        image-rendering: pixelated;
        overflow-x: clip;
    }

    /* 像素素材一律按最近邻放大 */
    .skin-lr .project-hero-shell,
    .skin-lr .project-hero-image,
    .skin-lr .project-prose,
    .skin-lr .project-prose h2,
    .skin-lr .project-prose h3::before,
    .skin-lr .project-prose img,
    .skin-lr .project-prose video.clip,
    .skin-lr .project-links-wrapper .brutalist-tag {
        image-rendering: pixelated;
    }

    /* ========================================================= */
    /* HERO：一级面板（金边橙色）                                   */
    /* ========================================================= */
    header.skin-lr {
        background-color: transparent;
        border-color: transparent !important;
        overflow: visible;
    }
    header.skin-lr > .absolute { display: none; }

    .skin-lr .project-hero-shell {
        position: relative;
        max-width: 86rem;
        margin: 0 auto;
        padding: 1.6rem 1.8rem 2rem;
        border-width: 24px;
        border-style: solid;
        border-color: transparent;
        border-image: var(--lr-panel-hero) 24 fill / 24px / 0 stretch;
        color: var(--lr-ink);
        --theme-text: var(--lr-ink);
    }

    .skin-lr .project-hero-screen h1 {
        font-family: var(--lr-title);
        font-weight: 700 !important;
        font-size: clamp(2.75rem, 6vw, 4.125rem);
        letter-spacing: .04em;
        color: var(--lr-peach);
        text-shadow: 3px 3px 0 var(--lr-ink), -3px 3px 0 var(--lr-ink), 3px -3px 0 var(--lr-ink), -3px -3px 0 var(--lr-ink), 0 6px 0 var(--lr-ink);
    }
    .skin-lr .back-btn {
        font-family: var(--lr-title);
        font-weight: 400;
        color: var(--lr-ink);
    }
    .skin-lr .back-btn:hover { color: var(--lr-peach); }

    /* 外链按钮：UI 包的六角名牌（蓝宝石） */
    /* 技能标签：不要底色，前面一颗 UI 包的橙色像素宝石 */
    .skin-lr .brutalist-badge {
        display: inline-flex !important;
        align-items: center;
        gap: .45rem;
        border: 0 !important;
        border-radius: 0 !important;
        background: transparent !important;
        color: var(--lr-ink) !important;
        box-shadow: none !important;
        padding: 0 1rem 0 0 !important;
        font-family: var(--lr-title);
        font-weight: 600 !important;
        font-size: 1.05rem !important;
        transform: none !important;
    }
    .skin-lr .brutalist-badge::before {
        content: "";
        flex: none;
        width: 18px;
        height: 18px;
        background: var(--lr-gem) center / 18px 18px no-repeat;
        image-rendering: pixelated;
    }
    .skin-lr .brutalist-badge i { display: none; }
    /* 编号和分类：UI 包的深紫按钮底，浅色字，不要宝石 */
    .skin-lr .project-hero-screen [data-reveal-children] > div:first-child .brutalist-badge {
        border-width: 9px 12px 12px !important;
        border-style: solid !important;
        border-color: transparent !important;
        border-image: var(--lr-button-plum) 9 12 12 fill / 9px 12px 12px / 0 stretch !important;
        color: var(--lr-peach) !important;
        padding: 0 .3rem !important;
        font-size: .95rem !important;
        letter-spacing: .06em;
    }
    .skin-lr .project-hero-screen [data-reveal-children] > div:first-child .brutalist-badge::before { display: none; }
    .skin-lr .project-hero-screen [data-reveal-children] > div:first-child .brutalist-badge i { display: inline; }

    .skin-lr .project-links-wrapper .brutalist-tag {
        border-width: 15px 24px !important;
        border-style: solid !important;
        border-color: transparent !important;
        border-image: var(--lr-plate-hex) 15 24 fill / 15px 24px / 0 stretch;
        background: transparent !important;
        color: #ffe6c9 !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 0 .3rem !important;
        font-family: var(--lr-title);
        font-weight: 600 !important;
        font-size: 1.1rem !important;
        line-height: 1.1 !important;
        transform: none !important;
    }
    .skin-lr .project-links-wrapper .brutalist-tag {
        transition: translate 100ms steps(2), filter 100ms;
    }
    .skin-lr .project-links-wrapper .brutalist-tag:hover { translate: 0 -3px; filter: brightness(1.05); }
    .skin-lr .project-links-wrapper .brutalist-tag:active { translate: 0 3px; }

    /* 简介：不套框，只留左侧一道深色竖线 */
    .skin-lr .project-hero-screen .border-l-\[4px\] {
        border-color: var(--lr-ink) !important;
        background: transparent;
        color: var(--lr-ink);
    }

    /* 封面：UI 包里金色角饰、绿宝石的相框（只用边，不填中间） */
    .skin-lr .project-hero-shell .project-hero-image {
        border-width: 30px !important;
        border-style: solid !important;
        border-color: transparent !important;
        border-image: var(--lr-panel-ornate) 30 / 30px / 0 stretch !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
    }

    /* ========================================================= */
    /* 正文：一级面板（金边橙色）                                   */
    /* ========================================================= */
    main.skin-lr {
        background: transparent !important;
        color: var(--lr-ink) !important;
        --theme-text: var(--lr-ink);
    }
    .skin-lr .project-prose {
        position: relative;
        padding: clamp(1.25rem, 3vw, 2.75rem);
        border-width: 24px;
        border-style: solid;
        border-color: transparent;
        border-image: var(--lr-panel-1) 24 fill / 24px / 0 stretch;
        color: var(--lr-ink);
    }
    .skin-lr .project-prose p,
    .skin-lr .project-prose li { color: var(--lr-ink); }
    .skin-lr .project-prose strong { color: #9b3d2f; }
    .skin-lr .project-prose a { color: #b0502c; }
    .skin-lr .project-prose li::marker { color: var(--lr-orange); }

    /* H2：UI 包的深棕宝石横幅 */
    .skin-lr .project-prose h2 {
        display: block;
        width: fit-content;
        max-width: 100%;
        padding: .15rem .6rem;
        border-width: 18px 30px;
        border-style: solid;
        border-color: transparent;
        border-image: var(--lr-ribbon) 18 30 fill / 18px 30px / 0 stretch;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: var(--lr-peach);
        font-family: var(--lr-title);
        font-weight: 400;
        font-size: 2.0625rem;
        line-height: 1.2;
        letter-spacing: .04em;
    }

    /* H3：UI 包的金色卷轴横幅，前面一枚图标，按顺序轮换剑 / 盾 / 书 / 法杖 / 骷髅 / 星 */
    .skin-lr .project-prose h3 {
        display: flex;
        align-items: center;
        gap: .6rem;
        width: fit-content;
        max-width: 100%;
        padding: .1rem .4rem .15rem;
        border-width: 9px 24px 24px;
        border-style: solid;
        border-color: transparent;
        border-image: var(--lr-ribbon-gold) 9 24 24 fill / 9px 24px 24px / 0 stretch;
        color: var(--lr-ink);
        font-family: var(--lr-title);
        font-weight: 600;
        font-size: 1.375rem;
        letter-spacing: .03em;
    }
    .skin-lr .project-prose h3::before {
        content: "";
        flex: none;
        width: 36px;
        height: 36px;
        background: var(--lr-icons) 0 0 / 576px 36px no-repeat;
        background-position: calc(var(--lr-i, 8) * -36px) 0;
    }
    .skin-lr .project-prose h3:nth-of-type(6n + 2) { --lr-i: 9; }
    .skin-lr .project-prose h3:nth-of-type(6n + 3) { --lr-i: 11; }
    .skin-lr .project-prose h3:nth-of-type(6n + 4) { --lr-i: 12; }
    .skin-lr .project-prose h3:nth-of-type(6n + 5) { --lr-i: 5; }
    .skin-lr .project-prose h3:nth-of-type(6n) { --lr-i: 0; }

    /* 图片 / 演示片段：不加边框 */
    .skin-lr .project-prose img,
    .skin-lr .project-prose video.clip {
        display: block;
        width: 100%;
        height: auto;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background: transparent;
    }
    .skin-lr .project-prose figure :is(img, video.clip) { margin: 0 !important; }
    .skin-lr .project-prose figcaption {
        color: var(--lr-ink-soft) !important;
        font-family: var(--lr-text);
        font-size: 1rem;
        font-weight: 400;
        opacity: 1;
    }

    .skin-lr .project-prose hr {
        border: 0;
        height: 6px;
        margin: 2.5rem 0;
        background: repeating-linear-gradient(90deg, var(--lr-ink-soft) 0 12px, transparent 12px 18px);
        opacity: .5;
    }


    /* ========================================================= */
    /* 手机                                                          */
    /* ========================================================= */
    @media (max-width: 639px) {
        html:has(.skin-lr) body { background-attachment: scroll, scroll; }
        .skin-lr .project-hero-shell { padding: 1rem .6rem 1.2rem; border-width: 18px; border-image-width: 18px; }
        .skin-lr .project-prose { padding: 1rem .4rem; border-width: 18px; border-image-width: 18px; }
        .skin-lr .project-prose h2 { font-size: 1.375rem; border-width: 12px 20px; border-image-width: 12px 20px; }
        .skin-lr .project-prose h3 { font-size: 1.1rem; }
        .skin-lr .project-prose h3::before { width: 24px; height: 24px; background-size: 384px 24px; background-position: calc(var(--lr-i, 8) * -24px) 0; }
        .skin-lr .project-hero-shell .project-hero-image { border-width: 20px !important; border-image-width: 20px !important; }
        .skin-lr .project-prose h3 { border-width: 6px 16px 16px; border-image-width: 6px 16px 16px; }
    }
</style>
