---
// Night Watch 项目页专属皮肤（projects.json 里 skin: "nw" 时由 [id].astro 挂载）
//
// 视觉照着游戏的美术走：hero 是一张木刻海报（骨白底、黑块、放射色楔），
// 整页背景是罩了骨白纱的主菜单原画，正文两侧是低透明度的游戏卡牌（纯背景，不挡内容），H2 前面插一张小卡。
// 装饰艺术 / 立体未来主义的木刻海报质感：骨白底、厚重黑块、每一类卡牌一个高饱和重色。
// 颜色是从 src/assets/projects/game-project-night-watch/*.webp 里直接取样的，
// 标题字沿用游戏 --font-display 的 Oswald。
// - 整页背景挂在 body 上，而不是页面里的 fixed 层：<main> 带 transition:animate，
//   转场期间它是 transform 容器，里面的 position: fixed 会退化成 absolute。
// - 所有规则都限定在 .skin-nw / html:has(.skin-nw) 下。这段 CSS 会被打进
//   [id].astro 这条路由的公共样式表，不作用域化就会污染其他项目页。
// - 投影一律用无模糊的硬偏移，这是木刻海报的质感，别改成柔和阴影。
interface Props {
    /** true 时只输出 hero 里的装饰层（字体与样式由页面顶部那次挂载负责） */
    stickers?: boolean;
}

const { stickers = false } = Astro.props;

// 游戏内素材：主菜单原画 + 各类卡牌卡面（从游戏构建里导出，300 × 450；主角卡 640 × 960）
import DebugVariantSwitcher from "@/components/portfolio/DebugVariantSwitcher.astro";
import keyArt from "@/assets/projects/game-project-night-watch/game-project-night-watch_KeyArt.webp";
const cardFiles = import.meta.glob<{ default: ImageMetadata }>("@/assets/projects/game-project-night-watch/cards/*.webp", { eager: true });
const card = (name: string) => Object.entries(cardFiles).find(([k]) => k.endsWith(`/${name}.webp`))![1].default.src;

// 每一类卡牌的重色（卡面底色），给卡牌的硬投影用
const FAMILY_COLOR: Record<string, string> = {
    enemy: "var(--nw-crimson)", equip: "var(--nw-steel)", event: "var(--nw-plum)",
    place: "var(--nw-rust)", mat: "var(--nw-navy)", meta: "var(--nw-gold)",
};
// 背景卡牌（三版共用同一组，各版只是摆法不同）：六类轮流，左右交替；j 是这一侧的第几张
// 一直排到页面底部：每侧 40 张（超出页面的被容器裁掉），循环使用 23 张卡面，不会多下载图片
const FACES = ["enemy-1", "place-1", "equip-1", "event-1", "mat-1", "meta-1", "enemy-2", "place-2", "equip-2", "event-2", "mat-2", "meta-2",
    "enemy-3", "place-3", "equip-3", "event-3", "mat-3", "meta-3", "enemy-4", "place-4", "equip-4", "event-4", "mat-4"];
const ORDER = Array.from({ length: 80 }, (_, i) => FACES[(i * 7) % FACES.length]);
const TILTS = [-9, 6, -4, 10, -7, 3, -11, 5, -3, 8, -6, 9];
const JITTER = [0.1, 0.7, 0.35, 0.9, 0.2, 0.55, 0.8, 0.05, 0.6, 0.3, 0.95, 0.45];
const rails = ORDER.map((name, i) => ({
    src: card(name),
    family: name.split("-")[0],
    side: i % 2 ? "right" : "left",
    j: Math.floor(i / 2),
    tilt: TILTS[i % TILTS.length],
    dx: JITTER[i % JITTER.length],
    color: FAMILY_COLOR[name.split("-")[0]],
}));
// H2 前面的小卡：按顺序轮换六类
const headCards = ["enemy-1", "equip-2", "event-2", "place-2", "mat-2", "meta-1"].map(card);
const vars = [
    `--nw-keyart: url("${keyArt.src}")`,
    `--nw-wall: url("${card("wall-strip")}")`,
    ...headCards.map((u, i) => `--nw-head-${i + 1}: url("${u}")`),
].join("; ");
---

{stickers ? (
        <div class="nw-deco" aria-hidden="true">
            <span class="nw-shard nw-shard-a"></span>
            <span class="nw-shard nw-shard-b"></span>
            <span class="nw-shard nw-shard-c"></span>
            <span class="nw-shard nw-shard-d"></span>
        </div>
) : (
        <>
            {/* 游戏本体的 --font-display 就是 Oswald */}
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link
                    rel="stylesheet"
                    href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&display=swap"
            />
            <style is:inline set:html={`html:has(.skin-nw) { ${vars}; }`} />
            {/* 背景卡牌：三版候选（A 牌桌 / B 海报墙 / C 列车车窗），本地 dev 右下角切换；线上用 data-variant-current 的默认值 */}
            <div class="nw-bg" data-variant-group="nwbg" data-variant-label="背景" data-variant-options="A,B,C" data-variant-current="A" aria-hidden="true">
                {rails.map((r) => (
                        <figure class:list={["nw-bg-card", `nw-bg-${r.side}`, `nw-fam-${r.family}`]} style={`--j: ${r.j}; --k: ${r.j % 2}; --r: ${Math.floor(r.j / 2)}; --tilt: ${r.tilt}deg; --dx: ${r.dx}; --c: ${r.color};`}>
                            <img src={r.src} alt="" width="300" height="450" loading="lazy" decoding="async" />
                        </figure>
                ))}
            </div>
            <DebugVariantSwitcher />
        </>
)}

<script>
    // 量顶部组件下沿到背景卡牌容器所在的定位父级（Base 的 main）顶部的距离
    function measureNwHero() {
        const bg = document.querySelector<HTMLElement>(".nw-bg");
        const hero = document.querySelector<HTMLElement>("header.skin-nw");
        if (!bg || !hero || bg.dataset.ready) return;
        bg.dataset.ready = "1";
        const update = () => {
            const parent = bg.offsetParent as HTMLElement | null;
            if (!parent) return;
            const bottom = hero.getBoundingClientRect().bottom - parent.getBoundingClientRect().top;
            document.documentElement.style.setProperty("--nw-hero-bottom", `${Math.round(bottom)}px`);
        };
        new ResizeObserver(update).observe(hero);
        update();
    }
    document.addEventListener("astro:page-load", measureNwHero);
    document.addEventListener("astro:before-swap", () => document.documentElement.style.removeProperty("--nw-hero-bottom"));
</script>

<style is:global>
    /* ========================================================= */
    /* 调色板：直接从卡面素材上取样                                 */
    /* ========================================================= */
    html:has(.skin-nw) {
        --nw-bone: #EFE8D8;
        --nw-bone-deep: #E3D8C0;
        --nw-ink: #14161A;
        --nw-ink-soft: #2A2C30;
        --nw-crimson: #A12C4F;   /* 敌人卡 */
        --nw-steel: #405C70;     /* 装备卡 */
        --nw-plum: #543A85;      /* 事件卡 */
        --nw-rust: #773C1E;      /* 地点卡 */
        --nw-navy: #1A314E;      /* 材料卡 */
        --nw-gold: #C48828;      /* 元卡 */
        --nw-display: "Oswald", var(--theme-font-active), sans-serif;
    }

    /* ---- 整页背景：三版各一套（变量），hero 外面垫同一套，盖住伸到顶部的背景卡 ---- */
    /* A 牌桌：深色桌面，顶上透出主菜单原画 */
    html:has(.skin-nw) {
        --nw-page-color: #15171B;
        --nw-page-image:
            radial-gradient(ellipse 80% 60% at 50% 18%, rgba(21, 23, 27, .5) 0%, rgba(21, 23, 27, .9) 62%, #111216 100%),
            var(--nw-keyart);
        --nw-page-size: cover, 100% auto;
        --nw-page-pos: center, center top;
        --nw-page-repeat: no-repeat, no-repeat;
    }
    /* B 海报墙：骨白纸面 + 细横纹 */
    html:has(.nw-bg[data-variant-current="B"]) {
        --nw-page-color: var(--nw-bone);
        --nw-page-image:
            repeating-linear-gradient(0deg, rgba(20, 22, 26, .03) 0 2px, transparent 2px 6px),
            linear-gradient(180deg, var(--nw-bone), var(--nw-bone-deep));
        --nw-page-size: auto, cover;
        --nw-page-pos: 0 0, center;
        --nw-page-repeat: repeat, no-repeat;
    }
    /* C 列车车窗：深色木墙板（竖向拼板 + 板缝） */
    html:has(.nw-bg[data-variant-current="C"]) {
        --nw-page-color: #2A190F;
        --nw-page-image:
            repeating-linear-gradient(90deg, rgba(0, 0, 0, .28) 0 3px, transparent 3px 112px),
            repeating-linear-gradient(90deg, #3A2417 0 56px, #331F13 56px 112px);
        --nw-page-size: auto, auto;
        --nw-page-pos: 0 0, 0 0;
        --nw-page-repeat: repeat, repeat;
    }

    html:has(.skin-nw) body {
        background-color: var(--nw-page-color);
        background-image: var(--nw-page-image);
        background-size: var(--nw-page-size);
        background-position: var(--nw-page-pos);
        background-repeat: var(--nw-page-repeat);
        background-attachment: fixed;
        overflow-x: clip;
    }

    /* ========================================================= */
    /* HERO：一张木刻海报                                          */
    /* ========================================================= */
    header.skin-nw {
        background-color: transparent;
        border-color: transparent !important;
        overflow: visible;
    }

    header.skin-nw > .absolute {
        display: none;
    }

    .skin-nw .project-hero-shell {
        position: relative;
        max-width: 86rem;
        margin: 0 auto;
        padding: 2.6rem 2.4rem 3rem;
        background-color: var(--nw-bone);
        border: 6px solid var(--nw-ink);
        /* 木刻海报的硬投影，不要模糊 */
        box-shadow: 14px 14px 0 var(--nw-crimson);
    }

    .skin-nw .project-hero-screen {
        position: relative;
        z-index: 2;
    }

    /* ---- 角落的色楔 ---- */
    .skin-nw .nw-deco {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
    }

    .skin-nw .nw-shard {
        position: absolute;
        display: block;
    }

    .skin-nw .nw-shard-a {
        top: 0;
        left: 0;
        width: 190px;
        height: 150px;
        background-color: var(--nw-gold);
        clip-path: polygon(0 0, 100% 0, 0 100%);
    }

    .skin-nw .nw-shard-b {
        top: 0;
        right: 0;
        width: 120px;
        height: 230px;
        background-color: var(--nw-steel);
        clip-path: polygon(100% 0, 100% 100%, 0 0);
    }

    .skin-nw .nw-shard-c {
        bottom: 0;
        left: 0;
        width: 150px;
        height: 110px;
        background-color: var(--nw-plum);
        clip-path: polygon(0 100%, 0 0, 100% 100%);
    }

    .skin-nw .nw-shard-d {
        bottom: 0;
        right: 0;
        width: 240px;
        height: 90px;
        background-color: var(--nw-navy);
        clip-path: polygon(100% 100%, 100% 0, 0 100%);
    }

    /* ---- 标题：黑色实心条上的骨白大写字 ---- */
    .skin-nw .project-hero-screen h1 {
        display: inline-block;
        padding: .35em .5em .3em;
        background-color: var(--nw-ink);
        color: var(--nw-bone);
        font-family: var(--nw-display);
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
        box-shadow: 10px 10px 0 var(--nw-gold);
    }

    .skin-nw .back-btn {
        font-family: var(--nw-display);
        font-weight: 600;
        color: var(--nw-ink);
        opacity: 1;
        letter-spacing: .22em;
        transition: color .15s ease, translate .15s ease;
    }

    .skin-nw .back-btn:hover {
        color: var(--nw-crimson);
        translate: -3px 0;
    }

    /* ---- 标签：实心色块 ---- */
    .skin-nw .brutalist-badge {
        border: 0 !important;
        border-radius: 0;
        padding: .34rem 1rem;
        background-color: var(--nw-ink);
        color: var(--nw-bone);
        box-shadow: none;
        font-family: var(--nw-display);
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    /* 序号 / 分类 / 各标签轮换卡面上的六个重色 */
    .skin-nw .project-hero-screen [data-reveal-children] > div:first-child .brutalist-badge:nth-child(1) {
        background-color: var(--nw-crimson);
    }

    .skin-nw .project-hero-screen [data-reveal-children] > div:first-child .brutalist-badge:nth-child(2) {
        background-color: var(--nw-ink);
    }

    .skin-nw .project-hero-screen .brutalist-badge:nth-child(3n + 1) {
        background-color: var(--nw-navy);
    }

    .skin-nw .project-hero-screen .brutalist-badge:nth-child(3n + 2) {
        background-color: var(--nw-rust);
    }

    .skin-nw .project-hero-screen .brutalist-badge:nth-child(3n) {
        background-color: var(--nw-plum);
    }

    /* ---- 简介：厚黑竖条 ---- */
    .skin-nw .project-hero-screen .border-l-\[4px\] {
        border-left-width: 10px;
        border-color: var(--nw-ink) !important;
        padding-left: 1.3rem;
        color: var(--nw-ink);
        font-weight: 600;
    }

    /* ---- 外链：切角实心块 ---- */
    .skin-nw .project-links-wrapper .brutalist-tag {
        border: 0;
        border-radius: 0;
        padding: .75rem 1.8rem;
        background-color: var(--nw-crimson);
        color: var(--nw-bone);
        box-shadow: 7px 7px 0 var(--nw-ink);
        font-family: var(--nw-display);
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
        clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
        transition: translate .12s ease, box-shadow .12s ease, background-color .12s ease;
    }

    .skin-nw .project-links-wrapper .brutalist-tag:hover,
    .skin-nw .project-links-wrapper .brutalist-tag:active {
        transform: none;
        translate: 4px 4px;
        background-color: var(--nw-ink);
        box-shadow: 3px 3px 0 var(--nw-crimson);
    }

    /* ---- 封面图：粗黑框 + 硬投影 ---- */
    .skin-nw .project-hero-shell .project-hero-image {
        border-width: 6px;
        border-color: var(--nw-ink) !important;
        border-radius: 0;
        background-color: var(--nw-ink) !important;
        box-shadow: 12px 12px 0 var(--nw-steel);
    }

    /* ---- 顶部组件 · A 牌桌（跟背景一起切）：墨黑牌面，骨白字，照游戏卡框的黑框 + 内圈金色细线；不放色楔 ---- */
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .project-hero-shell {
        background-color: #1B1D22;
        border-color: #0B0C0F;
        outline: 2px solid var(--nw-gold);
        outline-offset: -16px;
        box-shadow: 0 26px 50px rgba(0, 0, 0, .55);
    }
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .project-hero-screen h1 {
        padding: 0 0 .2em;
        background: linear-gradient(var(--nw-crimson), var(--nw-crimson)) left bottom / 100% .09em no-repeat;
        color: var(--nw-bone);
        letter-spacing: .28em;
        box-shadow: none;
    }
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .back-btn,
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .project-hero-screen .border-l-\[4px\] {
        color: var(--nw-bone);
    }
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .project-hero-screen .border-l-\[4px\] {
        border-color: var(--nw-gold) !important;
    }
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .project-hero-shell .project-hero-image {
        border-color: #0B0C0F !important;
        box-shadow: 0 16px 30px rgba(0, 0, 0, .6);
        outline: 2px solid rgba(239, 232, 216, .8);
        outline-offset: -10px;
    }

    /* ---- 顶部组件 · C 列车车厢：深色木板面，黄铜镶边，标题刻在黄铜铭牌上，封面是一扇拱顶车窗 ---- */
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .project-hero-shell {
        background-color: #3A2417;
        background-image:
            repeating-linear-gradient(90deg, rgba(0, 0, 0, .22) 0 2px, transparent 2px 96px),
            repeating-linear-gradient(90deg, #452A1A 0 48px, #3E2617 48px 96px);
        border: 10px solid #1A0F09;
        outline: 3px solid #B08440;
        outline-offset: -10px;
        box-shadow: 0 26px 50px rgba(0, 0, 0, .5);
    }
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .project-hero-screen h1 {
        padding: .3em .7em .25em;
        background: linear-gradient(180deg, #E2C27A 0%, #B08440 55%, #8A6329 100%);
        color: #2A190F;
        letter-spacing: .2em;
        border: 3px solid #5C3F17;
        border-radius: .3rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .5), 0 6px 0 #1A0F09;
        text-shadow: 0 1px 0 rgba(255, 255, 255, .4);
    }
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .back-btn,
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .project-hero-screen .border-l-\[4px\] {
        color: #EFE2C6;
    }
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .project-hero-screen .border-l-\[4px\] {
        border-color: #B08440 !important;
    }
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .project-hero-shell .project-hero-image {
        border: 12px solid #1A0F09 !important;
        border-radius: 46% 46% .6rem .6rem / 30% 30% .6rem .6rem;
        outline: 3px solid #B08440;
        outline-offset: -3px;
        box-shadow: 0 16px 30px rgba(0, 0, 0, .55);
    }
    html:has(.nw-bg[data-variant-current="A"]) .skin-nw .nw-deco,
    html:has(.nw-bg[data-variant-current="C"]) .skin-nw .nw-deco {
        display: none;
    }

    /* ========================================================= */
    /* 正文：一张贴在骨白纸上的说明版                               */
    /* ========================================================= */
    main.skin-nw {
        position: relative;
        background-color: transparent;
    }

    .skin-nw .project-prose {
        position: relative;
        padding: 3.4rem 3rem 3.8rem;
        background-color: var(--nw-bone);
        border: 6px solid var(--nw-ink);
        box-shadow: 14px 14px 0 var(--nw-navy);
    }

    .skin-nw .project-prose p,
    .skin-nw .project-prose li,
    .skin-nw .project-prose strong,
    .skin-nw .project-prose h4 {
        color: var(--nw-ink);
    }

    .skin-nw .project-prose h4 {
        font-family: var(--nw-display);
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    /* 列表标记换成方块 */
    .skin-nw .project-prose ul {
        list-style: square;
    }

    .skin-nw .project-prose li::marker {
        color: var(--nw-crimson);
    }

    /* ---- H2：黑色切角横条 ---- */
    .skin-nw .project-prose h2 {
        display: block;
        width: auto;
        position: relative;
        padding: .8rem 1.6rem .7rem 4.4rem;
        border: 0;
        border-radius: 0;
        background-color: var(--nw-ink);
        color: var(--nw-bone);
        box-shadow: 9px 9px 0 var(--nw-gold);
        font-family: var(--nw-display);
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%);
    }

    .skin-nw .project-prose h2::before {
        content: "";
        position: absolute;
        left: 1rem;
        top: 50%;
        width: 2.2rem;
        height: 3.3rem;
        translate: 0 -50%;
        rotate: -6deg;
        background: var(--nw-head-1) center / cover;
        border: 2px solid var(--nw-bone);
    }
    .skin-nw .project-prose h2:nth-of-type(6n + 2)::before { background-image: var(--nw-head-2); }
    .skin-nw .project-prose h2:nth-of-type(6n + 3)::before { background-image: var(--nw-head-3); }
    .skin-nw .project-prose h2:nth-of-type(6n + 4)::before { background-image: var(--nw-head-4); }
    .skin-nw .project-prose h2:nth-of-type(6n + 5)::before { background-image: var(--nw-head-5); }
    .skin-nw .project-prose h2:nth-of-type(6n)::before { background-image: var(--nw-head-6); }

    /* ---- 背景卡牌：只在正文两侧放得下时显示，垫在所有内容下面，不挡字 ---- */
    html:has(.skin-nw) .nw-bg {
        display: none;
    }
    @media (min-width: 1360px) {
        main.l-main:has(.skin-nw) {
            position: relative;
        }
        html:has(.skin-nw) .nw-bg {
            --gutter: calc(50vw - 32rem);
            display: block;
            position: absolute;
            /* 从顶部组件下沿开始（--nw-hero-bottom 由下面的脚本量），卡牌永远不会被它盖住 */
            inset: calc(var(--nw-hero-bottom, 48rem) + 2.5rem) 0 0 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }
