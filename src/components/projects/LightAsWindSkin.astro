---
// 愿此身如风 Light as Wind 项目页专属皮肤（projects.json 里 skin: "law" 时由 [id].astro 挂载）
//
// 样式照搬游戏官网 lightaswind.com（Website/assets/site.css），图也是官网的那几张：
// - 页头：官网首页的分层海报（天空、女孩、手写标题和副标题的图、小人），位置照官网的百分比；下面一条 bleed.webp
//   把海报下缘的颜色渗进纸里。竖屏照官网：女孩的侧脸在上，标题叠在下面的天空上。
//   模板自己的标题只在视觉上隐藏（读屏仍读它），右侧 4:3 封面图藏起来。
// - 正文：米白的纸、墨蓝的字、小赖手写字；标题居中、前面一只橙色小海星（.star-h），分隔线是细线中间一只海星
//   （.star-rule）；按钮是手绘边框（.itch-btn）；视频后面一圈错开的铅笔框（.story-art）；
//   诗在中文、日文里竖排，三列依次往下错开。MDX 里用的类都以 law- 开头。
// - 小赖字体（OFL）只收这一页用到的字（skin/xiaolai-law.woff2，由 Trailer/fonts/Xiaolai-Regular.ttf 用 fontTools
//   截取）。这一页的正文也用它，所以改了 MDX 的文字要重新截取，缺的字会退回站内字体。
// - 所有规则都限定在 .skin-law / html:has(.skin-law) 下（样式表是整条路由共用的）。
interface Props {
    /** true 时只输出 hero 里的装饰层（样式由页面顶部那次挂载负责） */
    stickers?: boolean;
}
const { stickers = false } = Astro.props;
const zh = (Astro.currentLocale ?? "en") === "zh";

import sky from "@/assets/projects/game-project-light-as-wind/skin/hero-sky-1920.webp";
import girl from "@/assets/projects/game-project-light-as-wind/skin/hero-girl-1920.webp";
import skyP from "@/assets/projects/game-project-light-as-wind/skin/hero-sky-p-780.webp";
import girlP from "@/assets/projects/game-project-light-as-wind/skin/hero-girl-p-780.webp";
import titleZh from "@/assets/projects/game-project-light-as-wind/skin/title-zh.webp";
import titleEn from "@/assets/projects/game-project-light-as-wind/skin/title-en.webp";
import subZh from "@/assets/projects/game-project-light-as-wind/skin/subtitle-zh.webp";
import subEn from "@/assets/projects/game-project-light-as-wind/skin/subtitle-en.webp";
import mascot from "@/assets/projects/game-project-light-as-wind/skin/mascot.webp";
import bleed from "@/assets/projects/game-project-light-as-wind/skin/bleed.webp";
import star from "@/assets/projects/game-project-light-as-wind/skin/star-orange.png";
import font from "@/assets/projects/game-project-light-as-wind/skin/xiaolai-law.woff2?url";

const title = zh ? titleZh : titleEn;
const sub = zh ? subZh : subEn;

const scribble = (stroke: string, w = 1.6) =>
    `url("data:image/svg+xml,${encodeURIComponent(
        `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 8' preserveAspectRatio='none'><path d='M1 5.5C18 3 34 6.5 52 4.2S83 2.8 99 4.6' fill='none' stroke='${stroke}' stroke-width='${w}' stroke-linecap='round' vector-effect='non-scaling-stroke'/></svg>`,
    )}")`;
const fontFace = `@font-face { font-family: "Xiaolai LAW"; src: url("${font}") format("woff2"); font-display: swap; }`;
const vars = [
    `--law-star: url("${star.src}")`,
    `--law-scribble: ${scribble("#26354d")}`,
    `--law-scribble-white: ${scribble("#ffffff", 1.8)}`,
    `--law-sky-img: url("${sky.src}")`,
    `--law-girl-img: url("${girl.src}")`,
    `--law-sky-p: url("${skyP.src}")`,
    `--law-girl-p: url("${girlP.src}")`,
    `--law-bleed: url("${bleed.src}")`,
];
---

{stickers ? (
        <div class="law-hero" aria-hidden="true">
            <div class="law-stage">
                <div class="law-layer law-sky"></div>
                <div class="law-layer law-girl"></div>
                <div class="law-layer law-words">
                    <img class="law-w-title" src={title.src} width={title.width} height={title.height} alt="" />
                    <img class="law-w-sub" src={sub.src} width={sub.width} height={sub.height} alt="" />
                    <img class="law-w-mascot" src={mascot.src} width={mascot.width} height={mascot.height} alt="" />
                </div>
            </div>
            <div class="law-bleed"></div>
        </div>
) : (
        <style is:inline set:html={`${fontFace} html:has(.skin-law) { ${vars.join("; ")}; }`} />
)}

<style is:global>
    /* ========================================================= */
    /* 官网的基础值                                                */
    /* ========================================================= */
    html:has(.skin-law) {
        --law-sky: #4381ef;
        --law-paper: #fbfaf6;
        --law-ink: #26354d;
        --law-ink-soft: #6a7488;
        --law-line: rgba(38, 53, 77, .55);
        --law-teal: #2b7a85;
        --law-font: "Xiaolai LAW", var(--theme-font-active), "PingFang SC", "Microsoft YaHei", sans-serif;
    }
    html:has(.skin-law) body { background: var(--law-paper); overflow-x: clip; }

    /* ========================================================= */
    /* 页头：官网的分层海报                                          */
    /* ========================================================= */
    header.skin-law {
        background: transparent !important;
        color: var(--law-ink) !important;
        border-bottom: 0 !important;
        padding-top: 0 !important;
        --theme-text: var(--law-ink);
    }
    header.skin-law > .absolute { display: none; }
    .skin-law .project-hero-shell { position: relative; display: flex; flex-direction: column; }
    .skin-law .project-hero-screen { display: contents; }
    .skin-law .project-hero-screen > div:first-child {
        position: absolute; top: 1.1rem; left: 0; right: 0; z-index: 3; margin: 0 auto !important;
    }
    .skin-law #back-btn { color: #fff; font-family: var(--law-font); font-weight: 400 !important; letter-spacing: .06em; text-shadow: 0 1px 4px rgba(15, 30, 70, .55); }
    .skin-law .project-hero-screen > div:last-child { order: 2; width: 100%; position: relative; z-index: 1; }
    .skin-law .project-hero-screen div:has(> .project-hero-image) { display: none; }
    header.skin-law h1 {
        position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }

    .skin-law .law-hero {
        order: 1; position: relative;
        width: 100vw; margin-left: calc(50% - 50vw);
        height: min(56.25vw, 88vh); min-height: 420px; overflow: hidden;
    }
    /* 舞台就是海报的 16:9 画幅，像 cover、0% 85% 的背景那样放（官网 .stage） */
    .skin-law .law-stage {
        --sw: max(100vw, calc(min(56.25vw, 88vh) * 1.7778), 746px);
        position: absolute; left: 0; width: var(--sw); height: calc(var(--sw) * .5625);
        top: calc((min(56.25vw, 88vh) - var(--sw) * .5625) * .85);
        -webkit-mask-image: linear-gradient(#000 0, #000 78%, rgba(0,0,0,.92) 85%, rgba(0,0,0,.75) 90%, rgba(0,0,0,.45) 95%, rgba(0,0,0,.15) 98.5%, transparent 100%);
                mask-image: linear-gradient(#000 0, #000 78%, rgba(0,0,0,.92) 85%, rgba(0,0,0,.75) 90%, rgba(0,0,0,.45) 95%, rgba(0,0,0,.15) 98.5%, transparent 100%);
    }
    .skin-law .law-layer { position: absolute; inset: 0; }
    .skin-law .law-sky { background: var(--law-sky) var(--law-sky-img) center / 100% 100% no-repeat; transform: scale(1.06); animation: law-drift 18s ease-in-out infinite alternate; }
    .skin-law .law-girl { background: var(--law-girl-img) center / 100% 100% no-repeat; transform: scale(1.04); transform-origin: 100% 50%; }
    @keyframes law-drift { from { translate: -.8% .3%; } to { translate: .8% -.3%; } }
    .skin-law .law-words img { position: absolute; height: auto; }
    .skin-law .law-w-title { left: 2.552%; top: 57.407%; width: 52.656%; animation: law-rise 1.2s .25s cubic-bezier(.2,.7,.2,1) both; }
    .skin-law .law-w-sub { left: 2.604%; top: 72.963%; width: 52.656%; animation: law-rise 1.2s .55s cubic-bezier(.2,.7,.2,1) both; }
    html[lang="en"] .skin-law .law-w-sub, html[lang="ja"] .skin-law .law-w-sub, html[lang="ko"] .skin-law .law-w-sub { left: 1.927%; top: 73.889%; }
    .skin-law .law-w-mascot { left: 49.479%; top: 75.926%; width: 13.542%; animation: law-rise 1.2s .85s cubic-bezier(.2,.7,.2,1) both, law-float 5s 2.1s ease-in-out infinite; }
    @keyframes law-rise { from { opacity: 0; transform: translateY(14px); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }
    @keyframes law-float { 50% { transform: translateY(-4%) rotate(-2deg); } }
    /* 海报下缘的颜色渗进纸里（官网 .bleed） */
    .skin-law .law-bleed {
        position: absolute; left: 0; right: 0; bottom: 0; height: 30%;
        background: var(--law-bleed) left bottom / max(100vw, 177.78vh) 100% no-repeat;
        -webkit-mask-image: linear-gradient(transparent, #000 60%); mask-image: linear-gradient(transparent, #000 60%);
        opacity: .0;
    }

    /* 竖屏：女孩的侧脸在上，标题叠在下面的天空上（官网的竖屏版式） */
    @media (max-aspect-ratio: 1/1) {
        .skin-law .law-hero { height: min(150vw, 82vh); min-height: 520px; background: linear-gradient(var(--law-sky) 0, var(--law-sky) 74%, #a9c6f6 90%, #dce7f8 97%, var(--law-paper) 100%); }
        .skin-law .law-stage { inset: 0; width: auto; height: auto; -webkit-mask-image: none; mask-image: none; }
        .skin-law .law-sky, .skin-law .law-girl { bottom: auto; height: 64%; background-size: cover; background-position: 72% top; }
        .skin-law .law-sky { background-image: var(--law-sky-p); animation: none; }
        .skin-law .law-girl { background-image: var(--law-girl-p); transform-origin: 70% 30%;
            -webkit-mask-image: linear-gradient(#000 0, #000 62%, transparent 100%); mask-image: linear-gradient(#000 0, #000 62%, transparent 100%); }
        .skin-law .law-sky::after { content: ""; position: absolute; inset: auto 0 -1px 0; height: 35%; background: linear-gradient(transparent, var(--law-sky)); }
        .skin-law .law-words { top: 58%; bottom: auto; padding: 0 24px; }
        .skin-law .law-words img { position: relative; left: auto !important; top: auto !important; margin: 0 auto; }
        .skin-law .law-w-title { width: min(100%, 520px); }
        .skin-law .law-w-sub { width: min(86%, 440px); margin-top: -5% !important; }
        .skin-law .law-w-mascot { display: none; }
        .skin-law .law-bleed { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .skin-law .law-sky, .skin-law .law-words img { animation: none; }
    }

    /* 页头下面：标签、简介、链接，居中，和官网的正文一样 */
    .skin-law .project-hero-screen > div:last-child > div { align-items: center !important; text-align: center !important; }
    .skin-law .project-hero-screen > div:last-child > div > div { justify-content: center; }
    header.skin-law .brutalist-badge {
        border: 1.5px solid var(--law-line) !important;
        border-radius: 14px 160px 12px 150px / 150px 14px 160px 12px;
        background: none; color: var(--law-ink); box-shadow: none;
        font-family: var(--law-font); font-weight: 400 !important; letter-spacing: .04em; text-transform: none;
    }
    header.skin-law .brutalist-badge i { display: none; }
    header.skin-law .border-l-\[4px\] {
        border-left: 0 !important; padding-left: 0 !important; max-width: 30em; word-break: keep-all; overflow-wrap: anywhere; text-wrap: balance; margin-left: auto; margin-right: auto;
        font-family: var(--law-font); font-weight: 400 !important; font-size: clamp(18px, 1.6vw, 22px) !important; line-height: 2 !important; letter-spacing: .04em;
    }
    /* 链接按钮：官网的手绘边框按钮 */
    .skin-law .brutalist-tag {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 10px 20px 12px 16px !important; color: var(--law-ink) !important;
        font-family: var(--law-font); font-weight: 400 !important; font-size: clamp(17px, 1.4vw, 20px) !important; letter-spacing: .04em; text-transform: none !important;
        border: 1.8px solid var(--law-ink) !important; border-radius: 16px 220px 14px 200px / 200px 16px 220px 14px !important;
        background: rgba(67, 129, 239, .07) !important;
        box-shadow: 3px 4px 0 -1px rgba(38, 53, 77, .18) !important;
        transition: transform .2s ease, background-color .2s ease, box-shadow .2s ease;
    }
    .skin-law .brutalist-tag:nth-child(2) { border-radius: 160px 12px 180px 14px / 12px 170px 14px 150px !important; }
    .skin-law .brutalist-tag:hover { transform: rotate(-1.5deg) translateY(-1px) !important; background: rgba(67, 129, 239, .13) !important; box-shadow: 4px 6px 0 -1px rgba(38, 53, 77, .2) !important; }
    .skin-law .project-links-wrapper { justify-content: center; }

    /* ========================================================= */
    /* 正文：纸上的书                                                */
    /* ========================================================= */
    section.skin-law {
        background: transparent !important; color: var(--law-ink) !important; --theme-text: var(--law-ink);
        padding-bottom: 0 !important;
    }
    .skin-law .project-prose {
        max-width: 64rem !important;
        padding-bottom: clamp(72px, 10vw, 130px);
        font-family: var(--law-font);
        line-break: strict;
    }
    .skin-law .project-prose p,
    .skin-law .project-prose li {
        font-size: clamp(17px, 1.25vw, 19px) !important; line-height: 1.95 !important; letter-spacing: .03em;
        color: var(--law-ink) !important;
    }
    .skin-law .project-prose > p,
    .skin-law .project-prose > ul { max-width: 38em; margin-left: auto; margin-right: auto; }
    .skin-law .project-prose strong { font-weight: 400; color: var(--law-teal); }
    .skin-law .project-prose a { color: var(--law-teal); text-decoration: none; border-bottom: 1.5px dashed currentColor; padding-bottom: 1px; }
    .skin-law .project-prose ul { list-style: none; padding-left: 0; }
    .skin-law .project-prose ul li { position: relative; padding-left: 1.6em; margin: .5em 0; }
    .skin-law .project-prose ul li::before {
        content: ""; position: absolute; left: 0; top: .55em; width: .95em; height: .95em;
        background: var(--law-star) center / contain no-repeat; rotate: -8deg;
    }
    .skin-law .project-prose ul li::marker { content: none; }

    /* 标题：居中，前面一只橙色小海星（官网 .sec-h.star-h） */
    .skin-law .project-prose h2 {
        display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%;
        margin: clamp(56px, 8vw, 110px) 0 clamp(20px, 3vw, 32px) !important;
        font-family: var(--law-font); font-weight: 400 !important; font-size: clamp(28px, 3.4vw, 40px) !important; letter-spacing: .06em;
        color: var(--law-ink); text-align: center;
        border: 0 !important; box-shadow: none !important; background: none !important; padding: 0 !important; border-radius: 0 !important;
    }
    .skin-law .project-prose > h2:first-child { margin-top: clamp(16px, 3vw, 40px) !important; }
    .skin-law .project-prose h2::before {
        content: ""; width: 1.15em; height: 1.15em; flex: none;
        background: var(--law-star) center / contain no-repeat; transform: rotate(-8deg);
    }
    .skin-law .project-prose h2::after { display: none !important; }
    /* 分隔线：细线中间一只海星（官网 .star-rule） */
    .skin-law .project-prose hr {
        position: relative; height: 46px; max-width: 640px; margin: clamp(28px, 4vw, 44px) auto !important;
        border: 0 !important; background: none !important;
    }
    .skin-law .project-prose hr::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; border-top: 1.5px solid rgba(43, 122, 133, .45); }
    .skin-law .project-prose hr::after {
        content: ""; position: absolute; left: 50%; top: 0; width: 46px; height: 46px; margin-left: -23px;
        background: var(--law-paper) var(--law-star) center / 34px no-repeat;
    }
    .skin-law .project-prose figcaption {
        margin-top: 8px !important; font-family: var(--law-font); font-weight: 400 !important;
        font-size: 15px !important; line-height: 1.5 !important; color: var(--law-ink-soft) !important; opacity: 1 !important;
    }

    /* 开头的一句话（官网 .lead） */
    .skin-law .project-prose .law-lead {
        margin: clamp(24px, 4vw, 48px) auto clamp(40px, 6vw, 64px) !important; max-width: 26em !important; text-align: center;
        font-size: clamp(19px, 1.7vw, 24px) !important; line-height: 2 !important; letter-spacing: .05em; text-wrap: balance;
    }

    /* 诗：中文、日文竖排，三列依次往下错开（官网 .poem） */
    .skin-law .law-poem {
        writing-mode: vertical-rl; display: flex; flex-direction: column; gap: clamp(28px, 4vw, 52px);
        margin: clamp(40px, 6vw, 72px) auto; width: fit-content;
        color: var(--law-ink); letter-spacing: .16em;
    }
    .skin-law .law-poem p { margin: 0 !important; font-size: clamp(18px, 1.5vw, 21px) !important; line-height: 2.1 !important; letter-spacing: .16em; white-space: pre-line; }
    .skin-law .law-poem p:nth-child(2) { padding-inline-start: 2.2em; }
    .skin-law .law-poem p:nth-child(3) { padding-inline-start: 4.4em; }
    html[lang="en"] .skin-law .law-poem, html[lang="ko"] .skin-law .law-poem {
        writing-mode: horizontal-tb; gap: 6px; max-width: 32em; text-align: center; letter-spacing: .02em;
    }
    html[lang="en"] .skin-law .law-poem p, html[lang="ko"] .skin-law .law-poem p { padding: 0; letter-spacing: .02em; line-height: 2 !important; text-wrap: balance; white-space: normal; }
    .skin-law .project-prose .law-motto {
        margin: 0 auto !important; max-width: 14em; text-align: center;
        font-size: clamp(26px, 3.2vw, 40px) !important; line-height: 1.55 !important; letter-spacing: .08em; text-wrap: balance; word-break: keep-all;
    }
    .skin-law .law-wave { display: block; width: 92px; height: 12px; margin: clamp(28px, 4vh, 40px) auto; fill: none; stroke: var(--law-line); stroke-width: 1.6; stroke-linecap: round; }

    /* 视频：后面一圈错开的铅笔框（官网 .story-art） */
    .skin-law .law-story { position: relative; margin: 0 auto; width: 100%; max-width: 820px; display: flex; flex-direction: column; gap: clamp(18px, 2.4vw, 32px); }
    .skin-law .law-story .law-clip { position: relative; z-index: 1; margin: 0 !important; }
    .skin-law .law-story .law-clip::before {
        content: ""; position: absolute; inset: 14px -14px -14px 14px; z-index: -1;
        border: 1.6px solid var(--law-line); border-radius: 12px 260px 10px 240px / 240px 12px 260px 10px;
    }
    .skin-law .law-story video,
    .skin-law .law-story img {
        display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: #0d1b33;
        border: 0 !important; box-shadow: none !important; border-radius: 8px 12px 8px 14px !important;
    }
    .skin-law .project-prose .law-story .law-clip-cap { margin: 22px 0 0 !important; text-align: center; color: var(--law-ink) !important; }
    .skin-law .law-shots { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 1.8vw, 24px); margin-top: 8px; }
    .skin-law .law-shots figure { margin: 0 !important; }
    .skin-law .law-shots video { border-radius: 6px 10px 7px 12px !important; }
    .skin-law .law-shots figure:nth-child(2) video { border-radius: 10px 6px 12px 7px !important; }
    .skin-law .law-shots figcaption { text-align: left; }

    @media (max-width: 760px) {
        .skin-law .law-shots { grid-template-columns: 1fr; }
        .skin-law .law-members { grid-template-columns: 1fr 1fr; }
        .skin-law .law-members figure:first-child { grid-column: 1 / -1; max-width: 240px; justify-self: center; }
        .skin-law .law-story .law-clip::before { inset: 8px -8px -8px 8px; }
    }
</style>
