---
// src/components/index/PortfolioBanner.astro
// 首页的「作品集」大字区：参照作品集页 AI 部分「Attention is all you need」标语的做法——
// 深色描边 + 浅色填充的大字，角色直接站 / 趴 / 倚在字上，鼠标经过时离得近的字抬起并填深，字上的角色跟着一起动
import { useTranslations, type Lang } from "@/i18n.ts";
import { COLORS } from "@/consts.ts";
import type { ImageMetadata } from "astro";
import witch from "@/assets/projects/game-project-empty-throne/deco/witch.png";
import eelHero from "@/assets/stickers/eel-on-mask-hero.webp";
import fractalShelter from "@/assets/stickers/fractal-shelter-girl.webp";
import eelFish from "@/assets/stickers/eel-fish.webp";

const t = useTranslations(Astro.currentLocale as Lang);

const bg = COLORS.khakiMilan;
const text = COLORS.black;

const word = t({ en: "Portfolio", zh: "作品集", ja: "作品集", ko: "포트폴리오" });
const letters = Array.from(word);
const last = letters.length - 1;
const middle = Math.floor(last / 2);

/*
 * 角色挂在某个字上（at：字的序号），随这个字一起抬起。
 * spot 决定摆法：left = 倚在字左侧、right = 站在字右侧、top = 站 / 趴在字顶上。
 * size 是高度（em，相对大字字号），x 是横向微调（em）。
 */
type Spot = "left" | "right" | "top";
type Character = { src: ImageMetadata; at: number; spot: Spot; size: number; x?: number; pixel?: boolean; flip?: boolean };
const characters: Character[] = [
    // 《空王座》女巫小姐
    { src: witch, at: 0, spot: "left", size: 1.75, x: 0.12, pixel: true },
    // 《鳗！》主角，站在第一个字顶上
    { src: eelHero, at: 0, spot: "top", size: 0.95, x: 0.05 },
    // 《鳗！》鳗鱼，趴在中间的字顶上
    { src: eelFish, at: middle, spot: "top", size: 0.36, flip: true },
    // 《分形收容所》角色
    { src: fractalShelter, at: last, spot: "right", size: 1.6, x: -0.18 },
];
const onLetter = (i: number) => characters.filter((c) => c.at === i);
---

<section
        id="portfolio-banner"
        class="relative w-full overflow-hidden"
        data-theme-bg={bg}
        data-theme-text={text}
        style={`background-color: ${bg}; color: ${text}; --theme-bg: ${bg}; --theme-text: ${text}; --pf-ink: ${text}; --pf-fill: ${COLORS.white};`}
>
    <div class="relative mx-auto flex h-[300px] sm:h-[520px] lg:h-[680px] max-w-[1600px] items-end justify-center px-4 pb-16 sm:pb-20 lg:pb-24">
        <h2 class="pf-word" aria-label={word} data-pf-attention data-reveal="up" data-reveal-once>
            {letters.map((ch, i) => (
                <span class="pf-ch" aria-hidden="true">
                    {ch}
                    {onLetter(i).map((c) => (
                        <img
                                src={c.src.src}
                                width={c.src.width}
                                height={c.src.height}
                                alt=""
                                loading="lazy"
                                draggable="false"
                                class:list={["pf-char", `pf-${c.spot}`, c.pixel && "pixelated", c.flip && "flip"]}
                                style={`--size: ${c.size}em; --x: ${c.x ?? 0}em;`}
                        />
                    ))}
                </span>
            ))}
        </h2>
    </div>
</section>

<script>
    // 「注意力」悬停，同作品集页 AI 标语：离鼠标越近的字权重越高（高斯衰减），权重决定抬多高、填多深。
    // 字只上下动，进来时量一次各字中心，之后每帧只算数、写样式
    function initPortfolioAttention() {
        document.querySelectorAll<HTMLElement>("[data-pf-attention]").forEach((line) => {
            if (line.dataset.attnReady) return;
            line.dataset.attnReady = "1";
            const chars = [...line.querySelectorAll<HTMLElement>(".pf-ch")];
            let raf = 0;
            let mouseX: number | null = null;
            let centers: number[] = [];
            let sigma = 120;
            const measure = () => {
                sigma = (parseFloat(getComputedStyle(line).fontSize) || 120) * 0.8;
                centers = chars.map((el) => {
                    const r = el.getBoundingClientRect();
                    return r.left + scrollX + r.width / 2;
                });
            };
            const apply = () => {
                raf = 0;
                chars.forEach((el, i) => {
                    let w = 0;
                    if (mouseX !== null) {
                        const d = mouseX - centers[i];
                        w = Math.exp(-(d * d) / (2 * sigma * sigma));
                    }
                    el.style.setProperty("--w", w.toFixed(3));
                });
            };
            const schedule = () => { if (!raf) raf = requestAnimationFrame(apply); };
            line.addEventListener("pointerenter", measure);
            line.addEventListener("pointermove", (e) => {
                if (!centers.length) measure();
                mouseX = e.clientX + scrollX;
                schedule();
            });
            line.addEventListener("pointerleave", () => { mouseX = null; schedule(); });
            window.addEventListener("resize", () => { centers = []; }, { passive: true });
        });
    }
    document.addEventListener("astro:page-load", initPortfolioAttention);
</script>

<style>
    .pf-word {
        display: flex;
        align-items: flex-end;
        white-space: nowrap;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.02em;
        font-size: clamp(4rem, 15vw, 13.5rem);
        /* 深色描边、白色填充；描边画在填充下面，露出来的是外侧一半 */
        color: var(--pf-fill);
        -webkit-text-stroke: 0.06em var(--pf-ink);
        paint-order: stroke fill;
        user-select: none;
    }
    html[lang="en"] .pf-word,
    html[lang="ko"] .pf-word {
        font-size: clamp(3rem, 11vw, 10rem);
    }

    /* 权重 --w（0~1）让字抬起、填充从白过渡到深色；字上的角色是字的子元素，跟着一起抬 */
    .pf-ch {
        position: relative;
        display: inline-block;
        translate: 0 calc(var(--w, 0) * -0.12em);
        color: color-mix(in srgb, var(--pf-ink) calc(var(--w, 0) * 100%), var(--pf-fill));
        transition: translate 200ms ease-out, color 200ms ease-out;
    }

    .pf-char {
        position: absolute;
        height: var(--size);
        width: auto;
        max-width: none;
        pointer-events: none;
    }
    /* 倚在字左侧：脚踩在字的底线上，身体贴着字的左边 */
    .pf-left {
        bottom: -0.02em;
        right: calc(100% - var(--x));
    }
    /* 站在字右侧 */
    .pf-right {
        bottom: -0.02em;
        left: calc(100% + var(--x));
    }
    /* 站 / 趴在字顶上：底边压在字顶的描边上 */
    .pf-top {
        bottom: 0.9em;
        left: calc(50% + var(--x));
        translate: -50% 0;
    }
    .pf-char.pixelated { image-rendering: pixelated; }
    .pf-char.flip { scale: -1 1; }

    @media (prefers-reduced-motion: reduce) {
        .pf-ch { translate: 0 0; }
    }
</style>
