---
// src/components/index/PortfolioBanner.astro
// 首页的「作品集」大字区：米色底，中间三个大字，两侧站着项目里的角色
import { useTranslations, type Lang } from "@/i18n.ts";
import { COLORS } from "@/consts.ts";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const t = useTranslations(Astro.currentLocale as Lang);

const bg = COLORS.khakiMilan;
const text = COLORS.black;

// 角色立绘：side 决定站在大字左边还是右边，height 是桌面端高度（px），手机端按比例缩小
type Character = { src: ImageMetadata; alt: string; side: "left" | "right"; height: number };
const characters: Character[] = [];
---

<section
        id="portfolio-banner"
        class="relative w-full overflow-hidden"
        data-theme-bg={bg}
        data-theme-text={text}
        style={`background-color: ${bg}; color: ${text}; --theme-bg: ${bg}; --theme-text: ${text};`}
>
    <div class="relative mx-auto flex h-[360px] sm:h-[480px] lg:h-[640px] max-w-[1600px] items-center justify-center px-4">
        <h2
                class="banner-title relative z-10 font-black leading-none tracking-tight whitespace-nowrap select-none"
                data-reveal="scale"
        >
            {t({ en: "Portfolio", zh: "作品集", ja: "作品集", ko: "포트폴리오" })}
        </h2>

        {characters.map((c, i) => (
            <div
                    class:list={["banner-char absolute bottom-0 z-20", c.side === "left" ? "left-side" : "right-side"]}
                    style={`--char-h: ${c.height}px; --char-i: ${i};`}
                    data-reveal="up"
                    data-reveal-delay={String(120 + i * 90)}
            >
                <Image src={c.src} alt={c.alt} widths={[240, 480, 720]} sizes="(max-width: 639px) 40vw, 360px" class="h-full w-auto" />
            </div>
        ))}
    </div>
</section>

<style>
    .banner-title {
        font-size: clamp(5rem, 20vw, 17rem);
    }
    html[lang="en"] .banner-title,
    html[lang="ko"] .banner-title {
        font-size: clamp(3.5rem, 14vw, 13rem);
    }

    .banner-char {
        height: var(--char-h);
    }
    .banner-char.left-side { right: 50%; margin-right: 22vw; }
    .banner-char.right-side { left: 50%; margin-left: 22vw; }

    @media (max-width: 639px) {
        .banner-char { height: calc(var(--char-h) * 0.5); }
        .banner-char.left-side { margin-right: 28vw; }
        .banner-char.right-side { margin-left: 28vw; }
    }
</style>
