---
// src/components/GameStickerSection.astro
import { useTranslations, type Lang } from "@/i18n.ts";
import { COLORS } from "@/consts.ts";
import { gameSectionUI } from "@/i18n/components/index/GameStickerSection_i18.ts";
import { getRelativeLocaleUrl } from "astro:i18n";
import witch from "@/assets/projects/game-project-empty-throne/deco/witch.png";
import eelHero from "@/assets/stickers/eel-on-mask-hero.webp";
import eelFish from "@/assets/stickers/eel-fish.webp";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

// 角色贴纸：透明底立绘，不带文字。显示大小 = 原图像素尺寸 × 统一比例 × 各自的 scale（默认 1）
const characterStickers = [
    { src: witch, alt: t({ en: "The Witch from Empty Throne", zh: "《空王座》女巫小姐", ja: "『空の玉座』の魔女", ko: "《빈 왕좌》의 마녀" }), pixel: true, scale: 1.85 },
    // 下面两张原图自带贴纸描边，不再叠加白边
    { src: eelHero, alt: t({ en: "The protagonist of Eel On Mask", zh: "《鳗！》主角", ja: "『Eel On Mask』の主人公", ko: "《Eel On Mask》의 주인공" }), outlined: true },
    { src: eelFish, alt: t({ en: "The eel from Eel On Mask", zh: "《鳗！》里的鳗鱼", ja: "『Eel On Mask』のウナギ", ko: "《Eel On Mask》의 장어" }), outlined: true, scale: 1.4 },
];

// 「作品集」拆成一个字一张贴纸；英文单词不拆
const portfolioWord = t({ en: "Portfolio", zh: "作品集", ja: "作品集", ko: "포트폴리오" });
const portfolioPieces = locale === "en" ? [portfolioWord] : Array.from(portfolioWord);
const portfolioHref = getRelativeLocaleUrl(locale, "portfolio");
---

<section
        id="games-sticker-section"
        class="relative w-full h-[var(--mobile-height)] lg:h-[1000px] overflow-hidden pt-12 lg:pt-16"
        style={`--mobile-height: 110vw; background-color: ${COLORS.khakiMilan}; color: ${COLORS.black};`}
        data-theme-bg={COLORS.khakiMilan}
        data-theme-text={COLORS.black}
>
    <div class="absolute top-12 lg:top-16 inset-x-0 mx-auto w-full px-4 sm:px-8 z-20 pointer-events-none flex justify-end">
        <div class="flex gap-3 sm:gap-4 pointer-events-auto" data-reveal-children="right" data-reveal-stagger="80">
            <button id="btn-shake" class="brutalist-tag bg-white cursor-pointer">
                <i class="fa-solid fa-bolt"></i>
                <span class="hidden sm:inline">{t(gameSectionUI.shake)}</span>
            </button>
            <button id="btn-reset" class="brutalist-tag bg-white cursor-pointer">
                <i class="fa-solid fa-rotate-right"></i>
                <span class="hidden sm:inline">{t(gameSectionUI.reset)}</span>
            </button>
        </div>
    </div>

    <div id="physics-container" class="absolute inset-0 z-10 w-full h-full touch-pan-y overflow-hidden">
        <!-- 「作品集」字形贴纸：每个字一张，沿字形描白边 + 深色外轮廓；点一下进作品集页 -->
        {portfolioPieces.map((ch) => (
            <div
                    data-href={portfolioHref}
                    data-fixed
                    class="game-sticker word-sticker absolute top-0 left-0 select-none leading-none cursor-pointer"
                    style={`color: ${COLORS.black};`}
            >
                <span class="block font-black whitespace-nowrap pointer-events-none">{ch}</span>
            </div>
        ))}

        {characterStickers.map((c) => (
            <div class="game-sticker char-sticker absolute top-0 left-0 select-none" style={`--nat-h: ${c.src.height}; --k: ${c.scale ?? 1};`}>
                <img
                        src={c.src.src}
                        width={c.src.width}
                        height={c.src.height}
                        alt={c.alt}
                        class:list={["block h-full w-auto pointer-events-none", c.pixel && "pixelated", c.outlined && "outlined"]}
                        draggable="false"
                        loading="lazy"
                />
            </div>
        ))}
    </div>
</section>

<style>
    .word-sticker span {
        font-size: clamp(7rem, 26vw, 16rem);
        padding: 0.06em 0.08em;
        /* 白色描边画在字的外侧（先描边后填充），再用四向投影叠一圈深色外轮廓，最后是硬阴影 */
        -webkit-text-stroke: 0.14em #fff;
        paint-order: stroke fill;
        filter:
            drop-shadow(3px 0 0 #494949) drop-shadow(-3px 0 0 #494949)
            drop-shadow(0 3px 0 #494949) drop-shadow(0 -3px 0 #494949)
            drop-shadow(7px 7px 0 rgba(73, 73, 73, 0.9));
    }
    /* 角色贴纸：沿透明轮廓描白边（八向白色投影），外面一圈深色细线，再加硬阴影 */
    .char-sticker {
        /* 原图高度 × 统一比例（桌面约 0.15，手机按屏宽缩小）× 单张的 scale */
        height: calc(var(--nat-h) * var(--k) * min(0.15px, 0.0104vw));
        padding: 8px;
        will-change: transform;
    }
    .char-sticker img {
        filter:
            drop-shadow(5px 0 0 #fff) drop-shadow(-5px 0 0 #fff)
            drop-shadow(0 5px 0 #fff) drop-shadow(0 -5px 0 #fff)
            drop-shadow(2px 0 0 #494949) drop-shadow(-2px 0 0 #494949)
            drop-shadow(0 2px 0 #494949) drop-shadow(0 -2px 0 #494949)
            drop-shadow(6px 6px 0 rgba(73, 73, 73, 0.9));
    }
    .char-sticker img.outlined {
        filter:
            drop-shadow(2px 0 0 #494949) drop-shadow(-2px 0 0 #494949)
            drop-shadow(0 2px 0 #494949) drop-shadow(0 -2px 0 #494949)
            drop-shadow(6px 6px 0 rgba(73, 73, 73, 0.9));
    }
    .char-sticker img.pixelated {
        image-rendering: pixelated;
    }
    .word-sticker {
        will-change: transform;
    }
    @media (max-width: 639px) {
        .char-sticker { height: calc(var(--nat-h) * var(--k) * 0.018vw); }
    }
    html[lang="en"] .word-sticker span {
        font-size: clamp(4rem, 14vw, 10rem);
    }
    html[lang="ko"] .word-sticker span {
        font-size: clamp(5rem, 18vw, 12rem);
    }
</style>

<script>
    import Matter from 'matter-js';
    import { navigate } from 'astro:transitions/client';

        document.addEventListener('astro:page-load', () => {
            // ==========================================
            // --- Matter.js 物理贴纸逻辑 ---
            // ==========================================
            const container = document.getElementById('physics-container');
            if (!container) return;

            // 触摸交互统一由下面的自定义手势处理，不再按屏幕宽度区分设备
            // （按宽度判断会把横屏平板/触屏笔记本当成桌面端，导致整个区域无法滚动）
            const gestures = new AbortController();
            const { signal } = gestures;

            const { Engine, Runner, Bodies, World, Mouse, MouseConstraint, Events } = Matter;

            const engine = Engine.create();
            engine.world.gravity.y = 1.2;

            let width = container.clientWidth;
            let height = container.clientHeight;
            const wallThickness = 200;

            const wallOptions = { isStatic: true, render: { visible: false } };
            const ground = Bodies.rectangle(width / 2, height + wallThickness / 2, width * 2, wallThickness, wallOptions);
            const leftWall = Bodies.rectangle(-wallThickness / 2, height / 2, wallThickness, height * 3, wallOptions);
            const rightWall = Bodies.rectangle(width + wallThickness / 2, height / 2, wallThickness, height * 3, wallOptions);
            const ceiling = Bodies.rectangle(width / 2, -1500, width * 2, wallThickness, wallOptions);

            World.add(engine.world, [ground, ceiling, leftWall, rightWall]);
            const stickers = Array.from(document.querySelectorAll('.game-sticker')) as HTMLElement[];
            type Item = { body: Matter.Body; el: HTMLElement; fixed: boolean; slot: number };
            const bodiesMap: Item[] = [];

            // 「作品集」字贴纸固定悬在空中：横向居中排成一行（放不下就折行），每个字带一点固定的歪斜
            const FIXED_TILTS = [-0.07, 0.05, -0.03, 0.06, -0.05];
            const fixedEls = stickers.filter(el => el.hasAttribute('data-fixed'));
            const freeEls = stickers.filter(el => !el.hasAttribute('data-fixed'));
            const fixedLayout = () => {
                const gap = Math.min(width * 0.02, 24);
                const rows: HTMLElement[][] = [[]];
                let rowW = 0;
                for (const el of fixedEls) {
                    const w = el.offsetWidth;
                    if (rows[rows.length - 1].length && rowW + gap + w > width * 0.94) { rows.push([]); rowW = 0; }
                    rowW += (rows[rows.length - 1].length ? gap : 0) + w;
                    rows[rows.length - 1].push(el);
                }
                const rowH = Math.max(...fixedEls.map(el => el.offsetHeight), 0);
                const top = height * 0.42 - (rows.length * rowH) / 2;
                const pos = new Map<HTMLElement, { x: number; y: number }>();
                rows.forEach((row, ri) => {
                    const total = row.reduce((sum, el) => sum + el.offsetWidth, 0) + gap * (row.length - 1);
                    let x = width / 2 - total / 2;
                    row.forEach(el => {
                        pos.set(el, { x: x + el.offsetWidth / 2, y: top + rowH * (ri + 0.5) });
                        x += el.offsetWidth + gap;
                    });
                });
                return pos;
            };
            // 角色贴纸从上方横向错开落下
            const spawnX = (slot: number, w: number) =>
                Math.min(Math.max(width / 2 + (slot - (freeEls.length - 1) / 2) * w * 1.05, w / 2), width - w / 2);

            const freeOptions = { restitution: 0.6, friction: 0.3, density: 0.002, chamfer: { radius: 16 } };
            const makeBody = (el: HTMLElement, fixed: boolean, slot: number, layout?: Map<HTMLElement, { x: number; y: number }>) => {
                const w = el.offsetWidth;
                const h = el.offsetHeight;
                if (fixed) {
                    const p = (layout ?? fixedLayout()).get(el)!;
                    const body = Bodies.rectangle(p.x, p.y, w, h, { isStatic: true, friction: 0.3, chamfer: { radius: 16 } });
                    Matter.Body.setAngle(body, FIXED_TILTS[slot % FIXED_TILTS.length]);
                    return body;
                }
                const body = Bodies.rectangle(spawnX(slot, w), -h * (0.5 + slot * 0.6), w, h, freeOptions);
                Matter.Body.setAngle(body, (Math.random() - 0.5) * 0.4);
                return body;
            };

            // 点击跳转逻辑（桌面和手机端都保留）
            function bindClick(el: HTMLElement) {
                let startX = 0, startY = 0;
                el.addEventListener('pointerdown', (e) => {
                    startX = e.clientX;
                    startY = e.clientY;
                    }, { signal });
                el.addEventListener('pointerup', (e) => {
                    const dx = Math.abs(e.clientX - startX);
                    const dy = Math.abs(e.clientY - startY);
                    if (dx < 10 && dy < 10) {
                        const href = el.getAttribute('data-href');
                        if (href) {
                            navigate(href);
                            return;
                            }
                        const link = el.getAttribute('data-link');
                        if (link) {
                            window.open(link, '_blank');
                            }
                        }
                    }, { signal });
            }

            const initialLayout = fixedLayout();
            stickers.forEach((el) => {
                const fixed = fixedEls.includes(el);
                const slot = fixed ? fixedEls.indexOf(el) : freeEls.indexOf(el);
                const body = makeBody(el, fixed, slot, initialLayout);
                bodiesMap.push({ body, el, fixed, slot });
                World.add(engine.world, body);
                if (fixed) return void bindClick(el);

                // 竖向手势留给页面滚动，横向手势才拖动贴纸
                el.classList.add('touch-pan-y', 'cursor-grab');

                bindClick(el);
                });

            // --- 按钮逻辑 ---
            const btnShake = document.getElementById('btn-shake');
            const btnReset = document.getElementById('btn-reset');

            btnShake?.addEventListener('click', () => {
                bodiesMap.forEach(({ body, fixed }) => {
                    if (fixed) return;
                    Matter.Body.setVelocity(body, {
                        x: (Math.random() - 0.5) * 15,
                        y: -25 - (Math.random() * 10)
                        });
                    Matter.Body.setAngularVelocity(body, (Math.random() - 0.5) * 0.4);
                    });
                });

            btnReset?.addEventListener('click', () => {
                bodiesMap.forEach((item) => {
                    if (item.fixed) return;
                    World.remove(engine.world, item.body);
                    item.body = makeBody(item.el, false, item.slot);
                    World.add(engine.world, item.body);
                    });
                });

            // --- 鼠标拖拽 ---
            const mouse = Mouse.create(container);
            // Matter 的 Mouse 会在 wheel / touch 事件里无条件 preventDefault，
            // 这会让整个区域在滚轮和触摸下都无法滚动页面，所以只保留鼠标事件。
            ([
                ['mousewheel', (mouse as any).mousewheel],
                ['DOMMouseScroll', (mouse as any).mousewheel],
                ['wheel', (mouse as any).mousewheel],
                ['touchstart', (mouse as any).mousedown],
                ['touchmove', (mouse as any).mousemove],
                ['touchend', (mouse as any).mouseup],
            ] as [string, EventListener][]).forEach(([type, handler]) => {
                mouse.element.removeEventListener(type, handler);
                });

            const mouseConstraint = MouseConstraint.create(engine, {
                mouse: mouse,
                constraint: { stiffness: 0.1, render: { visible: false } }
                });
            World.add(engine.world, mouseConstraint);

            // --- 触摸拖拽：横向手势拖贴纸，纵向手势交还给页面滚动 ---
            const toContainerPoint = (touch: Touch) => {
                const rect = container.getBoundingClientRect();
                const scaleX = rect.width ? container.clientWidth / rect.width : 1;
                const scaleY = rect.height ? container.clientHeight / rect.height : 1;
                return {
                    x: (touch.clientX - rect.left) * scaleX,
                    y: (touch.clientY - rect.top) * scaleY
                    };
                };

            bodiesMap.forEach((item) => {
                if (item.fixed) return;
                let touchId: number | null = null;
                let startX = 0, startY = 0;
                let mode: 'undecided' | 'drag' | 'scroll' = 'undecided';
                let constraint: Matter.Constraint | null = null;

                const endTouch = () => {
                    if (constraint) {
                        World.remove(engine.world, constraint);
                        constraint = null;
                        }
                    touchId = null;
                    mode = 'undecided';
                    };

                item.el.addEventListener('touchstart', (e) => {
                    if (touchId !== null) return;
                    const touch = e.changedTouches[0];
                    touchId = touch.identifier;
                    startX = touch.clientX;
                    startY = touch.clientY;
                    mode = 'undecided';
                    }, { signal, passive: true });

                item.el.addEventListener('touchmove', (e) => {
                    if (touchId === null || mode === 'scroll') return;
                    const touch = Array.from(e.changedTouches).find(t => t.identifier === touchId);
                    if (!touch) return;

                    if (mode === 'undecided') {
                        const dx = Math.abs(touch.clientX - startX);
                        const dy = Math.abs(touch.clientY - startY);
                        if (dx < 8 && dy < 8) return;
                        // 纵向为主 → 页面滚动；横向为主 → 拖动贴纸
                        mode = dx > dy ? 'drag' : 'scroll';
                        if (mode === 'scroll') return;

                        const point = toContainerPoint(touch);
                        const body = item.body;
                        Matter.Sleeping.set(body, false);
                        constraint = Matter.Constraint.create({
                            pointA: point,
                            bodyB: body,
                            pointB: { x: point.x - body.position.x, y: point.y - body.position.y },
                            angleB: body.angle,
                            length: 0.01,
                            stiffness: 0.1,
                            angularStiffness: 1,
                            render: { visible: false }
                            });
                        World.add(engine.world, constraint);
                        }

                    if (!constraint) return;
                    Matter.Sleeping.set(item.body, false);
                    constraint.pointA = toContainerPoint(touch);
                    if (e.cancelable) e.preventDefault();
                    }, { signal, passive: false });

                item.el.addEventListener('touchend', endTouch, { signal });
                item.el.addEventListener('touchcancel', endTouch, { signal });
                });

            const runner = Runner.create();
            Runner.run(runner, engine);

            Events.on(engine, 'afterUpdate', () => {
                bodiesMap.forEach(({ body, el }) => {
                    const { x, y } = body.position;
                    const angle = body.angle;
                    el.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%) rotate(${angle}rad)`;
                    });
                });

            // --- 窗口 Resize 逻辑 ---
            let resizeTimeout: ReturnType<typeof setTimeout>;
            const handleResize = () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(() => {
                    width = container!.clientWidth;
                    height = container!.clientHeight;

                    Matter.Body.setPosition(ground, { x: width / 2, y: height + wallThickness / 2 });
                    Matter.Body.setPosition(ceiling, { x: width / 2, y: -1500 });
                    Matter.Body.setPosition(leftWall, { x: -wallThickness / 2, y: height / 2 });
                    Matter.Body.setPosition(rightWall, { x: width + wallThickness / 2, y: height / 2 });

                    const layout = fixedLayout();
                    bodiesMap.forEach((item) => {
                        if (item.fixed) {
                            World.remove(engine.world, item.body);
                            item.body = makeBody(item.el, true, item.slot, layout);
                            World.add(engine.world, item.body);
                            return;
                            }
                        const el = item.el;
                        const newW = el.offsetWidth;
                        const newH = el.offsetHeight;

                        const { position, velocity, angularVelocity, angle } = item.body;

                        World.remove(engine.world, item.body);

                        const newBody = Bodies.rectangle(position.x, position.y, newW, newH, {
                            restitution: 0.6,
                            friction: 0.3,
                            density: 0.002,
                            chamfer: { radius: 16 }
                            });

                        Matter.Body.setAngle(newBody, angle);
                        Matter.Body.setVelocity(newBody, velocity);
                        Matter.Body.setAngularVelocity(newBody, angularVelocity);

                        item.body = newBody;
                        World.add(engine.world, newBody);
                        });
                    }, 150);
                };

            window.addEventListener('resize', handleResize);

            document.addEventListener('astro:before-swap', () => {
                Runner.stop(runner);
                Engine.clear(engine);
                World.clear(engine.world, false);
                gestures.abort();
                window.removeEventListener('resize', handleResize);
                }, { once: true });
            });
</script>