---
// src/components/PongGame.astro
import { type Lang, useTranslations } from "@/i18n.ts";
import { KAOMOJI, pongTranslations } from "@/i18n/components/index/PongGame_i18.ts";
import { COLORS } from "@/consts.ts";

const currentLocale = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(currentLocale);

const GAME_THEMES = [
    COLORS.blue,
    COLORS.green,
    COLORS.yellow,
    COLORS.orange,
    COLORS.purple,
    COLORS.red
];
---

<div id="pong-container" class="w-full min-h-[220px] overflow-hidden relative font-sans transition-colors duration-300"
     style={`height: 260px; background-color: var(--theme-light); --theme-light: ${COLORS.blue.light};
--theme-dark: ${COLORS.blue.dark};`}
     data-i18n-start={t(pongTranslations.startGame)}
     data-i18n-try={t(pongTranslations.tryNow)}
     data-i18n-resume={t(pongTranslations.resumeGame)}
     data-i18n-press={t(pongTranslations.pressWS)}
     data-i18n-touch={t(pongTranslations.touchScreen)}
     data-i18n-level={t(pongTranslations.level)}
     data-themes={JSON.stringify(GAME_THEMES)}
     data-kaomoji={JSON.stringify(KAOMOJI)}
     data-theme-bg={COLORS.blue.light}
     data-theme-text={COLORS.blue.dark}
>

    <div id="start-screen" class="absolute inset-0 z-10 flex flex-col items-center justify-center transition-opacity duration-500 ease-out pb-3" style="background-color: var(--theme-light);">
        <div id="pong-kaomoji" aria-hidden="true"
             class="kaomoji text-4xl lg:text-5xl font-bold text-center leading-tight mb-5 tracking-tight transition-opacity duration-200 ease-out select-none"
             style="color: var(--theme-dark);">{KAOMOJI[0]}</div>

        <div class="flex items-center gap-3 px-5 py-2.5 rounded-2xl shadow-sm scale-90 lg:scale-100 transition-transform" style="background-color: rgba(255, 255, 255, 0.6);">
            <div id="key-hint-wrapper" class="flex flex-col items-center gap-1">
                <div class="w-7 h-7 bg-white rounded-md flex items-center justify-center shadow-[0_2px_4px_rgba(0,0,0,0.05)] font-bold text-base" style="color: var(--theme-dark);">W</div>
                <div class="w-7 h-7 bg-white rounded-md flex items-center justify-center shadow-[0_2px_4px_rgba(0,0,0,0.05)] font-bold text-base" style="color: var(--theme-dark);">S</div>
            </div>
            <div class="text-left ml-1.5">
                <div id="btn-title" class="font-bold text-lg tracking-wide leading-tight" style="color: var(--theme-dark);">{t(pongTranslations.startGame)}</div>
                <div id="btn-subtitle" class="text-xs mt-1 leading-none opacity-80" style="color: var(--theme-dark);">{t(pongTranslations.tryNow)}</div>
            </div>
        </div>
    </div>

    <canvas id="pong" tabindex="0" class="block w-full h-full focus:outline-none cursor-pointer"></canvas>

    <style>
        /* 颜文字混用了假名、西里尔、泰文等字符，单独给一条覆盖面更广的字体栈，避免缺字变豆腐块 */
        .kaomoji {
            font-family: "Segoe UI Symbol", "Segoe UI", "Yu Gothic", "Hiragino Sans",
            "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
        }
    </style>

    <div id="drag-handle" class="absolute bottom-0 left-0 w-full h-2.5 cursor-ns-resize z-20 flex items-center justify-center opacity-40 hover:opacity-100 transition-opacity" style="background-color: var(--theme-dark);">
        <div class="w-12 h-[2px] bg-white/80 rounded-full"></div>
    </div>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const container = document.getElementById("pong-container");
        const canvas = document.getElementById("pong") as HTMLCanvasElement;
        const startScreen = document.getElementById("start-screen");
        const btnTitle = document.getElementById("btn-title");
        const btnSubtitle = document.getElementById("btn-subtitle");
        const keyHintWrapper = document.getElementById("key-hint-wrapper");

        if (!container || !canvas || !startScreen || !btnTitle || !btnSubtitle) return;

        if (container.style.height.includes('vh')) {
            container.style.height = `${container.clientHeight}px`;
        }

        const isTouchDevice = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
            (window.matchMedia("(pointer: coarse)").matches && window.innerWidth <= 1024);

        if (isTouchDevice && keyHintWrapper) {
            keyHintWrapper.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--theme-dark);"><path d="M12 5v14"/><path d="m15 8-3-3-3 3"/><path d="m9 16 3 3 3-3"/></svg>`;
        }

        const i18nStart = container.getAttribute("data-i18n-start") || "Start Game";
        const i18nTry = container.getAttribute("data-i18n-try") || "Try now";
        const i18nResume = container.getAttribute("data-i18n-resume") || "Resume Game";
        const i18nLevel = container.getAttribute("data-i18n-level") || "LV ";

        const i18nPress = isTouchDevice
            ? (container.getAttribute("data-i18n-touch") || "Swipe Screen")
            : (container.getAttribute("data-i18n-press") || "Press WS");

        // ========== 首屏颜文字随机轮播 ==========
        const kaomojiEl = document.getElementById("pong-kaomoji");
        const kaomojiRaw = container.getAttribute("data-kaomoji");
        const KAOMOJI: string[] = kaomojiRaw ? JSON.parse(kaomojiRaw) : [];
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let kaomojiTimer = 0;

        if (kaomojiEl && KAOMOJI.length > 1 && !prefersReducedMotion) {
            let kaomojiIndex = 0;

            kaomojiTimer = window.setInterval(() => {
                // 开始屏隐藏（游戏进行中）时不必空转
                if (startScreen!.style.opacity === '0') return;

                let next = kaomojiIndex;
                while (next === kaomojiIndex) {
                    next = Math.floor(Math.random() * KAOMOJI.length);
                }
                kaomojiIndex = next;

                kaomojiEl.style.opacity = '0';
                window.setTimeout(() => {
                    kaomojiEl.textContent = KAOMOJI[kaomojiIndex];
                    kaomojiEl.style.opacity = '1';
                }, 200);
            }, 2000);
        }

        const themesRaw = container.getAttribute("data-themes");
        const THEMES = themesRaw ? JSON.parse(themesRaw) : [{ light: "#BDF1CD", dark: "#16A062" }];

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const controller = new AbortController();
        const { signal } = controller;

        // ========== 广播主题色给 Header ==========
        function broadcastTheme(theme: { light: string; dark: string }) {
            container!.setAttribute('data-theme-bg', theme.light);
            container!.setAttribute('data-theme-text', theme.dark);
            document.dispatchEvent(new CustomEvent('section-theme-change', {
                detail: { bg: theme.light, text: theme.dark, source: container }
            }));
        }

        let currentLevel = parseInt(sessionStorage.getItem('pongLevel') || '1', 10);

        const initialThemeIndex = (currentLevel <= THEMES.length) ? (currentLevel - 1) : 0;
        let currentTheme = THEMES[initialThemeIndex];
        let oldTheme = currentTheme;

        container.style.setProperty('--theme-light', currentTheme.light);
        container.style.setProperty('--theme-dark', currentTheme.dark);
        container.style.backgroundColor = currentTheme.light;

        broadcastTheme(currentTheme);

        let hasStarted = false;
        let isPaused = false;
        let isResetting = false;
        let resetTimer = 0;
        let gameWidth = 0;
        let gameHeight = 0;

        let isTransitioning = false;
        let transitionRadius = 0;
        let maxTransitionRadius = 0;

        let particles: any[] = [];
        let rings: { x: number; y: number; r: number; maxR: number; life: number; width: number }[] = [];
        let popups: { x: number; y: number; text: string; life: number; size: number }[] = [];
        let shake = 0;
        let shakeX = 0;
        let shakeY = 0;
        let screenFlash = 0;

        const paddleWidth = 10;
        const paddleHeight = 60;
        const basePaddleSpeed = 7;
        const keys: Record<string, boolean> = {};

        type Paddle = {
            x: number; y: number; width: number; height: number;
            targetHeight: number; sizeTimer: number;
            vy: number; prevY: number; flash: number; squash: number;
        };
        const makePaddle = (x: number): Paddle => ({
            x, y: 0, width: paddleWidth, height: paddleHeight,
            targetHeight: paddleHeight, sizeTimer: 0,
            vy: 0, prevY: 0, flash: 0, squash: 0
        });
        const user = makePaddle(20);
        const com  = makePaddle(0);

        type Ball = {
            x: number; y: number; radius: number; currentRadius: number;
            speed: number; velocityX: number; velocityY: number;
            spin: number; rot: number; trail: { x: number; y: number }[];
            lastHit: Paddle | null;
        };
        const START_SPEED = 6;
        const makeBall = (x: number, y: number): Ball => ({
            x, y, radius: 8, currentRadius: 8,
            speed: START_SPEED, velocityX: 0, velocityY: 0,
            spin: 0, rot: 0, trail: [], lastHit: null
        });
        let balls: Ball[] = [makeBall(0, 0)];

        // 连击：每次接球 +1，越长球越快；最高纪录存本地
        let rally = 0;
        let rallyBump = 0;
        let bestRally = parseInt(localStorage.getItem('pongBestRally') || '0', 10) || 0;

        // AI 的失误量和瞄准：每次玩家回球时重新决定
        let aiOffset = 0;
        let aiAimed = false;

        type PowerUp = { x: number; y: number; kind: 'grow' | 'shrink' | 'multi'; life: number; t: number };
        let powerUp: PowerUp | null = null;
        let powerUpTimer = 360;

        // 难度曲线：巡航速度随关卡和连击上涨，上限随关卡放宽
        const cruiseSpeed = () => Math.min(8.5 + (currentLevel - 1) * 0.9, 15) + Math.min(rally * 0.12, 2.5);
        const maxSpeed = () => Math.min(15 + (currentLevel - 1) * 0.6, 20);
        const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

        function createParticles(x: number, y: number, color: string, count: number = 25, power: number = 12) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x, y: y, vx: (Math.random() - 0.5) * power, vy: (Math.random() - 0.5) * power,
                    life: 1, decay: Math.random() * 0.02 + 0.01,
                    color: color, size: Math.random() * 3 + 1
                });
            }
        }

        function addRing(x: number, y: number, maxR: number, width: number = 3) {
            rings.push({ x, y, r: 4, maxR, life: 1, width });
        }

        function addPopup(x: number, y: number, text: string, size: number = 16) {
            popups.push({ x: clamp(x, 40, gameWidth - 40), y: clamp(y, 24, gameHeight - 24), text, life: 1, size });
        }

        function addShake(amount: number) {
            if (!prefersReducedMotion) shake = Math.max(shake, amount);
        }

        function updateEffects() {
            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx; p.y += p.vy; p.life -= p.decay;
                p.vx *= 0.96; p.vy *= 0.96;
                if (p.life <= 0) particles.splice(i, 1);
            }
            for (let i = rings.length - 1; i >= 0; i--) {
                const r = rings[i];
                r.r += (r.maxR - r.r) * 0.12;
                r.life -= 0.04;
                if (r.life <= 0) rings.splice(i, 1);
            }
            for (let i = popups.length - 1; i >= 0; i--) {
                const p = popups[i];
                p.y -= 0.6;
                p.life -= 0.02;
                if (p.life <= 0) popups.splice(i, 1);
            }
            shake *= 0.85;
            if (shake < 0.3) shake = 0;
            shakeX = (Math.random() - 0.5) * 2 * shake;
            shakeY = (Math.random() - 0.5) * 2 * shake;
            screenFlash *= 0.9;
            rallyBump *= 0.85;
        }

        function triggerReset(explodeX: number, explodeY: number, doExplode: boolean = true) {
            if (doExplode) {
                createParticles(explodeX, explodeY, currentTheme.dark, 30, 14);
                addRing(explodeX, explodeY, 90, 4);
                addShake(8);
            }
            isResetting = true;
            resetTimer = 80;
            const b = makeBall(gameWidth / 2, gameHeight / 2);
            b.currentRadius = 0;
            balls = [b];
            powerUp = null;
            powerUpTimer = 300 + Math.random() * 240;
            rally = 0;
        }

        function levelUp(explodeX: number, explodeY: number) {
            createParticles(explodeX, explodeY, currentTheme.dark, 60, 18);
            addRing(explodeX, explodeY, 160, 5);
            addRing(explodeX, explodeY, 90, 3);
            addShake(14);
            screenFlash = 0.7;

            oldTheme = currentTheme;
            currentLevel++;
            addPopup(gameWidth / 2, gameHeight / 2 - 60, `${i18nLevel}${currentLevel}`, 28);

            localStorage.setItem('pongLevel', currentLevel.toString());
            sessionStorage.setItem('pongLevel', currentLevel.toString());
            document.dispatchEvent(new CustomEvent('pong-level-update', { detail: { level: currentLevel } }));

            const themeIndex = (currentLevel <= THEMES.length) ? (currentLevel - 1) : 0;
            currentTheme = THEMES[themeIndex];

            broadcastTheme(currentTheme);

            isTransitioning = true;
            transitionRadius = 0;
            maxTransitionRadius = Math.sqrt((gameWidth/2)**2 + (gameHeight/2)**2) + 50;

            for (const b of balls) {
                b.currentRadius = 0;
                b.velocityX = 0; b.velocityY = 0;
                b.trail = [];
            }
            powerUp = null;
            for (const p of [user, com]) { p.targetHeight = paddleHeight; p.sizeTimer = 0; }
        }

        function easeOutBack(x: number): number {
            const c1 = 1.70158; const c3 = c1 + 1;
            return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
        }

        function toggleUI(show: boolean, isResuming: boolean = false) {
            if (show) {
                if (isResuming) {
                    btnTitle!.innerText = i18nResume;
                    btnSubtitle!.innerText = i18nPress;
                } else {
                    btnTitle!.innerText = i18nStart;
                    btnSubtitle!.innerText = i18nTry;
                }
                startScreen!.style.opacity = '1';
                startScreen!.style.pointerEvents = 'auto';
            } else {
                startScreen!.style.opacity = '0';
                startScreen!.style.pointerEvents = 'none';
            }
        }

        function activateGame() {
            if (!hasStarted) {
                hasStarted = true;
                localStorage.setItem('pongHasStarted', 'true');
                sessionStorage.setItem('pongHasStarted', 'true');
                document.dispatchEvent(new CustomEvent('pong-level-update', { detail: { level: currentLevel } }));
                toggleUI(false);
                triggerReset(0, 0, false);
            } else if (isPaused) {
                isPaused = false;
                toggleUI(false);
            }
            canvas.focus();
        }

        function pauseGame() {
            if (hasStarted && !isPaused) {
                isPaused = true;
                toggleUI(true, true);
            }
        }

        window.addEventListener('keydown', (e) => {
            keys[e.code] = true;
            if (['KeyW', 'KeyS'].includes(e.code) && (!hasStarted || isPaused)) activateGame();
        }, { signal });

        window.addEventListener('keyup', (e) => { keys[e.code] = false; }, { signal });
        window.addEventListener('resize', () => { resizeCanvas(); pauseGame(); }, { signal });
        window.addEventListener('blur', pauseGame, { signal });

        document.addEventListener('click', (e) => {
            if (!container.contains(e.target as Node)) pauseGame();
        }, { signal });

        let isTouching = false;

        // ===== 修复：touch 坐标转换为 CSS 像素 =====
        function handleTouch(e: TouchEvent) {
            if (hasStarted && !isPaused && e.cancelable) {
                e.preventDefault();
            }
            if (e.touches.length > 0) {
                const touch = e.touches[0];
                const rect = canvas.getBoundingClientRect();
                const touchY = touch.clientY - rect.top;
                user.y = touchY - user.height / 2;
                if (user.y < 0) user.y = 0;
                if (user.y + user.height > gameHeight) user.y = gameHeight - user.height;
            }
        }

        container.addEventListener('touchstart', (e) => {
            if (!hasStarted || isPaused) {
                activateGame();
                if (e.cancelable) e.preventDefault();
            }
            isTouching = true;
            handleTouch(e as TouchEvent);
        }, { signal, passive: false });

        container.addEventListener('touchmove', (e) => {
            if (isTouching) handleTouch(e as TouchEvent);
        }, { signal, passive: false });

        container.addEventListener('touchend', () => { isTouching = false; }, { signal });
        container.addEventListener('touchcancel', () => { isTouching = false; }, { signal });

        function resizeCanvas() {
            const dpr = window.devicePixelRatio || 1;
            gameWidth = container!.clientWidth;
            gameHeight = container!.clientHeight;
            canvas.width = gameWidth * dpr;
            canvas.height = gameHeight * dpr;
            ctx!.scale(dpr, dpr);
            com.x = gameWidth - paddleWidth - 20;
            user.x = 20;
            if (user.y === 0) user.y = gameHeight / 2 - paddleHeight / 2;
            if (com.y === 0) com.y = gameHeight / 2 - paddleHeight / 2;
        }
        resizeCanvas();

        // ===== 修复：拖拽手柄用 CSS 像素 =====
        const dragHandle = document.getElementById('drag-handle');
        let isResizingContainer = false;
        let startY = 0;
        let startHeight = 0;

        if (dragHandle) {
            const startDrag = (e: MouseEvent | TouchEvent) => {
                e.stopPropagation();
                if (e.cancelable) e.preventDefault();

                isResizingContainer = true;
                startY = e.type.includes('mouse') ? (e as MouseEvent).clientY : (e as TouchEvent).touches[0].clientY;
                startHeight = container.clientHeight; // 使用 clientHeight（CSS 像素）而非 getBoundingClientRect
                document.body.style.cursor = 'ns-resize';
            };

            const doDrag = (e: MouseEvent | TouchEvent) => {
                if (!isResizingContainer) return;
                const currentY = e.type.includes('mouse') ? (e as MouseEvent).clientY : (e as TouchEvent).touches[0].clientY;
                const dy = currentY - startY;
                let newHeight = startHeight + dy;

                const minHeight = 260;
                if (newHeight < minHeight) newHeight = minHeight;
                const maxHeight = window.innerHeight * 0.8;
                if (newHeight > maxHeight) newHeight = maxHeight;

                container.style.height = `${newHeight}px`;
                resizeCanvas();
            };

            const stopDrag = () => {
                if (isResizingContainer) {
                    isResizingContainer = false;
                    document.body.style.cursor = '';
                }
            };

            dragHandle.addEventListener('mousedown', startDrag as EventListener, { signal });
            dragHandle.addEventListener('touchstart', startDrag as EventListener, { signal, passive: false });

            window.addEventListener('mousemove', doDrag as EventListener, { signal });
            window.addEventListener('touchmove', doDrag as EventListener, { signal, passive: false });
            window.addEventListener('mouseup', stopDrag, { signal });
            window.addEventListener('touchend', stopDrag, { signal });
        }

        function collision(b: Ball, p: Paddle) {
            return b.x + b.radius > p.x && b.x - b.radius < p.x + p.width && b.y + b.radius > p.y && b.y - b.radius < p.y + p.height;
        }

        // 预测球到达 targetX 时的 y（按上下墙反弹折叠，不算旋转）
        function predictY(b: Ball, targetX: number) {
            if (b.velocityX <= 0) return gameHeight / 2;
            const t = (targetX - b.x) / b.velocityX;
            const lo = b.radius, span = gameHeight - 2 * b.radius;
            if (span <= 0) return gameHeight / 2;
            let m = (b.y + b.velocityY * t - lo) % (2 * span);
            if (m < 0) m += 2 * span;
            return lo + (m > span ? 2 * span - m : m);
        }

        function setSpeed(b: Ball, speed: number) {
            const v = Math.hypot(b.velocityX, b.velocityY);
            if (v > 0) {
                b.velocityX = (b.velocityX / v) * speed;
                b.velocityY = (b.velocityY / v) * speed;
            }
        }

        function updatePaddle(p: Paddle) {
            if (p.sizeTimer > 0 && --p.sizeTimer === 0) p.targetHeight = paddleHeight;
            const dh = p.targetHeight - p.height;
            if (Math.abs(dh) > 0.1) {
                const center = p.y + p.height / 2;
                p.height += dh * 0.15;
                p.y = center - p.height / 2;
            }
            p.y = clamp(p.y, 0, gameHeight - p.height);
            p.vy = p.y - p.prevY;
            p.prevY = p.y;
            p.flash *= 0.88;
            p.squash *= 0.8;
        }

        function hitPaddle(b: Ball, p: Paddle, dir: number) {
            const rel = clamp((b.y - (p.y + p.height / 2)) / (p.height / 2 + b.radius), -1, 1);
            const angle = rel * Math.PI * 0.3;
            const isUser = p === user;
            // 挥拍击球：接球瞬间拍子在快速移动，球猛地加速
            const smash = isUser && Math.abs(p.vy) > basePaddleSpeed * (gameHeight / 250) * 0.7;

            let speed = Math.max(b.speed, cruiseSpeed()) + 0.35;
            if (smash) speed += 1.8;
            b.speed = Math.min(speed, maxSpeed() + (smash ? 2 : 0));
            b.velocityX = dir * b.speed * Math.cos(angle);
            b.velocityY = b.speed * Math.sin(angle);
            // 拍子移动方向带给球旋转，飞行中会拐弯
            b.spin = clamp(p.vy * 0.018, -0.22, 0.22);
            b.x = dir > 0 ? p.x + p.width + b.radius : p.x - b.radius;
            b.lastHit = p;

            p.flash = 1;
            p.squash = 1;
            rally++;
            rallyBump = 1;
            if (rally > bestRally) {
                bestRally = rally;
                localStorage.setItem('pongBestRally', String(bestRally));
            }

            for (let i = 0; i < 10; i++) {
                particles.push({
                    x: b.x, y: b.y,
                    vx: dir * (2 + Math.random() * 6), vy: (Math.random() - 0.5) * 7,
                    life: 0.8, decay: 0.035, color: currentTheme.dark, size: 1.5 + Math.random() * 2
                });
            }
            addRing(b.x, b.y, smash ? 64 : 34, smash ? 4 : 2.5);
            addShake(smash ? 7 : 2 + b.speed * 0.12);

            if (smash) {
                addPopup(b.x + dir * 40, b.y - 20, 'SMASH!', 18);
                screenFlash = Math.max(screenFlash, 0.25);
            } else if (Math.abs(b.spin) > 0.12) {
                addPopup(b.x + dir * 40, b.y - 20, 'SPIN!', 14);
            }
            if (rally >= 5 && rally % 5 === 0) {
                addPopup(gameWidth / 2, gameHeight * 0.22, `×${rally} COMBO`, 22);
            }

            if (isUser) {
                // AI 失误量随关卡减小
                const err = Math.max(0.2, 1.0 - 0.1 * (currentLevel - 1)) * com.height;
                aiOffset = (Math.random() - 0.5) * err;
                aiAimed = false;
            }
        }

        function wallHit(b: Ball) {
            b.spin = -b.spin * 0.6;
            addRing(b.x, b.y, 18, 2);
            for (let i = 0; i < 4; i++) {
                particles.push({
                    x: b.x, y: b.y, vx: (Math.random() - 0.5) * 4, vy: (b.y < gameHeight / 2 ? 1 : -1) * Math.random() * 3,
                    life: 0.5, decay: 0.04, color: currentTheme.dark, size: 1.5
                });
            }
            addShake(1.2);
        }

        function spawnPowerUp() {
            const kinds: PowerUp['kind'][] = balls.length < 3 ? ['grow', 'shrink', 'multi'] : ['grow', 'shrink'];
            powerUp = {
                x: gameWidth * (0.36 + Math.random() * 0.28),
                y: gameHeight * (0.2 + Math.random() * 0.6),
                kind: kinds[Math.floor(Math.random() * kinds.length)],
                life: 600, t: 0
            };
            addRing(powerUp.x, powerUp.y, 30, 2);
        }

        function applyPowerUp(b: Ball, pu: PowerUp) {
            const owner = b.lastHit ?? (b.velocityX > 0 ? user : com);
            const other = owner === user ? com : user;
            if (pu.kind === 'grow') {
                owner.targetHeight = paddleHeight * 1.6;
                owner.sizeTimer = 540;
                addPopup(owner.x, owner.y + owner.height / 2, 'BIG!', 16);
            } else if (pu.kind === 'shrink') {
                other.targetHeight = paddleHeight * 0.6;
                other.sizeTimer = 540;
                addPopup(other.x, other.y + other.height / 2, 'SMALL!', 16);
            } else {
                const nb = makeBall(b.x, b.y);
                nb.speed = b.speed;
                nb.velocityX = b.velocityX;
                nb.velocityY = Math.abs(b.velocityY) > 1 ? -b.velocityY : b.speed * 0.45;
                setSpeed(nb, nb.speed);
                nb.lastHit = b.lastHit;
                balls.push(nb);
                addPopup(pu.x, pu.y - 24, 'MULTI!', 18);
            }
            createParticles(pu.x, pu.y, currentTheme.dark, 20, 10);
            addRing(pu.x, pu.y, 70, 3);
            addShake(5);
            powerUp = null;
            powerUpTimer = 420 + Math.random() * 300;
        }

        function update() {
            if (isPaused || !hasStarted) return;
            updateEffects();

            const currentPaddleSpeed = basePaddleSpeed * (gameHeight / 250);

            if (keys['KeyW']) user.y -= currentPaddleSpeed;
            if (keys['KeyS']) user.y += currentPaddleSpeed;
            updatePaddle(user);

            if (isTransitioning) {
                transitionRadius += maxTransitionRadius / 45;
                if (transitionRadius >= maxTransitionRadius) {
                    isTransitioning = false;
                    container!.style.setProperty('--theme-light', currentTheme.light);
                    container!.style.setProperty('--theme-dark', currentTheme.dark);
                    container!.style.backgroundColor = currentTheme.light;
                    broadcastTheme(currentTheme);
                    triggerReset(gameWidth / 2, gameHeight / 2, false);
                }
                updatePaddle(com);
                return;
            }

            if (isResetting) {
                const ball = balls[0];
                resetTimer--;
                if (resetTimer > 25) {
                    ball.currentRadius = 0;
                } else if (resetTimer > 0) {
                    let progress = 1 - (resetTimer / 25);
                    ball.currentRadius = ball.radius * Math.max(0, easeOutBack(progress));
                } else {
                    isResetting = false;
                    ball.currentRadius = ball.radius;
                    ball.speed = START_SPEED;
                    let angle = (Math.random() * Math.PI / 4) - (Math.PI / 8);
                    ball.velocityX = (Math.random() > 0.5 ? 1 : -1) * ball.speed * Math.cos(angle);
                    ball.velocityY = (Math.random() > 0.5 ? 1 : -1) * ball.speed * Math.sin(angle);
                    addRing(ball.x, ball.y, 40, 2);
                }
                com.y += (gameHeight / 2 - com.height / 2 - com.y) * 0.05;
                updatePaddle(com);
                return;
            }

            // ===== AI：追最先到达的球，按关卡提高预判和移速，会故意往玩家反方向打 =====
            let target: Ball | null = null;
            for (const b of balls) {
                if (b.velocityX > 0 && (!target || (com.x - b.x) / b.velocityX < (com.x - target.x) / target.velocityX)) target = b;
            }
            let targetY: number;
            if (target) {
                const foresight = Math.min(1, 0.4 + 0.12 * (currentLevel - 1));
                const pred = predictY(target, com.x - target.radius);
                if (!aiAimed && currentLevel >= 3 && target.x > gameWidth * 0.6) {
                    aiAimed = true;
                    const userTop = user.y + user.height / 2 < gameHeight / 2;
                    aiOffset += (userTop ? 1 : -1) * com.height * 0.25 * Math.min(1, (currentLevel - 2) * 0.3);
                }
                targetY = target.y + (pred - target.y) * foresight - aiOffset;
            } else {
                targetY = gameHeight / 2 + (balls[0].y - gameHeight / 2) * 0.3;
            }
            const aiMax = Math.min(4.2 + 0.5 * (currentLevel - 1), 9) * (gameHeight / 250);
            com.y += clamp((targetY - (com.y + com.height / 2)) * 0.2, -aiMax, aiMax);
            updatePaddle(com);

            // ===== 道具 =====
            if (powerUp) {
                powerUp.t++;
                if (--powerUp.life <= 0) {
                    powerUp = null;
                    powerUpTimer = 300 + Math.random() * 240;
                }
            } else if (--powerUpTimer <= 0) {
                spawnPowerUp();
            }

            // ===== 球 =====
            const cruise = cruiseSpeed();
            for (let i = balls.length - 1; i >= 0; i--) {
                const b = balls[i];

                if (b.speed < cruise) {
                    b.speed += 0.05;
                    setSpeed(b, b.speed);
                }

                if (b.spin !== 0) {
                    b.velocityY += b.spin;
                    b.spin *= 0.985;
                    if (Math.abs(b.spin) < 0.005) b.spin = 0;
                    setSpeed(b, b.speed);
                    // 别让旋转把球拐成竖直方向
                    const minVX = b.speed * 0.55;
                    if (Math.abs(b.velocityX) < minVX) {
                        b.velocityX = Math.sign(b.velocityX || 1) * minVX;
                        b.velocityY = Math.sign(b.velocityY || 1) * Math.sqrt(b.speed ** 2 - minVX ** 2);
                    }
                }
                b.rot += b.velocityX * 0.03 + b.spin * 3;

                b.trail.push({ x: b.x, y: b.y });
                if (b.trail.length > 14) b.trail.shift();

                // 分步移动，高速时不会穿过拍子
                const steps = Math.max(1, Math.ceil(b.speed / 5));
                for (let s = 0; s < steps; s++) {
                    b.x += b.velocityX / steps;
                    b.y += b.velocityY / steps;
                    if (b.y - b.radius < 0) { b.y = b.radius; b.velocityY = Math.abs(b.velocityY); wallHit(b); }
                    else if (b.y + b.radius > gameHeight) { b.y = gameHeight - b.radius; b.velocityY = -Math.abs(b.velocityY); wallHit(b); }
                    if (b.velocityX < 0 && collision(b, user)) hitPaddle(b, user, 1);
                    else if (b.velocityX > 0 && collision(b, com)) hitPaddle(b, com, -1);
                }

                if (powerUp && Math.hypot(b.x - powerUp.x, b.y - powerUp.y) < 16 + b.radius) {
                    applyPowerUp(b, powerUp);
                }

                if (b.x > gameWidth) {
                    levelUp(gameWidth, b.y);
                    return;
                } else if (b.x < 0) {
                    balls.splice(i, 1);
                    if (balls.length === 0) {
                        triggerReset(0, b.y, true);
                        return;
                    }
                    createParticles(0, b.y, currentTheme.dark, 15, 10);
                    addRing(0, b.y, 50, 3);
                    addShake(4);
                }
            }
        }

        function drawPaddle(p: Paddle, theme: any) {
            const w = p.width * (1 + p.squash * 0.5);
            const h = p.height * (1 - p.squash * 0.08);
            const x = p.x + p.width / 2 - w / 2;
            const y = p.y + p.height / 2 - h / 2;
            ctx!.fillStyle = theme.dark;
            ctx!.fillRect(x, y, w, h);
            if (p.flash > 0.05) {
                ctx!.globalAlpha = p.flash * 0.8;
                ctx!.fillStyle = theme.light;
                ctx!.fillRect(x + 2, y + 2, w - 4, h - 4);
                ctx!.globalAlpha = 1;
            }
            // 道具快到期时闪烁提示
            if (p.sizeTimer > 0 && p.sizeTimer < 120 && Math.floor(p.sizeTimer / 8) % 2 === 0) {
                ctx!.globalAlpha = 0.5;
                ctx!.fillStyle = theme.light;
                ctx!.fillRect(x + 3, y + 3, w - 6, h - 6);
                ctx!.globalAlpha = 1;
            }
        }

        function drawBall(b: Ball, theme: any) {
            if (b.currentRadius <= 0) return;
            const r = b.currentRadius;

            ctx!.fillStyle = theme.dark;
            for (let i = 0; i < b.trail.length; i++) {
                const k = (i + 1) / b.trail.length;
                ctx!.globalAlpha = k * 0.28;
                ctx!.beginPath();
                ctx!.arc(b.trail[i].x, b.trail[i].y, r * (0.3 + 0.7 * k), 0, Math.PI * 2);
                ctx!.fill();
            }
            ctx!.globalAlpha = 1;

            const sp = Math.hypot(b.velocityX, b.velocityY);
            const stretch = 1 + Math.min(sp / 45, 0.3);
            ctx!.save();
            ctx!.translate(b.x, b.y);
            ctx!.rotate(Math.atan2(b.velocityY, b.velocityX));
            if (sp > 11) {
                ctx!.shadowColor = theme.dark;
                ctx!.shadowBlur = Math.min((sp - 11) * 3, 18);
            }
            ctx!.beginPath();
            ctx!.ellipse(0, 0, r * stretch, r / stretch, 0, 0, Math.PI * 2);
            ctx!.fill();
            ctx!.restore();

            if (b.spin !== 0) {
                ctx!.fillStyle = theme.light;
                ctx!.globalAlpha = 0.85;
                ctx!.beginPath();
                ctx!.arc(b.x + Math.cos(b.rot) * r * 0.45, b.y + Math.sin(b.rot) * r * 0.45, r * 0.28, 0, Math.PI * 2);
                ctx!.fill();
                ctx!.globalAlpha = 1;
            }
        }

        function drawPowerUp(pu: PowerUp, theme: any) {
            if (pu.life < 90 && Math.floor(pu.life / 6) % 2 === 0) return;
            const grow = Math.min(1, pu.t / 15);
            const pulse = 1 + Math.sin(pu.t * 0.12) * 0.08;
            const r = 14 * grow * pulse;

            ctx!.strokeStyle = theme.dark;
            ctx!.lineWidth = 2;
            ctx!.setLineDash([5, 5]);
            ctx!.lineDashOffset = -pu.t * 0.5;
            ctx!.beginPath();
            ctx!.arc(pu.x, pu.y, r + 7, 0, Math.PI * 2);
            ctx!.stroke();
            ctx!.setLineDash([]);

            ctx!.fillStyle = theme.dark;
            ctx!.beginPath();
            ctx!.arc(pu.x, pu.y, r, 0, Math.PI * 2);
            ctx!.fill();

            ctx!.fillStyle = theme.light;
            ctx!.font = `bold ${Math.round(15 * grow)}px sans-serif`;
            ctx!.textAlign = "center";
            ctx!.textBaseline = "middle";
            ctx!.fillText(pu.kind === 'grow' ? '+' : pu.kind === 'shrink' ? '−' : '×2', pu.x, pu.y + 1);
        }

        function drawGameScene(theme: any, levelNum: number) {
            ctx!.fillStyle = theme.light;
            ctx!.fillRect(-20, -20, gameWidth + 40, gameHeight + 40);

            ctx!.fillStyle = theme.dark;
            ctx!.globalAlpha = 0.1;
            for (let i = 0; i <= gameHeight; i += 20) {
                ctx!.fillRect(gameWidth / 2 - 1, i, 2, 10);
            }

            ctx!.globalAlpha = 0.15;
            ctx!.font = "bold 80px sans-serif";
            ctx!.textAlign = "center";
            ctx!.textBaseline = "middle";
            ctx!.fillText(i18nLevel + levelNum, gameWidth / 2, gameHeight / 2);

            if (rally >= 2) {
                ctx!.globalAlpha = 0.22 + rallyBump * 0.4;
                ctx!.font = `bold ${Math.round(24 + rallyBump * 12)}px sans-serif`;
                ctx!.fillText(`×${rally}`, gameWidth / 2, gameHeight / 2 + 58);
            }
            if (bestRally > 0) {
                ctx!.globalAlpha = 0.25;
                ctx!.font = "bold 12px sans-serif";
                ctx!.fillText(`BEST ×${bestRally}`, gameWidth / 2, 16);
            }

            particles.forEach(p => {
                ctx!.globalAlpha = Math.max(0, p.life);
                ctx!.fillStyle = p.color;
                ctx!.beginPath();
                ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx!.fill();
            });

            ctx!.strokeStyle = theme.dark;
            rings.forEach(r => {
                ctx!.globalAlpha = Math.max(0, r.life) * 0.7;
                ctx!.lineWidth = Math.max(0.5, r.width * r.life);
                ctx!.beginPath();
                ctx!.arc(r.x, r.y, r.r, 0, Math.PI * 2);
                ctx!.stroke();
            });
            ctx!.globalAlpha = 1.0;

            if (powerUp) drawPowerUp(powerUp, theme);

            drawPaddle(user, theme);
            drawPaddle(com, theme);

            balls.forEach(b => drawBall(b, theme));

            ctx!.textAlign = "center";
            ctx!.textBaseline = "middle";
            popups.forEach(p => {
                const pop = p.life > 0.85 ? 1 + (p.life - 0.85) * 3 : 1;
                ctx!.globalAlpha = Math.min(1, p.life * 1.6);
                ctx!.font = `900 ${Math.round(p.size * pop)}px sans-serif`;
                ctx!.lineWidth = 4;
                ctx!.strokeStyle = theme.light;
                ctx!.strokeText(p.text, p.x, p.y);
                ctx!.fillStyle = theme.dark;
                ctx!.fillText(p.text, p.x, p.y);
            });
            ctx!.globalAlpha = 1.0;
        }

        function render() {
            if (!hasStarted) return;

            ctx!.save();
            ctx!.translate(shakeX, shakeY);
            if (isTransitioning) {
                drawGameScene(oldTheme, currentLevel - 1);
                ctx!.save();
                ctx!.beginPath();
                ctx!.arc(gameWidth / 2, gameHeight / 2, transitionRadius, 0, Math.PI * 2);
                ctx!.clip();
                drawGameScene(currentTheme, currentLevel);
                ctx!.restore();
            } else {
                drawGameScene(currentTheme, currentLevel);
            }
            ctx!.restore();

            if (screenFlash > 0.02) {
                ctx!.globalAlpha = screenFlash * 0.5;
                ctx!.fillStyle = '#fff';
                ctx!.fillRect(0, 0, gameWidth, gameHeight);
                ctx!.globalAlpha = 1;
            }
        }

        // 固定 60Hz 逻辑步长，高刷屏上球不会变快
        const STEP = 1000 / 60;
        let lastTime = performance.now();
        let accumulator = 0;
        let animationFrameId: number;
        function gameLoop(now: number) {
            accumulator += Math.min(now - lastTime, 100);
            lastTime = now;
            let n = 0;
            while (accumulator >= STEP - 1 && n < 5) {
                update();
                accumulator -= STEP;
                n++;
            }
            if (n === 5) accumulator = 0;
            render();
            animationFrameId = requestAnimationFrame(gameLoop);
        }
        animationFrameId = requestAnimationFrame(gameLoop);

        document.addEventListener('astro:before-swap', () => {
            cancelAnimationFrame(animationFrameId);
            clearInterval(kaomojiTimer);
            controller.abort();
        }, { once: true });
    });
</script>