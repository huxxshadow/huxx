---
// src/components/index/PortfolioPosters.astro
// 首页的作品集区：一排海报。每张海报一个项目——主题色单色的角色立绘、大号作品名、副标题 Portfolio，点进对应项目页。
// 版式参考《分形收容所》的角色海报：米色底，角色靠右上，标题压在左下
import { useTranslations, type Lang } from "@/i18n.ts";
import { COLORS } from "@/consts.ts";
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { ImageMetadata } from "astro";
import clickHand from "@/assets/projects/game-project-click-click-universe/props/icon-click.png";
import witch from "@/assets/projects/game-project-empty-throne/deco/witch.png";
import eelHero from "@/assets/stickers/eel-on-mask-hero.webp";
import fractalGirl from "@/assets/projects/game-project-fractal-shelter/fractal-shelter_Character.webp";
import nightWatchCard from "@/assets/projects/game-project-night-watch/cards/enemy-1.webp";

const locale = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(locale);

// levels：灰度的黑点 / 白点（0~1），原图偏浅或偏平时拉开对比，默认不调
type Poster = { id: string; art: ImageMetadata; color: { light: string; dark: string }; pixel?: boolean; artHeight?: number; levels?: [number, number] };
const POSTERS: Poster[] = [
    { id: "game-project-click-click-universe", art: clickHand, color: COLORS.yellow, artHeight: 50, levels: [0.74, 0.9] },
    { id: "game-project-empty-throne", art: witch, color: COLORS.blue, pixel: true },
    { id: "game-project-eel-on-mask", art: eelHero, color: COLORS.green },
    { id: "game-project-fractal-shelter", art: fractalGirl, color: COLORS.red },
    { id: "game-project-night-watch", art: nightWatchCard, color: COLORS.orange, artHeight: 52, levels: [0.1, 0.85] },
];

const posters = await Promise.all(POSTERS.map(async (p, i) => {
    const entry = await getEntry("projects", p.id);
    return {
        ...p,
        filter: `poster-duo-${i}`,
        title: entry ? t(entry.data.title) : p.id,
        href: getRelativeLocaleUrl(locale, `projects/${p.id}`),
    };
}));

// 双色调：先按亮度灰度化，再把暗部映射成主题深色、亮部映射成海报底色（和参考图一样，白色的地方「透」成纸色）
const PAPER = "#F7EDDF";
const hex = (c: string) => [1, 3, 5].map((k) => parseInt(c.slice(k, k + 2), 16) / 255);
const paper = hex(PAPER);
const levels = (p: Poster) => {
    const [lo, hi] = p.levels ?? [0, 1];
    return { slope: (1 / (hi - lo)).toFixed(3), intercept: (-lo / (hi - lo)).toFixed(3) };
};
const table = (dark: string, ch: number) => `${hex(dark)[ch].toFixed(3)} ${paper[ch].toFixed(3)}`;

const bg = "#EFEDEA";
const ink = COLORS.black;
---

<section
        id="portfolio-posters"
        class="relative w-full overflow-hidden py-14 lg:py-20"
        data-theme-bg={bg}
        data-theme-text={ink}
        style={`background-color: ${bg}; color: ${ink}; --theme-bg: ${bg}; --theme-text: ${ink}; --paper: ${PAPER};`}
>
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
        {posters.map((p) => (
            <filter id={p.filter} color-interpolation-filters="sRGB">
                <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
                <feComponentTransfer>
                    <feFuncR type="linear" slope={levels(p).slope} intercept={levels(p).intercept} />
                    <feFuncG type="linear" slope={levels(p).slope} intercept={levels(p).intercept} />
                    <feFuncB type="linear" slope={levels(p).slope} intercept={levels(p).intercept} />
                </feComponentTransfer>
                <feComponentTransfer>
                    <feFuncR type="table" tableValues={table(p.color.dark, 0)} />
                    <feFuncG type="table" tableValues={table(p.color.dark, 1)} />
                    <feFuncB type="table" tableValues={table(p.color.dark, 2)} />
                </feComponentTransfer>
            </filter>
        ))}
    </svg>

    <ul class="poster-row" data-reveal-children="up" data-reveal-stagger="70">
        {posters.map((p) => (
            <li>
                <a href={p.href} class="poster" style={`--c: ${p.color.dark};`}>
                    <img
                            src={p.art.src}
                            width={p.art.width}
                            height={p.art.height}
                            alt=""
                            loading="lazy"
                            draggable="false"
                            class:list={["poster-art", p.pixel && "pixelated"]}
                            style={`filter: url(#${p.filter}); --art-h: ${p.artHeight ?? 64}%;`}
                    />
                    <div class="poster-text">
                        <h3 class="poster-title">{p.title}</h3>
                        <p class="poster-sub">Portfolio</p>
                    </div>
                    <p class="poster-foot">JEFFERY HU</p>
                </a>
            </li>
        ))}
    </ul>
</section>

<style>
    .poster-row {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: clamp(0.5rem, 1vw, 1rem);
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 clamp(1rem, 3vw, 2.5rem);
        list-style: none;
    }

    .poster {
        position: relative;
        display: block;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: var(--paper);
        color: var(--c);
        container-type: inline-size;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
        transition: translate 220ms ease-out, box-shadow 220ms ease-out;
    }
    .poster:hover,
    .poster:focus-visible {
        translate: 0 -6px;
        box-shadow: 0 14px 28px rgb(0 0 0 / 0.12);
    }

    /* 角色靠右上，底部被标题压住一截 */
    .poster-art {
        position: absolute;
        right: 4%;
        top: 9%;
        height: var(--art-h);
        width: auto;
        max-width: 88%;
        object-fit: contain;
        object-position: right top;
        pointer-events: none;
        transition: scale 300ms ease-out;
        transform-origin: 70% 30%;
    }
    .poster:hover .poster-art { scale: 1.03; }
    .poster-art.pixelated { image-rendering: pixelated; }

    .poster-text {
        position: absolute;
        left: 6%;
        right: 6%;
        bottom: 11%;
    }
    .poster-title {
        font-weight: 900;
        line-height: 0.92;
        letter-spacing: -0.02em;
        font-size: 17cqw;
        text-wrap: balance;
    }
    html[lang="en"] .poster-title,
    html[lang="ko"] .poster-title {
        font-size: 13.5cqw;
    }
    .poster-sub {
        margin-top: 0.35em;
        font-weight: 800;
        font-size: 7.5cqw;
        line-height: 1;
        font-family: 'Roboto', sans-serif;
    }
    .poster-foot {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 4%;
        text-align: center;
        font-family: 'Roboto', sans-serif;
        font-weight: 700;
        font-size: 3cqw;
        letter-spacing: 0.12em;
    }

    /* 平板：三列；手机：横向滑动，一次看到一张半 */
    @media (max-width: 1023px) {
        .poster-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 639px) {
        .poster-row {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            padding-bottom: 0.5rem;
        }
        .poster-row::-webkit-scrollbar { display: none; }
        .poster-row > li {
            flex: 0 0 64vw;
            scroll-snap-align: center;
        }
    }
</style>
