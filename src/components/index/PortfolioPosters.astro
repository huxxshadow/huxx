---
// src/components/index/PortfolioPosters.astro
// 首页的作品集区：一排项目海报，从屏幕最左边开始无缝排开。每张占屏宽的 1/5、2:3 竖版（高度固定为屏宽的 3/10），
// 始终只排一行，放不下时横向滑动；不足一屏时右边空着。
// 每张海报一个项目——主题色单色的角色立绘、大号作品名、副标题 Portfolio，点进对应项目页。
// 版式参考《分形收容所》的角色海报：米色纸底（站内存的 khakiMilan），角色靠右上，标题压在左下
import { useTranslations, type Lang } from "@/i18n.ts";
import { COLORS } from "@/consts.ts";
import { getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { ImageMetadata } from "astro";
// 分形收容所的人物是矢量图（从位图描出来的单色路径，fill 用 currentColor），直接按海报主题色上色，不走双色调滤镜
import FractalGirl from "@/assets/projects/game-project-fractal-shelter/fractal-shelter_Character.svg";
import witch from "@/assets/projects/game-project-empty-throne/deco/witch.png";

const locale = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(locale);

// levels：灰度的黑点 / 白点（0~1），原图偏浅或偏平时拉开对比，默认不调
// art 是位图（走双色调滤镜）或 SVG 组件（单色路径，直接用主题色）
type SvgArt = ((props: Record<string, unknown>) => unknown) & { width: number; height: number };
type Poster = { id: string; art: ImageMetadata | SvgArt; color: { light: string; dark: string }; pixel?: boolean; levels?: [number, number] };
const isSvg = (art: Poster["art"]): art is SvgArt => typeof art === "function";
const POSTERS: Poster[] = [
    { id: "game-project-fractal-shelter", art: FractalGirl as unknown as SvgArt, color: COLORS.red },
    { id: "game-project-empty-throne", art: witch, color: COLORS.blue, pixel: true },
];

// 主标题统一是「作品集」，副标题是作品名。两行都只排一行：按字数估算宽度（中日韩字约 1em、拉丁字母约 0.56em），
// 放不下 86% 版宽时缩小字号，max 是不超过的字号（cqw）
const fitSize = (text: string, max: number) => {
    const em = Array.from(text).reduce((w, ch) => w + (/[⺀-￯]/.test(ch) ? 1 : ch === " " ? 0.28 : 0.56), 0);
    return Math.min(max, 86 / Math.max(em, 1)).toFixed(2);
};
const heading = t({ en: "Portfolio", zh: "作品集", ja: "作品集", ko: "포트폴리오" });
const headingSize = fitSize(heading, 17);

// 人物图按比例塞进右上角 86×92cqw 的框里（底边离标题约 8cqw），算出实际显示宽高，按实际大小摆放
const ART_W = 86, ART_H = 92;
const artBox = (img: { width: number; height: number }) => {
    const ratio = img.width / img.height;
    return ratio > ART_W / ART_H
        ? { artW: ART_W, artH: +(ART_W / ratio).toFixed(2) }
        : { artW: +(ART_H * ratio).toFixed(2), artH: ART_H };
};

const posters = await Promise.all(POSTERS.map(async (p, i) => {
    const entry = await getEntry("projects", p.id);
    return {
        ...p,
        filter: `poster-duo-${i}`,
        title: entry ? t(entry.data.title) : p.id,
        titleSize: fitSize(entry ? t(entry.data.title) : p.id, 8.5),
        href: getRelativeLocaleUrl(locale, `projects/${p.id}`),
        ...artBox(p.art),
    };
}));

// 双色调：先按亮度灰度化，再把暗部映射成主题深色、亮部映射成海报底色（和参考图一样，白色的地方「透」成纸色）
const PAPER = COLORS.khakiMilan;
const hex = (c: string) => [1, 3, 5].map((k) => parseInt(c.slice(k, k + 2), 16) / 255);
const paper = hex(PAPER);
const levels = (p: Poster) => {
    const [lo, hi] = p.levels ?? [0, 1];
    return { slope: (1 / (hi - lo)).toFixed(3), intercept: (-lo / (hi - lo)).toFixed(3) };
};
const table = (dark: string, ch: number) => `${hex(dark)[ch].toFixed(3)} ${paper[ch].toFixed(3)}`;

const bg = PAPER;
const ink = COLORS.black;
---

<section
        id="portfolio-posters"
        class="relative w-full overflow-hidden"
        data-theme-bg={bg}
        data-theme-text={ink}
        style={`background-color: ${bg}; color: ${ink}; --theme-bg: ${bg}; --theme-text: ${ink}; --paper: ${PAPER};`}
>
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
        {posters.map((p) => (
            <filter id={p.filter} color-interpolation-filters="sRGB">
                <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
                <feComponentTransfer>
                    <feFuncR type="linear" slope={levels(p).slope} intercept={levels(p).intercept} />
                    <feFuncG type="linear" slope={levels(p).slope} intercept={levels(p).intercept} />
                    <feFuncB type="linear" slope={levels(p).slope} intercept={levels(p).intercept} />
                </feComponentTransfer>
                <feComponentTransfer>
                    <feFuncR type="table" tableValues={table(p.color.dark, 0)} />
                    <feFuncG type="table" tableValues={table(p.color.dark, 1)} />
                    <feFuncB type="table" tableValues={table(p.color.dark, 2)} />
                </feComponentTransfer>
            </filter>
        ))}
    </svg>

    <ul class="poster-row">
        {posters.map((p) => (
            <li style={`--c: ${p.color.dark};`}>
                <a href={p.href} class="poster">
                    <span class="poster-halo" aria-hidden="true"></span>
                    <div class="poster-figure" style={`width: ${p.artW}cqw; height: ${p.artH}cqw;`}>
                        {isSvg(p.art) ? (
                            <p.art class="poster-art" aria-hidden="true" preserveAspectRatio="xMidYMid meet" />
                        ) : (
                        <img
                                src={p.art.src}
                                width={p.art.width}
                                height={p.art.height}
                                alt=""
                                loading="lazy"
                                draggable="false"
                                class:list={["poster-art", p.pixel && "pixelated"]}
                                style={`filter: url(#${p.filter});`}
                        />
                        )}
                    </div>
                    <div class="poster-text">
                        <p class="poster-title" style={`--title-size: ${headingSize}cqw;`}>{heading}</p>
                        <h3 class="poster-sub" style={`--sub-size: ${p.titleSize}cqw;`}>{p.title}</h3>
                    </div>
                    <p class="poster-foot">huxx</p>
                </a>
            </li>
        ))}
    </ul>
</section>

<style>
    /* 一行排开：每张 1/5 屏宽、2:3 竖版，贴着屏幕左边无缝排开，放不下时横向滑动；海报之间不加分隔线 */
    .poster-row {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        list-style: none;
    }
    .poster-row::-webkit-scrollbar { display: none; }
    .poster-row > li {
        flex: 0 0 20%;
        scroll-snap-align: start;
    }

    .poster {
        position: relative;
        display: block;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: var(--paper);
        color: var(--c);
        container-type: size;
    }

    /*
     * 角色永远靠右上，框在标题上方的区域里，不压字：
     * 海报高 150cqw，文字块（标题 + 作品名）从底边往上约 45cqw，所以图框止于顶部往下 96cqw
     */
    /* 人物靠右，右边留出竖线和一点间距 */
    .poster-figure {
        position: absolute;
        right: 6cqw;
        top: 10cqw;
        pointer-events: none;
        transition: scale 400ms ease-out;
        transform-origin: right top;
    }
    .poster:hover .poster-figure { scale: 1.03; }
    .poster-art {
        display: block;
        width: 100%;
        height: 100%;
    }
    /* 海报右侧的圆角竖线，主题色，从上到下贯穿整张海报，上下各留一点间距 */
    .poster-halo {
        position: absolute;
        top: 5cqw;
        bottom: 5cqw;
        right: 2.5cqw;
        width: 1.8cqw;
        border-radius: 999px;
        background: var(--c);
    }
    .poster-art.pixelated { image-rendering: pixelated; }

    .poster-text {
        position: absolute;
        left: 7%;
        right: 7%;
        bottom: 11%;
    }
    .poster-title {
        font-weight: 900;
        line-height: 0.92;
        letter-spacing: -0.02em;
        font-size: var(--title-size, 15cqw);
        white-space: nowrap;
    }
    .poster-sub {
        margin-top: 0.35em;
        font-weight: 800;
        font-size: var(--sub-size, 7cqw);
        line-height: 1;
        white-space: nowrap;
    }
    /* 底边正中的 huxx：小号、中等粗细 */
    .poster-foot {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 2.5%;
        text-align: center;
        font-family: 'Roboto', sans-serif;
        font-weight: 500;
        font-size: max(10px, 3.8cqw);
        letter-spacing: 0.04em;
    }

    /* 平板一屏约 2.5 张、手机一屏约 1.7 张 */
    @media (max-width: 1023px) {
        .poster-row > li { flex-basis: 40%; }
    }
    @media (max-width: 639px) {
        .poster-row > li { flex-basis: 60%; }
    }
</style>
