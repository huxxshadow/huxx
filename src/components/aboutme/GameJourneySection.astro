---
// src/components/aboutme/GameJourneySection.astro
import { COLORS } from "@/consts.ts";
import { getCollection } from "astro:content";
import type { Lang } from "@/i18n.ts";
import { useTranslations } from "@/i18n.ts";
import { Image } from 'astro:assets';
import {
    animeJourneyLabels,
    gameJourneyLabels,
    journeyTitleParts,
    playerProfileData,
    playStyleData,
} from "@/i18n/components/aboutme/GameJourneySection_i18.ts";

const games = await getCollection("games");
const animes = await getCollection("animes");

// 按照 JSON 顺序倒序显示：JSON 最后一个 -> 页面最前面
const byOrderDesc = <T extends { data: { order: number } }>(entries: T[]) =>
    [...entries].sort((a, b) => b.data.order - a.data.order);

const currentLang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(currentLang);

// 游戏 / 动画两条旅程结构完全一致，只是数据和文案不同，
// 下面的模板对它们各渲染一份，由标题里的按钮切换显示。
const journeys = [
    {
        key: "game",
        word: journeyTitleParts.gameWord,
        marquee: gameJourneyLabels.marqueeBanner,
        profileHeader: gameJourneyLabels.playerProfileHeader,
        styleHeader: gameJourneyLabels.playStyleHeader,
        favoritesHeader: gameJourneyLabels.allTimeFavoritesHeader,
        libraryHeader: gameJourneyLabels.gameLibraryHeader,
        favoriteTag: gameJourneyLabels.favoriteTag,
        profile: playerProfileData,
        style: playStyleData,
        items: byOrderDesc(games),
    },
    {
        key: "anime",
        word: journeyTitleParts.animeWord,
        // 动画旅程不要滚动类型条，也不要档案 / 偏好那两块介绍
        marquee: null,
        profileHeader: null,
        styleHeader: null,
        favoritesHeader: animeJourneyLabels.allTimeFavoritesHeader,
        libraryHeader: animeJourneyLabels.animeLibraryHeader,
        favoriteTag: animeJourneyLabels.favoriteTag,
        profile: null,
        style: null,
        items: byOrderDesc(animes),
    },
].map((journey) => ({
    ...journey,
    favorites: journey.items.filter((entry) => entry.data.favorite),
}));

const defaultJourney = "game";
---

<section
        id="game-journey-section"
        class="relative w-full overflow-hidden py-12 lg:py-20"
        style={`
            background-color: ${COLORS.khakiMilan}; 
            color: ${COLORS.black}; 
            --card-size: 180px;
            --fav-card-size: 240px;
            --color-black: ${COLORS.black};
            --color-white: ${COLORS.white};
            --color-orange-dark: ${COLORS.orange.dark};
            --color-yellow-dark: ${COLORS.yellow.dark};
            --color-blue-dark: ${COLORS.blue.dark};
            --color-khaki: ${COLORS.khakiMilan};
        `}
        data-theme-bg={COLORS.khakiMilan}
        data-theme-text={COLORS.black}
>
    <div class="mx-auto px-4 sm:px-6 lg:px-8 ">
        {/* 1. 大标题 (居中、白底黑阴影、带铆钉、圆角、不换行) */}
        <div class="flex justify-center mb-16 relative z-10">
            <div class="relative border-4 px-12 py-6 sm:px-20 sm:py-8 text-center bg-white rounded-xl transition-transform hover:-translate-y-1"
                 style={`border-color: ${COLORS.black}; box-shadow: 10px 10px 0px ${COLORS.black};`}
                 data-reveal="scale"
            >
                {/* 铆钉 */}
                <div class="absolute top-3 left-3 sm:top-4 sm:left-4 w-3 h-3 sm:w-4 sm:h-4 rounded-full border-[3px]" style={`background-color: ${COLORS.black}; border-color: ${COLORS.black};`}></div>
                <div class="absolute top-3 right-3 sm:top-4 sm:right-4 w-3 h-3 sm:w-4 sm:h-4 rounded-full border-[3px]" style={`background-color: ${COLORS.black}; border-color: ${COLORS.black};`}></div>
                <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 w-3 h-3 sm:w-4 sm:h-4 rounded-full border-[3px]" style={`background-color: ${COLORS.black}; border-color: ${COLORS.black};`}></div>
                <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-3 h-3 sm:w-4 sm:h-4 rounded-full border-[3px]" style={`background-color: ${COLORS.black}; border-color: ${COLORS.black};`}></div>

                <h1 class="text-4xl sm:text-6xl lg:text-8xl font-black leading-none whitespace-nowrap flex items-baseline justify-center" style={`color: ${COLORS.black};`}>
                    <span>{t(journeyTitleParts.prefix)}</span>
                    <button
                            id="journey-toggle"
                            type="button"
                            class="journey-word"
                            title={t(journeyTitleParts.toggleHint)}
                            aria-label={t(journeyTitleParts.toggleHint)}
                            data-word-game={t(journeyTitleParts.gameWord)}
                            data-word-anime={t(journeyTitleParts.animeWord)}
                    ><span class="journey-word-text">{t(journeyTitleParts.gameWord)}</span></button>
                    <span>{t(journeyTitleParts.suffix)}</span>
                </h1>
            </div>
        </div>
    </div>

    {journeys.map((journey) => (
    <div class="journey-panel" data-journey={journey.key} hidden={journey.key !== defaultJourney}>

    {/* 2. 满宽街机风格滚动 Banner（只有游戏旅程有）*/}
    {journey.marquee && (
            <div
                    class="relative w-full border-y-4 py-3 sm:py-4 flex overflow-hidden whitespace-nowrap mb-16 sm:mb-24"
                    style={`border-color: ${COLORS.black}; background-color: ${COLORS.white};`}
                    data-reveal="fade"
            >
                <div class="animate-marquee flex gap-8 text-xl sm:text-2xl font-black tracking-widest" style={`color: ${COLORS.black};`}>
                    <span>{t(journey.marquee)}</span>
                    <span>{t(journey.marquee)}</span>
                    <span>{t(journey.marquee)}</span>
                    <span>{t(journey.marquee)}</span>
                </div>
            </div>
    )}

    <div class:list={["mx-auto px-4 sm:px-6 lg:px-8", !journey.marquee && "pt-4 sm:pt-8"]}>

        {/* 3. 关于我的游戏经历介绍 (双栏布局，只有游戏旅程有) */}
        {journey.profile && journey.style && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 mb-16 sm:mb-24" data-reveal-children="up" data-reveal-stagger="110">

            {/* 左侧：玩家档案 */}
            <div class="relative w-full border-4 p-6 sm:p-10 rounded-xl" style={`border-color: ${COLORS.black}; background-color: ${COLORS.white}; box-shadow: 10px 10px 0px ${COLORS.black};`}>
                <div class="absolute -top-4 -left-4 w-8 h-8 sm:w-10 sm:h-10 border-4 rounded-full" style={`border-color: ${COLORS.black}; background-color: ${COLORS.orange.dark};`}></div>

                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-6" style={`color: ${COLORS.black};`}>
                    {t(journey.profileHeader)}
                </h2>
                <div class="text-base sm:text-lg font-bold leading-relaxed space-y-4" style={`color: ${COLORS.black};`}>
                    <p>{t(journey.profile.description1)}</p>
                    <p class="opacity-80">{t(journey.profile.description2)}</p>
                </div>
            </div>

            {/* 右侧：游玩风格 */}
            <div class="relative w-full border-4 p-6 sm:p-10 rounded-xl" style={`border-color: ${COLORS.black}; background-color: ${COLORS.white}; box-shadow: 10px 10px 0px ${COLORS.black};`}>
                <div class="absolute -top-4 -right-4 w-8 h-8 sm:w-10 sm:h-10 border-4 rounded-full" style={`border-color: ${COLORS.black}; background-color: ${COLORS.blue.dark};`}></div>

                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-6 text-left md:text-right" style={`color: ${COLORS.black};`}>
                    {t(journey.styleHeader)}
                </h2>
                <div class="text-base sm:text-lg font-bold leading-relaxed space-y-4 text-left md:text-right" style={`color: ${COLORS.black};`}>
                    <p>{t(journey.style.description1)}</p>
                    <p class="opacity-80">{t(journey.style.description2)}</p>
                </div>
            </div>

        </div>
        )}

        {/* 4. 最爱游戏区 (自适应矩形网格，居中) */}
        {journey.favorites.length > 0 && (
                <div class="mb-20 sm:mb-28">
                    <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-8" data-reveal-children="up">
                        <h2 class="text-4xl sm:text-5xl font-black shrink-0" style={`color: ${COLORS.black};`}>
                            {t(journey.favoritesHeader)}
                        </h2>
                        <div class="hidden sm:block h-2 flex-grow" style={`background-color: ${COLORS.black};`}></div>

                        <!-- Size Slider -->
                        <div class="flex items-center gap-3 shrink-0">
                            <i class="fa-solid fa-compress text-base opacity-40"></i>
                            <input
                                    type="range"
                                    min="160"
                                    max="420"
                                    value="240"
                                    class="card-slider fav-size-slider"
                                    style={`--thumb-color: ${COLORS.orange.dark};`}
                            />
                            <i class="fa-solid fa-expand text-base opacity-40"></i>
                        </div>
                    </div>

                    {/* 和下面的库一样：auto-fill 网格，由滑块控制的最小列宽决定列数 */}
                    <div
                            class="favorites-grid grid gap-4 sm:gap-5 lg:gap-6 pt-2"
                            style="grid-template-columns: repeat(auto-fill, minmax(var(--fav-card-size), 1fr));"
                            data-reveal-children="scale"
                            data-reveal-order="columns"
                            data-reveal-stagger="45"
                    >
                        {journey.favorites.map((game) => {
                            const { data } = game;
                            const displayTitle = data.title[currentLang] || data.title.en || data.title.zh || game.id;
                            let displayComment = "";
                            if (data.comment) {
                                displayComment = data.comment[currentLang] || data.comment.en || data.comment.zh || "";
                            }

                            return (
                                    <div
                                            class="fav-card group relative flex flex-col rounded-xl overflow-hidden border-4"
                                            style={`border-color:${COLORS.black}; box-shadow:6px 6px 0px ${COLORS.black}; background-color: ${COLORS.white};`}
                                    >
                                        {/* Cover */}
                                        <div class="relative w-full overflow-hidden shrink-0" style={`aspect-ratio: 2 / 3; background-color: ${COLORS.khakiMilan}; border-bottom: 4px solid ${COLORS.black};`}>
                                            {data.image ? (
                                                    <Image
                                                            src={data.image}
                                                            alt={displayTitle}
                                                            class="absolute inset-0 w-full h-full object-cover"
                                                            loading="lazy"
                                                            decoding="async"
                                                            draggable="false"
                                                    />
                                            ) : (
                                                    <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                                                        <i class="fa-solid fa-gamepad text-4xl opacity-25" style={`color:${COLORS.black};`}></i>
                                                    </div>
                                            )}
                                        </div>

                                        {/* Info */}
                                        <div class="flex-1 p-3 sm:p-4" style={`background-color: ${COLORS.white};`}>
                                            <h3 class="fav-card-title font-black leading-tight mb-1 sm:mb-2 truncate" title={displayTitle}>{displayTitle}</h3>
                                            <p class="fav-card-comment font-bold opacity-70 leading-snug line-clamp-8">{displayComment}</p>
                                        </div>
                                    </div>
                            );
                        })}
                    </div>
                </div>
        )}

        {/* 5. 全部游戏库 (动态网格 + 滑块) */}
        <div class="all-games-section">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-8" data-reveal-children="up">
                <h2 class="text-4xl sm:text-5xl font-black shrink-0" style={`color: ${COLORS.black};`}>
                    {t(journey.libraryHeader)}
                    <span class="opacity-50">({journey.items.length})</span>
                </h2>
                <div class="hidden sm:block h-2 flex-grow" style={`background-color: ${COLORS.black};`}></div>

                <!-- Size Slider -->
                <div class="flex items-center gap-3 shrink-0">
                    <i class="fa-solid fa-compress text-base opacity-40"></i>
                    <input
                            type="range"
                            min="100"
                            max="320"
                            value="180"
                            class="card-slider card-size-slider"
                            style={`--thumb-color: ${COLORS.orange.dark};`}
                    />
                    <i class="fa-solid fa-expand text-base opacity-40"></i>
                </div>
            </div>

            <!-- Game Grid -->
            <div
                    class="library-grid grid gap-4 sm:gap-5 lg:gap-6"
                    style="grid-template-columns: repeat(auto-fill, minmax(var(--card-size), 1fr));"
                    data-reveal-children="scale"
                    data-reveal-order="columns"
                    data-reveal-stagger="45"
            >
                {journey.items.map((game) => {
                    const { data } = game;
                    const displayTitle = data.title[currentLang] || data.title.en || data.title.zh || game.id;

                    return (
                            <div
                                    class="game-journey-card group relative flex flex-col"
                                    data-favorite={data.favorite ? "true" : "false"}
                            >
                                {/* 非 favorite：不可见占位，在卡片边框外部 */}
                                {!data.favorite && (
                                        <div
                                                class="favorite-strip flex items-center justify-between shrink-0 border-b-2"
                                                style="visibility: hidden; border-color: transparent;"
                                        >
                                            <div class="flex items-center gap-1.5 sm:gap-2">
                                                <i class="strip-icon fa-solid fa-star"></i>
                                                <span class="strip-text font-black tracking-wider leading-none">&nbsp;</span>
                                            </div>
                                        </div>
                                )}

                                {/* Card body */}
                                <div
                                        class="card-body relative flex flex-col rounded-xl overflow-hidden border-2"
                                        style={`border-color:${COLORS.black}; box-shadow:6px 6px 0px ${COLORS.black}; background-color: ${COLORS.white};`}
                                >
                                    {/* Favorite Strip */}
                                    {data.favorite && (
                                            <div
                                                    class="favorite-strip flex items-center justify-between border-b-2 shrink-0 z-10 transition-colors duration-200"
                                                    style={`background-color:${COLORS.white}; border-color:${COLORS.black};`}
                                            >
                                                <div class="flex items-center gap-1.5 sm:gap-2">
                                                    <i class="strip-icon fa-solid fa-star" style={`color:${COLORS.black};`}></i>
                                                    <span class="strip-text font-black tracking-wider leading-none" style={`color:${COLORS.black};`}>{t(journey.favoriteTag)}</span>
                                                </div>
                                            </div>
                                    )}

                                    {/* Cover */}
                                    <div class="relative w-full overflow-hidden shrink-0" style={`aspect-ratio: 2 / 3; background-color: ${COLORS.khakiMilan};`}>
                                        {data.image ? (
                                                <Image
                                                        src={data.image}
                                                        alt={displayTitle}
                                                        class="absolute inset-0 w-full h-full object-cover"
                                                        loading="lazy"
                                                        decoding="async"
                                                        draggable="false"
                                                />
                                        ) : (
                                                <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                                                    <i class="fa-solid fa-gamepad text-3xl opacity-25" style={`color:${COLORS.black};`}></i>
                                                </div>
                                        )}
                                    </div>

                                    {/* Info */}
                                    <div class="card-info relative flex-1 p-2.5 sm:p-3 border-t-2" style={`background-color: ${COLORS.white}; border-color:${COLORS.black};`}>
                                        <h3 class="card-title font-black">{displayTitle}</h3>
                                    </div>
                                </div>
                            </div>
                    );
                })}
            </div>
        </div>
    </div>

    </div>
    ))}
</section>

<style>
    /* ---- 最爱作品 网格卡片字体自适应 ----
       和下面游戏库的 .card-title 一套写法：跟着卡片自身宽度走，上下有封顶 */
    .fav-card-title {
        font-size: clamp(0.75rem, 8cqw, 1.25rem);
    }
    .fav-card-comment {
        font-size: clamp(0.7rem, 5.5cqw, 0.875rem);
    }

    .fav-card {
        container-type: inline-size;
        container-name: favcard;
        transition: transform 0.1s ease-in-out, box-shadow 0.1s ease-in-out;
    }
    .fav-card:hover {
        transform: translate(3px, 3px);
        box-shadow: 3px 3px 0px var(--color-black) !important;
    }
    .fav-card:active {
        transform: translate(6px, 6px);
        box-shadow: 0px 0px 0px var(--color-black) !important;
    }

    /* 卡片入场动画由全站的进出场动效系统接管，见 src/styles/motion.css */

    /* ---- 游戏库 网格卡片样式 ---- */
    .game-journey-card {
        container-type: inline-size;
        container-name: gamecard;
    }

    .card-body {
        transition: transform 0.1s ease-in-out, box-shadow 0.1s ease-in-out;
    }
    .game-journey-card:hover .card-body {
        transform: translate(3px, 3px);
        box-shadow: 3px 3px 0px var(--color-black) !important;
    }
    .game-journey-card:active .card-body {
        transform: translate(6px, 6px);
        box-shadow: 0px 0px 0px var(--color-black) !important;
    }

    .favorite-strip {
        padding: clamp(6px, 3cqw, 10px) clamp(8px, 4.5cqw, 14px);
    }
    .game-journey-card[data-favorite="true"]:hover .favorite-strip {
        background-color: var(--color-yellow-dark) !important;
    }
    .strip-icon, .strip-text {
        font-size: clamp(0.6rem, 6.5cqw, 0.9rem);
    }

    .card-title {
        font-size: clamp(0.75rem, 8cqw, 1.25rem);
        line-height: 1.2;
        height: 1.2em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @container gamecard (max-width: 180px) {
        .card-info {
            display: none;
        }
    }

    /* ---- 标题里可点击的「游戏 / 动画」词 ----
       不加框、不加底，只在词下面留一条会流动的横线做交互提示 */
    .journey-word {
        position: relative;
        display: inline-block;
        /* 不加内边距，词的字号、字重、行高、颜色都和标题其余部分完全一致，
           配合 h1 的 items-baseline，三段文字坐在同一条基线上 */
        padding: 0;
        border: none;
        background: none;
        color: inherit;
        font: inherit;
        line-height: inherit;
        cursor: pointer;
    }

    .journey-word::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.14em;
        height: 0.09em;
        border-radius: 999px;
        /* 线的颜色跟文字一致，流动的高光只是同色系里透出来的一段 */
        background-image: linear-gradient(
                90deg,
                var(--color-black) 0%,
                var(--color-black) 38%,
                color-mix(in srgb, var(--color-black) 28%, transparent) 50%,
                var(--color-black) 62%,
                var(--color-black) 100%
        );
        background-size: 300% 100%;
        background-position: 100% 0;
        animation: journey-underline-flow 3.2s linear infinite;
        transition: height 0.18s ease-out, bottom 0.18s ease-out;
    }

    .journey-word:hover::after,
    .journey-word:focus-visible::after {
        height: 0.15em;
        bottom: -0.18em;
    }

    .journey-word:focus-visible {
        outline: none;
    }

    @keyframes journey-underline-flow {
        to { background-position: -200% 0; }
    }

    /* 点击换词时的一个上下交错的小切换动效 */
    .journey-word.is-switching .journey-word-text {
        animation: journey-word-swap 0.36s ease-in-out;
    }

    .journey-word-text {
        display: inline-block;
    }

    @keyframes journey-word-swap {
        0%   { opacity: 1; transform: translateY(0); }
        45%  { opacity: 0; transform: translateY(-0.18em); }
        55%  { opacity: 0; transform: translateY(0.18em); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .journey-word::after {
            animation: none;
            background-image: none;
            background-color: var(--color-black);
        }
        .journey-word.is-switching .journey-word-text {
            animation: none;
        }
    }

    /* ---- 街机 Banner 跑马灯动画 ---- */
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-marquee {
        width: fit-content;
        animation: marquee 30s linear infinite;
    }

    /* ---- Slider 样式 ---- */
    .card-slider {
        -webkit-appearance: none;
        appearance: none;
        width: 240px;
        height: 24px;
        background: var(--color-white);
        border: 2px solid var(--color-black);
        border-radius: 8px;
        box-shadow: 4px 4px 0px var(--color-black);
        outline: none;
        cursor: pointer;
        transition: box-shadow 0.15s, transform 0.15s;
    }

    .card-slider:active {
        box-shadow: 1px 1px 0px var(--color-black);
        transform: translate(3px, 3px);
    }

    .card-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 20px;
        height: 36px;
        background: var(--thumb-color, var(--color-orange-dark));
        border: 2px solid var(--color-black);
        border-radius: 6px;
        cursor: grab;
        box-shadow: 3px 3px 0px var(--color-black);
        transition: transform 0.1s, box-shadow 0.1s;
    }
    .card-slider:active::-webkit-slider-thumb {
        cursor: grabbing;
        transform: translate(3px, 3px);
        box-shadow: 0px 0px 0px var(--color-black);
    }

    .card-slider::-moz-range-thumb {
        width: 20px;
        height: 36px;
        background: var(--thumb-color, var(--color-orange-dark));
        border: 2px solid var(--color-black);
        border-radius: 6px;
        cursor: grab;
        box-shadow: 3px 3px 0px var(--color-black);
        transition: transform 0.1s, box-shadow 0.1s;
    }
    .card-slider:active::-moz-range-thumb {
        cursor: grabbing;
        transform: translate(3px, 3px);
        box-shadow: 0px 0px 0px var(--color-black);
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const panels = Array.from(document.querySelectorAll<HTMLElement>('.journey-panel'));
        const toggle = document.getElementById("journey-toggle");

        // ---- Slider 控制卡片大小（每个面板各自一个）----
        panels.forEach((panel) => {
            const slider = panel.querySelector<HTMLInputElement>(".card-size-slider");
            if (slider) {
                slider.addEventListener("input", () => {
                    panel.style.setProperty("--card-size", slider.value + "px");
                    // 列数变了，入场动画的左右次序要跟着重算
                    document.dispatchEvent(new CustomEvent('motion:relayout'));
                });
            }

            const favSlider = panel.querySelector<HTMLInputElement>(".fav-size-slider");
            if (favSlider) {
                favSlider.addEventListener("input", () => {
                    panel.style.setProperty("--fav-card-size", favSlider.value + "px");
                    document.dispatchEvent(new CustomEvent('motion:relayout'));
                });
            }
        });

        // ---- 标题里的词：在游戏 / 动画两条旅程之间切换 ----
        const toggleText = toggle?.querySelector<HTMLElement>(".journey-word-text");

        if (toggle && toggleText && panels.length > 1) {
            const words: Record<string, string> = {
                game: toggle.dataset.wordGame || "",
                anime: toggle.dataset.wordAnime || "",
            };
            let active = "game";
            let switching = false;

            function applyJourney(next: string) {
                toggleText!.textContent = words[next];

                panels.forEach((panel) => {
                    panel.hidden = panel.dataset.journey !== next;
                });

                // 隐藏时元素没有布局，offsetLeft 读作 0，
                // 所以切出来之后要重算入场动画的列序
                document.dispatchEvent(new CustomEvent('motion:relayout'));
            }

            toggle.addEventListener("click", () => {
                if (switching) return;

                active = active === "game" ? "anime" : "game";
                const next = active;

                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    applyJourney(next);
                    return;
                }

                // 等词淡出到中途再换内容，视觉上是一次完整的切换而不是闪一下
                switching = true;
                toggle.classList.add("is-switching");
                window.setTimeout(() => applyJourney(next), 160);
                window.setTimeout(() => {
                    toggle.classList.remove("is-switching");
                    switching = false;
                }, 360);
            });
        }
    });
</script>