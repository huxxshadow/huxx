---
import { COLORS } from "@/consts";
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "@/i18n";
import { introLabels } from "@/i18n/components/aboutme/DndIntroSection_i18";

const locale = Astro.currentLocale as Lang || 'en';
const t = useTranslations(locale);


---

<section
        class="relative overflow-hidden w-full px-4 lg:px-24 py-12 lg:py-20 flex justify-center border-b-[4px] border-dashed border-current/20"
        style={`background-color: ${COLORS.khakiMilan}; color: ${COLORS.black}; --theme-bg: ${COLORS.khakiMilan}; --theme-text: ${COLORS.black};`}
>
    <!-- 主体内容容器 -->
    <div class="w-full flex flex-col  lg:flex-row gap-8 lg:gap-16 relative z-10 items-stretch">

        <!-- 右侧区域：核心自我介绍内容 -->
        <div
                class="flex-1 w-full flex flex-col justify-center gap-8"
                data-reveal-children="up"
                data-reveal-once
                data-reveal-stagger="90"
        >

            <!-- 问候语 -->
            <h3 class="text-center text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight">{t(introLabels.greeting)}</h3>


            <!-- 爱好：海报式排版，左右交替、人物放大，每条下面一条圆角横线 -->
            <ul class="hobbies">
                {introLabels.hobbies.map((h, i) => (
                        <>
                        <li
                                class:list={["hobby", `hobby-${i + 1}`, i % 2 ? "side-right" : "side-left", { "has-image": !!h.image, "has-photo": !!h.photo }]}
                                style={`grid-row: ${i + 1};${h.theme ? ` --t-light: ${h.theme.light}; --t-dark: ${h.theme.dark};` : ""}`}
                        >
                            <div class="hobby-media">
                                {h.image ? (
                                        <h.image class="hobby-img" aria-hidden="true" preserveAspectRatio="xMidYMax meet" />
                                ) : h.iconSvg ? (
                                        <span class="hobby-icon hobby-svg" aria-hidden="true" set:html={h.iconSvg} />
                                ) : (
                                        <i class={`fa-solid ${h.icon} hobby-icon`} aria-hidden="true"></i>
                                )}
                            </div>
                            <div class="hobby-text">
                                <p class="hobby-title">{t(h.title)}</p>
                                <div class="hobby-notes">
                                    {h.notes.map((n) => <p class="hobby-note">{t(n)}</p>)}
                                </div>
                            </div>
                        </li>
                        {h.photo && (
                                <li
                                        class:list={["photo-cell", `photo-${i + 1}`, i % 2 ? "side-right" : "side-left"]}
                                        style={`grid-row: ${i + 1};${h.theme ? ` --t-light: ${h.theme.light}; --t-dark: ${h.theme.dark};` : ""}`}
                                        aria-hidden="true"
                                >
                                    <figure class="hobby-photo">
                                        <Image src={h.photo} alt="" widths={[640, 1040]} sizes="(min-width: 1024px) 460px, 90vw" />
                                    </figure>
                                </li>
                        )}
                        </>
                ))}
            </ul>

            {/* 「凡俗的履历」引导按钮暂时隐藏
            <div class="mt-4   border-current/15">
                <div
                        class="cta-box group flex items-start lg:items-center gap-5 p-5 sm:p-8 rounded-2xl border-[3px] cursor-pointer"
                        style={`border-color: ${COLORS.red.dark}; background-color: ${COLORS.red.light};`}
                >
                    <i class="fa-solid fa-dice-d20 text-[2.5rem] lg:text-[3rem] fa-bounce " style={`color: ${COLORS.red.dark};`}></i>
                    <div class="flex-1">
                        <p class="text-base sm:text-lg font-bold italic opacity-95 leading-snug whitespace-pre-line">
                            {t(introLabels.transition)}
                        </p>
                    </div>
                    桌面端向下跳动的箭头图标
                    <div
                            class="hidden lg:flex items-center justify-center w-12 h-12 rounded-full border-[3px] opacity-80 group-hover:opacity-100 transition-opacity"
                            style={`border-color: ${COLORS.red.dark};`}
                    >
                        <i class="fa-solid fa-arrow-down text-xl animate-pulse"></i>
                    </div>
                </div>
            </div>
            */}

        </div>
    </div>
</section>

<style>
    .title-vertical-mode {
        writing-mode: horizontal-tb;
    }

    @media (min-width: 1024px) {
        .title-vertical-mode {
            writing-mode: vertical-lr;
            text-orientation: upright;
        }
    }

    /* ================= 爱好：通用 ================= */
    .hobbies { list-style: none; }
    .hobby { position: relative; }
    .hobby-title { font-weight: 900; line-height: 1.1; }
    .hobby-note { font-weight: 700; opacity: 0.75; }
    .hobby-notes { display: flex; flex-direction: column; gap: 0.2rem; }
    .hobby-media { display: flex; align-items: center; justify-content: center; }
    .hobby-img { width: auto; object-fit: contain; }
    /*
     * 矢量插画：默认是原来的黑白灰，鼠标悬停这一条时换成它的主题色
     *（白色部分不变；灰 → 主题深色，墨线 → 更深一点的主题色）
     */
    .hobby {
        --paper: #ffffff;
        --shade: #4e4e4e;
        --ink: #1a1a1a;
    }
    /*
     * 「选中」：鼠标放在某一条或它的照片上，这一整行一起变成主题色——
     * 插画深色部分、标题、标签、横线、照片边框换色，背后浮出一块主题浅色底，整行微微浮起
     */
    .hobbies:has(.hobby-1:hover, .photo-1:hover) :is(.hobby-1, .photo-1),
    .hobbies:has(.hobby-2:hover, .photo-2:hover) :is(.hobby-2, .photo-2),
    .hobbies:has(.hobby-3:hover, .photo-3:hover) :is(.hobby-3, .photo-3),
    .hobbies:has(.hobby-4:hover, .photo-4:hover) :is(.hobby-4, .photo-4),
    .hobbies:has(.hobby-5:hover, .photo-5:hover) :is(.hobby-5, .photo-5),
    .hobbies:has(.hobby-6:hover, .photo-6:hover) :is(.hobby-6, .photo-6) {
        --shade: var(--t-dark, #4e4e4e);
        --ink: color-mix(in srgb, var(--t-dark, #1a1a1a) 55%, #000);
        --sel: 1;
    }
    .hobby,
    .photo-cell { --sel: 0; }

    /* 浅色底：比条目四周多出一圈，圆角，选中时淡入 */
    .hobbies .hobby::before {
        content: "";
        position: absolute;
        inset: -1.2rem -1.6rem -0.6rem;
        z-index: 0;
        border-radius: 1.6rem;
        background: var(--t-light, transparent);
        opacity: calc(var(--sel) * 0.75);
        scale: calc(0.96 + var(--sel) * 0.04);
        transition: opacity 0.3s ease, scale 0.3s ease;
        pointer-events: none;
    }
    .hobbies .hobby > * { position: relative; z-index: 1; }

    .hobbies .hobby,
    .hobbies .photo-cell {
        transition: translate 0.3s ease;
        translate: 0 calc(var(--sel) * -4px);
    }
    .hobbies .hobby-title { transition: color 0.3s ease; }
    .hobbies .hobby-note { transition: background-color 0.3s ease; }
    .hobbies .hobby::after { transition: background-color 0.3s ease; }
    .hobby-photo { transition: border-color 0.3s ease, box-shadow 0.3s ease; }
    .hobbies:has(.hobby-1:hover, .photo-1:hover) .hobby-1 .hobby-title,
    .hobbies:has(.hobby-2:hover, .photo-2:hover) .hobby-2 .hobby-title,
    .hobbies:has(.hobby-3:hover, .photo-3:hover) .hobby-3 .hobby-title,
    .hobbies:has(.hobby-4:hover, .photo-4:hover) .hobby-4 .hobby-title,
    .hobbies:has(.hobby-5:hover, .photo-5:hover) .hobby-5 .hobby-title,
    .hobbies:has(.hobby-6:hover, .photo-6:hover) .hobby-6 .hobby-title {
        color: var(--t-dark);
    }
    .hobbies:has(.hobby-1:hover, .photo-1:hover) .hobby-1 .hobby-note,
    .hobbies:has(.hobby-2:hover, .photo-2:hover) .hobby-2 .hobby-note,
    .hobbies:has(.hobby-3:hover, .photo-3:hover) .hobby-3 .hobby-note,
    .hobbies:has(.hobby-4:hover, .photo-4:hover) .hobby-4 .hobby-note,
    .hobbies:has(.hobby-5:hover, .photo-5:hover) .hobby-5 .hobby-note,
    .hobbies:has(.hobby-6:hover, .photo-6:hover) .hobby-6 .hobby-note {
        background: var(--t-dark);
    }
    .hobbies:has(.hobby-1:hover, .photo-1:hover) .hobby-1::after,
    .hobbies:has(.hobby-2:hover, .photo-2:hover) .hobby-2::after,
    .hobbies:has(.hobby-3:hover, .photo-3:hover) .hobby-3::after,
    .hobbies:has(.hobby-4:hover, .photo-4:hover) .hobby-4::after,
    .hobbies:has(.hobby-5:hover, .photo-5:hover) .hobby-5::after,
    .hobbies:has(.hobby-6:hover, .photo-6:hover) .hobby-6::after {
        background: var(--t-dark);
    }
    .hobbies:has(.hobby-1:hover, .photo-1:hover) .photo-1 .hobby-photo,
    .hobbies:has(.hobby-2:hover, .photo-2:hover) .photo-2 .hobby-photo,
    .hobbies:has(.hobby-3:hover, .photo-3:hover) .photo-3 .hobby-photo,
    .hobbies:has(.hobby-4:hover, .photo-4:hover) .photo-4 .hobby-photo,
    .hobbies:has(.hobby-5:hover, .photo-5:hover) .photo-5 .hobby-photo,
    .hobbies:has(.hobby-6:hover, .photo-6:hover) .photo-6 .hobby-photo {
        border-color: var(--t-dark);
        box-shadow: 7px 7px 0 var(--t-dark);
    }
    @media (prefers-reduced-motion: reduce) {
        .hobbies .hobby,
        .hobbies .photo-cell { translate: none; }
    }
    .hobby-img :global(path) { transition: fill 0.35s ease; }
    svg.hobby-img { display: block; overflow: visible; }
    .hobby-icon { opacity: 0.85; }
    /* 自绘 SVG 图标和字体图标一样大：1em 见方 */
    .hobby-svg { display: inline-flex; width: 1em; height: 1em; }
    .hobby-svg :global(svg) { width: 100%; height: 100%; }

    /* ================= 海报式排版：人物很大，各条大幅左右错开 ================= */
    .hobbies {
        position: relative;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        padding: 2rem 0 3rem;
        /* 整块居中，最宽 1360px，大屏上不再铺到两边 */
        width: 100%;
        max-width: 1360px;
        margin-inline: auto;
    }
    .hobbies .hobby {
        display: flex;
        align-items: flex-end;
        gap: 1.2rem;
    }
    .hobbies .hobby-media,
    .hobbies .hobby-text { position: relative; z-index: 1; min-width: 0; }
    .hobbies .hobby-title {
        font-size: clamp(2.4rem, 5.4vw, 5rem);
        line-height: 1;
        letter-spacing: -0.03em;
    }
    .hobbies .hobby-notes {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5rem 0.6rem;
        margin-top: 0.8rem;
    }
    .hobbies .hobby-2 .hobby-notes,
    .hobbies .hobby-4 .hobby-notes { justify-content: flex-end; }
    .hobbies .hobby-note:nth-child(2) { rotate: 2.5deg; translate: 0 0.2rem; }
    .hobbies .hobby-note:nth-child(3) { rotate: -1.5deg; }
    .hobbies .hobby-note {
        display: inline-block;
        padding: 0.25rem 0.7rem;
        border-radius: 0.3rem;
        font-size: 1.05rem;
        color: #fffdf8;
        background: #494949;
        opacity: 1;
    }

    /* 有大插画的几条往上叠进前一条旁边的空白（左右交错） */
    .hobbies { --lift-up: clamp(-9rem, -10vw, -3rem); }

    /* 每条下面一条圆角横线，长度就是这一段（插画 + 文字）的宽度：
       条目收缩到内容宽度，靠左的贴左、靠右的贴右，横线铺满条目 */
    .hobbies .hobby {
        position: relative;
        padding-bottom: 2.2rem;
        width: fit-content;
        max-width: 100%;
        justify-self: start;
    }
    .hobbies .hobby.side-right { justify-self: end; }
    .hobbies .hobby::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 6px;
        border-radius: 999px;
        background: currentColor;
    }

    /* 01 游戏：左边，大人物站着，标题压在人物右侧脚边 */
    .hobbies .hobby-1 { grid-column: 1 / 10; }
    .hobbies .hobby-1 .hobby-media { height: clamp(18rem, 32vw, 30rem); }
    .hobbies .hobby-1 .hobby-img { height: 100%; }
    .hobbies .hobby-1 .hobby-text { padding-bottom: 2.5rem; }
    .hobbies .hobby-1 .hobby-note:first-child { rotate: -3deg; }

    /* 02 二次元：右边，往上咬进第一条的空白，大圆 + 右对齐，整体微微倾斜 */
    .hobbies .hobby-2 {
        grid-column: 6 / 13;
        margin-top: var(--lift-up);
        flex-direction: row-reverse;
        align-items: center;
        text-align: right;
        rotate: -2deg;
    }
    .hobbies .hobby-2 .hobby-media {
        flex: none;
        width: clamp(9rem, 14vw, 13rem);
        height: clamp(9rem, 14vw, 13rem);
        border-radius: 999px;
        border: 4px solid currentColor;
        background: #fffdf8;
        box-shadow: 8px 8px 0 currentColor;
    }
    .hobbies .hobby-2 .hobby-icon { font-size: clamp(3.5rem, 5.5vw, 5rem); }

    /* 04 烹饪：再甩到右边，圆形徽章，和 02 呼应 */
    .hobbies .hobby-4 {
        grid-column: 5 / 13;
        margin-top: var(--lift-up);
        flex-direction: row-reverse;
        align-items: center;
        text-align: right;
        rotate: 1.5deg;
    }
    .hobbies .hobby-4 .hobby-media {
        flex: none;
        width: clamp(8rem, 12vw, 11rem);
        height: clamp(8rem, 12vw, 11rem);
        border-radius: 999px;
        border: 4px solid currentColor;
        background: #fffdf8;
        box-shadow: 8px 8px 0 currentColor;
    }
    .hobbies .hobby-4 .hobby-icon { font-size: clamp(3.2rem, 5vw, 4.6rem); }
    .hobbies .hobby-4 .hobby-note:first-child { rotate: -2deg; }
    .hobbies .hobby-4.has-image { rotate: 0deg; align-items: flex-end; }
    .hobbies .hobby-4.has-image .hobby-text { padding-bottom: 2rem; }
    .hobbies .hobby-5.has-image { align-items: flex-end; }
    /* 击剑插画右下角是空的（剑在上方），文字往左收进这块空白 */
    .hobbies .hobby-5.has-image .hobby-text { padding-bottom: 1.5rem; margin-left: clamp(-10rem, -9vw, -4rem); }

    /* 05 击剑：回到左边，斜放的深色方块徽章，和 03 呼应 */
    .hobbies .hobby-5 {
        grid-column: 1 / 10;
        margin-top: clamp(-4rem, -4vw, -1rem);
        align-items: center;
    }
    .hobbies .hobby-5 .hobby-media {
        flex: none;
        width: clamp(8rem, 12vw, 11rem);
        height: clamp(8rem, 12vw, 11rem);
        border: 4px solid currentColor;
        border-radius: 1.4rem;
        background: #494949;
        color: #fffdf8;
        rotate: -7deg;
        box-shadow: 8px 8px 0 rgb(73 73 73 / 0.35);
    }
    .hobbies .hobby-5 .hobby-icon { font-size: clamp(3.2rem, 5vw, 4.6rem); opacity: 1; }
    .hobbies .hobby-5 .hobby-note:first-child { rotate: -2deg; }

    /* 06 音乐：再甩回右边，圆形徽章，和 02 / 04 呼应 */
    .hobbies .hobby-6 {
        grid-column: 5 / 13;
        margin-top: var(--lift-up);
        flex-direction: row-reverse;
        align-items: center;
        text-align: right;
        rotate: -1.5deg;
    }
    .hobbies .hobby-6 .hobby-media {
        flex: none;
        width: clamp(8rem, 12vw, 11rem);
        height: clamp(8rem, 12vw, 11rem);
        border-radius: 999px;
        border: 4px solid currentColor;
        background: #fffdf8;
        box-shadow: 8px 8px 0 currentColor;
    }
    .hobbies .hobby-6 .hobby-icon { font-size: clamp(3.2rem, 5vw, 4.6rem); }
    .hobbies .hobby-6 .hobby-notes { justify-content: flex-end; }
    .hobbies .hobby-6 .hobby-note:first-child { rotate: 2deg; }
    .hobbies .hobby-6.has-image { rotate: 0deg; align-items: flex-end; }
    .hobbies .hobby-6.has-image .hobby-text { padding-bottom: 2rem; }

    /* 有配图的条目：插画放大显示，不套圆形 / 方块框 */
    .hobbies .has-image .hobby-media {
        width: auto;
        height: clamp(16rem, 28vw, 26rem);
        border: 0;
        border-radius: 0;
        background: none;
        box-shadow: none;
        rotate: 0deg;
    }
    .hobbies .has-image .hobby-img { height: 100%; }
    .hobbies .hobby-2.has-image { grid-column: 3 / 13; rotate: 0deg; align-items: flex-end; }
    .hobbies .has-image .hobby-title { white-space: nowrap; }
    .hobbies .hobby-3.has-image { align-items: flex-end; }
    /* 这里的选择器比「03 长跑方块徽章」更具体，有配图时把方块框完全去掉 */
    .hobbies .hobby-3.has-image .hobby-media,
    .hobbies .hobby-4.has-image .hobby-media,
    .hobbies .hobby-5.has-image .hobby-media,
    .hobbies .hobby-6.has-image .hobby-media {
        width: auto;
        height: clamp(16rem, 28vw, 26rem);
        border: 0;
        border-radius: 0;
        background: none;
        box-shadow: none;
        rotate: 0deg;
        color: inherit;
    }
    .hobbies .hobby-3.has-image .hobby-text { padding-bottom: 2rem; }
    .hobbies .hobby-2.has-image .hobby-text { padding-bottom: 2rem; rotate: -2deg; }

    /* 03 长跑：回到左侧但往里缩，方形徽章斜放 */
    .hobbies .hobby-3 {
        grid-column: 1 / 10;
        margin-top: var(--lift-up);
        align-items: center;
    }
    .hobbies .hobby-3 .hobby-media {
        flex: none;
        width: clamp(8rem, 12vw, 11rem);
        height: clamp(8rem, 12vw, 11rem);
        border: 4px solid currentColor;
        border-radius: 1.4rem;
        background: #494949;
        color: #fffdf8;
        rotate: 8deg;
        box-shadow: 8px 8px 0 rgb(73 73 73 / 0.35);
    }
    .hobbies .hobby-3 .hobby-icon { font-size: clamp(3.2rem, 5vw, 4.6rem); opacity: 1; }
    .hobbies .hobby-3 .hobby-note:first-child { rotate: 2deg; }

    /* 手机：三版都改成一列，保留各自的风格 */
    @media (max-width: 639px) {
        .hobbies .hobby { align-self: center; }
        .hobbies { --lift-up: 0rem; }
        /* 手机上文字不再往插画那边挤，标签居中、可以换行 */
        .hobbies .hobby .hobby-text { margin: 0 !important; padding-bottom: 0 !important; rotate: 0deg !important; }
        .hobbies .hobby .hobby-notes { justify-content: center; }
        .hobbies .has-image .hobby-title { white-space: normal; }
        .hobbies { display: flex; flex-direction: column; gap: 3rem; }
        .hobbies .hobby { flex-direction: column; align-items: center; text-align: center; }
        .hobbies .hobby-2 { margin-top: 0; flex-direction: column; text-align: center; }
        .hobbies .hobby-3,
        .hobbies .hobby-4,
        .hobbies .hobby-5,
        .hobbies .hobby-6 { margin-top: 0; }
        .hobbies .hobby-6 { flex-direction: column; text-align: center; }
        .hobbies .hobby-4 { flex-direction: column; text-align: center; }
        .hobbies .hobby-1 .hobby-text { margin-left: 0; padding-bottom: 0; }
        }

    /*
     * 真实照片：单独占一个格子，和这一条在同一行，放在整块区域的另一侧边上
     *（靠左的条目 → 照片在最右边；靠右的条目 → 照片在最左边）。条目本身和下面的横线都不变。
     */
    .photo-cell {
        display: flex;
        margin-top: 3.5rem;
        align-items: center;
        align-self: center;
    }
    /* 照片朝文字那一侧留出间隔（网格没有列间距，照片又是歪着的），文字永远碰不到照片 */
    .photo-cell.side-left { grid-column: 9 / 13; justify-self: stretch; padding-left: clamp(1.5rem, 3vw, 2.5rem); }
    .photo-cell.side-right { grid-column: 1 / 5; justify-self: stretch; padding-right: clamp(1.5rem, 3vw, 2.5rem); }
    .hobby-photo {
        display: block;
        /* 占满照片那四列（最宽 1120 时约 370px） */
        width: 100%;
        padding: 0.6rem 0.6rem 1.6rem;
        background: #fffdf8;
        border: 3px solid currentColor;
        border-radius: 0.5rem;
        box-shadow: 7px 7px 0 currentColor;
        rotate: 3deg;
    }
    .photo-cell.side-right .hobby-photo { rotate: -3deg; }
    /* 带照片的行：条目让出照片那几列；这一行和下一行都不往上叠，免得撞到照片 */
    .hobbies .hobby.has-photo.side-left { grid-column: 1 / 9; }
    .hobbies .hobby.has-photo.side-right { grid-column: 5 / 13; }
    /* 带照片的行文字区变窄：标题稍小；中日韩标题不断行（英文可以换行） */
