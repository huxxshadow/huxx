---
import { COLORS } from "@/consts";
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "@/i18n";
import { introLabels, rolesData } from "@/i18n/components/aboutme/DndIntroSection_i18";

const locale = Astro.currentLocale as Lang || 'en';
const t = useTranslations(locale);

const roleList = rolesData[locale] || rolesData.en;

---

<section
        class="relative overflow-hidden w-full px-4 lg:px-24 py-12 lg:py-20 flex justify-center border-b-[4px] border-dashed border-current/20"
        style={`background-color: ${COLORS.khakiMilan}; color: ${COLORS.black}; --theme-bg: ${COLORS.khakiMilan}; --theme-text: ${COLORS.black};`}
>
    <!-- 主体内容容器 -->
    <div class="w-full flex flex-col  lg:flex-row gap-8 lg:gap-16 relative z-10 items-stretch">

        <!-- 右侧区域：核心自我介绍内容 -->
        <div
                class="flex-1 w-full flex flex-col justify-center gap-8"
                data-reveal-children="up"
                data-reveal-once
                data-reveal-stagger="90"
        >

            <!-- 问候语 & 标签 -->
            <div class="flex flex-col gap-4">
                <h3 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight">{t(introLabels.greeting)}</h3>

                <div class="flex flex-wrap items-center gap-3">
                    {roleList.map((role) => (
                            <span class="brutalist-tag">{role}</span>
                    ))}
                </div>
            </div>

            <!-- 爱好：三版排版待选（A 剪贴簿 / B 大字错落 / C 便当格），本地开发时用右下角的 DebugVariantSwitcher 切换 -->
            <ul
                    class="hobbies"
                    data-variant-group="hobbies"
                    data-variant-label="爱好"
                    data-variant-options="A,B,C,D"
                    data-variant-current="D"
            >
                {introLabels.hobbies.map((h, i) => (
                        <li class:list={["hobby", `hobby-${i + 1}`, { "has-image": !!h.image }]}>
                            <div class="hobby-media">
                                {h.image ? (
                                        <Image src={h.image} alt="" widths={[320, 640]} sizes="(min-width: 1024px) 320px, 200px" class="hobby-img" />
                                ) : (
                                        <i class={`fa-solid ${h.icon} hobby-icon`} aria-hidden="true"></i>
                                )}
                            </div>
                            <div class="hobby-text">
                                <p class="hobby-title">{t(h.title)}</p>
                                <div class="hobby-notes">
                                    {h.notes.map((n) => <p class="hobby-note">{t(n)}</p>)}
                                </div>
                            </div>
                        </li>
                ))}
            </ul>

            {/* 「凡俗的履历」引导按钮暂时隐藏
            <div class="mt-4   border-current/15">
                <div
                        class="cta-box group flex items-start lg:items-center gap-5 p-5 sm:p-8 rounded-2xl border-[3px] cursor-pointer"
                        style={`border-color: ${COLORS.red.dark}; background-color: ${COLORS.red.light};`}
                >
                    <i class="fa-solid fa-dice-d20 text-[2.5rem] lg:text-[3rem] fa-bounce " style={`color: ${COLORS.red.dark};`}></i>
                    <div class="flex-1">
                        <p class="text-base sm:text-lg font-bold italic opacity-95 leading-snug whitespace-pre-line">
                            {t(introLabels.transition)}
                        </p>
                    </div>
                    桌面端向下跳动的箭头图标
                    <div
                            class="hidden lg:flex items-center justify-center w-12 h-12 rounded-full border-[3px] opacity-80 group-hover:opacity-100 transition-opacity"
                            style={`border-color: ${COLORS.red.dark};`}
                    >
                        <i class="fa-solid fa-arrow-down text-xl animate-pulse"></i>
                    </div>
                </div>
            </div>
            */}

        </div>
    </div>
</section>

<style>
    .title-vertical-mode {
        writing-mode: horizontal-tb;
    }

    @media (min-width: 1024px) {
        .title-vertical-mode {
            writing-mode: vertical-lr;
            text-orientation: upright;
        }
    }

    /* ================= 爱好：通用 ================= */
    .hobbies { list-style: none; }
    .hobby { position: relative; }
    .hobby-title { font-weight: 900; line-height: 1.1; }
    .hobby-note { font-weight: 700; opacity: 0.75; }
    .hobby-notes { display: flex; flex-direction: column; gap: 0.2rem; }
    .hobby-media { display: flex; align-items: center; justify-content: center; }
    .hobby-img { width: auto; object-fit: contain; }
    .hobby-icon { opacity: 0.85; }

    /* ================= A：剪贴簿，卡片歪着、错开、上面贴胶带，插画探出卡片 ================= */
    .hobbies[data-variant-current="A"] {
        display: grid;
        grid-template-columns: 1.25fr 1fr 1fr;
        gap: 2.5rem 2rem;
        padding: 3rem 0.5rem 1rem;
        align-items: start;
    }
    [data-variant-current="A"] .hobby {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.4rem 1.6rem 1.6rem;
        border: 3px solid currentColor;
        border-radius: 1.1rem;
        background: #fffdf8;
        box-shadow: 6px 6px 0 currentColor;
        transition: rotate 0.25s ease, translate 0.25s ease;
    }
    [data-variant-current="A"] .hobby:hover { rotate: 0deg; translate: 0 -4px; }
    [data-variant-current="A"] .hobby-1 { rotate: -3deg; margin-top: 1.5rem; }
    [data-variant-current="A"] .hobby-2 { rotate: 2.5deg; margin-top: 4.5rem; }
    [data-variant-current="A"] .hobby-3 { rotate: -1.5deg; margin-top: 0; }
    /* 胶带 */
    [data-variant-current="A"] .hobby::before {
        content: "";
        position: absolute;
        top: -14px;
        left: 50%;
        width: 5.5rem;
        height: 1.6rem;
        translate: -50% 0;
        rotate: -4deg;
        background: rgb(73 73 73 / 0.18);
        border-left: 2px dashed rgb(73 73 73 / 0.25);
        border-right: 2px dashed rgb(73 73 73 / 0.25);
    }
    [data-variant-current="A"] .hobby-media { height: 9rem; }
    [data-variant-current="A"] .hobby-1 .hobby-media { height: 12rem; margin-top: -4.5rem; }
    [data-variant-current="A"] .hobby-img { height: 100%; }
    [data-variant-current="A"] .hobby-icon { font-size: 4.5rem; }
    [data-variant-current="A"] .hobby-title { font-size: clamp(1.5rem, 2.2vw, 2rem); }
    [data-variant-current="A"] .hobby-note { font-size: 0.95rem; }

    /* ================= B：大字错落，没有卡片，一左一右一左地排，插画和图标放在字旁边 ================= */
    .hobbies[data-variant-current="B"] {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 1rem 0;
    }
    [data-variant-current="B"] .hobby {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        max-width: 75%;
    }
    [data-variant-current="B"] .hobby-2 {
        align-self: flex-end;
        flex-direction: row-reverse;
        text-align: right;
    }
    [data-variant-current="B"] .hobby-3 { margin-left: 8%; }
    [data-variant-current="B"] .hobby-media {
        flex: none;
        width: 8rem;
        height: 8rem;
        border-radius: 999px;
        border: 3px solid currentColor;
        background: #fffdf8;
        box-shadow: 5px 5px 0 currentColor;
    }
    [data-variant-current="B"] .hobby-1 .hobby-media {
        width: auto;
        height: 13rem;
        border: 0;
        border-radius: 0;
        background: none;
        box-shadow: none;
    }
    [data-variant-current="B"] .hobby-img { height: 100%; }
    [data-variant-current="B"] .hobby-icon { font-size: 3.2rem; }
    [data-variant-current="B"] .hobby-title {
        font-size: clamp(2rem, 4.6vw, 4rem);
        letter-spacing: -0.02em;
    }
    [data-variant-current="B"] .hobby-note {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.15rem 0.6rem;
        border-radius: 0.4rem;
        font-size: 1.05rem;
        color: #fffdf8;
        background: #494949;
        opacity: 1;
    }

    /* ================= C：便当格，大小不一的格子，游戏占左边一整块，长跑那格反色 ================= */
    .hobbies[data-variant-current="C"] {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        grid-template-rows: auto auto;
        gap: 1.1rem;
    }
    [data-variant-current="C"] .hobby {
        display: flex;
        border: 3px solid currentColor;
        border-radius: 1.4rem;
        overflow: hidden;
        background: #fffdf8;
    }
    [data-variant-current="C"] .hobby-1 {
        grid-row: span 2;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.8rem;
    }
    [data-variant-current="C"] .hobby-1 .hobby-media { justify-content: flex-end; height: 15rem; }
    [data-variant-current="C"] .hobby-1 .hobby-img { height: 100%; }
    [data-variant-current="C"] .hobby-1 .hobby-title { font-size: clamp(2rem, 3.6vw, 3.2rem); }
    [data-variant-current="C"] .hobby-2,
    [data-variant-current="C"] .hobby-3 {
        align-items: center;
        gap: 1.2rem;
        padding: 1.4rem 1.6rem;
    }
    [data-variant-current="C"] .hobby-2 .hobby-media,
    [data-variant-current="C"] .hobby-3 .hobby-media { flex: none; width: 5rem; }
    [data-variant-current="C"] .hobby-2 .hobby-icon,
    [data-variant-current="C"] .hobby-3 .hobby-icon { font-size: 3.4rem; }
    [data-variant-current="C"] .hobby-3 { background: #494949; color: #fffdf8; border-color: #494949; }
    [data-variant-current="C"] .hobby-2 { rotate: 1.2deg; }
    [data-variant-current="C"] .hobby-title { font-size: clamp(1.4rem, 2.3vw, 2rem); }
    [data-variant-current="C"] .hobby-note { font-size: 0.95rem; margin-top: 0.3rem; }


    /* ================= D：海报。B 的大字错落再放开：人物很大，各条大幅左右错开、互相咬合
       ================= */
    .hobbies[data-variant-current="D"] {
        position: relative;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        padding: 2rem 0 3rem;
    }
    [data-variant-current="D"] .hobby {
        display: flex;
        align-items: flex-end;
        gap: 1.2rem;
    }
    [data-variant-current="D"] .hobby-media,
    [data-variant-current="D"] .hobby-text { position: relative; z-index: 1; }
    [data-variant-current="D"] .hobby-title {
        font-size: clamp(2.4rem, 5.4vw, 5rem);
        line-height: 1;
        letter-spacing: -0.03em;
    }
    [data-variant-current="D"] .hobby-notes {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5rem 0.6rem;
        margin-top: 0.8rem;
    }
    [data-variant-current="D"] .hobby-2 .hobby-notes,
    [data-variant-current="D"] .hobby-4 .hobby-notes { justify-content: flex-end; }
    [data-variant-current="D"] .hobby-note:nth-child(2) { rotate: 2.5deg; translate: 0 0.2rem; }
    [data-variant-current="D"] .hobby-note:nth-child(3) { rotate: -1.5deg; }
    [data-variant-current="D"] .hobby-note {
        display: inline-block;
        padding: 0.25rem 0.7rem;
        border-radius: 0.3rem;
        font-size: 1.05rem;
        color: #fffdf8;
        background: #494949;
        opacity: 1;
    }

    /* 01 游戏：左边，大人物站着，标题压在人物右侧脚边 */
    [data-variant-current="D"] .hobby-1 { grid-column: 1 / 10; }
    [data-variant-current="D"] .hobby-1 .hobby-media { height: clamp(18rem, 32vw, 30rem); }
    [data-variant-current="D"] .hobby-1 .hobby-img { height: 100%; }
    [data-variant-current="D"] .hobby-1 .hobby-text { margin-left: -1.5rem; padding-bottom: 2.5rem; }
    [data-variant-current="D"] .hobby-1 .hobby-note:first-child { rotate: -3deg; }

    /* 02 二次元：右边，往上咬进第一条的空白，大圆 + 右对齐，整体微微倾斜 */
    [data-variant-current="D"] .hobby-2 {
        grid-column: 6 / 13;
        margin-top: -1rem;
        flex-direction: row-reverse;
        align-items: center;
        text-align: right;
        rotate: -2deg;
    }
    [data-variant-current="D"] .hobby-2 .hobby-media {
        flex: none;
        width: clamp(9rem, 14vw, 13rem);
        height: clamp(9rem, 14vw, 13rem);
        border-radius: 999px;
        border: 4px solid currentColor;
        background: #fffdf8;
        box-shadow: 8px 8px 0 currentColor;
    }
    [data-variant-current="D"] .hobby-2 .hobby-icon { font-size: clamp(3.5rem, 5.5vw, 5rem); }

    /* 04 烹饪：再甩到右边，圆形徽章，和 02 呼应 */
    [data-variant-current="D"] .hobby-4 {
        grid-column: 5 / 13;
        margin-top: 3rem;
        flex-direction: row-reverse;
        align-items: center;
        text-align: right;
        rotate: 1.5deg;
    }
    [data-variant-current="D"] .hobby-4 .hobby-media {
        flex: none;
        width: clamp(8rem, 12vw, 11rem);
        height: clamp(8rem, 12vw, 11rem);
        border-radius: 999px;
        border: 4px solid currentColor;
        background: #fffdf8;
        box-shadow: 8px 8px 0 currentColor;
    }
    [data-variant-current="D"] .hobby-4 .hobby-icon { font-size: clamp(3.2rem, 5vw, 4.6rem); }
    [data-variant-current="D"] .hobby-4 .hobby-note:first-child { rotate: -2deg; }
    [data-variant-current="D"] .hobby-4.has-image { rotate: 0deg; align-items: flex-end; }

    /* 有配图的条目：插画放大显示，不套圆形 / 方块框 */
    [data-variant-current="D"] .has-image .hobby-media {
        width: auto;
        height: clamp(16rem, 28vw, 26rem);
        border: 0;
        border-radius: 0;
        background: none;
        box-shadow: none;
        rotate: 0deg;
    }
    [data-variant-current="D"] .has-image .hobby-img { height: 100%; }
    [data-variant-current="D"] .hobby-2.has-image { grid-column: 3 / 13; rotate: 0deg; align-items: flex-end; }
    [data-variant-current="D"] .has-image .hobby-title { white-space: nowrap; }
    [data-variant-current="D"] .hobby-2.has-image .hobby-text { margin-right: -1.5rem; padding-bottom: 2rem; rotate: -2deg; }

    /* 03 长跑：回到左侧但往里缩，方形徽章斜放 */
    [data-variant-current="D"] .hobby-3 {
        grid-column: 2 / 11;
        margin-top: 3rem;
        align-items: center;
    }
    [data-variant-current="D"] .hobby-3 .hobby-media {
        flex: none;
        width: clamp(8rem, 12vw, 11rem);
        height: clamp(8rem, 12vw, 11rem);
        border: 4px solid currentColor;
        border-radius: 1.4rem;
        background: #494949;
        color: #fffdf8;
        rotate: 8deg;
        box-shadow: 8px 8px 0 rgb(73 73 73 / 0.35);
    }
    [data-variant-current="D"] .hobby-3 .hobby-icon { font-size: clamp(3.2rem, 5vw, 4.6rem); opacity: 1; }
    [data-variant-current="D"] .hobby-3 .hobby-note:first-child { rotate: 2deg; }

    /* 手机：三版都改成一列，保留各自的风格 */
    @media (max-width: 639px) {
        .hobbies[data-variant-current="A"] { grid-template-columns: 1fr; gap: 2.4rem; padding-top: 3.5rem; }
        [data-variant-current="A"] .hobby-2 { margin-top: 0; }
        [data-variant-current="B"] .hobby { max-width: 100%; }
        [data-variant-current="B"] .hobby-3 { margin-left: 0; }
        [data-variant-current="B"] .hobby-media { width: 5rem; height: 5rem; }
        [data-variant-current="B"] .hobby-1 .hobby-media { height: 9rem; }
        .hobbies[data-variant-current="C"] { grid-template-columns: 1fr; }
        [data-variant-current="C"] .hobby-1 { grid-row: auto; }
        .hobbies[data-variant-current="D"] { display: flex; flex-direction: column; gap: 3rem; }
        [data-variant-current="D"] .hobby { flex-direction: column; align-items: center; text-align: center; }
        [data-variant-current="D"] .hobby-2 { margin-top: 0; flex-direction: column; text-align: center; }
        [data-variant-current="D"] .hobby-3,
        [data-variant-current="D"] .hobby-4 { margin-top: 0; }
        [data-variant-current="D"] .hobby-4 { flex-direction: column; text-align: center; }
        [data-variant-current="D"] .hobby-1 .hobby-text { margin-left: 0; padding-bottom: 0; }
        }

    .cta-box {
        box-shadow: 6px 6px 0px currentColor;
        transition: transform 0.1s ease-in-out, box-shadow 0.1s ease-in-out;
    }
    .cta-box:hover {
        transform: translate(3px, 3px);
        box-shadow: 3px 3px 0px currentColor;
    }
    .cta-box:active {
        transform: translate(6px, 6px);
        box-shadow: 0px 0px 0px currentColor;
    }
</style>
