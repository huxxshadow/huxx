---
import { useTranslations, type Lang } from "@/i18n";
import { COLORS } from "@/consts";
import Avatar from "@/assets/avater.svg";

import {
    dndLabels,
    characterCardData,
    equipmentListData,
    traitListData,
    skillsLeftData,
    skillsRightData,
    spellBookData,
    mainQuestData,
    sideQuestsData,
    timelineData,
} from "@/i18n/components/aboutme/DndAboutSection_i18";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

// ---- Flatten i18n data for template ----
const character = {
    name: characterCardData.name,
    alignment: t(characterCardData.alignment),
    race: t(characterCardData.race),
    stats: characterCardData.stats.map((s) => ({
        label: s.label,
        value: s.value,
        modifier: s.modifier,
        name: t(s.name),
    })),
    classes: characterCardData.classes.map((c) => ({
        name: t(c.name),
        level: c.level,
        progress: c.progress,
    })),
    hobbies: t(characterCardData.hobbies),
    likes: t(characterCardData.likes),
    favMusic: characterCardData.favMusic.map((m) => t(m)),
    favAnime: characterCardData.favAnime.map((a) => t(a)),
    personalityTitle: t(characterCardData.personalityTitle),
    personalityDesc1: t(characterCardData.personalityDesc1),
    personalityDesc2: t(characterCardData.personalityDesc2),
    quote: t(characterCardData.quote),
};

const equipments = equipmentListData.map((eq) => ({
    icon: eq.icon,
    col: eq.col,
    mt: eq.mt,
    name: t(eq.name),
    rarity: t(eq.rarity),
    stats: t(eq.stats),
    flavor: t(eq.flavor),
}));

const traits = traitListData.map((tr) => ({
    icon: tr.icon,
    name: t(tr.name),
    description: t(tr.description),
}));

const skillsLeft = skillsLeftData.map((s) => ({ modifier: s.modifier, name: t(s.name) }));
const skillsRight = skillsRightData.map((s) => ({ modifier: s.modifier, name: t(s.name) }));
const spellBook = spellBookData.map((lvl) => ({
    label: t(lvl.label),
    totalSlots: lvl.totalSlots,
    filledSlots: lvl.filledSlots,
    spells: lvl.spells.map((sp) => ({
        icon: sp.icon,
        name: sp.name,
        subtitle: t(sp.subtitle),
    })),
}));

const mainQuest = {
    icon: mainQuestData.icon,
    title: t(mainQuestData.title),
    description: t(mainQuestData.description),
    progress: mainQuestData.progress,
};

const sideQuests = sideQuestsData.map((sq) => ({
    icon: sq.icon,
    title: t(sq.title),
    progress: sq.progress,
}));

const timeline = timelineData.map((entry) => ({
    year: entry.year,
    title: t(entry.title),
    description: t(entry.description),
    isNow: entry.isNow ?? false,
}));
const classNameSize = (locale === "en" || locale === "ja") ? "text-sm" : "text-lg";
// ---- Layout helpers (not i18n) ----
function tooltipPos(col: number): string {
    if (col <= 1) return "left-0";
    if (col >= 5) return "right-0";
    return "left-1/2 -translate-x-1/2";
}

const colStartClass: Record<number, string> = {
    1: "col-start-1",
    2: "col-start-2",
    3: "col-start-3",
    4: "col-start-4",
    5: "col-start-5",
};

const showSpellSubtitle = locale !== "en";
---

<section
        class="relative overflow-hidden w-full px-4 sm:px-6 pt-8 pb-48  flex flex-col"
        style={`background-color: ${COLORS.red.light}; color: ${COLORS.red.dark};`}
        data-theme-bg={COLORS.red.light}
        data-theme-text={COLORS.red.dark}
>


    <div class="flex flex-col px-8 lg:flex-row w-full">
        <!-- ========== Column 1: Character Card ========== -->
        <div class="relative z-10 w-full lg:w-2/6 flex flex-col  pr-0 lg:pr-6 mb-8 lg:mb-0">

            <div class="flex flex-col lg:flex-row gap-4 lg:min-h-[380px] lg:flex-shrink-0">

                <div class="dnd-card w-full lg:w-[300px] relative flex flex-col rounded-xl overflow-hidden border-2 border-current  shadow-[3px_3px_0px_currentColor]">
                    <div class="w-full text-center pt-4 pb-2">
                        <span class="text-5xl lg:text-5xl font-black opacity-90">{character.name}</span>
                    </div>
                    <div class="flex-1 w-full flex items-center justify-center relative">
                        <Avatar class="w-full h-auto opacity-70 block drop-shadow-md" fill="currentColor" />
                    </div>
                </div>

                <div class="flex-1 min-w-0 flex flex-col lg:h-full justify-between py-1">

                    <div class="w-full text-center pb-2 border-b-3 border-current mb-3">
                        <span class="text-2xl font-black tracking-widest opacity-90">{character.alignment}</span>
                    </div>

                    <div class="flex-1 flex flex-col mb-3">
                        <div class="flex items-center justify-center gap-2 mb-2 text-xl font-black opacity-80">
                            <i class="fa-solid fa-mars"></i>
                            <span>{character.race}</span>
                        </div>

                        <div class="bg-current/5 rounded-md  p-2">
                            <table class="w-full text-left text-base ">
                                <tbody class="divide-y divide-current/10">
                                {character.stats.map((stat) => (
                                        <tr class="hover:bg-current/10 transition-colors">
                                            <td class="py-1 font-black opacity-70">
                                                {stat.label}
                                                {stat.name && (
                                                        <span class="text-sm font-bold opacity-80 ml-1">{stat.name}</span>
                                                )}
                                            </td>
                                            <td class="font-black text-center">{stat.value}</td>
                                            <td class="text-right font-black">{stat.modifier}</td>
                                        </tr>
                                ))}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2 pt-3 border-current/20">
                        <div class="flex flex-col gap-4 w-full pr-4">
                            {character.classes.map((cls) => (
                                    <div class="flex flex-col gap-1.5">
                                        <div class="flex justify-between items-end gap-2 ">
                                            <span class:list={[classNameSize, "font-black leading-none whitespace-nowrap"]}>{cls.name}</span>
                                            <span class="text-sm font-black opacity-70 tracking-widest flex-shrink-0">{cls.level}</span>
                                        </div>
                                        <div class="w-full h-1.5  bg-current/10 rounded-full overflow-hidden">
                                            <div class="h-full bg-current opacity-70" style={`width: ${cls.progress}%;`}></div>
                                        </div>
                                    </div>
                            ))}
                        </div>
                    </div>

                </div>
            </div>

            <div class="dnd-card mt-6 lg:flex-1 border-2 border-current  shadow-[3px_3px_0px_currentColor]  rounded-xl  p-5 flex flex-col gap-4">

                <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-1.5">
                            <i class="fa-solid fa-dice-d20 text-xs opacity-60"></i>
                            <span class="text-sm font-black uppercase tracking-widest opacity-70">{t(dndLabels.hobbiesLabel)}</span>
                        </div>
                        <span class="text-base font-bold leading-tight opacity-90 pl-1">{character.hobbies}</span>
                    </div>

                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-1.5">
                            <i class="fa-solid fa-heart text-xs opacity-70"></i>
                            <span class="text-sm font-black uppercase tracking-widest opacity-60">{t(dndLabels.likesLabel)}</span>
                        </div>
                        <span class="text-base font-bold leading-tight opacity-90 pl-1">{character.likes}</span>
                    </div>
                </div>


                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-headphones text-xs opacity-60"></i>
                        <span class="text-sm font-black uppercase tracking-widest opacity-60">{t(dndLabels.favMusicLabel)}</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 mt-0.5 pl-1 opacity-90">
                        {character.favMusic.map((m) => (
                                <span class="text-base font-bold underline decoration-current/30 underline-offset-4">{m}</span>
                        ))}
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-tv text-xs opacity-60"></i>
                        <span class="text-sm font-black uppercase tracking-widest opacity-60">{t(dndLabels.favAnimeLabel)}</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 mt-0.5 pl-1 opacity-90">
                        {character.favAnime.map((a) => (
                                <span class="text-base font-bold underline decoration-current/30 underline-offset-4">{a}</span>
                        ))}
                    </div>
                </div>

            </div>

            <div class="dnd-card lg:flex-1 mt-6 border-2 border-current  shadow-[3px_3px_0px_currentColor] rounded-xl  p-5 flex flex-col gap-4">
                <div class="flex  flex-col gap-1">
                    <p class="text-lg font-black leading-tight pl-1">
                        {character.personalityTitle}
                    </p>
                    <p class="text-base font-bold leading-relaxed opacity-80 pl-1 mt-1">{character.personalityDesc1}</p>
                    <p class="text-sm leading-relaxed  opacity-80 pl-1">{character.personalityDesc2}</p>
                </div>

                <div class="h-px w-full bg-current/10"></div>

                <div class="flex flex-col gap-1">
                    <p class="text-sm italic font-medium leading-relaxed   py-0.5 opacity-90">
                        {character.quote}
                    </p>
                </div>
            </div>

        </div>

        <!-- ========== Column 2: Equipment + Traits ========== -->
        <div class="relative z-10 w-full lg:w-5/24 flex flex-col pl-0 lg:pl-10 pt-8 lg:pt-0">


            <h3 class="text-xl font-bold mb-4 hidden lg:flex items-center gap-2 opacity-90">
                <i class="fa-solid fa-crosshairs"></i> {t(dndLabels.equipmentHeader)}
            </h3>

            <div class="flex-1  p-4 mb-6  relative hidden lg:flex flex-col">
                <div class="flex-1 grid grid-cols-5 gap-y-3 gap-x-2 relative z-10" style="grid-auto-rows: 1fr;">
                    {equipments.map((eq) => (
                            <div class:list={[
                                colStartClass[eq.col],
                                eq.mt && "translate-y-4",
                                "group relative hover:z-50"
                            ]}>
                                <div class="relative w-full h-full shadow-[1px_1px_0px_currentColor] border-2 border-current rounded flex items-center justify-center hover:bg-current/10 hover:border-current/60 transition-all cursor-help">
                                    <i class:list={[eq.icon, "text-lg opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all"]} />

                                    <div
                                            class:list={[
                                                "absolute top-full mt-2 w-max p-2.5 rounded-lg border-2 border-current/30 shadow-md",
                                                "opacity-0 group-hover:opacity-100 pointer-events-none transition-all z-50 group-hover:translate-y-1",
                                                tooltipPos(eq.col),
                                            ]}
                                            style={`background-color: ${COLORS.white};`}
                                    >
                                        <div class="h-0.5 w-full bg-current/60 rounded-full mb-2" />
                                        <p class="font-bold text-base whitespace-nowrap">{eq.name}</p>
                                        <p class="text-sm opacity-50 mb-1.5">{eq.rarity}</p>
                                        <p class="text-sm opacity-70 max-w-60">{eq.stats}</p>
                                        <p class="text-xs italic opacity-50 mt-1.5 leading-relaxed max-w-60">{eq.flavor}</p>
                                    </div>
                                </div>
                            </div>
                    ))}
                </div>
            </div>

            <h3 class="text-xl font-black mb-4 flex items-center gap-2 opacity-90">
                <i class="fa-solid fa-wand-magic-sparkles"></i> {t(dndLabels.traitsHeader)}
            </h3>

            <div class="flex flex-col gap-4">
                {traits.map((trait) => (
                        <div class="dnd-card border-2 border-current  shadow-[3px_3px_0px_currentColor] rounded-xl p-4 flex items-start gap-3 group">
                            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-current/10 flex items-center justify-center group-hover:bg-current/20 transition-colors">
                                <i class:list={[trait.icon, "text-xl"]} />
                            </div>
                            <div class="flex flex-col">
                                <span class="font-black text-base leading-none mb-1.5">{trait.name}</span>
                                <p class="text-sm opacity-70 leading-relaxed">{trait.description}</p>
                            </div>
                        </div>
                ))}
            </div>

        </div>

        <!-- ========== Column 3: Feats + Skills + Spell Book ========== -->
        <div class="relative z-10 w-full lg:w-7/24 flex flex-col gap-6 pl-0 lg:pl-10 pt-8 lg:pt-0">

            <!-- Feats Table -->
            <div class="flex flex-col">
                <h3 class="text-xl font-black mb-4 flex items-center gap-2 opacity-90">
                    <i class="fa-solid fa-dice-d20"></i> {t(dndLabels.featsHeader)}
                </h3>
                <div class="dnd-card flex border-2 border-current  shadow-[3px_3px_0px_currentColor] rounded-xl overflow-hidden">
                    <table class="w-1/2 text-left text-sm font-bold">
                        <tbody class="divide-y-2 divide-current">
                        {skillsLeft.map((s) => (
                                <tr>
                                    <td class="py-2.5 pl-4 pr-2 font-black text-base w-12 text-right">{s.modifier}</td>
                                    <td class="py-2.5 px-2">{s.name}</td>
                                </tr>
                        ))}
                        </tbody>
                    </table>

                    <div class="border-l-2 border-current"></div>

                    <table class="w-1/2 text-left text-sm font-bold">
                        <tbody class="divide-y-2 divide-current">
                        {skillsRight.map((s) => (
                                <tr>
                                    <td class="py-2.5 pl-4 pr-2 font-black text-base w-12 text-right">{s.modifier}</td>
                                    <td class="py-2.5 px-2">{s.name}</td>
                                </tr>
                        ))}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="flex flex-col flex-1">
                <h3 class="text-xl font-black mb-4 flex items-center gap-2 opacity-90">
                    <i class="fa-solid fa-wand-sparkles"></i> {t(dndLabels.grimoireHeader)}
                </h3>

                <div class="flex-1 flex flex-col gap-4">
                    {spellBook.map((level) => (
                            <div class="flex flex-col gap-2"> <div class="dnd-card flex items-center justify-between px-3 py-2 border-2 border-current  shadow-[3px_3px_0px_currentColor] rounded-lg relative z-10">
                                <div class="flex items-center gap-2 min-w-0">
                            <span class="text-[10px] font-black uppercase tracking-widest opacity-50 whitespace-nowrap">
                                {t(dndLabels.spellLabel)}
                            </span>
                                    <span class="text-sm font-black opacity-90 truncate">
                                ▸ {level.label}
                            </span>
                                </div>

                                {level.totalSlots > 0 && (
                                        <div class="flex items-center gap-1.5 flex-shrink-0">
                                    <span class="text-[10px] font-black uppercase tracking-widest opacity-40 whitespace-nowrap">
                                        {t(dndLabels.slotsLabel)}
                                    </span>
                                            <span class="inline-flex gap-1">
                                        {Array.from({ length: level.totalSlots }).map((_, i) => (
                                                <span
                                                        class:list={[
                                                            "w-2 h-2 rounded-full bg-current inline-block",
                                                            i < level.filledSlots ? "opacity-70" : "opacity-20",
                                                        ]}
                                                ></span>
                                        ))}
                                    </span>
                                        </div>
                                )}
                            </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 ml-2 sm:ml-3">
                                    {level.spells.map((sp) => (
                                            <div class=" flex items-center gap-2  py-2 hover:bg-current/10 transition-colors min-w-0">

                                                <div class="flex-shrink-0 w-5 h-5 rounded bg-current/10 flex items-center justify-center">
                                                    <i class:list={[sp.icon, "text-[10px] opacity-70"]} />
                                                </div>

                                                <div class="min-w-0 flex-1 truncate leading-none">
                                                    <span class="text-sm font-black opacity-90">{sp.name}</span>
                                                    {showSpellSubtitle && (
                                                            <span class="text-xs font-normal opacity-60 ml-1">
                                                    {sp.subtitle}
                                                </span>
                                                    )}
                                                </div>

                                            </div>
                                    ))}
                                </div>

                            </div>
                    ))}
                </div>
            </div>

        </div>

        <!-- ========== Column 4: Quest Log + Timeline ========== -->
        <div class="relative z-10 w-full lg:w-4/24 flex flex-col gap-6 border-t lg:border-t-0 border-current/20 pt-8 lg:pt-0 lg:pl-8">

            <!-- Quest Log -->
            <div class="flex flex-col gap-3">
                <h3 class="text-xl font-black flex items-center gap-2 opacity-90">
                    <i class="fa-solid fa-list-check"></i> {t(dndLabels.questsHeader)}
                </h3>

                <!-- Main Quest -->
                <div class="dnd-card border-2 border-current  shadow-[3px_3px_0px_currentColor] rounded-lg px-4 py-3 flex flex-col gap-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i class:list={[mainQuest.icon, "text-xs opacity-50"]}></i>
                            <span class="font-black text-base">{mainQuest.title}</span>
                        </div>
                        <span class="text-base font-black opacity-60 border border-current/20 px-1.5 py-0.5 rounded">{t(dndLabels.mainQuestTag)}</span>
                    </div>
                    <p class="text-sm opacity-70 leading-relaxed">{mainQuest.description}</p>
                    <div class="flex items-center gap-2">
                        <div class="flex-1 bg-current/10 rounded-full h-1.5 overflow-hidden">
                            <div class="bg-current font-bold h-full rounded-full opacity-80" style={`width: ${mainQuest.progress}%`}></div>
                        </div>
                        <span class="text-xs font-black opacity-60">{mainQuest.progress}%</span>
                    </div>
                </div>

                <!-- Side Quests -->
                {sideQuests.map((sq) => (
                        <div class="dnd-card border-2 border-current shadow-[3px_3px_0px_currentColor] rounded-lg px-4 py-3 flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <i class:list={[sq.icon, "text-xs opacity-50"]}></i>
                                    <span class="font-bold text-sm">{sq.title}</span>
                                </div>
                                <span class="text-xs font-black opacity-60">{sq.progress}%</span>
                            </div>
                        </div>
                ))}
            </div>

            <div class="flex flex-col gap-4 mt-2">
                <h3 class="text-xl font-black flex items-center gap-2 opacity-90">
                    <i class="fa-solid fa-scroll"></i> {t(dndLabels.adventureHeader)}
                </h3>

                <div class="flex flex-col gap-4">
                    {timeline.map((entry) => (
                            <div class="flex items-start gap-3 relative group">
                                <div class:list={[
                                    "w-1.5 rounded-full flex-shrink-0 h-full absolute left-0 top-0 bottom-0",
                                    entry.isNow ? "bg-current animate-pulse" : "bg-current/20 group-hover:bg-current/50 transition-colors"
                                ]}></div>

                                <div class="flex flex-col pl-4 w-full">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-xs font-black tracking-widest opacity-50 uppercase">{entry.year}</span>
                                        <div class="h-px bg-current/20 flex-1"></div>
                                    </div>

                                    <p class="text-base font-bold leading-tight">
                                        {entry.title}
                                    </p>
                                    <p class="text-sm opacity-70 leading-relaxed mt-1">{entry.description}</p>
                                </div>
                            </div>
                    ))}
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .dnd-card {
        transition: transform 0.1s ease-in-out, box-shadow 0.1s ease-in-out;
    }
    .dnd-card:hover {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0px currentColor !important;
    }
    .dnd-card:active {
        transform: translate(3px, 3px);
        box-shadow: 0px 0px 0px currentColor !important;
    }
</style>