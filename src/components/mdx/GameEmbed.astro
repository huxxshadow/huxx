---
// 项目页内嵌可玩的 Web 版游戏（public/games/ 下的单文件构建）。
// 默认进入页面就开始加载：先用 fetch 流式下载游戏的 index.html，按「已收到字节 / 构建时量出的文件大小」显示进度，
// 下完直接用这份内容生成 blob 页面放进 iframe（插一个 <base> 让音频等相对路径照常指向原目录），不用再下载第二遍。
// 手机、省流量模式下不自动下载（整包几十 MB），显示一个「加载」按钮，点了再走同一套流程。
import fs from "node:fs";
import path from "node:path";
import type { Lang } from "@/i18n";

interface Props {
    /** public 目录下的路径，例如 /games/night-watch/index.html */
    src: string;
    title: string;
    /** 游戏按这个「虚拟窗口」尺寸排版，再整体缩放到内嵌框的宽度（游戏按真实窗口大小自适应，窗口太小会挤在一起）。默认 1600 × 900 */
    width?: number;
    height?: number;
}
const { src, title, width = 1600, height = 900 } = Astro.props;
const lang = (Astro.currentLocale as Lang) || "en";

// 构建时量出文件大小，作为进度的分母（服务器可能压缩传输，Content-Length 不可靠）
let bytes = 0;
try {
    bytes = fs.statSync(path.join(process.cwd(), "public", decodeURIComponent(src))).size;
} catch {}
const mb = (bytes / 1024 / 1024).toFixed(1);

const L = {
    loading: { zh: "正在加载游戏", en: "Loading the game", ja: "ゲームを読み込み中", ko: "게임 불러오는 중" },
    starting: { zh: "正在启动…", en: "Starting…", ja: "起動中…", ko: "시작하는 중…" },
    load: { zh: `加载游戏（约 ${mb} MB）`, en: `Load the game (~${mb} MB)`, ja: `ゲームを読み込む（約 ${mb} MB）`, ko: `게임 불러오기 (약 ${mb} MB)` },
    failed: { zh: "下载失败，点这里直接打开", en: "Download failed, click to open directly", ja: "読み込みに失敗しました。ここから直接開く", ko: "불러오기에 실패했습니다. 여기서 바로 열기" },
    fullscreen: { zh: "全屏", en: "Fullscreen", ja: "全画面", ko: "전체 화면" },
    newTab: { zh: "新标签页打开", en: "Open in new tab", ja: "新しいタブで開く", ko: "새 탭에서 열기" },
} as const;
const tr = (k: keyof typeof L) => L[k][lang] ?? L[k].en;
---

<div class="game-embed" data-game-embed data-src={src} data-bytes={bytes} style={`--vw: ${width}; --vh: ${height};`}>
    <div class="game-embed-frame">
        <iframe title={title} allow="fullscreen; autoplay" allowfullscreen loading="eager"></iframe>
        <div class="game-embed-overlay" data-overlay>
            <p class="game-embed-title">{title}</p>
            <div class="game-embed-progress" data-progress hidden>
                <div class="game-embed-bar"><span data-bar></span></div>
                <p class="game-embed-status">
                    <span data-label>{tr("loading")}</span>
                    <span data-pct>0%</span>
                    <span class="game-embed-bytes" data-bytes-text>0 / {mb} MB</span>
                </p>
            </div>
            <button type="button" class="game-embed-button" data-start hidden>{tr("load")}</button>
            <a class="game-embed-button" data-fallback href={src} target="_blank" rel="noopener" hidden>{tr("failed")}</a>
        </div>
    </div>
    <div class="game-embed-tools">
        <button type="button" data-fullscreen><i class="fa-solid fa-expand"></i> {tr("fullscreen")}</button>
        <a href={src} target="_blank" rel="noopener"><i class="fa-solid fa-link"></i> {tr("newTab")}</a>
    </div>
    <template data-i18n-starting>{tr("starting")}</template>
</div>

<script>
    function initGameEmbeds() {
        document.querySelectorAll<HTMLElement>("[data-game-embed]").forEach((root) => {
            if (root.dataset.ready) return;
            root.dataset.ready = "1";
            const src = root.dataset.src!;
            const total = Number(root.dataset.bytes) || 0;
            const iframe = root.querySelector("iframe")!;
            const overlay = root.querySelector<HTMLElement>("[data-overlay]")!;
            const progress = root.querySelector<HTMLElement>("[data-progress]")!;
            const bar = root.querySelector<HTMLElement>("[data-bar]")!;
            const pct = root.querySelector<HTMLElement>("[data-pct]")!;
            const bytesText = root.querySelector<HTMLElement>("[data-bytes-text]")!;
            const label = root.querySelector<HTMLElement>("[data-label]")!;
            const startBtn = root.querySelector<HTMLButtonElement>("[data-start]")!;
            const fallback = root.querySelector<HTMLElement>("[data-fallback]")!;
            const starting = root.querySelector<HTMLTemplateElement>("[data-i18n-starting]")?.content.textContent ?? "";
            const totalMb = (total / 1024 / 1024).toFixed(1);

            const show = (received: number) => {
                const p = total ? Math.min(1, received / total) : 0;
                bar.style.width = (p * 100).toFixed(1) + "%";
                pct.textContent = Math.round(p * 100) + "%";
                bytesText.textContent = `${(received / 1024 / 1024).toFixed(1)} / ${totalMb} MB`;
            };
            let blobUrl = "";
            const open = async (chunks: Uint8Array[]) => {
                label.textContent = starting;
                iframe.addEventListener("load", () => overlay.classList.add("is-done"), { once: true });
                // blob 页面和本站同源（localStorage 照常可用）；<base> 指回游戏目录，相对路径不受影响
                const base = new URL(src, location.href);
                base.pathname = base.pathname.replace(/[^/]*$/, "");
                const html = (await new Blob(chunks).text()).replace(/<head([^>]*)>/i, `<head$1><base href="${base.href}">`);
                blobUrl = URL.createObjectURL(new Blob([html], { type: "text/html" }));
                iframe.src = blobUrl;
            };
            document.addEventListener("astro:before-swap", () => { if (blobUrl) URL.revokeObjectURL(blobUrl); }, { once: true });
            const load = async () => {
                startBtn.hidden = true;
                progress.hidden = false;
                try {
                    const res = await fetch(src, { cache: "force-cache" });
                    if (!res.ok || !res.body) throw new Error(String(res.status));
                    const reader = res.body.getReader();
                    const chunks: Uint8Array[] = [];
                    let received = 0;
                    for (;;) {
                        const { done, value } = await reader.read();
                        if (done) break;
                        chunks.push(value);
                        received += value.byteLength;
                        show(received);
                    }
                    show(total || received);
                    await open(chunks);
                } catch {
                    progress.hidden = true;
                    fallback.hidden = false;
                }
            };

            // 手机或开了省流量：不自动下载，等点击
            const saveData = (navigator as any).connection?.saveData === true;
            const small = window.matchMedia("(max-width: 767px)").matches;
            if (saveData || small) {
                startBtn.hidden = false;
                startBtn.addEventListener("click", load, { once: true });
            } else {
                load();
            }

            // 游戏在固定的虚拟窗口里排版，按框的宽度整体缩放
            const frame = root.querySelector<HTMLElement>(".game-embed-frame")!;
            const vw = parseFloat(getComputedStyle(root).getPropertyValue("--vw")) || 1600;
            const fit = () => root.style.setProperty("--s", String(frame.clientWidth / vw));
            new ResizeObserver(fit).observe(frame);
            fit();

            root.querySelector<HTMLButtonElement>("[data-fullscreen]")?.addEventListener("click", () => {
                const el = root.querySelector<HTMLElement>(".game-embed-frame")!;
                if (document.fullscreenElement) document.exitFullscreen();
                else el.requestFullscreen?.().catch(() => {});
            });
        });
    }
    document.addEventListener("astro:page-load", initGameEmbeds);
</script>

<style>
    .game-embed {
        margin: 2rem 0 2.5rem;
    }
    .game-embed-frame {
        position: relative;
        aspect-ratio: var(--vw) / var(--vh);
        overflow: hidden;
        border: 2px solid var(--theme-text);
        border-radius: 0.75rem;
        background-color: #0E0F12;
    }
    .game-embed-frame:fullscreen {
        border: 0;
        border-radius: 0;
        aspect-ratio: auto;
    }
    /* 固定的虚拟窗口尺寸，整体缩放到框的宽度（--s 由脚本按框宽算）；全屏时直接用屏幕大小，不缩放 */
    .game-embed iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: calc(var(--vw) * 1px);
        height: calc(var(--vh) * 1px);
        transform: scale(var(--s, 1));
        transform-origin: 0 0;
        border: 0;
        margin: 0 !important;
    }
    .game-embed-frame:fullscreen iframe {
        width: 100%;
        height: 100%;
        transform: none;
    }
    .game-embed-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.1rem;
        padding: 1.5rem;
        background-color: #0E0F12;
        color: #EFE8D8;
        text-align: center;
        transition: opacity 400ms ease, visibility 0s linear 400ms;
    }
    .game-embed-overlay.is-done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
    .game-embed-title {
        margin: 0 !important;
        font-weight: 900;
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        letter-spacing: 0.04em;
        color: #EFE8D8 !important;
    }
    .game-embed-progress {
        width: min(26rem, 80%);
    }
    .game-embed-bar {
        height: 8px;
        overflow: hidden;
        border-radius: 999px;
        background-color: rgb(239 232 216 / 0.16);
    }
    .game-embed-bar span {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        background-color: #C48828;
        transition: width 150ms linear;
    }
    .game-embed-status {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.6rem 0 0 !important;
        font-size: 0.85rem;
        font-weight: 700;
        color: rgb(239 232 216 / 0.8) !important;
    }
    .game-embed-bytes {
        margin-left: auto;
        opacity: 0.7;
        font-variant-numeric: tabular-nums;
    }
    .game-embed-button {
        padding: 0.6rem 1.3rem;
        border: 2px solid #C48828;
        border-radius: 999px;
        background: transparent;
        color: #EFE8D8 !important;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none !important;
    }
    .game-embed-button:hover {
        background-color: #C48828;
        color: #0E0F12 !important;
    }
    .game-embed-tools {
        display: flex;
        justify-content: flex-end;
        gap: 1.25rem;
        margin-top: 0.6rem;
        font-size: 0.85rem;
        font-weight: 700;
    }
    .game-embed-tools button,
    .game-embed-tools a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: none;
        border: 0;
        padding: 0;
        color: inherit;
        cursor: pointer;
        opacity: 0.75;
        text-decoration: none;
    }
    .game-embed-tools button:hover,
    .game-embed-tools a:hover {
        opacity: 1;
    }
</style>
