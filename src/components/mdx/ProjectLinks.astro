---

export interface LinkItem {
    name: string;
    url: string;
    icon: string; // FontAwesome class, 例如 "fa-brands fa-github" 或 "fa-brands fa-google-drive"
}

interface Props {
    links: LinkItem[];
}

const { links = [] } = Astro.props;

// 站内自带的游戏（/games/...）带上当前页面语言，让游戏进去就是对应语言
const currentLang = Astro.currentLocale ?? "en";
const withLang = (url: string) =>
    url.startsWith("/games/")
        ? `${url}${url.includes("?") ? "&" : "?"}lang=${currentLang}`
        : url;
---

{links.length > 0 && (
<div class="project-links-wrapper">
    {links.map((link) => (
            <a href={withLang(link.url)} class="brutalist-tag brutalist-tag-uppercase">
                <i class={link.icon}></i>
                <span>{link.name}</span>
            </a>
    ))}
</div>
    )}

<style>
    .project-links-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        /* 在 My Contributions 之前留出适当的空间 */
        margin-bottom: 3.5rem;
        margin-top: 1rem;
    }


</style>