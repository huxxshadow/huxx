---
// 版式 B3 · 塔罗：代表作是斜切大图 + 压在图上的白色对话框（P3R 的信息框），首部通栏，其余两部并排；
// 精选是三张竖版塔罗牌（罗马数字编号，扇形摆开），个人项目是一条斜切暗色“队伍栏”
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDesignShowcase } from "./data";
import WorkCover from "./WorkCover.astro";
import P3TierBar from "./P3TierBar.astro";

interface Props {
    showcase: GameDesignShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
const num = (n: number) => String(n).padStart(2, "0");
const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const { featured, selected, solo } = showcase;
const [hero, ...side] = featured;
const selectedStart = featured.length;
const soloStart = featured.length + selected.length;
const fan = [-4, 0, 4];
---

<div>
    <!-- ===== 代表作：大图 + 对话框 ===== -->
    <P3TierBar label={t(labels.tierFeatured)} count={featured.length} />

    {hero && (
            <a href={href(hero.id)} class="s3-feature s3-feature-hero group mb-10" data-reveal="left" data-reveal-once>
                <div class="s3-feature-img">
                    <WorkCover work={hero} lang={lang} sizes="(min-width: 1024px) 65vw, 100vw" />
                    <span class="s3-numeral">{ROMAN[0]}</span>
                </div>
                <div class="s3-box">
                    <span class="s3-kicker">{hero.context} / {hero.role}</span>
                    <h3 class="font-black italic text-3xl lg:text-5xl leading-none tracking-tight">{hero.title}</h3>
                    <p class="text-sm lg:text-base font-bold leading-[1.65]">{hero.line}</p>
                    <ol class="flex flex-col gap-1.5">
                        {hero.highlights.map((h, k) => <li class="s3-hl"><span>{k + 1}</span>{h}</li>)}
                    </ol>
                </div>
            </a>
    )}

    <div class="grid md:grid-cols-2 gap-8 lg:gap-10 mb-16">
        {side.map((work, i) => (
                <a href={href(work.id)} class="s3-feature group" data-reveal="up" data-reveal-once data-reveal-delay={String(120 * i)}>
                    <div class="s3-feature-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 45vw, 100vw" />
                        <span class="s3-numeral">{ROMAN[i + 1]}</span>
                    </div>
                    <div class="s3-box">
                        <span class="s3-kicker">{work.context} / {work.role}</span>
                        <h3 class="font-black italic text-2xl lg:text-3xl leading-none tracking-tight">{work.title}</h3>
                        <p class="text-sm font-bold leading-[1.65]">{work.line}</p>
                        <ol class="flex flex-col gap-1">
                            {work.highlights.map((h, k) => <li class="s3-hl s3-hl-sm"><span>{k + 1}</span>{h}</li>)}
                        </ol>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 精选：塔罗牌 ===== -->
    <P3TierBar label={t(labels.tierSelected)} count={selected.length} />

    <div class="grid md:grid-cols-3 gap-8 lg:gap-12 mb-16 lg:px-12" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
        {selected.map((work, i) => (
                <a href={href(work.id)} class="s3-tarot-wrap group" style={`--fan: ${fan[i % fan.length]}deg;`}>
                    <div class="s3-tarot">
                        <span class="s3-tarot-numeral">{ROMAN[selectedStart + i]}</span>
                        <div class="s3-tarot-img">
                            <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 25vw, 90vw" />
                        </div>
                        <span class="s3-tarot-name">{work.title}</span>
                    </div>
                    <div class="flex flex-col gap-1.5 pt-5 text-center items-center">
                        <span class="s3-kicker s3-kicker-dark">{work.context} / {work.role}</span>
                        <p class="text-sm font-bold leading-[1.65]">{work.line}</p>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 个人项目：队伍栏 ===== -->
    <P3TierBar label={t(labels.tierSolo)} count={solo.length} />

    <div class="s3-roster" data-reveal="left" data-reveal-once>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-5 gap-y-6">
            {solo.map((work, i) => (
                    <a href={href(work.id)} class="s3-member group">
                        <div class="s3-member-img">
                            <WorkCover work={work} lang={lang} sizes="(min-width: 1024px) 16vw, 42vw" />
                        </div>
                        <div class="flex items-baseline gap-2 pt-2">
                            <span class="s3-member-no">{num(soloStart + i + 1)}</span>
                            <h3 class="font-black italic text-base leading-tight">{work.title}</h3>
                        </div>
                        <span class="text-[0.72rem] font-extrabold leading-tight" style="color: var(--gd-accent);">{work.context}</span>
                        <p class="text-[0.75rem] font-semibold leading-snug line-clamp-3 pt-1 opacity-90">{work.line}</p>
                    </a>
            ))}
        </div>
    </div>
</div>

<style>
    /* 代表作：斜切大图，右下角压一个白色对话框 */
    .s3-feature {
        position: relative;
        display: block;
    }
    .s3-feature-hero {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        align-items: center;
    }
    .s3-feature-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gd-ink);
        clip-path: polygon(0 0, 100% 0, 94% 100%, 0 100%);
    }
    .s3-feature-img :global(img) {
        transition: scale 450ms ease;
    }
    .s3-feature:hover .s3-feature-img :global(img) {
        scale: 1.04;
    }
    .s3-numeral {
        position: absolute;
        left: 1.2rem;
        top: 0.6rem;
        z-index: 2;
        font-family: "Times New Roman", Georgia, serif;
        font-weight: 700;
        font-size: clamp(3rem, 5vw, 4.5rem);
        line-height: 1;
        color: var(--gd-paper);
        -webkit-text-stroke: 6px var(--gd-ink);
        paint-order: stroke fill;
    }
    .s3-box {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        padding: 1.4rem 1.6rem 1.5rem;
        background-color: var(--gd-paper);
        border: 3px solid var(--gd-ink);
        box-shadow: 8px 8px 0 var(--gd-accent);
        transform: rotate(-1.5deg);
        transition: transform 220ms ease, box-shadow 220ms ease;
    }
    /* 首部：对话框压进图的右侧 */
    .s3-feature-hero .s3-box {
        margin-left: -5rem;
    }
    /* 其余两部：对话框压在图的右下角 */
    .s3-feature:not(.s3-feature-hero) .s3-box {
        margin: -3.5rem 0 0 12%;
    }
    .s3-feature:hover .s3-box {
        transform: rotate(0deg) translate(-3px, -3px);
        box-shadow: 11px 11px 0 var(--gd-accent);
    }
    .s3-kicker {
        align-self: flex-start;
        padding: 0.12rem 0.9rem 0.12rem 0.6rem;
        background-color: var(--gd-accent);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        clip-path: polygon(0 0, 100% 0, calc(100% - 0.5rem) 100%, 0 100%);
    }
    .s3-kicker-dark {
        align-self: center;
        background-color: var(--gd-ink);
        padding: 0.12rem 0.8rem;
        clip-path: polygon(0.4rem 0, 100% 0, calc(100% - 0.4rem) 100%, 0 100%);
    }
    .s3-hl {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 800;
        font-size: 0.9rem;
    }
    .s3-hl > span {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.35rem;
        height: 1.35rem;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        font-style: italic;
        font-size: 0.75rem;
        font-weight: 900;
        transform: skewX(-10deg);
    }
    .s3-hl-sm {
        font-size: 0.8rem;
    }

    /* 精选：竖版塔罗牌，扇形摆开，悬停扶正并抬起 */
    .s3-tarot-wrap {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 17rem;
        margin: 0 auto;
    }
    .s3-tarot {
        position: relative;
        display: flex;
        flex-direction: column;
        aspect-ratio: 5 / 7;
        padding: 0.7rem;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        box-shadow: 8px 8px 0 color-mix(in srgb, var(--gd-ink) 35%, transparent);
        transform: rotate(var(--fan));
        transition: transform 220ms ease;
    }
    .s3-tarot::before {
        content: "";
        position: absolute;
        inset: 0.35rem;
        border: 2px solid var(--gd-paper);
        pointer-events: none;
        z-index: 2;
    }
    .s3-tarot-wrap:hover .s3-tarot {
        transform: rotate(0deg) translateY(-8px);
    }
    .s3-tarot-numeral {
        align-self: center;
        padding: 0.35rem 0 0.45rem;
        font-family: "Times New Roman", Georgia, serif;
        font-weight: 700;
        font-size: 1.5rem;
        letter-spacing: 0.1em;
        line-height: 1;
    }
    .s3-tarot-img {
        position: relative;
        flex: 1;
        overflow: hidden;
        background-color: var(--gd-ink);
        clip-path: polygon(0 4%, 100% 0, 100% 96%, 0 100%);
    }
    .s3-tarot-name {
        align-self: center;
        margin-top: -0.9rem;
        position: relative;
        z-index: 3;
        max-width: 90%;
        padding: 0.3rem 1.2rem;
        background-color: var(--gd-paper);
        color: var(--gd-ink);
        font-weight: 900;
        font-style: italic;
        font-size: 1.1rem;
        line-height: 1.2;
        text-align: center;
        clip-path: polygon(0.6rem 0, 100% 0, calc(100% - 0.6rem) 100%, 0 100%);
    }
    .s3-tarot-wrap:hover .s3-tarot-name {
        background-color: var(--gd-accent);
        color: var(--gd-paper);
    }

    /* 个人项目：斜切暗色队伍栏 */
    .s3-roster {
        padding: 1.75rem 3.5rem 2rem;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        clip-path: polygon(1.6rem 0, 100% 0, calc(100% - 1.6rem) 100%, 0 100%);
    }
    .s3-member {
        display: flex;
        flex-direction: column;
        transition: transform 180ms ease;
    }
    .s3-member:hover {
        transform: translateY(-4px);
    }
    .s3-member-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gd-paper);
        clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
        transition: clip-path 200ms ease;
    }
    .s3-member:hover .s3-member-img {
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    }
    .s3-member-no {
        font-weight: 900;
        font-style: italic;
        font-size: 1.1rem;
        color: var(--gd-accent);
    }

    @media (max-width: 1023px) {
        .s3-feature-hero {
            grid-template-columns: 1fr;
        }
        .s3-feature-hero .s3-box {
            margin: -3rem 0 0 8%;
        }
    }
    @media (max-width: 767px) {
        .s3-feature .s3-box,
        .s3-feature-hero .s3-box {
            margin: -2rem 0 0 1rem;
        }
        .s3-tarot-wrap {
            max-width: 20rem;
            margin: 0 auto;
        }
        .s3-roster {
            padding: 1.5rem 1.25rem;
            clip-path: none;
        }
    }
</style>
