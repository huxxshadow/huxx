---
// Part 2 · 游戏设计：按分量分三层：代表作放大图，精选中图，个人项目小图。
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { gameDesignLabels as L } from "@/i18n/components/portfolio/GameDesignShowcase_i18";
import { getGameDesignShowcase } from "./data";
import DesignP3 from "./DesignP3.astro";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "game-design")!;
const showcase = await getGameDesignShowcase(lang);

const ink = COLORS.black;
const accent = COLORS.orange.dark;
// 背景用米色（和 Part 1 同一个），橙色只留作强调色
const tint = COLORS.khakiMilan;
const layout = { showcase, lang, labels: L };
---

<section
        id={role.anchor}
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --gd-accent: ${accent}; --gd-tint: ${tint}; --gd-ink: ${ink}; --gd-paper: #FFFDF7;`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 紧凑标题：编号 · 名称，给下面的内容留出一整屏 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-6 lg:mb-8" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="gd-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <div class="flex flex-col pb-1">
                <h2 class="gd-skew font-black leading-none tracking-tight text-4xl lg:text-5xl">{t(role.name)}</h2>
            </div>
        </div>
    </header>

    <DesignP3 {...layout} />
</section>

<style>
    .gd-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }
</style>
