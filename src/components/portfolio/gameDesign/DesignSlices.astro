---
// 版式 B1 · 斜切切片：三部代表作并排切成斜向长条，首部最宽，悬停的那条展开；
// 精选是平行四边形卡片，个人项目是逐级错开的斜切菜单
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDesignShowcase } from "./data";
import WorkCover from "./WorkCover.astro";
import P3TierBar from "./P3TierBar.astro";

interface Props {
    showcase: GameDesignShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
const num = (n: number) => String(n).padStart(2, "0");
const { featured, selected, solo } = showcase;
const selectedStart = featured.length;
const soloStart = featured.length + selected.length;
---

<div>
    <!-- ===== 代表作：斜切长条 ===== -->
    <P3TierBar label={t(labels.tierFeatured)} count={featured.length} />

    <div class="s1-slices mb-16" data-reveal-children="left" data-reveal-once data-reveal-stagger="120">
        {featured.map((work, i) => (
                <a href={href(work.id)} class="s1-slice group" style={`--grow: ${i === 0 ? 1.9 : 1};`}>
                    <div class="s1-slice-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 1024px) 55vw, 100vw" />
                    </div>
                    <span class="s1-no" aria-hidden="true">{num(i + 1)}</span>
                    <div class="s1-slice-info">
                        <span class="s1-kicker">{work.context} / {work.role}</span>
                        <h3 class={`font-black leading-none tracking-tight ${i === 0 ? "text-3xl lg:text-5xl" : "text-2xl lg:text-3xl"}`}>{work.title}</h3>
                        <p class="s1-line text-sm font-bold leading-[1.6]">{work.line}</p>
                        <ul class="flex flex-wrap gap-1.5 pt-1">
                            {work.highlights.map((h) => <li class="s1-chip">{h}</li>)}
                        </ul>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 精选：平行四边形卡片 ===== -->
    <P3TierBar label={t(labels.tierSelected)} count={selected.length} />

    <div class="grid md:grid-cols-3 gap-6 mb-16 md:px-4" data-reveal-children="left" data-reveal-order="columns" data-reveal-once>
        {selected.map((work, i) => (
                <a href={href(work.id)} class="s1-card group">
                    <div class="s1-card-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 30vw, 100vw" />
                        <span class="s1-card-no">{num(selectedStart + i + 1)}</span>
                    </div>
                    <div class="s1-card-body">
                        <span class="s1-kicker s1-kicker-dark">{work.context} / {work.role}</span>
                        <h3 class="font-black text-xl leading-tight">{work.title}</h3>
                        <p class="text-sm font-bold leading-[1.65]">{work.line}</p>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 个人项目：错开的斜切菜单 ===== -->
    <P3TierBar label={t(labels.tierSolo)} count={solo.length} />

    <ul class="flex flex-col gap-2.5" data-reveal-children="left" data-reveal-once data-reveal-stagger="60">
        {solo.map((work, i) => (
                <li class="s1-menu-row" style={`--step: ${i};`}>
                    <a href={href(work.id)} class="s1-menu group">
                        <span class="s1-menu-no">{num(soloStart + i + 1)}</span>
                        <span class="s1-menu-thumb">
                            <WorkCover work={work} lang={lang} sizes="160px" />
                        </span>
                        <span class="s1-menu-title">{work.title}</span>
                        <span class="s1-menu-context">{work.context}</span>
                        <span class="s1-menu-line">{work.line}</span>
                        <span class="s1-menu-arrow" aria-hidden="true">▶</span>
                    </a>
                </li>
        ))}
    </ul>
</div>

<style>
    /* 斜切长条：相邻两条的斜边平行，中间留一道缝 */
    .s1-slices {
        --slant: 3.5rem;
        --seam: 0.6rem;
        display: flex;
        height: clamp(28rem, 38vw, 36rem);
    }
    .s1-slice {
        position: relative;
        flex: var(--grow) 1 0;
        min-width: 0;
        overflow: hidden;
        margin-left: calc(var(--seam) - var(--slant));
        clip-path: polygon(var(--slant) 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        transition: flex-grow 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .s1-slice:first-child {
        margin-left: 0;
    }
    .s1-slices:hover .s1-slice:hover {
        flex-grow: calc(var(--grow) + 0.9);
    }
    .s1-slice-img {
        position: absolute;
        inset: 0;
        transition: scale 450ms ease;
    }
    .s1-slice:hover .s1-slice-img {
        scale: 1.04;
    }
    .s1-slice::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 25%, color-mix(in srgb, var(--gd-ink) 94%, transparent) 100%);
        pointer-events: none;
    }
    .s1-slice-info {
        position: absolute;
        left: calc(var(--slant) * 0.35 + 1rem);
        right: calc(var(--slant) + 0.5rem);
        bottom: 1.5rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }
    .s1-no {
        position: absolute;
        top: -0.1em;
        right: calc(var(--slant) * 0.6);
        z-index: 2;
        font-weight: 900;
        font-style: italic;
        font-size: clamp(4.5rem, 8vw, 9rem);
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 3px var(--gd-paper);
    }
    .s1-kicker {
        align-self: flex-start;
        padding: 0.12rem 0.9rem 0.12rem 0.6rem;
        background-color: var(--gd-accent);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        clip-path: polygon(0 0, 100% 0, calc(100% - 0.5rem) 100%, 0 100%);
    }
    .s1-kicker-dark {
        background-color: var(--gd-ink);
    }
    .s1-chip {
        padding: 0.05rem 0.55rem;
        border: 2px solid var(--gd-paper);
        font-weight: 800;
        font-size: 0.75rem;
        transform: skewX(-12deg);
    }

    /* 精选：平行四边形卡片 */
    .s1-card {
        display: flex;
        flex-direction: column;
        background-color: var(--gd-paper);
        clip-path: polygon(6% 0, 100% 0, 94% 100%, 0 100%);
        transition: background-color 200ms ease;
    }
    .s1-card-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gd-ink);
    }
    .s1-card-no {
        position: absolute;
        left: 8%;
        top: 0.4rem;
        z-index: 2;
        font-weight: 900;
        font-style: italic;
        font-size: 2.6rem;
        line-height: 1;
        color: var(--gd-paper);
        -webkit-text-stroke: 2px var(--gd-ink);
        paint-order: stroke fill;
    }
    .s1-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem 10% 1.4rem;
    }
    .s1-card:hover {
        background-color: var(--gd-ink);
        color: var(--gd-paper);
    }
    .s1-card:hover .s1-kicker-dark {
        background-color: var(--gd-accent);
    }

    /* 个人项目：每行往右错开一点，像 P3R 的菜单 */
    .s1-menu-row {
        margin-left: calc(var(--step) * 1.1rem);
    }
    .s1-menu {
        position: relative;
        display: grid;
        grid-template-columns: 3rem 7rem minmax(9rem, 14rem) 9rem 1fr 1.5rem;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem 2rem 0.5rem 1rem;
        background-color: var(--gd-paper);
        clip-path: polygon(0 0, 100% 0, calc(100% - 1.4rem) 100%, 0 100%);
        isolation: isolate;
        overflow: hidden;
    }
    .s1-menu::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: var(--gd-ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .s1-menu:hover::before {
        transform: scaleX(1);
    }
    .s1-menu:hover {
        color: var(--gd-paper);
    }
    .s1-menu-no {
        font-weight: 900;
        font-style: italic;
        font-size: 1.6rem;
        color: var(--gd-accent);
    }
    .s1-menu-thumb {
        position: relative;
        display: block;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gd-ink);
        clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
    }
    .s1-menu-title {
        font-weight: 900;
        font-size: 1.1rem;
        line-height: 1.15;
    }
    .s1-menu-context {
        font-weight: 800;
        font-size: 0.8rem;
        opacity: 0.75;
    }
    .s1-menu-line {
        font-weight: 600;
        font-size: 0.85rem;
        line-height: 1.5;
    }
    .s1-menu-arrow {
        color: var(--gd-accent);
        transition: translate 200ms ease;
    }
    .s1-menu:hover .s1-menu-arrow {
        translate: 4px 0;
    }

    @media (max-width: 1023px) {
        .s1-slices {
            flex-direction: column;
            height: auto;
            gap: 1rem;
        }
        .s1-slice {
            margin-left: 0;
            min-height: 20rem;
            clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.5rem), 0 100%);
        }
        .s1-slice-info { left: 1.25rem; right: 1.25rem; bottom: 2rem; }
        .s1-no { right: 1rem; }
        .s1-menu-row { margin-left: 0; }
        .s1-menu { grid-template-columns: 2.5rem 6rem 1fr 1.2rem; }
        .s1-menu-context,
        .s1-menu-line { display: none; }
    }
    @media (max-width: 767px) {
        .s1-card { clip-path: none; }
    }
</style>
