---
// Part 2 版式 · P3R 斜切面板：倾斜的层标题条、平行四边形大图（一大两叠）；
// 下面一行 2×2 宽面板。
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDesignShowcase, DesignWorkView } from "./data";
import WorkCover from "./WorkCover.astro";

interface Props {
    showcase: GameDesignShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
// 背景和职责按「·」「/」拆成多个标签
const tagsOf = (w: DesignWorkView) => [w.context, w.role].flatMap((x) => x.split(/\s*[·/]\s*/)).filter(Boolean);
const [hero, ...side] = showcase.featured as DesignWorkView[];
---

<div class="p3">
    <!-- ===== 代表作 ===== -->
    <div class="p3-bar" data-reveal="left" data-reveal-once>
        <span class="p3-bar-fill">{t(labels.tierFeatured)}</span>
        <span class="p3-bar-rule"></span>
        <span class="p3-bar-count">{showcase.featured.length + showcase.selected.length}</span>
    </div>

    <div class="grid sm:grid-cols-[1.6fr_1fr] gap-3 sm:gap-5 lg:gap-6 mb-3 sm:mb-6">
        {hero && (
                <a href={href(hero.id)} class="p3-panel p3-panel-hero group" data-reveal="left" data-reveal-once>
                    <div class="p3-panel-img">
                        <WorkCover work={hero} lang={lang} sizes="(min-width: 1024px) 60vw, 100vw" />
                    </div>
                    <div class="p3-panel-info">
                        <h3 class="font-black text-2xl sm:text-3xl lg:text-5xl leading-none tracking-tight">{hero.title}</h3>
                        {hero.caption && <p class="text-[13px] leading-[1.55] sm:text-sm sm:leading-[1.65] lg:text-base font-bold max-w-[40rem]">{hero.caption}</p>}
                        <ul class="flex flex-wrap gap-1 sm:gap-2 pt-1">
                            {tagsOf(hero).map((tag) => <li class="p3-chip">{tag}</li>)}
                        </ul>
                    </div>
                </a>
        )}
        <div class="grid grid-cols-2 sm:grid-cols-1 gap-3 sm:gap-5 lg:gap-6">
            {side.map((work, i) => (
                    <a href={href(work.id)} class="p3-panel group" data-reveal="left" data-reveal-once data-reveal-delay={String(140 * (i + 1))}>
                        <div class="p3-panel-img">
                            <WorkCover work={work} lang={lang} sizes="(min-width: 1024px) 38vw, 100vw" />
                        </div>
                        <div class="p3-panel-info">
                            <h3 class="font-black text-base sm:text-2xl lg:text-3xl leading-none tracking-tight">{work.title}</h3>
                            {work.caption && <p class="hidden sm:block text-sm font-bold leading-[1.55] max-w-[34rem]">{work.caption}</p>}
                            <ul class="flex flex-wrap gap-1 sm:gap-1.5 pt-0.5 sm:pt-1">
                                {tagsOf(work).map((tag) => <li class="p3-chip p3-chip-sm">{tag}</li>)}
                            </ul>
                        </div>
                    </a>
            ))}
        </div>
    </div>

    <!-- 代表作下面：四个次一级的作品，2×2 宽面板，多一句简介 -->
    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:gap-6" data-reveal-children="left" data-reveal-order="columns" data-reveal-once>
        {showcase.selected.map((work) => (
                <a href={href(work.id)} class="p3-panel p3-panel-wide group">
                    <div class="p3-panel-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 50vw, 100vw" />
                    </div>
                    <div class="p3-panel-info">
                        <h3 class="font-black text-base sm:text-2xl lg:text-3xl leading-none tracking-tight">{work.title}</h3>
                        <p class="p3-clamp text-[10px] leading-[1.45] sm:text-sm sm:leading-[1.65] lg:text-base font-bold max-w-[40rem]">{work.line}</p>
                        <ul class="flex flex-wrap gap-1 sm:gap-2 pt-0.5 sm:pt-1">
                            {tagsOf(work).map((tag) => <li class="p3-chip">{tag}</li>)}
                        </ul>
                    </div>
                </a>
        ))}
    </div>
</div>

<style>
    /* 层标题：斜切色条 + 延伸细线 + 数量 */
    .p3-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .p3-bar-fill {
        padding: 0.4rem 2rem 0.4rem 1.2rem;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 1.5rem;
        letter-spacing: 0.06em;
        clip-path: polygon(0 0, 100% 0, calc(100% - 1rem) 100%, 0 100%);
    }
    .p3-bar-rule {
        flex: 1;
        height: 3px;
        background-color: var(--gd-ink);
        transform: skewX(-30deg);
    }
    .p3-bar-count {
        font-weight: 900;
        font-size: 2.2rem;
        line-height: 1;
        font-style: italic;
        color: var(--gd-accent);
    }

    /* 平行四边形大图面板 */
    .p3-panel {
        position: relative;
        display: block;
        min-height: 15rem;
        overflow: hidden;
        clip-path: polygon(3.5% 0, 100% 0, 96.5% 100%, 0 100%);
        background-color: var(--gd-ink);
        color: var(--gd-paper);
    }
    .p3-panel-hero {
        min-height: 30rem;
        clip-path: polygon(2.5% 0, 100% 0, 97.5% 100%, 0 100%);
    }
    /* 图层自己也按面板的斜边裁切，只放大里面的图：放大动画走合成层时会绕过父级的 clip-path，
       图的直角会短暂露到斜边外面 */
    .p3-panel-img {
        position: absolute;
        inset: 0;
        overflow: hidden;
        clip-path: inherit;
    }
    .p3-panel-img > :global(*) {
        transition: scale 400ms ease;
    }
    .p3-panel:hover .p3-panel-img > :global(*) {
        scale: 1.04;
    }
    /* 底部压暗，保证文字可读 */
    .p3-panel::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--gd-ink) 92%, transparent) 100%);
        pointer-events: none;
    }
    .p3-panel-info {
        position: absolute;
        left: 6%;
        right: 6%;
        bottom: 1.5rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .p3-chip {
        align-self: flex-start;
        padding: 0.15rem 0.7rem;
        border: 2px solid var(--gd-paper);
        font-weight: 800;
        font-size: 0.85rem;
        transform: skewX(-12deg);
    }
    .p3-chip-sm {
        font-size: 0.72rem;
        padding: 0.05rem 0.5rem;
    }



    @media (max-width: 1023px) {
        .p3-panel-hero { min-height: 22rem; }
    }
    @media (max-width: 767px) {
        .p3-panel { min-height: 17rem; }
    }

    /* 代表作下面的 2×2 宽面板 */
    .p3-panel-wide {
        min-height: 0;
        aspect-ratio: 16 / 7.5;
    }
    @media (max-width: 767px) {
        .p3-panel-wide { aspect-ratio: 16 / 10; }
    }

    /* 手机：代表作整宽一张，两个次代表作并排；下面 2 × 2 只放标题和标签 */
    @media (max-width: 639px) {
        .p3-bar { gap: 0.7rem; margin-bottom: 1rem; }
        .p3-bar-fill { font-size: 1.05rem; padding: 0.3rem 1.3rem 0.3rem 0.8rem; clip-path: polygon(0 0, 100% 0, calc(100% - 0.7rem) 100%, 0 100%); }
        .p3-bar-count { font-size: 1.7rem; }
        .p3-panel { min-height: 0; aspect-ratio: 4 / 3.6; }
        .p3-panel-hero { min-height: 0; aspect-ratio: 4 / 3.4; }
        .p3-panel-wide { aspect-ratio: 4 / 3.6; }
        .p3-panel-info { left: 8%; right: 8%; bottom: 0.7rem; gap: 0.35rem; }
        .p3-panel-hero .p3-panel-info { left: 6%; right: 6%; bottom: 1rem; }
        .p3-chip { font-size: 11px; padding: 0.05rem 0.45rem; border-width: 1.5px; }
        .p3-chip-sm { font-size: 10.5px; padding: 0 0.4rem; }
        .p3-panel:not(.p3-panel-hero) li:nth-child(n + 3) { display: none; }
        .p3-panel-wide p { display: none; }
    }
</style>
