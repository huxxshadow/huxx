---
// 版式 B2 · 大字横幅：每部代表作是一条通栏斜边横幅，巨型斜体标题压在图的斜切边上，左右交替、深浅交替；
// 精选是斜切底边的卡片 + 压图的大号编号，个人项目是一排小图块
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDesignShowcase } from "./data";
import WorkCover from "./WorkCover.astro";
import P3TierBar from "./P3TierBar.astro";

interface Props {
    showcase: GameDesignShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
const num = (n: number) => String(n).padStart(2, "0");
const { featured, selected, solo } = showcase;
const selectedStart = featured.length;
const soloStart = featured.length + selected.length;
---

<div>
    <!-- ===== 代表作：通栏横幅 ===== -->
    <P3TierBar label={t(labels.tierFeatured)} count={featured.length} />

    <div class="flex flex-col gap-5 mb-16">
        {featured.map((work, i) => (
                <a href={href(work.id)} class={`s2-band group ${i % 2 ? "s2-band-alt" : ""}`} data-reveal={i % 2 ? "right" : "left"} data-reveal-once>
                    <div class="s2-band-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 1024px) 65vw, 100vw" />
                    </div>
                    <div class="s2-band-text">
                        <span class="s2-no" aria-hidden="true">{num(i + 1)}</span>
                        <span class="s2-kicker">{work.context} / {work.role}</span>
                        <h3 class="s2-title">{work.title}</h3>
                        <p class="text-sm lg:text-base font-bold leading-[1.65] max-w-[30rem]">{work.line}</p>
                        <ul class="flex flex-col gap-1.5 pt-1">
                            {work.highlights.map((h) => <li class="s2-hl"><span aria-hidden="true">▶</span>{h}</li>)}
                        </ul>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 精选 ===== -->
    <P3TierBar label={t(labels.tierSelected)} count={selected.length} />

    <div class="grid md:grid-cols-3 gap-6 mb-16" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
        {selected.map((work, i) => (
                <a href={href(work.id)} class="s2-card group">
                    <div class="s2-card-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 30vw, 100vw" />
                    </div>
                    <span class="s2-card-no" aria-hidden="true">{num(selectedStart + i + 1)}</span>
                    <div class="flex flex-col gap-2 px-5 pb-5">
                        <span class="s2-kicker s2-kicker-dark">{work.context} / {work.role}</span>
                        <h3 class="font-black italic text-2xl leading-tight tracking-tight">{work.title}</h3>
                        <p class="text-sm font-bold leading-[1.65]">{work.line}</p>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 个人项目：小图块 ===== -->
    <P3TierBar label={t(labels.tierSolo)} count={solo.length} />

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4" data-reveal-children="left" data-reveal-order="columns" data-reveal-once>
        {solo.map((work, i) => (
                <a href={href(work.id)} class="s2-tile group">
                    <div class="s2-tile-img">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 1024px) 18vw, 45vw" />
                        <span class="s2-tile-no">{num(soloStart + i + 1)}</span>
                    </div>
                    <div class="flex flex-col gap-1 px-1 pt-2">
                        <h3 class="font-black italic text-base leading-tight">{work.title}</h3>
                        <span class="text-[0.72rem] font-extrabold leading-tight" style="color: var(--gd-accent);">{work.context}</span>
                        <p class="text-[0.75rem] font-semibold leading-snug line-clamp-3">{work.line}</p>
                    </div>
                </a>
        ))}
    </div>
</div>

<style>
    /* 通栏横幅：底边斜切；图占右侧六成多，左边缘斜切，文字压在斜边上 */
    .s2-band {
        position: relative;
        display: block;
        min-height: clamp(22rem, 30vw, 28rem);
        overflow: hidden;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 2.2rem), 0 100%);
    }
    .s2-band-alt {
        background-color: var(--gd-paper);
        color: var(--gd-ink);
        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 2.2rem));
    }
    .s2-band-img {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 64%;
        overflow: hidden;
        clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
        transition: width 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .s2-band-alt .s2-band-img {
        right: auto;
        left: 0;
        clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
    }
    .s2-band:hover .s2-band-img {
        width: 68%;
    }
    .s2-band-text {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        width: 50%;
        padding: 2rem 0 3.2rem 2.5rem;
    }
    .s2-band-alt .s2-band-text {
        margin-left: auto;
        align-items: flex-end;
        text-align: right;
        padding: 2rem 2.5rem 3.2rem 0;
    }
    .s2-no {
        font-weight: 900;
        font-style: italic;
        font-size: clamp(3.5rem, 6vw, 5.5rem);
        line-height: 0.8;
        color: var(--gd-accent);
    }
    /* 巨型斜体标题，向图那一侧越界，用底色描边保证压在图上也读得清 */
    .s2-title {
        font-weight: 900;
        font-style: italic;
        font-size: clamp(2.4rem, 5vw, 4.8rem);
        line-height: 0.95;
        letter-spacing: -0.02em;
        width: 125%;
        -webkit-text-stroke: 8px var(--gd-ink);
        paint-order: stroke fill;
    }
    .s2-band-alt .s2-title {
        -webkit-text-stroke-color: var(--gd-paper);
    }
    .s2-kicker {
        align-self: flex-start;
        padding: 0.12rem 0.9rem 0.12rem 0.6rem;
        background-color: var(--gd-accent);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        clip-path: polygon(0 0, 100% 0, calc(100% - 0.5rem) 100%, 0 100%);
    }
    .s2-band-alt .s2-kicker {
        align-self: flex-end;
        padding: 0.12rem 0.6rem 0.12rem 0.9rem;
        clip-path: polygon(0.5rem 0, 100% 0, 100% 100%, 0 100%);
    }
    .s2-kicker-dark {
        background-color: var(--gd-ink);
    }
    .s2-hl {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 0.9rem;
    }
    .s2-hl > span {
        color: var(--gd-accent);
        font-size: 0.7rem;
    }
    .s2-band-alt .s2-hl {
        flex-direction: row-reverse;
    }
    .s2-band-alt .s2-hl > span {
        transform: scaleX(-1);
    }

    /* 精选：底边斜切的图 + 压在斜边上的大号编号 */
    .s2-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background-color: var(--gd-paper);
        transition: background-color 200ms ease, color 200ms ease;
    }
    .s2-card-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gd-ink);
        clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);
    }
    .s2-card-no {
        align-self: flex-end;
        margin: -2.6rem 1rem 0 0;
        position: relative;
        z-index: 2;
        font-weight: 900;
        font-style: italic;
        font-size: 3.4rem;
        line-height: 1;
        color: var(--gd-accent);
        -webkit-text-stroke: 6px var(--gd-paper);
        paint-order: stroke fill;
    }
    .s2-card:hover {
        background-color: var(--gd-ink);
        color: var(--gd-paper);
    }
    .s2-card:hover .s2-card-no {
        -webkit-text-stroke-color: var(--gd-ink);
    }
    .s2-card:hover .s2-kicker-dark {
        background-color: var(--gd-accent);
    }

    /* 个人项目：小图块，悬停时往右上错一下 */
    .s2-tile {
        display: flex;
        flex-direction: column;
        transition: transform 180ms ease;
    }
    .s2-tile:hover {
        transform: translate(4px, -4px);
    }
    .s2-tile-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--gd-ink);
        clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
    }
    .s2-tile-no {
        position: absolute;
        left: 10%;
        bottom: 0.2rem;
        z-index: 2;
        font-weight: 900;
        font-style: italic;
        font-size: 1.5rem;
        line-height: 1;
        color: var(--gd-paper);
        -webkit-text-stroke: 4px var(--gd-ink);
        paint-order: stroke fill;
    }

    @media (max-width: 1023px) {
        .s2-band,
        .s2-band-alt {
            display: flex;
            flex-direction: column;
        }
        .s2-band-img,
        .s2-band-alt .s2-band-img {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
        }
        .s2-band:hover .s2-band-img { width: 100%; }
        .s2-band-text,
        .s2-band-alt .s2-band-text {
            width: 100%;
            margin: -2.5rem 0 0;
            align-items: flex-start;
            text-align: left;
            padding: 0 1.5rem 3.2rem;
        }
        .s2-band-alt .s2-kicker { align-self: flex-start; }
        .s2-band-alt .s2-hl { flex-direction: row; }
        .s2-band-alt .s2-hl > span { transform: none; }
        .s2-title { width: 100%; }
    }
</style>
