---
// 版式 A · P5R 勒索信拼贴：歪斜的锯齿剪切图、逐字拼贴的标题、爆炸星、半调网点、贴纸式小卡。
// 三层：代表作（大）→ 精选（中）→ 个人项目（小贴纸）。悬停时扶正并抬起
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDesignShowcase, DesignWorkView } from "./data";
import WorkCover from "./WorkCover.astro";

interface Props {
    showcase: GameDesignShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

// 16 角爆炸星
const star = Array.from({ length: 32 }, (_, i) => {
    const r = i % 2 ? 36 : 50;
    const a = (Math.PI * 2 * i) / 32;
    return `${(50 + Math.cos(a) * r).toFixed(1)}% ${(50 + Math.sin(a) * r).toFixed(1)}%`;
}).join(", ");

// 勒索信字块：每个字轮换底色、角度、字号（按下标固定，不随机，构建结果稳定）
const ransom = (text: string) =>
    Array.from(text).map((ch, i) => ({ ch, v: i % 4, rot: [-4, 3, -2, 5][i % 4], space: ch.trim() === "" }));

// 锯齿剪切轮廓，按下标换几种
const cuts = [
    "polygon(1% 3%, 97% 0, 100% 90%, 94% 100%, 3% 97%, 0 20%)",
    "polygon(4% 0, 100% 5%, 97% 100%, 0 94%)",
    "polygon(0 6%, 92% 0, 100% 96%, 7% 100%)",
];
const tilt = [-2.5, 2, -1.5, 1.5, -2];
const [hero, ...side] = showcase.featured as DesignWorkView[];
---

<div class="p5 relative">
    <div class="p5-halftone" aria-hidden="true"></div>

    <!-- ===== 代表作 ===== -->
    <div class="p5-tier" data-reveal="left" data-reveal-once>
        <span class="p5-tier-star" style={`clip-path: polygon(${star});`}>01</span>
        <span class="p5-tier-label">{t(labels.tierFeatured)}</span>
    </div>

    {hero && (
            <a href={href(hero.id)} class="p5-piece group grid lg:grid-cols-[1.55fr_1fr] gap-8 lg:gap-12 items-center mb-14" style={`--tilt: ${tilt[0]}deg;`} data-reveal="up" data-reveal-once>
                <div class="p5-frame" style={`--cut: ${cuts[0]};`}>
                    <div class="p5-img relative aspect-video">
                        <WorkCover work={hero} lang={lang} sizes="(min-width: 1024px) 60vw, 100vw" />
                    </div>
                </div>
                <div class="flex flex-col gap-4">
                    <span class="p5-context">{hero.context} · {hero.role}</span>
                    <h3 class="p5-ransom text-3xl lg:text-5xl">
                        {ransom(hero.title).map((c) => c.space ? <span class="p5-gap"></span> : <span class={`p5-r p5-r-${c.v}`} style={`--r: ${c.rot}deg;`}>{c.ch}</span>)}
                    </h3>
                    <p class="text-base lg:text-lg font-bold leading-[1.7]">{hero.line}</p>
                    <ul class="flex flex-col gap-2">
                        {hero.highlights.map((h) => <li class="p5-hl">★ {h}</li>)}
                    </ul>
                </div>
            </a>
    )}

    <div class="grid md:grid-cols-2 gap-10 lg:gap-14 mb-16">
        {side.map((work, i) => (
                <a href={href(work.id)} class="p5-piece group flex flex-col gap-4" style={`--tilt: ${tilt[i + 1]}deg;`} data-reveal="up" data-reveal-once data-reveal-delay={String(120 * (i + 1))}>
                    <div class="p5-frame" style={`--cut: ${cuts[(i + 1) % cuts.length]};`}>
                        <div class="p5-img relative aspect-video">
                            <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 45vw, 100vw" />
                        </div>
                    </div>
                    <span class="p5-context">{work.context} · {work.role}</span>
                    <h3 class="p5-ransom text-2xl lg:text-3xl">
                        {ransom(work.title).map((c) => c.space ? <span class="p5-gap"></span> : <span class={`p5-r p5-r-${c.v}`} style={`--r: ${c.rot}deg;`}>{c.ch}</span>)}
                    </h3>
                    <p class="text-sm lg:text-base font-bold leading-[1.7]">{work.line}</p>
                    <div class="flex flex-wrap gap-2">
                        {work.highlights.map((h) => <span class="p5-hl text-sm">★ {h}</span>)}
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 精选 ===== -->
    <div class="p5-tier" data-reveal="left" data-reveal-once>
        <span class="p5-tier-star" style={`clip-path: polygon(${star});`}>02</span>
        <span class="p5-tier-label">{t(labels.tierSelected)}</span>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-16" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
        {showcase.selected.map((work, i) => (
                <a href={href(work.id)} class="p5-card p5-piece group flex flex-col" style={`--tilt: ${tilt[(i + 3) % tilt.length]}deg;`}>
                    <div class="p5-frame p5-frame-thin" style={`--cut: ${cuts[i % cuts.length]};`}>
                        <div class="p5-img relative aspect-video">
                            <WorkCover work={work} lang={lang} sizes="(min-width: 768px) 30vw, 100vw" />
                        </div>
                    </div>
                    <div class="p-4 flex flex-col gap-2">
                        <span class="p5-context text-xs">{work.context} · {work.role}</span>
                        <h3 class="font-black text-xl leading-tight">{work.title}</h3>
                        <p class="text-sm font-bold leading-[1.65]">{work.line}</p>
                    </div>
                </a>
        ))}
    </div>

    <!-- ===== 个人项目：贴纸 ===== -->
    <div class="p5-tier" data-reveal="left" data-reveal-once>
        <span class="p5-tier-star" style={`clip-path: polygon(${star});`}>03</span>
        <span class="p5-tier-label">{t(labels.tierSolo)}</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
        {showcase.solo.map((work, i) => (
                <a href={href(work.id)} class="p5-sticker p5-piece group flex flex-col" style={`--tilt: ${tilt[(i + 2) % tilt.length] * 1.4}deg;`}>
                    <div class="relative aspect-video overflow-hidden" style="background-color: var(--gd-ink);">
                        <WorkCover work={work} lang={lang} sizes="(min-width: 1024px) 18vw, 45vw" />
                    </div>
                    <div class="pt-2 flex flex-col gap-1">
                        <h3 class="font-black text-sm lg:text-base leading-tight">{work.title}</h3>
                        <span class="text-[0.7rem] font-bold leading-tight opacity-75">{work.context}</span>
                        <p class="text-[0.72rem] font-medium leading-snug line-clamp-3">{work.line}</p>
                    </div>
                </a>
        ))}
    </div>
</div>

<style>
    .p5-halftone {
        position: absolute;
        inset: -2rem -3rem;
        pointer-events: none;
        background-image: radial-gradient(circle, var(--gd-ink) 1.2px, transparent 1.6px);
        background-size: 12px 12px;
        opacity: 0.08;
        -webkit-mask: linear-gradient(135deg, #000 0%, transparent 55%, #000 100%);
        mask: linear-gradient(135deg, #000 0%, transparent 55%, #000 100%);
    }

    /* 层标题：爆炸星编号 + 倾斜的黑底白字条 */
    .p5-tier {
        position: relative;
        display: flex;
        align-items: center;
        margin: 0 0 2.25rem;
    }
    .p5-tier-star {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 5.5rem;
        height: 5.5rem;
        background-color: var(--gd-accent);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 1.9rem;
        transform: rotate(-12deg);
        z-index: 1;
    }
    .p5-tier-label {
        margin-left: -1rem;
        padding: 0.45rem 1.6rem 0.45rem 1.8rem;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 1.6rem;
        letter-spacing: 0.08em;
        transform: rotate(-3deg) skewX(-12deg);
        box-shadow: 6px 6px 0 var(--gd-paper);
    }

    /* 倾斜的拼贴块：悬停扶正、抬起 */
    .p5-piece {
        transform: rotate(var(--tilt, 0deg));
        transition: transform 180ms ease;
    }
    .p5-piece:hover {
        transform: rotate(0deg) translateY(-4px);
    }

    /* 锯齿剪切：外层黑框、里层图，同一个轮廓 */
    .p5-frame {
        clip-path: var(--cut);
        background-color: var(--gd-ink);
        padding: 7px;
    }
    .p5-frame-thin {
        padding: 5px;
    }
    .p5-img {
        clip-path: var(--cut);
        overflow: hidden;
        background-color: var(--gd-ink);
    }

    .p5-context {
        align-self: flex-start;
        padding: 0.15rem 0.6rem;
        background-color: var(--gd-accent);
        color: var(--gd-paper);
        font-weight: 900;
        font-size: 0.85rem;
        transform: skewX(-12deg);
    }

    /* 勒索信标题：每个字一块 */
    .p5-ransom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.12em;
        line-height: 1;
        font-weight: 900;
    }
    .p5-r {
        display: inline-block;
        padding: 0.08em 0.14em;
        transform: rotate(var(--r));
    }
    .p5-r-0 { background-color: var(--gd-ink); color: var(--gd-paper); }
    .p5-r-1 { background-color: var(--gd-paper); color: var(--gd-ink); font-size: 0.86em; }
    .p5-r-2 { background-color: var(--gd-accent); color: var(--gd-paper); font-size: 1.08em; }
    .p5-r-3 { background-color: var(--gd-paper); color: var(--gd-accent); border: 2px solid var(--gd-ink); font-size: 0.92em; }
    .p5-gap { width: 0.35em; }

    .p5-hl {
        align-self: flex-start;
        padding: 0.2rem 0.7rem;
        background-color: var(--gd-ink);
        color: var(--gd-paper);
        font-weight: 800;
        font-size: 0.9rem;
        transform: skewX(-8deg);
    }

    .p5-card {
        background-color: var(--gd-paper);
        border: 3px solid var(--gd-ink);
        box-shadow: 7px 7px 0 var(--gd-ink);
    }
    .p5-sticker {
        background-color: var(--gd-paper);
        padding: 8px 8px 12px;
        box-shadow: 4px 5px 0 color-mix(in srgb, var(--gd-ink) 55%, transparent);
    }

    @media (max-width: 767px) {
        .p5-piece { transform: none; }
    }
</style>
