---
// 项目区 · 版式 C：左侧是该角色的插画和代表作信息，右侧是横向滚动的倾斜卡片条，可拖动滚动或用箭头翻页
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { OverviewRole, RoleProject } from "../portfolioRolesData";
import gameDesignArt from "@/assets/portfolio/roles/game-design.svg";
import gameDevArt from "@/assets/portfolio/roles/game-dev.svg";
import aiAppArt from "@/assets/portfolio/roles/ai-app.svg";
import techArtArt from "@/assets/portfolio/roles/tech-art.svg";

interface Props {
    role: OverviewRole;
    projects: RoleProject[];
    lang: string;
    labels: { featured: string; view: string; prev: string; next: string };
}
const { role, projects, lang, labels } = Astro.props;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
const roleArt: Record<string, ImageMetadata> = {
    "game-design": gameDesignArt,
    "game-dev": gameDevArt,
    "ai-app": aiAppArt,
    "tech-art": techArtArt,
};
const art = roleArt[role.id];
---

<div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] gap-8 lg:gap-10 items-stretch" data-strip>
    <!-- 左：角色插画 + 翻页按钮 -->
    <div class="hidden lg:flex flex-col justify-between gap-6" data-reveal="fade" data-reveal-once>
        {art && <img src={art.src} alt="" width={art.width} height={art.height} class="w-full h-auto" loading="lazy" decoding="async" />}
        <div class="flex gap-3">
            <button type="button" class="pc-arrow" data-strip-prev aria-label={labels.prev}><i class="fa-solid fa-arrow-left"></i></button>
            <button type="button" class="pc-arrow" data-strip-next aria-label={labels.next}><i class="fa-solid fa-arrow-right"></i></button>
        </div>
    </div>

    <!-- 右：横向卡片条。左右留出倾斜多出来的宽度，避免被滚动容器裁掉 -->
    <div class="pc-track flex gap-6 lg:gap-8 overflow-x-auto snap-x snap-mandatory pb-6 px-8 -mx-8" data-strip-track data-reveal-children="left" data-reveal-once data-reveal-stagger="80">
        {projects.map((project, i) => (
                <a href={href(project.id)} class="pc-card group snap-start shrink-0 w-[78vw] sm:w-80 lg:w-[22rem] flex flex-col">
                    <div class="pc-unskew flex flex-col h-full">
                        <div class="relative aspect-[4/3] overflow-hidden" style="background-color: var(--role-dark);">
                            {project.cover && (
                                    <Image src={project.cover} alt={project.title} widths={[400, 800]} sizes="(min-width: 1024px) 22rem, (min-width: 640px) 20rem, 78vw" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            )}
                            <span class="absolute top-3 left-3 font-black text-4xl leading-none" style="color: var(--paper); -webkit-text-stroke: 2px var(--role-dark);">{String(i + 1).padStart(2, "0")}</span>
                            {project.featured && (
                                    <span class="absolute top-3 right-3 px-2.5 py-1 font-black text-xs tracking-[0.2em] uppercase" style="background-color: var(--role-dark); color: var(--paper);">
                                        <i class="fa-solid fa-star mr-1"></i>{labels.featured}
                                    </span>
                            )}
                        </div>
                        <div class="flex-1 flex flex-col gap-3 p-5">
                            <h3 class="font-black text-xl lg:text-2xl leading-tight">{project.title}</h3>
                            <div class="flex flex-wrap gap-2">
                                {project.roles.map((r) => <span class="px-2.5 py-0.5 font-black text-xs" style="background-color: var(--role-dark); color: var(--paper);">{r}</span>)}
                            </div>
                            <p class="text-sm font-medium leading-[1.75] line-clamp-4">{project.desc}</p>
                            <span class="mt-auto pt-2 flex items-center gap-2 font-black" style="color: var(--role-dark);">
                                {labels.view}<i class="fa-solid fa-arrow-right transition-transform duration-200 group-hover:translate-x-1.5"></i>
                            </span>
                        </div>
                    </div>
                </a>
        ))}
    </div>
</div>

<style>
    .pc-card {
        background-color: var(--paper);
        border-left: 8px solid var(--role-dark);
        transition: transform 160ms ease, box-shadow 160ms ease;
    }
    /* 悬停用 transform 而不是 translate：卡片是入场动画的子元素，动画结束后会一直占着 translate */
    /* 卡片不高，倾斜只多出约 5rem × tan6°，放在轨道左右的内边距里 */
    @media (min-width: 1024px) {
        .pc-card {
            transform: skewX(-6deg);
            transform-origin: left bottom;
        }
        .pc-unskew {
            transform: skewX(6deg);
        }
    }
    .pc-card:hover,
    .pc-card:focus-visible {
        transform: translateY(-6px);
        box-shadow: 0 6px 0 var(--role-dark);
    }
    @media (min-width: 1024px) {
        .pc-card:hover,
        .pc-card:focus-visible {
            transform: skewX(-6deg) translateY(-6px);
        }
    }
    .pc-track {
        scrollbar-width: thin;
        scrollbar-color: var(--role-dark) transparent;
    }
    .pc-arrow {
        width: 3.25rem;
        height: 3.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        border: 3px solid var(--role-dark);
        color: var(--role-dark);
        background-color: var(--paper);
        box-shadow: 4px 4px 0 var(--role-dark);
        cursor: pointer;
        transition: transform 120ms ease, box-shadow 120ms ease;
    }
    .pc-arrow:hover {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 var(--role-dark);
    }
    .pc-arrow:active {
        transform: translate(4px, 4px);
        box-shadow: 0 0 0 var(--role-dark);
    }
</style>

<script>
    // 箭头一次翻一张卡片的宽度（含间距）
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
            const track = strip.querySelector<HTMLElement>('[data-strip-track]');
            if (!track) return;
            const step = () => {
                const card = track.firstElementChild as HTMLElement | null;
                const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
                return card ? card.offsetWidth + gap : track.clientWidth * 0.8;
            };
            strip.querySelector('[data-strip-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
            strip.querySelector('[data-strip-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
        });
    });
</script>
