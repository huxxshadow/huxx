---
// Part 5 · 技术美术：吉祥物（握着画笔的猫耳画师）站在正中，左边「技术」、右边「美术」两个板块。
// 候选版式（右下角 Debug 面板切换）：
//   A 三联画：左右两栏卡片朝向中间，中间是整身吉祥物
//   B 蓝图 / 画布：一块板子左半是蓝图方格纸、右半是画布，吉祥物跨在接缝上；技术是规格表，美术是画框
//   C 拼贴：卡片像贴在墙上的照片，歪着错开，背后是巨大的空心字 TECH / ART
// 这一页只用 COLORS.yellow 的深浅两档（吉祥物本身就是 yellow.dark）
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { techArtWorks, techArtLabels as L } from "@/i18n/components/portfolio/TechArtShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import mascot from "@/assets/portfolio/techArt/mascot-brush.svg";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "tech-art")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = techArtWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        side: w.side,
        title: w.title ? t(w.title) : d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: "yellow",
        colorBackground: "yellow",
        inDevelopment: !!d.inDevelopment,
    }];
});
const tech = works.filter((w) => w.side === "tech");
const art = works.filter((w) => w.side === "art");
const code = (i: number, side: "tech" | "art") => `${side === "tech" ? "T" : "A"}-${String(i + 1).padStart(2, "0")}`;

const ink = COLORS.black;
const accent = COLORS.yellow.dark;
const tint = COLORS.yellow.light;
const paper = "#FFFDF7";
const sizesSide = "(min-width: 1024px) 28vw, (min-width: 640px) 50vw, 100vw";
const sizesThumb = "(min-width: 1024px) 12vw, 40vw";
---

<section
        id={role.anchor}
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ta-accent: ${accent}; --ta-tint: ${tint}; --ta-ink: ${ink}; --ta-paper: ${paper}; --ta-ratio: ${(mascot.width / mascot.height).toFixed(4)};`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2、3、4 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-8 lg:mb-10" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ta-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ta-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{works.length} {t(L.projects)}</span>
    </header>

    <div data-variant-group="part5" data-variant-label="Part 5 · TA">

        <!-- ================= A · 三联画 ================= -->
        <div data-variant="A">
            <div class="ta-a">
                <div class="ta-a-col ta-a-left">
                    <div class="ta-a-head" data-reveal="right" data-reveal-once>
                        <span class="ta-a-head-name">{t(L.tech)}</span>
                        <span class="ta-a-head-sub">{t(L.techSub)}</span>
                    </div>
                    <div class="ta-a-list" data-reveal-children="right" data-reveal-once>
                        {tech.map((w) => (
                                <a href={href(w.id)} class="ta-a-card">
                                    <div class="ta-a-thumb"><WorkCover work={w} lang={lang} sizes={sizesThumb} /></div>
                                    <div class="ta-a-body">
                                        <h3 class="ta-a-title">{w.title}</h3>
                                        <p class="ta-a-caption">{w.caption}</p>
                                        <ul class="ta-tags">{w.tags.map((tag) => <li class="ta-tag">{tag}</li>)}</ul>
                                    </div>
                                </a>
                        ))}
                    </div>
                </div>

                <div class="ta-a-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
                    <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                </div>

                <div class="ta-a-col ta-a-right">
                    <div class="ta-a-head" data-reveal="left" data-reveal-once>
                        <span class="ta-a-head-name">{t(L.art)}</span>
                        <span class="ta-a-head-sub">{t(L.artSub)}</span>
                    </div>
                    <div class="ta-a-list ta-a-list-art" data-reveal-children="left" data-reveal-once>
                        {art.map((w) => (
                                <a href={href(w.id)} class="ta-a-card ta-a-card-art">
                                    <div class="ta-a-img"><WorkCover work={w} lang={lang} sizes={sizesSide} /></div>
                                    <div class="ta-a-body">
                                        <h3 class="ta-a-title">{w.title}</h3>
                                        <p class="ta-a-caption">{w.caption}</p>
                                        <ul class="ta-tags">{w.tags.map((tag) => <li class="ta-tag">{tag}</li>)}</ul>
                                    </div>
                                </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= B · 蓝图 / 画布 ================= -->
        <div data-variant="B" hidden>
            <div class="ta-b">
                <div class="ta-b-bg-left" aria-hidden="true"></div>
                <div class="ta-b-bg-right" aria-hidden="true"></div>

                <div class="ta-b-col">
                    <div class="ta-b-head ta-b-head-tech" data-reveal="up" data-reveal-once>
                        <span class="ta-b-mono">// {t(L.techSub)}</span>
                        <span class="ta-b-head-name">{t(L.tech)}</span>
                    </div>
                    <ol class="ta-b-specs" data-reveal-children="up" data-reveal-once>
                        {tech.map((w, i) => (
                                <li>
                                    <a href={href(w.id)} class="ta-b-spec">
                                        <span class="ta-b-code">{code(i, "tech")}</span>
                                        <div class="ta-b-spec-thumb"><WorkCover work={w} lang={lang} sizes={sizesThumb} /></div>
                                        <div class="ta-b-spec-body">
                                            <h3 class="ta-b-spec-title">{w.title}</h3>
                                            <p class="ta-b-spec-caption">{w.caption}</p>
                                            <ul class="ta-b-spec-tags">{w.tags.map((tag) => <li>#{tag}</li>)}</ul>
                                        </div>
                                    </a>
                                </li>
                        ))}
                    </ol>
                </div>

                <div class="ta-b-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
                    <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                </div>

                <div class="ta-b-col">
                    <div class="ta-b-head ta-b-head-art" data-reveal="up" data-reveal-once>
                        <span class="ta-b-script">{t(L.artSub)}</span>
                        <span class="ta-b-head-name">{t(L.art)}</span>
                    </div>
                    <ol class="ta-b-gallery" data-reveal-children="up" data-reveal-once>
                        {art.map((w) => (
                                <li>
                                    <a href={href(w.id)} class="ta-b-frame">
                                        <div class="ta-b-mat">
                                            <div class="ta-b-img"><WorkCover work={w} lang={lang} sizes={sizesSide} /></div>
                                        </div>
                                        <div class="ta-b-label">
                                            <h3 class="ta-b-label-title">{w.title}</h3>
                                            <p class="ta-b-label-caption">{w.caption}</p>
                                            <p class="ta-b-label-tags">{w.tags.join(" / ")}</p>
                                        </div>
                                    </a>
                                </li>
                        ))}
                    </ol>
                </div>
            </div>
        </div>

        <!-- ================= C · 拼贴 ================= -->
        <div data-variant="C" hidden>
            <div class="ta-c">
                <span class="ta-c-word ta-c-word-left" aria-hidden="true">TECH</span>
                <span class="ta-c-word ta-c-word-right" aria-hidden="true">ART</span>

                <div class="ta-c-col">
                    <p class="ta-c-sticker ta-c-sticker-tech" data-reveal="scale" data-reveal-once>{t(L.tech)}</p>
                    <div class="ta-c-pile" data-reveal-children="up" data-reveal-once>
                        {tech.map((w) => (
                                <a href={href(w.id)} class="ta-c-photo">
                                    <span class="ta-c-tape" aria-hidden="true"></span>
                                    <div class="ta-c-img"><WorkCover work={w} lang={lang} sizes={sizesSide} /></div>
                                    <h3 class="ta-c-title">{w.title}</h3>
                                    <p class="ta-c-caption">{w.caption}</p>
                                    <ul class="ta-tags">{w.tags.map((tag) => <li class="ta-tag">{tag}</li>)}</ul>
                                </a>
                        ))}
                    </div>
                </div>

                <div class="ta-c-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
                    <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                </div>

                <div class="ta-c-col ta-c-col-art">
                    <p class="ta-c-sticker ta-c-sticker-art" data-reveal="scale" data-reveal-once>{t(L.art)}</p>
                    <div class="ta-c-pile" data-reveal-children="up" data-reveal-once>
                        {art.map((w) => (
                                <a href={href(w.id)} class="ta-c-photo">
                                    <span class="ta-c-tape" aria-hidden="true"></span>
                                    <div class="ta-c-img"><WorkCover work={w} lang={lang} sizes={sizesSide} /></div>
                                    <h3 class="ta-c-title">{w.title}</h3>
                                    <p class="ta-c-caption">{w.caption}</p>
                                    <ul class="ta-tags">{w.tags.map((tag) => <li class="ta-tag">{tag}</li>)}</ul>
                                </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .ta-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    /* 通用标签：圆角描边小块 */
    .ta-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }
    .ta-tag {
        padding: 0.15rem 0.6rem;
        border: 2px solid var(--ta-ink);
        border-radius: 0.5rem;
        font-size: 0.75rem;
        font-weight: 700;
        background-color: var(--ta-paper);
    }

    /* 吉祥物：宽度给定，高度按原比例（约 1:3） */
    .ta-a-mascot img,
    .ta-b-mascot img,
    .ta-c-mascot img {
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
        user-select: none;
    }

    /* ======================= A · 三联画 ======================= */
    .ta-a {
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(9rem, 15vw, 17rem) minmax(0, 1fr);
        gap: clamp(1.5rem, 3vw, 3.5rem);
        align-items: start;
    }
    .ta-a-mascot { align-self: center; }
    .ta-a-col {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .ta-a-head {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 4px solid var(--ta-accent);
    }
    .ta-a-left .ta-a-head { align-items: flex-end; text-align: right; }
    .ta-a-head-name {
        font-weight: 900;
        font-size: clamp(2rem, 3.4vw, 3.4rem);
        line-height: 1;
        letter-spacing: -0.01em;
    }
    .ta-a-head-sub {
        font-weight: 800;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ta-accent);
        filter: brightness(0.8);
    }
    .ta-a-list {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }
    /* 美术 3 张：第一张横跨两列当主图，另外两张并排，整栏高度和左边 4 行差不多 */
    .ta-a-list-art {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ta-a-list-art > :first-child { grid-column: span 2; }
    /* 卡片：描边 + 偏移实色阴影，悬停往阴影方向按下去（和 Part 4 同一套手感） */
    .ta-a-card {
        display: flex;
        overflow: hidden;
        border: 2px solid var(--ta-ink);
        border-radius: 1rem;
        background-color: var(--ta-paper);
        box-shadow: 6px 6px 0 var(--ta-accent);
        transition: transform 100ms ease, box-shadow 100ms ease;
    }
    .ta-a-card:hover { transform: translate(3px, 3px); box-shadow: 3px 3px 0 var(--ta-accent); }
    .ta-a-card:active { transform: translate(6px, 6px); box-shadow: 0 0 0 var(--ta-accent); }
    /* 左栏：文字在外侧，缩略图贴着中间的吉祥物 */
    .ta-a-left .ta-a-card { flex-direction: row-reverse; text-align: right; }
    .ta-a-left .ta-a-card .ta-tags { justify-content: flex-end; }
    .ta-a-thumb {
        position: relative;
        flex: none;
        width: 38%;
        min-height: 7.5rem;
        border-left: 2px solid var(--ta-ink);
    }
    /* 右栏美术：图是主角，上图下文 */
    .ta-a-card-art { flex-direction: column; }
    .ta-a-img {
        position: relative;
        aspect-ratio: 16 / 9;
        border-bottom: 2px solid var(--ta-ink);
    }
    .ta-a-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
        min-width: 0;
        padding: 0.85rem 1rem 1rem;
    }
    .ta-a-title { font-weight: 900; font-size: 1.1rem; line-height: 1.25; }
    .ta-a-caption { font-weight: 600; font-size: 0.85rem; line-height: 1.5; opacity: 0.85; }
    .ta-a-thumb :global(img),
    .ta-a-img :global(img) { transition: scale 500ms ease; }
    .ta-a-card:hover :global(img) { scale: 1.05; }

    @media (max-width: 1023px) {
        .ta-a { grid-template-columns: 1fr; }
        .ta-a-mascot { order: -1; width: 8rem; margin: 0 auto; }
        .ta-a-left .ta-a-head { align-items: flex-start; text-align: left; }
        .ta-a-left .ta-a-card { flex-direction: row; text-align: left; }
        .ta-a-left .ta-a-card .ta-tags { justify-content: flex-start; }
        .ta-a-thumb { border-left: none; border-right: 2px solid var(--ta-ink); }
    }
    @media (max-width: 519px) {
        .ta-a-left .ta-a-card { flex-direction: column; }
        .ta-a-thumb { width: 100%; aspect-ratio: 16 / 9; min-height: 0; border-right: none; border-bottom: 2px solid var(--ta-ink); }
    }

    /* ======================= B · 蓝图 / 画布 ======================= */
    .ta-b {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(8rem, 13vw, 15rem) minmax(0, 1fr);
        gap: clamp(1rem, 2vw, 2rem);
        align-items: start;
        padding: clamp(1.5rem, 3vw, 3rem);
        border: 3px solid var(--ta-ink);
        border-radius: 1.25rem;
        box-shadow: 10px 10px 0 var(--ta-accent);
        overflow: hidden;
        isolation: isolate;
    }
    /* 左半：方格纸蓝图；右半：画布，几块淡淡的颜料 */
    .ta-b-bg-left,
    .ta-b-bg-right {
        position: absolute;
        top: 0;
        bottom: 0;
        z-index: -1;
    }
    .ta-b-bg-left {
        left: 0;
        right: 50%;
        background-color: var(--ta-paper);
        background-image:
                linear-gradient(color-mix(in srgb, var(--ta-accent) 35%, transparent) 1px, transparent 1px),
                linear-gradient(90deg, color-mix(in srgb, var(--ta-accent) 35%, transparent) 1px, transparent 1px),
                linear-gradient(color-mix(in srgb, var(--ta-accent) 14%, transparent) 1px, transparent 1px),
                linear-gradient(90deg, color-mix(in srgb, var(--ta-accent) 14%, transparent) 1px, transparent 1px);
        background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px;
        border-right: 3px dashed var(--ta-ink);
    }
    .ta-b-bg-right {
        left: 50%;
        right: 0;
        background-color: var(--ta-tint);
        background-image:
                radial-gradient(ellipse 42% 22% at 78% 14%, color-mix(in srgb, var(--ta-accent) 38%, transparent) 60%, transparent 62%),
                radial-gradient(ellipse 30% 16% at 18% 62%, color-mix(in srgb, var(--ta-accent) 22%, transparent) 60%, transparent 62%),
                radial-gradient(ellipse 36% 12% at 70% 92%, color-mix(in srgb, var(--ta-accent) 30%, transparent) 60%, transparent 62%);
    }
    .ta-b-col {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .ta-b-head { display: flex; flex-direction: column; gap: 0.2rem; }
    .ta-b-head-name {
        font-weight: 900;
        font-size: clamp(2rem, 3.4vw, 3.4rem);
        line-height: 1;
    }
    .ta-b-head-art { align-items: flex-end; text-align: right; }
    .ta-b-mono,
    .ta-b-code,
    .ta-b-spec-tags {
        font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
    }
    .ta-b-mono { font-size: 0.8rem; font-weight: 700; opacity: 0.7; }
    .ta-b-script { font-size: 0.85rem; font-weight: 700; font-style: italic; opacity: 0.7; }

    /* 技术：规格表，每行编号 + 缩略图 + 说明，虚线分隔 */
    .ta-b-specs {
        display: flex;
        flex-direction: column;
        border-top: 2px solid var(--ta-ink);
    }
    .ta-b-spec {
        display: grid;
        grid-template-columns: auto 34% minmax(0, 1fr);
        gap: 0.9rem;
        align-items: start;
        padding: 0.9rem 0.25rem;
        border-bottom: 2px dashed var(--ta-ink);
        transition: background-color 150ms ease;
    }
    .ta-b-spec:hover { background-color: color-mix(in srgb, var(--ta-accent) 16%, transparent); }
    .ta-b-code {
        font-size: 0.8rem;
        font-weight: 800;
        padding: 0.1rem 0.35rem;
        background-color: var(--ta-ink);
        color: var(--ta-paper);
    }
    .ta-b-spec-thumb {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border: 2px solid var(--ta-ink);
    }
    .ta-b-spec-body { display: flex; flex-direction: column; gap: 0.35rem; }
    .ta-b-spec-title { font-weight: 900; font-size: 1.05rem; line-height: 1.25; }
    .ta-b-spec-caption { font-weight: 600; font-size: 0.82rem; line-height: 1.5; opacity: 0.85; }
    .ta-b-spec-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        color: color-mix(in srgb, var(--ta-accent) 65%, var(--ta-ink));
    }

    /* 美术：画框 + 展签 */
    /* 3 幅画：第一幅横跨两列，另两幅并排挂在下面 */
    .ta-b-gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.75rem 1.4rem;
    }
    .ta-b-gallery > :first-child { grid-column: span 2; }
    .ta-b-frame { display: block; }
    .ta-b-mat {
        padding: 0.7rem;
        background-color: var(--ta-paper);
        border: 3px solid var(--ta-ink);
        box-shadow: 6px 6px 0 var(--ta-ink);
        transition: transform 150ms ease, box-shadow 150ms ease;
    }
    .ta-b-frame:hover .ta-b-mat { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--ta-ink); }
    .ta-b-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        outline: 1px solid color-mix(in srgb, var(--ta-ink) 30%, transparent);
    }
    .ta-b-label {
        margin-top: 0.8rem;
        padding-left: 0.75rem;
        border-left: 4px solid var(--ta-accent);
    }
    .ta-b-label-title { font-weight: 900; font-size: 1.05rem; line-height: 1.25; }
    .ta-b-label-caption { margin-top: 0.2rem; font-weight: 600; font-size: 0.82rem; line-height: 1.5; opacity: 0.85; }
    .ta-b-label-tags { margin-top: 0.25rem; font-size: 0.75rem; font-style: italic; font-weight: 700; opacity: 0.65; }

    /* 吉祥物站在接缝上，垂直居中 */
    .ta-b-mascot {
        align-self: center;
        filter: drop-shadow(0 0 0.5rem var(--ta-paper));
    }

    @media (max-width: 1023px) {
        .ta-b { grid-template-columns: 1fr; }
        .ta-b-bg-left, .ta-b-bg-right { display: none; }
        .ta-b { background-color: var(--ta-paper); }
        .ta-b-mascot { order: -1; width: 7rem; margin: 0 auto; }
        .ta-b-head-art { align-items: flex-start; text-align: left; }
    }
    @media (max-width: 519px) {
