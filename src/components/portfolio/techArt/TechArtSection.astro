---
// Part 5 · 技术美术：吉祥物（握着画笔的猫耳画师）站在正中、几乎撑满整个 Part 的高度，背后一个又窄又尖的倒三角从 Part 顶边一直扎到底边，
// 左边「技术」、右边「美术」，两边都是列表，完全左右对称（文字面板靠外、封面靠三角；右栏的一切都是左栏的镜像）。
// 宽屏上分左中右三个区域：鼠标进左区，右栏往右飞出、吉祥物移到右栏的位置并绕笔尖往右斜，
// 倒三角跟过去一起斜，尖伸到 Part 底边以下，Part 里只露出一截梯形，两条边正好把整个人物包住；右区反过来；回到中间或离开这个 Part 就复原。
// 版式走 P3R 的平面设计路子：描边大斜体栏名、平行四边形的行逐行向中间错开，悬停整条填深黄。
// 这一页只用米色底（COLORS.khakiMilan）+ 白色 + 深黄（COLORS.yellow.dark），不用大块黑色；黑色只留给正文文字（吉祥物本身就是 yellow.dark）
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { techArtWorks, techArtLabels as L } from "@/i18n/components/portfolio/TechArtShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import mascot from "@/assets/portfolio/techArt/mascot-brush.svg";
// 深黄 / 白两色互换的版本，只在底部反色条那一截露出来
import mascotInverse from "@/assets/portfolio/techArt/mascot-brush-inverse.svg";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "tech-art")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = techArtWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        side: w.side,
        title: w.title ? t(w.title) : d.title[lang] || d.title.en || d.title.zh || w.projectId,
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: "yellow",
        colorBackground: "yellow",
        inDevelopment: !!d.inDevelopment,
    }];
});

// 左栏技术、右栏美术；reveal 方向都是从外侧滑向中间
const sides = (["tech", "art"] as const).map((side) => ({
    side,
    items: works.filter((w) => w.side === side),
    name: t(side === "tech" ? L.tech : L.art),
    heading: t(side === "tech" ? L.techHeading : L.artHeading),
    reveal: side === "tech" ? "right" : "left",
}));

// 两栏卡片用同一个行高：按项目多的那一栏平分屏幕高度
const rows = Math.max(...sides.map((s) => s.items.length));

const ink = COLORS.black;
const accent = COLORS.yellow.dark;
// 背景用米色（和 Part 1、2 同一个），深黄只留作强调色
const tint = COLORS.khakiMilan;
const paper = "#FFFDF7";
const sizesThumb = "(min-width: 1024px) 18vw, 50vw";
---

<section
        id={role.anchor}
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ta-accent: ${accent}; --ta-tint: ${tint}; --ta-ink: ${ink}; --ta-paper: ${paper}; --rows: ${rows};`}
        data-theme-bg={tint}
        data-theme-text={ink}
        data-ta-section
>
    <!-- 宽屏：倒三角贴着整个 Part 的上下边，底边正中是尖 -->
    <div class="pa-tri-page" aria-hidden="true">
        <div class="pa-tri pa-tri-back"></div>
        <div class="pa-tri"></div>
    </div>

    <!-- 最底部一条深黄反色条，贯穿整个 Part 宽度：条内三角换色（深黄边变白、白底变深黄），吉祥物也换色（见 .ta-mascot-inv） -->
    <div class="ta-bottom-bar" aria-hidden="true"></div>
    <div class="pa-tri-page pa-tri-inv" aria-hidden="true">
        <div class="pa-tri pa-tri-back"></div>
        <div class="pa-tri"></div>
    </div>

    <!-- 和 Part 2、3、4 同一套紧凑标题：编号 · 名称（这一部分不显示项目数） -->
    <header class="relative z-10 flex flex-wrap items-end gap-x-8 gap-y-3 mb-6 lg:mb-4" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ta-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ta-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
    </header>

    <div class="ta-stage pa">
        {sides.map((s) => (
                <div class:list={["ta-side", `ta-side-${s.side}`]}>
                    <div class="pa-head" data-reveal={s.reveal} data-reveal-once>
                        <span class="pa-head-en">{s.heading}</span>
                        <span class="pa-head-name">{s.name}</span>
                    </div>
                    <ol class="pa-list" style={`--n: ${s.items.length};`} data-reveal-children={s.reveal} data-reveal-once>
                        {s.items.map((w, i) => (
                                <li style={`--i: ${i};`}>
                                    <a href={href(w.id)} class="pa-row">
                                        <div class="pa-text">
                                            <span class="pa-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                                            <h3 class="pa-title">{w.title}</h3>
                                            <p class="pa-tags">{w.tags.join(" / ")}</p>
                                        </div>
                                        <div class="pa-thumb"><WorkCover work={w} lang={lang} sizes={sizesThumb} /></div>
                                    </a>
                                </li>
                        ))}
                    </ol>
                </div>
        ))}
        <div class="ta-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
            <!-- 窄屏用：吉祥物单独在最上面时，背后一个小倒三角 -->
            <div class="pa-tri pa-tri-local pa-tri-back"></div>
            <div class="pa-tri pa-tri-local"></div>
            <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
            <img class="ta-mascot-inv" src={mascotInverse.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
        </div>
    </div>
</section>

<script>
    // 左中右三个区域：鼠标在左栏范围 → data-focus="tech"，右栏范围 → "art"，中间或离开 → 清空。
    // 区域按「没有位移时」的栏位划分（offsetLeft 不受 transform 影响），所以栏飞走以后区域也不会跟着跑。
    // 同时量出吉祥物中线（--c）、它移到另一栏正中要走的距离（--to-art / --to-tech）、倾斜角（--tilt），
    // 三种状态下背景三角的 transform（--tri-none-* / --tri-tech-* / --tri-art-*），
    // 以及两栏卡片的阶梯、黄条斜边、展开成 3 × 2 后每张卡的位置。右栏的量法和左栏完全一样，只是在「左右镜像」的坐标里算
    // 吉祥物轮廓（含甩出的颜料点）的凸包，SVG 坐标；笔尖在 TIP
    const HULL = [[89, 245], [175, 43], [181, 35], [369, 88], [537, 140], [545, 143], [544, 621], [542, 631], [297, 1758], [295, 1748], [183, 1229], [129, 951], [107, 783], [89, 276]];
    const TIP = [297.41, 1758.17];

    type SideName = "tech" | "art";
    interface SideCfg {
        name: SideName;
        el: HTMLElement;
        /** 右栏在镜像坐标里算：x' = W - x */
        mirror: boolean;
        cards: HTMLElement[];
        /** 展开后的行数（第一列的卡数） */
        rows: number;
        /** 展开后贴着三角的那条边：鼠标越过它才算离开这一侧（section 宽度的比例） */
        focusEdge: number;
    }

    function initTechArtFocus() {
        document.querySelectorAll<HTMLElement>("[data-ta-section]").forEach((section) => {
            if (section.dataset.focusReady) return;
            section.dataset.focusReady = "1";
            const stage = section.querySelector<HTMLElement>(".ta-stage");
            const tech = section.querySelector<HTMLElement>(".ta-side-tech");
            const art = section.querySelector<HTMLElement>(".ta-side-art");
            const mascot = section.querySelector<HTMLElement>(".ta-mascot");
            if (!stage || !tech || !art || !mascot) return;
            const wide = window.matchMedia("(min-width: 1024px) and (hover: hover)");
            let techEdge = 0.38;
            let artEdge = 0.62;
            const sides: Record<SideName, SideCfg> = {
                tech: { name: "tech", el: tech, mirror: false, cards: [], rows: 3, focusEdge: 0.6 },
                art: { name: "art", el: art, mirror: true, cards: [], rows: 3, focusEdge: 0.4 },
            };
            for (const cfg of Object.values(sides)) {
                cfg.cards = Array.from(cfg.el.querySelectorAll<HTMLElement>(".pa-list > li > .pa-row"));
            }

            // 相对 section 的位置（不受 transform 影响）
            const pos = (el: HTMLElement) => {
                let left = 0;
                let top = 0;
                for (let e: HTMLElement | null = el; e && e !== section; e = e.offsetParent as HTMLElement | null) {
                    left += e.offsetLeft;
                    top += e.offsetTop;
                }
                return { left, top, width: el.offsetWidth, height: el.offsetHeight };
            };

            const measure = () => {
                const W = section.offsetWidth;
                const center = (el: HTMLElement) => el.offsetLeft + el.offsetWidth / 2;
                const m = center(mascot);
                section.style.setProperty("--c", `${stage.offsetLeft + m}px`);
                const H = section.offsetHeight;
                const slant = H * 0.2;
                // 人物倾斜后上半身往外偏（顶上偏出 slant），少走半个 slant，让斜着的人物整体落在那一栏正中、不顶出页面
                const toArt = center(art) - m - slant / 2;
                const toTech = center(tech) - m + slant / 2;
                section.style.setProperty("--to-art", `${toArt}px`);
                section.style.setProperty("--to-tech", `${toTech}px`);
                const tilt = Math.atan2(slant, H);
                section.style.setProperty("--tilt", `${(tilt * 180 / Math.PI).toFixed(2)}deg`);
                // 聚焦时的三角：尖沿着倾斜后的人物中轴，一直伸到 Part 底边以下 depth 处，所以在 Part 里只露出上面一截梯形；
                // 两条边按人物轮廓的凸包（SVG 坐标）算，刚好把人物包住，再留 pad 的边（白色层窄、深黄层宽）
                const depth = H * 0.8;
                const k = mascot.offsetWidth / 592;
                const frame = (sign: number) => {
                    const t = tilt * sign;
                    const ax = -depth * Math.tan(t);
                    const pts = HULL.map(([x, y]) => {
                        const dx = (x - TIP[0]) * k;
                        const up = (TIP[1] - y) * k;
                        // CSS rotate 正角是顺时针：笔尖上方的点往右偏
                        return [dx * Math.cos(t) + up * Math.sin(t) - ax, up * Math.cos(t) - dx * Math.sin(t) + depth];
                    });
                    const edges = (pad: number) => {
                        const kl = Math.max(...pts.map(([rx, ry]) => (pad - rx) / ry));
                        const kr = Math.max(...pts.map(([rx, ry]) => (rx + pad) / ry));
                        return [ax - kl * (H + depth), ax + kr * (H + depth)];
                    };
                    return { ax, front: edges(8), back: edges(22) };
                };
                // 三角不再用 clip-path 做动画（每帧都要重绘整块 section，会掉帧发抖），
                // 而是一个固定的底三角（BW × BH 的盒子里：左上、右上、底边正中），用 transform 摆到目标三角上：
                // 任意三角都能由仿射变换得到，拆成 translate · skewX · scale 这几个函数，过渡时逐项线性插值，
                // 中间每一帧仍然是三角，而且全程在合成层上跑。底三角取得比目标大，只缩不放，边缘不会糊
                const cx = stage.offsetLeft + m;
                const w = mascot.offsetWidth;
                const BW = 2400;
                const BH = Math.ceil(H + depth + 10);
                section.style.setProperty("--tri-bw", `${BW}px`);
                section.style.setProperty("--tri-bh", `${BH}px`);
                const place = (x0: number, x1: number, apexX: number, apexY: number) => {
                    // 底三角 (0,0) (BW,0) (BW/2,BH) → 目标 (x0,0) (x1,0) (apexX,apexY)
                    const a = (x1 - x0) / BW;
                    const c = (apexX - x0 - (x1 - x0) / 2) / BH;
                    const d = apexY / BH;
                    return `translate(${x0.toFixed(1)}px, 0px) skewX(${Math.atan2(c, d).toFixed(4)}rad) scale(${a.toFixed(4)}, ${d.toFixed(4)})`;
                };
                // 居中：顶边宽度不变（半宽 0.525 / 0.6 倍吉祥物宽），尖往下伸到 Part 底边以下 drop 处，
                // Part 里看到的是底边被切平的梯形；两边因此更陡
                const drop = H * 0.5;
                for (const [layer, hw] of [["f", 0.525], ["b", 0.6]] as const) {
                    section.style.setProperty(`--tri-none-${layer}`, place(cx - w * hw, cx + w * hw, cx, H + drop));
                }
                // 居中梯形白色层边的斜率（每往下 1px 横向收多少），列表行的斜边、阶梯和黄条都跟它平行
                const triSlope = (w * 0.525) / (H + drop);
                section.style.setProperty("--tri-slope", triSlope.toFixed(4));
                // 聚焦左栏：吉祥物去右栏（tip = cx + toArt），往右斜；聚焦右栏反过来
                const focusTri = {
                    tech: { f: frame(1), tip: cx + toArt },
                    art: { f: frame(-1), tip: cx + toTech },
                };
                for (const name of ["tech", "art"] as const) {
                    const { f, tip } = focusTri[name];
                    section.style.setProperty(`--tri-${name}-f`, place(tip + f.front[0], tip + f.front[1], tip + f.ax, H + depth));
                    section.style.setProperty(`--tri-${name}-b`, place(tip + f.back[0], tip + f.back[1], tip + f.ax, H + depth));
                }

                // 两栏里行数多的那栏定下展开后的行高，两边卡片一样大
                const maxN = Math.max(...Object.values(sides).map((c) => c.cards.length));
                for (const cfg of Object.values(sides)) layoutSide(cfg, { W, H, cx, w, drop, depth, triSlope, maxN, focus: focusTri[cfg.name] });

                if (!section.dataset.triReady) {
                    // 第一次摆好时不要动画（否则三角会从没变换的样子飞过来，后台标签页里还会卡在半路），
                    // 下一帧之后再打开过渡
                    section.dataset.triReady = "1";
                    requestAnimationFrame(() => requestAnimationFrame(() => { section.dataset.triAnim = "1"; }));
                }
                techEdge = (stage.offsetLeft + tech.offsetLeft + tech.offsetWidth) / W;
                artEdge = (stage.offsetLeft + art.offsetLeft) / W;
            };

            // 一栏的卡片：阶梯往三角拉近、黄条斜边对齐卡片、展开后 3 × 2 的位置。都在「这一栏靠三角的一侧是右边」的坐标里算，
            // 右栏先镜像（x' = W - x），算完再换回来
            const layoutSide = (
                cfg: SideCfg,
                g: { W: number; H: number; cx: number; w: number; drop: number; depth: number; triSlope: number; maxN: number; focus: { f: { ax: number; back: number[] }; tip: number } },
            ) => {
                const { W, H, w, drop, depth, triSlope: slope, maxN } = g;
                const el = cfg.el;
                const list = el.querySelector<HTMLElement>(".pa-list");
                const bar = el.querySelector<HTMLElement>(".pa-head-name");
                const li0 = list?.querySelector<HTMLElement>(":scope > li");
                if (!list || !bar || !li0) return;
                const X = (x: number) => (cfg.mirror ? W - x : x);
                // 镜像坐标里的盒子：左边 = 镜像后的左边
                const boxM = (e: HTMLElement) => {
                    const p = pos(e);
                    return { left: cfg.mirror ? W - (p.left + p.width) : p.left, top: p.top, width: p.width, height: p.height };
                };
                const cxM = X(g.cx);
                const rowH = li0.offsetHeight;
                const gap = parseFloat(getComputedStyle(list).rowGap) || 0;
                const step = (rowH + gap) * slope;
                const n = list.children.length;
                const y0 = pos(li0).top;
                const listM = boxM(list);
                // 第一张卡不拉近时，靠三角那条斜边的顶端
                const x0 = listM.left + listM.width - (n - 1) * step - rowH * slope;
                const edgeBack = (y: number) => cxM - w * 0.6 * ((H + drop - y) / (H + drop));
                // 整栏往三角拉近间距的 45%
                const pull = Math.max(0, (edgeBack(y0) - x0) * 0.45);
                el.style.setProperty("--pull", `${pull.toFixed(1)}px`);
                const line = (y: number) => x0 + pull + slope * (y - y0);
                // 黄条靠三角那条斜边的两端，换成相对黄条自身左边的真实坐标
                const b = pos(bar);
                const barX = (xm: number) => `${(X(xm) - b.left).toFixed(1)}px`;
                el.style.setProperty("--bar-t", barX(line(b.top)));
                el.style.setProperty("--bar-b", barX(line(b.top + b.height)));

                // ---------- 展开后的卡片位置 ----------
                // 三角跟着吉祥物斜过去以后，靠这一栏的那条边（深黄外层）：左栏是它的左边，右栏是它的右边（镜像后也是「左边」）
                const { f, tip } = g.focus;
                const eX0 = cfg.mirror ? W - (tip + f.back[1]) : tip + f.back[0];
                const apexX = cfg.mirror ? W - (tip + f.ax) : tip + f.ax;
                const eS = (apexX - eX0) / (H + depth);
                const gapTri = 44;
                const L = (y: number) => eX0 + eS * y - gapTri;
                const rows = Math.ceil(n / 2);
                cfg.rows = rows;
                const total = maxN * rowH + (maxN - 1) * gap;
                const rowsMax = Math.ceil(maxN / 2);
                const rowF = (total - (rowsMax - 1) * gap) / rowsMax;
                const colGap = 12;
                const listLeft = listM.left;
                // 第二列宽度固定：按第一行把可用宽度对半分
                const wB = (Math.min(L(y0), L(y0 + rowF)) - listLeft - colGap) / 2;
                // 所有斜边的新斜度：每往下 1px 往外 eS（镜像坐标）
                const cutF = rowF * eS;
                const lis = Array.from(list.children) as HTMLElement[];
                // 每一行第二列靠三角的一边（斜边整个落在 L 上：取斜边更靠外的那一端）
                const innerOf = (r: number) => {
                    const top = y0 + r * (rowF + gap);
                    return Math.max(L(top), L(top + rowF));
                };
                const fws: number[] = [];
                lis.forEach((li, i) => {
                    const r = i % rows;
                    const top = y0 + r * (rowF + gap);
                    const leftB = innerOf(r) - wB;
                    // 第一列都贴着栏的外边，宽度伸到第二列前面
                    const [xm, wid] = i < rows ? [listLeft, leftB - colGap - listLeft] : [leftB, wB];
                    const realLeft = cfg.mirror ? W - (xm + wid) : xm;
                    const p0 = pos(li);
                    li.style.setProperty("--f-x", `${(realLeft - p0.left).toFixed(1)}px`);
                    li.style.setProperty("--f-y", `${(top - p0.top).toFixed(1)}px`);
                    li.style.setProperty("--f-w", `${wid.toFixed(1)}px`);
                    li.style.setProperty("--f-h", `${rowF.toFixed(1)}px`);
                    fws.push(wid);
                });
                list.style.setProperty("--f-cut", `${cutF.toFixed(1)}px`);
                // 封面统一宽度 = 最窄那张卡减去文字面板宽度（--text-w 是 clamp()，放个探针量出实际值）
                const probe = document.createElement("div");
                probe.style.cssText = "position:absolute;visibility:hidden;width:var(--text-w)";
                el.append(probe);
                const textW = probe.offsetWidth || 200;
                probe.remove();
                list.style.setProperty("--img-w", `${Math.max(40, li0.offsetWidth - textW).toFixed(1)}px`);
                list.style.setProperty("--img-w-f", `${Math.max(40, Math.min(...fws) - textW).toFixed(1)}px`);
                // 黄条的斜边也换到新斜度，落在第二列斜边那条线往上的延长线上
                el.style.setProperty("--bar-t-f", barX(L(b.top)));
                el.style.setProperty("--bar-b-f", barX(L(b.top + b.height)));
                // 展开后鼠标可以一直移到三角边上都算这一侧
                cfg.focusEdge = X(L(y0) + gapTri) / W;
            };

            // 卡片的展开 / 收起用 Web Animations 驱动：每次切换先读出每张卡「此刻屏幕上的样子」（包括正在播的动画），
            // 取消旧动画，切换状态后再从这个样子动画到新状态（CSS 里的终态）。所以随时进出都从当前位置接着走，不会跳。
            // 第二列的卡要换列：先往外滑淡出，再从三角那一侧淡入落位；中途打断时按当前透明度缩短淡出那一段
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
            const snap = (el: HTMLElement) => {
                const cs = getComputedStyle(el);
                return {
                    transform: cs.transform === "none" ? "translate(0px, 0px)" : cs.transform,
                    width: cs.width,
                    height: cs.height,
                    gridTemplateColumns: cs.gridTemplateColumns,
                    opacity: Number(cs.opacity),
                };
            };
            const EASE_MOVE = "cubic-bezier(0.7, 0, 0.2, 1)";
            const EASE_SWAP = "cubic-bezier(0.5, 0, 0.2, 1)";
            const animateCards = (involved: { cfg: SideCfg; expanding: boolean }[], apply: () => void) => {
                const all = involved.flatMap(({ cfg }) => cfg.cards);
                if (!wide.matches || reduceMotion.matches) {
                    all.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
                    apply();
                    return;
                }
                const from = new Map(all.map((el) => [el, snap(el)]));
                // 被打断时还在动（或还在等错落延迟）的卡，接着动、不再重新等延迟，否则会停在半路一下
                const moving = new Map(all.map((el) => [el, el.getAnimations().some((a) => a.playState === "running")]));
                all.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
                apply();
                for (const { cfg, expanding } of involved) {
                    // 靠三角的一侧：左栏在右（+），右栏在左（-）
                    const side = cfg.mirror ? -1 : 1;
                    cfg.cards.forEach((el, i) => {
                        const f = from.get(el)!;
                        const t = snap(el);
                        const delay = moving.get(el) ? 0 : i * 70;
                        const frame = (v: typeof f, extra = "", opacity = v.opacity) => ({
                            transform: `${v.transform} ${extra}`.trim(),
                            width: v.width,
                            height: v.height,
                            gridTemplateColumns: v.gridTemplateColumns,
                            opacity: String(opacity),
                        });
                        if (i < cfg.rows) {
                            el.animate([frame(f), frame(t, "", 1)], { duration: 650, delay, easing: EASE_MOVE, fill: "backwards" });
                            return;
                        }
                        // 换列：展开时往下滑出、从三角那一侧进来；收起时往三角那一侧滑出、从下面上来
                        const sideShift = `translateX(${48 * side}px)`;
                        const out = expanding ? "translateY(40px)" : sideShift;
                        const into = expanding ? sideShift : "translateY(40px)";
                        const cut = 0.35 * f.opacity;
                        const kf: Keyframe[] = [];
                        if (cut > 0.01) {
                            kf.push({ ...frame(f), offset: 0, easing: EASE_SWAP });
                            kf.push({ ...frame(f, out, 0), offset: cut });
                            kf.push({ ...frame(t, into, 0), offset: Math.min(cut + 0.001, 0.999), easing: EASE_SWAP });
                        } else {
                            kf.push({ ...frame(t, into, 0), offset: 0, easing: EASE_SWAP });
                        }
                        kf.push({ ...frame(t, "", 1), offset: 1 });
                        el.animate(kf, { duration: 800, delay, fill: "backwards" });
                    });
                }
            };
            let sideLocked = false;
            let lockedAt = 0;
            const leaveSide = () => {
                sideLocked = true;
                lockedAt = performance.now();
                setFocus("");
            };
            const setFocus = (focus: string) => {
                const prev = section.dataset.focus ?? "";
                if (prev === focus) return;
                const apply = () => {
                    if (focus) section.dataset.focus = focus;
                    else delete section.dataset.focus;
                };
                const involved = (["tech", "art"] as const)
                    .filter((name) => prev === name || focus === name)
                    .map((name) => ({ cfg: sides[name], expanding: focus === name }));
                if (involved.length) animateCards(involved, apply);
                else apply();
            };

            section.addEventListener("pointermove", (e) => {
                if (!wide.matches || e.pointerType !== "mouse") return;
                const r = section.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width;
                // 滞回：已经在某一边时，要往中间多走 2% 才退出，免得鼠标停在边界上来回抖、动画反复重启；
                // 展开时一直到斜过去的三角边上都算这一侧，越过就回到中间（不直接跳到另一侧）
                const cur = section.dataset.focus ?? "";
                if (cur === "tech") {
                    if (x > Math.max(techEdge + 0.02, sides.tech.focusEdge)) leaveSide();
                    return;
                }
                if (cur === "art") {
                    if (x < Math.min(artEdge - 0.02, sides.art.focusEdge)) leaveSide();
                    return;
                }
                // 刚从一边退回中间：先锁住两边，鼠标经过中间那一栏（吉祥物原来的位置）或过了一会儿再动，才重新判断
                if (sideLocked) {
                    if (x >= techEdge && x <= artEdge) sideLocked = false;
                    else if (performance.now() - lockedAt > 900) sideLocked = false;
                    else return;
                }
                setFocus(x < techEdge ? "tech" : x > artEdge ? "art" : "");
            });
            section.addEventListener("pointerleave", () => { sideLocked = false; setFocus(""); });
            wide.addEventListener("change", () => { setFocus(""); measure(); });
            new ResizeObserver(measure).observe(section);
            measure();
        });
    }
    document.addEventListener("astro:page-load", initTechArtFocus);
</script>

<style>
    .ta-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    /* ---------- 三个版式共用的舞台：左栏 · 吉祥物 · 右栏 ---------- */
    /* 中间一栏放宽，吉祥物按 1:3 的原比例几乎撑满整个 Part 的高度；两边列表在它的高度里垂直居中 */
    .ta-stage {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) var(--mascot-w) minmax(0, 1fr);
        gap: clamp(1.5rem, 2.6vw, 3rem);
        align-items: center;
        isolation: isolate;
    }
    .ta-side-tech { order: 0; }
    /* 吉祥物往上伸进标题那一行（中间是空的），往下吃掉 section 的下内边距（lg:py-16 = 4rem），
       这样笔尖正好落在 Part 的底边，和倒三角的尖重合（SVG 的 viewBox 已经裁到笔尖为止，笔尖在水平正中） */
    .ta-mascot {
        order: 1;
        position: relative;
        /* 贴着这一行的底边：列表比吉祥物高的时候笔尖也还在 Part 的底边上 */
        align-self: end;
        margin-top: -5.5rem;
        margin-bottom: -4rem;
    }
    .ta-side-art { order: 2; }
    .ta-mascot img {
        position: relative;
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
        user-select: none;
    }
    /* 两栏不单独抬层级：按 DOM 顺序画在背景三角之上、吉祥物之下（左栏那条长黄条要从吉祥物身后穿过去） */
    .ta-side {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        min-width: 0;
    }

    /* ---------- 左中右三个区域的聚焦（脚本写 data-focus）---------- */
    /* 入场动画占用了 translate / scale，这里的位移只用 transform */
    [data-ta-section] {
        --ta-move: 650ms cubic-bezier(0.7, 0, 0.2, 1);
        /* 吉祥物那一栏的宽度：随屏宽，但人物（宽高比 0.3425）高度不超过一屏减去上内边距，整个 Part 在一屏里放得下 */
        --mascot-w: min(clamp(14rem, 24vw, 28rem), calc((100vh - 4.5rem) * 0.3425));
    }
    .ta-side,
    .ta-mascot {
        transition: transform var(--ta-move), opacity 450ms ease;
        will-change: transform;
    }
    [data-focus="tech"] .ta-side-art {
        transform: translateX(calc(100% + 40vw));
        opacity: 0;
        pointer-events: none;
    }
    /* 吉祥物绕笔尖（底边正中）往外斜一点 */
    .ta-mascot { transform-origin: 50% 100%; }
    [data-focus="tech"] .ta-mascot { transform: translateX(var(--to-art, 0px)) rotate(var(--tilt, 0deg)); }
    [data-focus="art"] .ta-side-tech {
        transform: translateX(calc(-100% - 40vw));
        opacity: 0;
        pointer-events: none;
    }
    [data-focus="art"] .ta-mascot { transform: translateX(var(--to-tech, 0px)) rotate(calc(-1 * var(--tilt, 0deg))); }

    .ta-bottom-bar {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: var(--bar-h);
        background-color: var(--ta-accent);
        pointer-events: none;
    }
    /* 反色条：三角和吉祥物各有一份换了色的副本，只露出底部条那一截 */
    [data-ta-section] { --bar-h: 2.25rem; }
    .pa-tri-page.pa-tri-inv { clip-path: inset(calc(100% - var(--bar-h)) 0 0 0); }
    .pa-tri-inv .pa-tri { background-color: var(--ta-accent); }
    .pa-tri-inv .pa-tri-back { background-color: var(--ta-paper); }
    .ta-mascot .ta-mascot-inv {
        position: absolute;
        inset: 0;
        clip-path: inset(calc(100% - var(--bar-h)) 0 0 0);
    }

    /* ======================= A · P3R ======================= */
    /* 倒三角：白色在前，深黄的宽一点垫在后面，两条斜边露出深黄的边 */
    .pa-tri {
        position: absolute;
        left: 50%;
        translate: -50% 0;
        background-color: var(--ta-paper);
        clip-path: polygon(0 0, 100% 0, 50% 100%);
    }
    .pa-tri-back { background-color: var(--ta-accent); }
    /* 宽屏：铺满整个 Part 的高度，水平居中（舞台左右对称，中线就是吉祥物的中线）；
       宽度按吉祥物那一栏算（和 .ta-stage 的中栏同一个 clamp），只比它宽一点，所以又窄又尖 */
    .pa-tri-page {
        --tri-w: var(--mascot-w);
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }
    /* 脚本生效前的兜底：整块铺满，用 clip-path 画居中的三角（上边两个角 + 底边的尖），--hw 是三角半宽 */
    .pa-tri-page .pa-tri {
        --tip: var(--c, 50%);
        --hw: calc(var(--tri-w) * 0.525);
        inset: 0;
        left: 0;
        translate: none;
        clip-path: polygon(calc(var(--tip) - var(--hw)) 0, calc(var(--tip) + var(--hw)) 0, var(--tip) 100%);
    }
    .pa-tri-page .pa-tri-back { --hw: calc(var(--tri-w) * 0.6); }
    /* 脚本量好以后（data-tri-ready）改用 transform 摆三角：一个 BW × BH 的底三角，
       居中 / 聚焦左栏 / 聚焦右栏三种状态各有一组 translate · skewX · scale（-f 白色层，-b 深黄层）。
       聚焦时三角跟着吉祥物过去、跟着它一起斜，尖伸到 Part 底边以下，Part 里只看到一截梯形，两条边刚好包住人物 */
    [data-tri-ready] .pa-tri-page .pa-tri {
        inset: auto;
        top: 0;
        left: 0;
        width: var(--tri-bw);
        height: var(--tri-bh);
        transform-origin: 0 0;
        clip-path: polygon(0 0, 100% 0, 50% 100%);
        transform: var(--tri-none-f);
        will-change: transform;
    }
    [data-tri-anim] .pa-tri-page .pa-tri { transition: transform var(--ta-move); }
    [data-tri-ready] .pa-tri-page .pa-tri-back { transform: var(--tri-none-b); }
    [data-tri-ready][data-focus="tech"] .pa-tri-page .pa-tri { transform: var(--tri-tech-f); }
    [data-tri-ready][data-focus="tech"] .pa-tri-page .pa-tri-back { transform: var(--tri-tech-b); }
    [data-tri-ready][data-focus="art"] .pa-tri-page .pa-tri { transform: var(--tri-art-f); }
    [data-tri-ready][data-focus="art"] .pa-tri-page .pa-tri-back { transform: var(--tri-art-b); }
    .pa-tri-local { display: none; }
    .pa-head { display: flex; flex-direction: column; line-height: 1; }
    /* 两栏都贴顶；左栏标题左对齐，右栏标题右对齐（镜像），下面的名字条拉满整栏 */
    .ta-side { align-self: start; }
    .pa-head { align-items: stretch; }
    .ta-side-tech .pa-head { text-align: left; }
    .ta-side-art .pa-head { text-align: right; }
    .pa-head-en {
        font-family: 'Roboto', sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: clamp(2.2rem, min(3.6vw, 6vh), 4rem);
        letter-spacing: -0.03em;
        /* 实心深黄，不描边 */
        color: var(--ta-accent);
    }
    .pa-head-name {
        display: inline-block;
        margin-top: 0.3rem;
        padding: 0.3rem 1rem;
        font-weight: 900;
        font-size: clamp(1.3rem, 1.8vw, 1.8rem);
        background-color: var(--ta-accent);
        color: var(--ta-paper);
        transform: skewX(-14deg);
    }
    /* 宽屏的黄条：梯形——外侧伸到画面边缘（section 的 overflow: hidden 在屏幕边裁掉），
       靠三角的一侧是斜边，落在下面卡片斜边连成的那条线上（--bar-t / --bar-b 由脚本算，相对黄条自身左边）。
       不再整体 skew，改用 clip-path 切，字保持斜体，仍然从栏的外边开始排 */
    @media (min-width: 1024px) {
        .pa-head-name {
            font-style: italic;
            transform: none;
            transition: clip-path var(--ta-move);
        }
        .ta-side-tech .pa-head-name {
            margin-left: -100vw;
            margin-right: -50vw;
            padding-left: calc(100vw + 1rem);
            clip-path: polygon(0 0, var(--bar-t, 100%) 0, var(--bar-b, 100%) 100%, 0 100%);
        }
        .ta-side-art .pa-head-name {
            margin-right: -100vw;
            margin-left: -50vw;
            padding-right: calc(100vw + 1rem);
            clip-path: polygon(var(--bar-t, 0%) 0, 100% 0, 100% 100%, var(--bar-b, 0%) 100%);
        }
        [data-focus="tech"] .ta-side-tech .pa-head-name {
            clip-path: polygon(0 0, var(--bar-t-f, 100%) 0, var(--bar-b-f, 100%) 100%, 0 100%);
        }
        [data-focus="art"] .ta-side-art .pa-head-name {
            clip-path: polygon(var(--bar-t-f, 0%) 0, 100% 0, 100% 100%, var(--bar-b-f, 0%) 100%);
        }
    }
    /* ---------- 列表行：直角梯形，靠中间的那条边是斜的，和居中时三角最近的那条边平行 ----------
       行高固定（--row-h），斜边的横向收进量 = 行高 × 三角斜率（--tri-slope，脚本按三角算好，之前先用 0.18）。
       每行再往中间错开一个「(行高 + 行距) × 斜率」，几行的斜边连成一条和三角边平行的直线。
       内容只留标题（最多两行）和一行标签，不显示编号 */
    .pa-list {
        /* 一屏高度扣掉 section 内边距、Part 标题、栏标题和黄条（约 21.5rem），按行数（--rows，两栏取多的）平分 */
        --row-h: clamp(3.5rem, calc((100vh - 21.5rem) / var(--rows, 5) - var(--row-gap)), 9rem);
        --row-gap: 0.8rem;
        --cut: calc(var(--row-h) * var(--tri-slope, 0.18));
        --step: calc((var(--row-h) + var(--row-gap)) * var(--tri-slope, 0.18));
        display: flex;
        flex-direction: column;
        gap: var(--row-gap);
    }
    /* 整栏再往三角拉近 --pull（脚本算），卡片可以伸进栏和吉祥物之间的空隙 */
    .ta-side-tech .pa-list > li { margin-right: calc((var(--n) - 1 - var(--i)) * var(--step) - var(--pull, 0px)); }
    .ta-side-art .pa-list > li { margin-left: calc((var(--n) - 1 - var(--i)) * var(--step) - var(--pull, 0px)); }
    /* 每张卡两块，紧贴在一起：文字面板在外侧（固定宽度）、封面靠三角（所有卡一样宽，--img-w 由脚本算）。
       两块都是平行四边形，四条斜边全和三角平行；封面往文字面板里伸 |cut|，两块沿同一条斜缝咬合。
       --cut 为正：靠三角那条边上窄下宽（居中时）；为负：上宽下窄（展开后三角斜向另一边）。两种都能画。
       --tl / --bl：外侧斜边在顶上 / 底下往里收多少。右栏的所有 polygon 都是左栏的左右镜像 */
    .pa-row {
        position: relative;
        /* 行高随屏幕变，矮到放不下标签那一行时就不显示标签（见下面的 @container） */
        container: pa-row / size;
        display: grid;
        height: var(--row-h);
        --tl: max(-1 * var(--cut), 0px);
        --bl: max(var(--cut), 0px);
        --abs-cut: max(var(--cut), -1 * var(--cut));
    }
    .ta-side { --text-w: clamp(10rem, 13vw, 15rem); }
    .ta-side-tech .pa-row { grid-template-columns: minmax(0, 1fr) var(--img-w, 50%); }
    .ta-side-art .pa-row { grid-template-columns: var(--img-w, 50%) minmax(0, 1fr); }
    .pa-thumb {
        position: relative;
        overflow: hidden;
        background-color: var(--ta-accent);
    }
    .pa-thumb :global(img) { transition: scale 500ms ease; }
    .pa-row:hover .pa-thumb :global(img) { scale: 1.06; }
    .pa-text {
        position: relative;
        background-color: var(--ta-paper);
        transition: background-color 180ms ease, clip-path var(--ta-move) var(--d, 0ms);
    }
    .ta-side-tech .pa-thumb {
        margin-left: calc(-1 * var(--abs-cut));
        clip-path: polygon(var(--tl) 0, calc(100% - var(--bl)) 0, calc(100% - var(--tl)) 100%, var(--bl) 100%);
    }
    .ta-side-art .pa-thumb {
        /* 封面在 DOM 里排在文字后面，右栏挪到左边（靠三角） */
        order: -1;
        margin-right: calc(-1 * var(--abs-cut));
        clip-path: polygon(var(--bl) 0, calc(100% - var(--tl)) 0, calc(100% - var(--bl)) 100%, var(--tl) 100%);
    }
    .ta-side-tech .pa-text {
        clip-path: polygon(var(--tl) 0, calc(100% - var(--bl)) 0, calc(100% - var(--tl)) 100%, var(--bl) 100%);
        padding-left: calc(12px + 1.1rem + var(--abs-cut));
        padding-right: calc(1.1rem + var(--abs-cut));
    }
    .ta-side-art .pa-text {
        clip-path: polygon(var(--bl) 0, calc(100% - var(--tl)) 0, calc(100% - var(--bl)) 100%, var(--tl) 100%);
        padding-right: calc(12px + 1.1rem + var(--abs-cut));
        padding-left: calc(1.1rem + var(--abs-cut));
        align-items: flex-end;
        text-align: right;
    }
    /* 外侧一道 12px 深黄斜边（面板被 clip-path 切过，普通 border 会被切掉，所以用伪元素沿斜边画一条等宽的斜带） */
    .pa-text::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background-color: var(--ta-accent);
        transition: clip-path var(--ta-move) var(--d, 0ms);
    }
    .ta-side-tech .pa-text::before {
        clip-path: polygon(var(--tl) 0, calc(var(--tl) + 12px) 0, calc(var(--bl) + 12px) 100%, var(--bl) 100%);
    }
    .ta-side-art .pa-text::before {
        clip-path: polygon(calc(100% - var(--tl) - 12px) 0, calc(100% - var(--tl)) 0, calc(100% - var(--bl)) 100%, calc(100% - var(--bl) - 12px) 100%);
    }

    /* 文字排法照这页最上面的总览菜单：粗体标题，下面一行粗体标签（不大写、不加字距，和总览里「N 个项目」那行一样）；不显示编号 */
    .pa-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.3rem;
        min-width: 0;
        padding: 0.45rem 1.1rem;
    }
    .pa-title {
        min-width: 0;
        font-weight: 900;
        font-size: clamp(0.95rem, min(1.25vw, 2.2vh), 1.3rem);
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    @container pa-row (max-height: 100px) {
        .pa-tags { display: none; }
    }
    /* 再矮的行：标题只留一行 */
    @container pa-row (max-height: 78px) {
        .pa-title { -webkit-line-clamp: 1; }
        .pa-text { gap: 0.15rem; padding-block: 0.3rem; }
    }
    .pa-tags {
        max-width: 100%;
        font-size: clamp(0.8rem, 0.95vw, 0.95rem);
        font-weight: 900;
        white-space: nowrap;
        overflow: hidden;
