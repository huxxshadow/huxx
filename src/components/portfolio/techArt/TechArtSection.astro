---
// Part 5 · 技术美术：吉祥物（握着画笔的猫耳画师）站在正中、几乎撑满整个 Part 的高度，背后一个又窄又尖的倒三角从 Part 顶边一直扎到底边，
// 左边「技术」、右边「美术」，两边都是列表，左右镜像（左栏文字靠外、图靠中间，右栏反过来）。
// 宽屏上分左中右三个区域：鼠标进左区，右栏往右飞出、吉祥物移到右栏的位置并绕笔尖往右斜，
// 倒三角跟过去一起斜，尖仍在笔尖上，两条边正好把整个人物包住；右区反过来；回到中间或离开这个 Part 就复原。
// 版式走 P3R 的平面设计路子：描边大斜体栏名、平行四边形的行逐行向中间错开，悬停整条填深黄。
// 这一页只用白色 + COLORS.yellow 的深浅两档，不用大块黑色；黑色只留给正文文字（吉祥物本身就是 yellow.dark）
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { techArtWorks, techArtLabels as L } from "@/i18n/components/portfolio/TechArtShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import mascot from "@/assets/portfolio/techArt/mascot-brush.svg";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "tech-art")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = techArtWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        side: w.side,
        title: w.title ? t(w.title) : d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: "yellow",
        colorBackground: "yellow",
        inDevelopment: !!d.inDevelopment,
    }];
});

// 左栏技术、右栏美术；reveal 方向都是从外侧滑向中间
const sides = (["tech", "art"] as const).map((side) => ({
    side,
    items: works.filter((w) => w.side === side).map((w, i) => ({
        ...w,
        num: String(i + 1).padStart(2, "0"),
        code: `${side === "tech" ? "T" : "A"}-${String(i + 1).padStart(2, "0")}`,
    })),
    name: t(side === "tech" ? L.tech : L.art),
    en: side === "tech" ? "TECHNICAL" : "ART",
    sub: t(side === "tech" ? L.techSub : L.artSub),
    reveal: side === "tech" ? "right" : "left",
}));

const ink = COLORS.black;
const accent = COLORS.yellow.dark;
const tint = COLORS.yellow.light;
const paper = "#FFFDF7";
const sizesThumb = "(min-width: 1024px) 14vw, 40vw";
---

<section
        id={role.anchor}
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ta-accent: ${accent}; --ta-tint: ${tint}; --ta-ink: ${ink}; --ta-paper: ${paper};`}
        data-theme-bg={tint}
        data-theme-text={ink}
        data-ta-section
>
    <!-- 宽屏：倒三角贴着整个 Part 的上下边，底边正中是尖 -->
    <div class="pa-tri-page" aria-hidden="true">
        <div class="pa-tri pa-tri-back"></div>
        <div class="pa-tri"></div>
    </div>

    <!-- 和 Part 2、3、4 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="relative z-10 flex flex-wrap items-end gap-x-8 gap-y-3 mb-6 lg:mb-4" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ta-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ta-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{works.length} {t(L.projects)}</span>
    </header>

    <div class="ta-stage pa">
        {sides.map((s) => (
                <div class:list={["ta-side", `ta-side-${s.side}`]}>
                    <div class="pa-head" data-reveal={s.reveal} data-reveal-once>
                        <span class="pa-head-en">{s.en}</span>
                        <span class="pa-head-name">{s.name}<small>{s.sub}</small></span>
                    </div>
                    <ol class="pa-list" data-reveal-children={s.reveal} data-reveal-once>
                        {s.items.map((w, i) => (
                                <li style={`--i: ${i};`}>
                                    <a href={href(w.id)} class="pa-row">
                                        <span class="pa-num">{w.num}</span>
                                        <div class="pa-body">
                                            <h3 class="pa-title">{w.title}</h3>
                                            <p class="pa-caption">{w.caption}</p>
                                            <p class="pa-tags">{w.tags.join(" / ")}</p>
                                        </div>
                                        <div class="pa-thumb"><WorkCover work={w} lang={lang} sizes={sizesThumb} /></div>
                                    </a>
                                </li>
                        ))}
                    </ol>
                </div>
        ))}
        <div class="ta-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
            <!-- 窄屏用：吉祥物单独在最上面时，背后一个小倒三角 -->
            <div class="pa-tri pa-tri-local pa-tri-back"></div>
            <div class="pa-tri pa-tri-local"></div>
            <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
        </div>
    </div>
</section>

<script>
    // 左中右三个区域：鼠标在左栏范围 → data-focus="tech"，右栏范围 → "art"，中间或离开 → 清空。
    // 区域按「没有位移时」的栏位划分（offsetLeft 不受 transform 影响），所以栏飞走以后区域也不会跟着跑。
    // 同时量出吉祥物中线（--c）、它移到两栏正中要走的距离（--to-art / --to-tech）、倾斜角（--tilt），
    // 以及斜过去以后三角顶边从尖往左 / 往右要伸多远才正好包住人物（--wl-tech / --wr-tech / --wl-art / --wr-art），
    // 都是相对 section 的 CSS 像素，给 CSS 里的位移和 clip-path 用
    function initTechArtFocus() {
        document.querySelectorAll<HTMLElement>("[data-ta-section]").forEach((section) => {
            if (section.dataset.focusReady) return;
            section.dataset.focusReady = "1";
            const stage = section.querySelector<HTMLElement>(".ta-stage");
            const tech = section.querySelector<HTMLElement>(".ta-side-tech");
            const art = section.querySelector<HTMLElement>(".ta-side-art");
            const mascot = section.querySelector<HTMLElement>(".ta-mascot");
            if (!stage || !tech || !art || !mascot) return;
            const wide = window.matchMedia("(min-width: 1024px) and (hover: hover)");
            let techEdge = 0.38;
            let artEdge = 0.62;

            const measure = () => {
                const W = section.offsetWidth;
                const center = (el: HTMLElement) => el.offsetLeft + el.offsetWidth / 2;
                const m = center(mascot);
                section.style.setProperty("--c", `${stage.offsetLeft + m}px`);
                const H = section.offsetHeight;
                const slant = H * 0.2;
                // 人物倾斜后上半身往外偏（顶上偏出 slant），少走半个 slant，让斜着的人物整体落在那一栏正中、不顶出页面
                section.style.setProperty("--to-art", `${center(art) - m - slant / 2}px`);
                section.style.setProperty("--to-tech", `${center(tech) - m + slant / 2}px`);
                const tilt = Math.atan2(slant, H);
                section.style.setProperty("--tilt", `${(tilt * 180 / Math.PI).toFixed(2)}deg`);
                // 从笔尖看出去，人物轮廓（连同颜料点）往左最多张开到斜率 0.2155、往右 0.2172（按 SVG 路径的点算的）。
                // 人物绕笔尖转 tilt 以后，两条包络线的角度一边减 tilt、一边加 tilt；顶边离尖的高度就是 section 高度 H
                const aL = Math.atan(0.2155);
                const aR = Math.atan(0.2172);
                const reach = (a: number) => `${(H * Math.tan(a)).toFixed(1)}px`;
                section.style.setProperty("--wl-tech", reach(aL - tilt));
                section.style.setProperty("--wr-tech", reach(aR + tilt));
                section.style.setProperty("--wl-art", reach(aL + tilt));
                section.style.setProperty("--wr-art", reach(aR - tilt));
                techEdge = (stage.offsetLeft + tech.offsetLeft + tech.offsetWidth) / W;
                artEdge = (stage.offsetLeft + art.offsetLeft) / W;
            };

            const setFocus = (focus: string) => {
                if ((section.dataset.focus ?? "") === focus) return;
                if (focus) section.dataset.focus = focus;
                else delete section.dataset.focus;
            };

            section.addEventListener("pointermove", (e) => {
                if (!wide.matches || e.pointerType !== "mouse") return;
                const r = section.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width;
                setFocus(x < techEdge ? "tech" : x > artEdge ? "art" : "");
            });
            section.addEventListener("pointerleave", () => setFocus(""));
            wide.addEventListener("change", () => { setFocus(""); measure(); });
            new ResizeObserver(measure).observe(section);
            measure();
        });
    }
    document.addEventListener("astro:page-load", initTechArtFocus);
</script>

<style>
    .ta-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    /* ---------- 三个版式共用的舞台：左栏 · 吉祥物 · 右栏 ---------- */
    /* 中间一栏放宽，吉祥物按 1:3 的原比例几乎撑满整个 Part 的高度；两边列表在它的高度里垂直居中 */
    .ta-stage {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(14rem, 24vw, 28rem) minmax(0, 1fr);
        gap: clamp(1.5rem, 2.6vw, 3rem);
        align-items: center;
        isolation: isolate;
    }
    .ta-side-tech { order: 0; }
    /* 吉祥物往上伸进标题那一行（中间是空的），往下吃掉 section 的下内边距（lg:py-16 = 4rem），
       这样笔尖正好落在 Part 的底边，和倒三角的尖重合（SVG 的 viewBox 已经裁到笔尖为止，笔尖在水平正中） */
    .ta-mascot {
        order: 1;
        position: relative;
        /* 贴着这一行的底边：列表比吉祥物高的时候笔尖也还在 Part 的底边上 */
        align-self: end;
        margin-top: -5.5rem;
        margin-bottom: -4rem;
    }
    .ta-side-art { order: 2; }
    .ta-mascot img {
        position: relative;
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
        user-select: none;
    }
    /* 列表压在倒三角上面（吉祥物的入场动画会自成层叠上下文，三角的 z-index 出不去，所以抬列表） */
    .ta-side {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        min-width: 0;
    }
    .ta-side-tech { text-align: right; }

    /* ---------- 左中右三个区域的聚焦（脚本写 data-focus）---------- */
    /* 入场动画占用了 translate / scale，这里的位移只用 transform */
    [data-ta-section] { --ta-move: 650ms cubic-bezier(0.7, 0, 0.2, 1); }
    .ta-side,
    .ta-mascot {
        transition: transform var(--ta-move), opacity 450ms ease;
    }
    [data-focus="tech"] .ta-side-art {
        transform: translateX(calc(100% + 40vw));
        opacity: 0;
        pointer-events: none;
    }
    /* 吉祥物绕笔尖（底边正中）往外斜一点 */
    .ta-mascot { transform-origin: 50% 100%; }
    [data-focus="tech"] .ta-mascot { transform: translateX(var(--to-art, 0px)) rotate(var(--tilt, 0deg)); }
    [data-focus="art"] .ta-side-tech {
        transform: translateX(calc(-100% - 40vw));
        opacity: 0;
        pointer-events: none;
    }
    [data-focus="art"] .ta-mascot { transform: translateX(var(--to-tech, 0px)) rotate(calc(-1 * var(--tilt, 0deg))); }

    /* ======================= A · P3R ======================= */
    /* 倒三角：白色在前，深黄的宽一点垫在后面，两条斜边露出深黄的边 */
    .pa-tri {
        position: absolute;
        left: 50%;
        translate: -50% 0;
        background-color: var(--ta-paper);
        clip-path: polygon(0 0, 100% 0, 50% 100%);
    }
    .pa-tri-back { background-color: var(--ta-accent); }
    /* 宽屏：铺满整个 Part 的高度，水平居中（舞台左右对称，中线就是吉祥物的中线）；
       宽度按吉祥物那一栏算（和 .ta-stage 的中栏同一个 clamp），只比它宽一点，所以又窄又尖 */
    .pa-tri-page {
        --tri-w: clamp(14rem, 24vw, 28rem);
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }
    /* 整块铺满，用 clip-path 画三角（上边两个角 + 底边的尖），这样三角可以平滑地移动、变形。
       --c 是吉祥物中线的 x（脚本量出来，之前先按 50%），--hw 是居中时的三角半宽 */
    .pa-tri-page .pa-tri {
        --tip: var(--c, 50%);
        --hw: calc(var(--tri-w) * 0.525);
        --pad: 0.5rem;
        inset: 0;
        left: 0;
        translate: none;
        clip-path: polygon(calc(var(--tip) - var(--hw)) 0, calc(var(--tip) + var(--hw)) 0, var(--tip) 100%);
        transition: clip-path var(--ta-move);
    }
    .pa-tri-page .pa-tri-back { --hw: calc(var(--tri-w) * 0.6); --pad: 1.4rem; }
    /* 聚焦时：三角跟着吉祥物过去、跟着它一起斜，尖还在笔尖上，两条边正好把整个人物（连同甩出的颜料点）包住。
       --wl-* / --wr-* 是脚本按人物轮廓算出的「顶边上从尖往左 / 往右要伸多远」，--pad 再留一点边 */
    [data-focus="tech"] .pa-tri-page .pa-tri {
        --tip: calc(var(--c, 50%) + var(--to-art, 0px));
        clip-path: polygon(calc(var(--tip) - var(--wl-tech, 0px) - var(--pad)) 0, calc(var(--tip) + var(--wr-tech, 0px) + var(--pad)) 0, var(--tip) 100%);
    }
    [data-focus="art"] .pa-tri-page .pa-tri {
        --tip: calc(var(--c, 50%) + var(--to-tech, 0px));
        clip-path: polygon(calc(var(--tip) - var(--wl-art, 0px) - var(--pad)) 0, calc(var(--tip) + var(--wr-art, 0px) + var(--pad)) 0, var(--tip) 100%);
    }
    .pa-tri-local { display: none; }
    .pa-head { display: flex; flex-direction: column; line-height: 1; }
    .ta-side-tech .pa-head { align-items: flex-end; }
    .pa-head-en {
        font-family: 'Roboto', sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: clamp(2.6rem, 4.6vw, 5rem);
        letter-spacing: -0.03em;
        color: var(--ta-paper);
        -webkit-text-stroke: 0.08em var(--ta-accent);
        paint-order: stroke fill;
    }
    .pa-head-name {
        display: inline-flex;
        align-items: baseline;
        gap: 0.8rem;
        margin-top: 0.3rem;
        padding: 0.3rem 1rem;
        font-weight: 900;
        font-size: clamp(1.3rem, 1.8vw, 1.8rem);
        background-color: var(--ta-accent);
        color: var(--ta-ink);
        transform: skewX(-14deg);
    }
    .pa-head-name small {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--ta-paper);
    }
    .ta-side-tech .pa-head-name { flex-direction: row-reverse; }
    .pa-list { display: flex; flex-direction: column; gap: 0.7rem; }
    /* 逐行向中间错开（P3R 菜单那种阶梯） */
    .ta-side-art .pa-list > li { padding-left: calc(var(--i) * 0.9rem); }
    .ta-side-tech .pa-list > li { padding-right: calc(var(--i) * 0.9rem); }
    .pa-row {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) 30%;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 1.6rem 0.8rem 1.2rem;
        background-color: var(--ta-paper);
        clip-path: polygon(1.2rem 0, 100% 0, calc(100% - 1.2rem) 100%, 0 100%);
        transition: background-color 180ms ease, color 180ms ease;
    }
    /* 左栏：图靠中间，号码靠外 */
    .ta-side-tech .pa-row { grid-template-columns: 30% minmax(0, 1fr) auto; padding: 0.8rem 1.2rem 0.8rem 1.6rem; }
    .ta-side-tech .pa-num { order: 3; }
    .ta-side-tech .pa-body { order: 2; }
    .ta-side-tech .pa-thumb { order: 1; }
    /* 外侧一道黄色斜切的标记条 */
    .pa-row::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0.5rem;
        width: 0.5rem;
        background-color: var(--ta-accent);
        transform: skewX(-14deg);
    }
    .ta-side-tech .pa-row::before { left: auto; right: 0.5rem; }
    .pa-num {
        font-family: 'Roboto', sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: clamp(2rem, 2.8vw, 3rem);
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--ta-accent);
        padding-inline: 0.6rem;
    }
    .pa-body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
    .pa-title { font-weight: 900; font-size: 1.05rem; line-height: 1.25; }
    .pa-caption { font-weight: 600; font-size: 0.8rem; line-height: 1.45; opacity: 0.8; }
    .pa-tags { font-size: 0.7rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--ta-accent) 70%, var(--ta-ink)); }
    .pa-thumb {
        position: relative;
        align-self: stretch;
        min-height: 5.5rem;
        clip-path: polygon(0.9rem 0, 100% 0, calc(100% - 0.9rem) 100%, 0 100%);
        background-color: var(--ta-accent);
    }
    /* 悬停：整条填成深黄，号码和标记条变白 */
    .pa-row:hover { background-color: var(--ta-accent); }
    .pa-row:hover::before { background-color: var(--ta-paper); }
    .pa-row:hover .pa-num { color: var(--ta-paper); -webkit-text-stroke-color: var(--ta-paper); }
    .pa-row:hover .pa-tags { color: var(--ta-paper); }

    /* ---------- 窄屏：吉祥物缩小放最上面，两栏依次往下，全部左对齐 ---------- */
    @media (max-width: 1023px) {
        .ta-stage { grid-template-columns: 1fr; }
        .pa-tri-page { display: none; }
        .pa-tri-local { display: block; z-index: -1; top: 2%; bottom: -3%; width: 115%; }
        .pa-tri-local.pa-tri-back { top: 0; bottom: -6%; width: 130%; }
        .ta-mascot { order: -1; width: 9rem; margin: 0 auto; }
        .ta-side-tech { text-align: left; }
        .ta-side-tech .pa-head { align-items: flex-start; }
        .ta-side-tech .pa-head-name { flex-direction: row; }
        .ta-side-tech .pa-list > li { padding-right: 0; padding-left: calc(var(--i) * 0.9rem); }
        .ta-side-tech .pa-row { grid-template-columns: auto minmax(0, 1fr) 30%; padding: 0.8rem 1.6rem 0.8rem 1.2rem; }
        .ta-side-tech .pa-num, .ta-side-tech .pa-body, .ta-side-tech .pa-thumb { order: 0; }
        .ta-side-tech .pa-row::before { right: auto; left: 0.5rem; }
    }
    /* 中等宽度（1024~1399px）两边栏太窄：去掉缩略图，行变矮，吉祥物仍然是这一段最高的 */
    @media (min-width: 1024px) and (max-width: 1399px) {
        .pa-thumb { display: none; }
        .pa-row { grid-template-columns: auto minmax(0, 1fr); }
        .ta-side-tech .pa-row { grid-template-columns: minmax(0, 1fr) auto; }
    }
    @media (max-width: 519px) {
        .pa-row, .ta-side-tech .pa-row { grid-template-columns: auto minmax(0, 1fr); }
        .pa-thumb { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
        [data-ta-section] { --ta-move: 0ms linear; }
        .pa-row { transition: none; }
    }
</style>
