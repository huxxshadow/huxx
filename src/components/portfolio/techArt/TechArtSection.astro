---
// Part 5 · 技术美术：吉祥物（握着画笔的猫耳画师）站在正中，左边「技术」、右边「美术」，两边都是列表。
// 两边左右镜像：左栏文字靠外、图靠中间，右栏反过来。
// 候选版式（右下角 Debug 面板切换）：
//   A 镜像清单：每行 编号 + 缩略图 + 标题/说明/标签，虚线分隔
//   B 手风琴：每行平时只露编号、标题、标签，悬停（或聚焦）的那行展开出封面和说明；每栏默认展开第一行
//   C 大字索引：标题做大，行首一块方形缩略图，悬停时底色从中间那一侧扫过来
// 这一页只用 COLORS.yellow 的深浅两档（吉祥物本身就是 yellow.dark）
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { techArtWorks, techArtLabels as L } from "@/i18n/components/portfolio/TechArtShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import mascot from "@/assets/portfolio/techArt/mascot-brush.svg";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "tech-art")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = techArtWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        side: w.side,
        title: w.title ? t(w.title) : d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: "yellow",
        colorBackground: "yellow",
        inDevelopment: !!d.inDevelopment,
    }];
});

// 左栏技术、右栏美术；reveal 方向都是从外侧滑向中间
const sides = (["tech", "art"] as const).map((side) => ({
    side,
    items: works.filter((w) => w.side === side).map((w, i) => ({ ...w, code: `${side === "tech" ? "T" : "A"}-${String(i + 1).padStart(2, "0")}` })),
    name: t(side === "tech" ? L.tech : L.art),
    sub: t(side === "tech" ? L.techSub : L.artSub),
    reveal: side === "tech" ? "right" : "left",
}));

const ink = COLORS.black;
const accent = COLORS.yellow.dark;
const tint = COLORS.yellow.light;
const paper = "#FFFDF7";
const sizesWide = "(min-width: 1024px) 30vw, 100vw";
const sizesThumb = "(min-width: 1024px) 12vw, 30vw";
---

<section
        id={role.anchor}
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ta-accent: ${accent}; --ta-tint: ${tint}; --ta-ink: ${ink}; --ta-paper: ${paper};`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2、3、4 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-8 lg:mb-10" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ta-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ta-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{works.length} {t(L.projects)}</span>
    </header>

    <div data-variant-group="part5" data-variant-label="Part 5 · TA">

        <!-- ================= A · 镜像清单 ================= -->
        <div data-variant="A">
            <div class="ta-stage">
                {sides.map((s) => (
                        <div class:list={["ta-side", `ta-side-${s.side}`]}>
                            <div class="ta-head" data-reveal={s.reveal} data-reveal-once>
                                <span class="ta-head-name">{s.name}</span>
                                <span class="ta-head-sub">{s.sub}</span>
                            </div>
                            <ol class="la-list" data-reveal-children={s.reveal} data-reveal-once>
                                {s.items.map((w) => (
                                        <li>
                                            <a href={href(w.id)} class="la-row">
                                                <div class="la-thumb"><WorkCover work={w} lang={lang} sizes={sizesThumb} /></div>
                                                <div class="la-body">
                                                    <span class="ta-code">{w.code}</span>
                                                    <h3 class="la-title">{w.title}</h3>
                                                    <p class="la-caption">{w.caption}</p>
                                                    <ul class="ta-tags">{w.tags.map((tag) => <li class="ta-tag">{tag}</li>)}</ul>
                                                </div>
                                            </a>
                                        </li>
                                ))}
                            </ol>
                        </div>
                ))}
                <div class="ta-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
                    <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                </div>
            </div>
        </div>

        <!-- ================= B · 手风琴 ================= -->
        <div data-variant="B" hidden>
            <div class="ta-stage">
                {sides.map((s) => (
                        <div class:list={["ta-side", `ta-side-${s.side}`]}>
                            <div class="ta-head" data-reveal={s.reveal} data-reveal-once>
                                <span class="ta-head-name">{s.name}</span>
                                <span class="ta-head-sub">{s.sub}</span>
                            </div>
                            <ol class="lb-list" data-reveal-children={s.reveal} data-reveal-once>
                                {s.items.map((w, i) => (
                                        <li class:list={["lb-row", { "is-default": i === 0 }]}>
                                            <a href={href(w.id)} class="lb-link">
                                                <div class="lb-bar">
                                                    <span class="lb-num">{String(i + 1).padStart(2, "0")}</span>
                                                    <h3 class="lb-title">{w.title}</h3>
                                                    <span class="lb-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                                                </div>
                                                <div class="lb-fold">
                                                    <div class="lb-fold-inner">
                                                        <div class="lb-img"><WorkCover work={w} lang={lang} sizes={sizesWide} /></div>
                                                        <p class="lb-caption">{w.caption}</p>
                                                    </div>
                                                </div>
                                                <ul class="ta-tags lb-tags">{w.tags.map((tag) => <li class="ta-tag">{tag}</li>)}</ul>
                                            </a>
                                        </li>
                                ))}
                            </ol>
                        </div>
                ))}
                <div class="ta-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
                    <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                </div>
            </div>
        </div>

        <!-- ================= C · 大字索引 ================= -->
        <div data-variant="C" hidden>
            <div class="ta-stage">
                {sides.map((s) => (
                        <div class:list={["ta-side", `ta-side-${s.side}`]}>
                            <div class="ta-head lc-head" data-reveal={s.reveal} data-reveal-once>
                                <span class="ta-head-name">{s.name}</span>
                                <span class="ta-head-sub">{s.sub}</span>
                            </div>
                            <ol class="lc-list" data-reveal-children={s.reveal} data-reveal-once>
                                {s.items.map((w) => (
                                        <li>
                                            <a href={href(w.id)} class="lc-row">
                                                <div class="lc-thumb"><WorkCover work={w} lang={lang} sizes={sizesThumb} /></div>
                                                <div class="lc-body">
                                                    <span class="lc-code">{w.code}</span>
                                                    <h3 class="lc-title">{w.title}</h3>
                                                    <p class="lc-caption">{w.caption}</p>
                                                    <p class="lc-tags">{w.tags.join("  /  ")}</p>
                                                </div>
                                            </a>
                                        </li>
                                ))}
                            </ol>
                        </div>
                ))}
                <div class="ta-mascot" data-reveal="fade" data-reveal-once aria-hidden="true">
                    <img src={mascot.src} width={mascot.width} height={mascot.height} alt="" loading="lazy" decoding="async" />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .ta-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    /* ---------- 三个版式共用的舞台：左栏 · 吉祥物 · 右栏 ---------- */
    .ta-stage {
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(9rem, 15vw, 17rem) minmax(0, 1fr);
        gap: clamp(1.5rem, 3vw, 3.5rem);
        align-items: start;
    }
    .ta-side-tech { order: 0; }
    .ta-mascot { order: 1; align-self: center; }
    .ta-side-art { order: 2; }
    .ta-mascot img {
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
        user-select: none;
    }
    .ta-side {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        min-width: 0;
    }
    /* 左栏整体靠右（朝向中间），右栏靠左 */
    .ta-side-tech { text-align: right; }
    .ta-side-tech .ta-tags { justify-content: flex-end; }
    .ta-head {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 4px solid var(--ta-ink);
    }
    .ta-side-tech .ta-head { align-items: flex-end; }
    .ta-head-name {
        font-weight: 900;
        font-size: clamp(2rem, 3.4vw, 3.4rem);
        line-height: 1;
    }
    .ta-head-sub {
        font-weight: 800;
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--ta-accent) 70%, var(--ta-ink));
    }
    .ta-code {
        font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 800;
        padding: 0.05rem 0.4rem;
        background-color: var(--ta-ink);
        color: var(--ta-paper);
        align-self: flex-start;
    }
    .ta-side-tech .ta-code { align-self: flex-end; }
    .ta-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }
    .ta-tag {
        padding: 0.1rem 0.55rem;
        border: 2px solid var(--ta-ink);
        border-radius: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        background-color: var(--ta-paper);
    }

    /* ======================= A · 镜像清单 ======================= */
    .la-row {
        display: grid;
        grid-template-columns: 36% minmax(0, 1fr);
        gap: 1.1rem;
        align-items: start;
        padding: 1rem 0.5rem;
        border-bottom: 2px dashed var(--ta-ink);
        transition: background-color 150ms ease;
    }
    /* 左栏：图放到靠中间的一侧 */
    .ta-side-tech .la-row { grid-template-columns: minmax(0, 1fr) 36%; }
    .ta-side-tech .la-thumb { order: 2; }
    .la-row:hover { background-color: color-mix(in srgb, var(--ta-accent) 18%, transparent); }
    .la-thumb {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border: 2px solid var(--ta-ink);
        border-radius: 0.5rem;
        box-shadow: 4px 4px 0 var(--ta-accent);
    }
    .la-thumb :global(img) { transition: scale 500ms ease; }
    .la-row:hover .la-thumb :global(img) { scale: 1.06; }
    .la-body { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
    .la-title { font-weight: 900; font-size: 1.15rem; line-height: 1.25; }
    .la-caption { font-weight: 600; font-size: 0.85rem; line-height: 1.5; opacity: 0.85; }

    /* ======================= B · 手风琴 ======================= */
    .lb-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .lb-link {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.8rem 1rem 0.9rem;
        background-color: var(--ta-paper);
        border: 2px solid var(--ta-ink);
        border-radius: 0.9rem;
        box-shadow: 5px 5px 0 var(--ta-accent);
        transition: box-shadow 150ms ease, background-color 150ms ease;
    }
    .lb-bar {
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
    }
    .ta-side-tech .lb-bar { flex-direction: row-reverse; }
    .lb-num {
        flex: none;
        font-family: 'Roboto', sans-serif;
        font-weight: 900;
        font-size: 1.9rem;
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--ta-ink);
        transition: color 200ms ease;
    }
    .lb-title { flex: 1; min-width: 0; font-weight: 900; font-size: 1.1rem; line-height: 1.25; }
    .lb-arrow {
        flex: none;
        font-size: 0.9rem;
        transition: rotate 250ms ease;
    }
    .ta-side-tech .lb-arrow { scale: -1 1; }
    /* 折叠区：grid-template-rows 0fr ↔ 1fr 做高度动画 */
    .lb-fold {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 320ms ease;
    }
    .lb-fold-inner {
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .lb-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 2px solid var(--ta-ink);
        border-radius: 0.5rem;
    }
    .lb-caption { font-weight: 600; font-size: 0.85rem; line-height: 1.5; opacity: 0.85; }
    /* 展开：悬停 / 聚焦的那行；没悬停任何行时，每栏的第一行展开 */
    .lb-row:hover .lb-fold,
    .lb-row:focus-within .lb-fold,
    .lb-list:not(:hover, :focus-within) .lb-row.is-default .lb-fold {
        grid-template-rows: 1fr;
    }
    .lb-row:hover .lb-num,
    .lb-row:focus-within .lb-num,
    .lb-list:not(:hover, :focus-within) .lb-row.is-default .lb-num {
        color: var(--ta-accent);
    }
    .lb-row:hover .lb-arrow,
    .lb-row:focus-within .lb-arrow,
    .lb-list:not(:hover, :focus-within) .lb-row.is-default .lb-arrow {
        rotate: 90deg;
    }
    /* 左栏的箭头是水平翻过来的，要反着转才朝下 */
    .ta-side-tech .lb-row:hover .lb-arrow,
    .ta-side-tech .lb-row:focus-within .lb-arrow,
    .ta-side-tech .lb-list:not(:hover, :focus-within) .lb-row.is-default .lb-arrow {
        rotate: -90deg;
    }
    .lb-row:hover .lb-link { box-shadow: 8px 8px 0 var(--ta-accent); }
    /* 触屏没有悬停：全部展开 */
    @media (hover: none) {
        .lb-fold { grid-template-rows: 1fr; }
    }

    /* ======================= C · 大字索引 ======================= */
    .lc-head { border-bottom-width: 6px; }
    .lc-list { display: flex; flex-direction: column; }
    .lc-row {
        display: grid;
        grid-template-columns: clamp(4.5rem, 6vw, 6.5rem) minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
        padding: 1.1rem 0.6rem;
        border-bottom: 3px solid var(--ta-ink);
        /* 悬停时底色从中间那一侧扫过来：右栏从左往右，左栏从右往左 */
        background-image: linear-gradient(var(--ta-accent), var(--ta-accent));
        background-repeat: no-repeat;
        background-position: left center;
        background-size: 0% 100%;
        transition: background-size 350ms ease;
    }
    .ta-side-tech .lc-row {
        grid-template-columns: minmax(0, 1fr) clamp(4.5rem, 6vw, 6.5rem);
        background-position: right center;
    }
    .ta-side-tech .lc-thumb { order: 2; }
    .lc-row:hover { background-size: 100% 100%; }
    .lc-thumb {
        position: relative;
        aspect-ratio: 1;
        overflow: hidden;
        border: 3px solid var(--ta-ink);
        border-radius: 50%;
        background-color: var(--ta-paper);
    }
    .lc-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
    .lc-code {
        font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 800;
        opacity: 0.6;
    }
    .lc-title {
        font-weight: 900;
        font-size: clamp(1.25rem, 1.8vw, 1.9rem);
        line-height: 1.15;
        letter-spacing: -0.01em;
    }
    .lc-caption { font-weight: 600; font-size: 0.85rem; line-height: 1.5; opacity: 0.85; }
    .lc-tags { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.04em; white-space: pre-wrap; color: color-mix(in srgb, var(--ta-accent) 60%, var(--ta-ink)); }
    .lc-row:hover .lc-tags { color: var(--ta-ink); }

    /* ---------- 窄屏：吉祥物缩小放最上面，两栏依次往下，全部左对齐 ---------- */
    @media (max-width: 1023px) {
        .ta-stage { grid-template-columns: 1fr; }
        .ta-mascot { order: -1; width: 7rem; margin: 0 auto; }
        .ta-side-tech { text-align: left; }
        .ta-side-tech .ta-tags { justify-content: flex-start; }
        .ta-side-tech .ta-head { align-items: flex-start; }
        .ta-side-tech .ta-code { align-self: flex-start; }
        .ta-side-tech .la-row { grid-template-columns: 36% minmax(0, 1fr); }
        .ta-side-tech .la-thumb,
        .ta-side-tech .lc-thumb { order: 0; }
        .ta-side-tech .lb-bar { flex-direction: row; }
        .ta-side-tech .lb-arrow { scale: 1 1; }
        .ta-side-tech .lc-row {
            grid-template-columns: clamp(4.5rem, 6vw, 6.5rem) minmax(0, 1fr);
            background-position: left center;
        }
    }
    @media (max-width: 519px) {
        .la-row,
        .ta-side-tech .la-row { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
        .la-row, .lb-link, .lb-fold, .lb-num, .lb-arrow, .lc-row, .la-thumb :global(img) { transition: none; }
    }
</style>
