---
// 版式 B · 杂志式：四部主推作品一行一部，大图与文字左右交替，文字栏写清「我搭的系统」与技术栈；
// 下面「更多作品」是一排五张小卡
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDevShowcase } from "./data";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";

interface Props {
    showcase: GameDevShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
---

<div>
    <div class="flex flex-col">
        {showcase.featured.map((w, i) => (
                <a href={href(w.id)} class={`ed-row group ${i % 2 ? "ed-row-flip" : ""}`} data-reveal={i % 2 ? "right" : "left"} data-reveal-once>
                    <div class="ed-img">
                        <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 55vw, 100vw" />
                    </div>
                    <div class="ed-text">
                        <span class="ed-meta">{w.context}</span>
                        <h3 class="ed-title">{w.title}</h3>
                        <span class="ed-role">{w.role}</span>
                        <p class="ed-line">{w.line}</p>
                        <div class="ed-built">
                            <span class="ed-label">{t(labels.built)}</span>
                            <ul>
                                {w.systems.map((s) => <li>{s}</li>)}
                            </ul>
                        </div>
                        <div class="ed-stack">
                            <span class="ed-label">{t(labels.stack)}</span>
                            <span>{w.stack.join(" / ")}</span>
                        </div>
                    </div>
                </a>
        ))}
    </div>

    <div class="ed-more-head" data-reveal="fade" data-reveal-once>
        <span>{t(labels.more)}</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
        {showcase.more.map((w) => (
                <a href={href(w.id)} class="ed-card group">
                    <div class="ed-card-img">
                        <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 18vw, 45vw" />
                    </div>
                    <h3 class="font-black text-base leading-tight pt-2.5">{w.title}</h3>
                    <span class="ed-card-meta">{w.role}</span>
                    <p class="text-[0.78rem] font-semibold leading-snug">{w.line}</p>
                    <span class="ed-card-stack">{w.stack.join(" / ")}</span>
                </a>
        ))}
    </div>
</div>

<style>
    .ed-row {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        gap: 2.5rem;
        align-items: center;
        padding: 2rem 0;
        border-top: 3px solid var(--dv-ink);
    }
    .ed-row:first-child {
        border-top: 0;
        padding-top: 0.5rem;
    }
    .ed-row-flip {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .ed-row-flip .ed-img {
        order: 2;
    }
    .ed-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--dv-ink);
        box-shadow: 10px 10px 0 var(--dv-accent);
        transition: box-shadow 200ms ease, transform 200ms ease;
    }
    .ed-row:hover .ed-img {
        transform: translate(-4px, -4px);
        box-shadow: 14px 14px 0 var(--dv-accent);
    }
    .ed-text {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .ed-meta {
        font-weight: 800;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        color: var(--dv-accent);
    }
    .ed-title {
        font-weight: 900;
        font-size: clamp(2rem, 3.4vw, 3.2rem);
        line-height: 1;
        letter-spacing: -0.02em;
    }
    .ed-row:hover .ed-title {
        color: var(--dv-accent);
    }
    .ed-role {
        align-self: flex-start;
        padding: 0.1rem 0.6rem;
        background-color: var(--dv-ink);
        color: var(--dv-paper);
        font-weight: 800;
        font-size: 0.8rem;
    }
    .ed-line {
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.65;
    }
    .ed-label {
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.6;
    }
    .ed-built {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.8rem 0;
        border-top: 1.5px solid color-mix(in srgb, var(--dv-ink) 30%, transparent);
        border-bottom: 1.5px solid color-mix(in srgb, var(--dv-ink) 30%, transparent);
    }
    .ed-built ul {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .ed-built li {
        position: relative;
        padding-left: 1.1rem;
        font-weight: 700;
        font-size: 0.9rem;
        line-height: 1.45;
    }
    .ed-built li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.45em;
        width: 0.55rem;
        height: 0.55rem;
        background-color: var(--dv-accent);
    }
    .ed-stack {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--dv-accent);
    }
    .ed-stack .ed-label {
        color: var(--dv-ink);
    }

    /* 更多作品 */
    .ed-more-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 2.5rem 0 1.25rem;
        font-weight: 900;
        font-size: 1.4rem;
    }
    .ed-more-head::after {
        content: "";
        flex: 1;
        height: 3px;
        background-color: var(--dv-ink);
    }
    .ed-card {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }
    .ed-card-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--dv-ink);
        box-shadow: 5px 5px 0 var(--dv-ink);
        transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .ed-card:hover .ed-card-img {
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0 var(--dv-accent);
    }
    .ed-card-meta {
        font-weight: 800;
        font-size: 0.72rem;
        color: var(--dv-accent);
    }
    .ed-card-stack {
        margin-top: auto;
        padding-top: 0.2rem;
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        opacity: 0.7;
    }

    @media (max-width: 1023px) {
        .ed-row,
        .ed-row-flip {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
        .ed-row-flip .ed-img { order: 0; }
    }
</style>
