---
// 版式 A · Bento：大小不一的格子拼成一整块。点点宇宙占最大格（图 + 一句话 + 三个系统），
// 其余主推作品中格，更多作品小格；每格都带技术栈
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDevShowcase, DevWorkView } from "./data";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";

interface Props {
    showcase: GameDevShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

type Size = "big" | "side" | "wide" | "small" | "third";
// 格子的尺寸按顺序排：大格 + 右侧两格 / 一宽两小 / 三等分
const SIZES: Size[] = ["big", "side", "side", "wide", "small", "small", "third", "third", "third"];
const tiles = [...showcase.featured, ...showcase.more].map((w, i) => ({ w, size: SIZES[i] ?? "third" })) as { w: DevWorkView; size: Size }[];
const imgSizes: Record<Size, string> = {
    big: "(min-width: 1024px) 60vw, 100vw",
    side: "(min-width: 1024px) 30vw, 100vw",
    wide: "(min-width: 1024px) 28vw, 100vw",
    small: "(min-width: 1024px) 23vw, 50vw",
    third: "(min-width: 1024px) 30vw, 50vw",
};
---

<div class="bento" data-reveal-children="up" data-reveal-once data-reveal-stagger="60">
    {tiles.map(({ w, size }) => (
            <a href={href(w.id)} class={`bento-tile bento-${size} group`}>
                <div class="bento-img">
                    <WorkCover work={w} lang={lang} sizes={imgSizes[size]} />
                </div>
                <div class="bento-body">
                    <span class="bento-meta">{w.context} · {w.role}</span>
                    <h3 class="bento-title">{w.title}</h3>
                    {(size === "big" || size === "wide") && (
                            <>
                                <p class="bento-line">{w.line}</p>
                                <div class="bento-built">
                                    <span class="bento-label">{t(labels.built)}</span>
                                    <ul>
                                        {w.systems.map((s) => <li>{s}</li>)}
                                    </ul>
                                </div>
                            </>
                    )}
                    <ul class="bento-stack">
                        {w.stack.map((s) => <li>{s}</li>)}
                    </ul>
                </div>
            </a>
    ))}
</div>

<style>
    .bento {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1.25rem;
    }
    .bento-tile {
        display: flex;
        flex-direction: column;
        min-width: 0;
        background-color: var(--dv-paper);
        border: 3px solid var(--dv-ink);
        box-shadow: 6px 6px 0 var(--dv-ink);
        transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .bento-tile:hover {
        transform: translate(-3px, -3px);
        box-shadow: 9px 9px 0 var(--dv-accent);
    }
    .bento-img {
        position: relative;
        overflow: hidden;
        background-color: var(--dv-ink);
        border-bottom: 3px solid var(--dv-ink);
        aspect-ratio: 16 / 9;
    }
    .bento-body {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0.9rem 1rem 1rem;
    }
    .bento-meta {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        color: var(--dv-accent);
    }
    .bento-title {
        font-weight: 900;
        font-size: 1.15rem;
        line-height: 1.15;
    }
    .bento-line {
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.6;
    }
    .bento-built {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding-top: 0.25rem;
    }
    .bento-label {
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.6;
    }
    .bento-built ul {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }
    .bento-built li {
        position: relative;
        padding-left: 1rem;
        font-size: 0.85rem;
        font-weight: 700;
        line-height: 1.45;
    }
    .bento-built li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.45em;
        width: 0.5rem;
        height: 0.5rem;
        background-color: var(--dv-accent);
    }
    .bento-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: auto;
        padding-top: 0.5rem;
    }
    .bento-stack li {
        padding: 0.05rem 0.45rem;
        border: 1.5px solid var(--dv-accent);
        color: var(--dv-accent);
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 700;
    }

    /* 大格：左上 8 列 × 2 行，图吃掉剩余高度 */
    .bento-big {
        grid-column: span 8;
        grid-row: span 2;
    }
    .bento-big .bento-img {
        flex: 1;
        aspect-ratio: auto;
        min-height: 18rem;
    }
    .bento-big .bento-body {
        padding: 1.25rem 1.5rem 1.4rem;
        gap: 0.55rem;
    }
    .bento-big .bento-title {
        font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    }
    .bento-big .bento-built ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
    }
    /* 右侧两格：4 列，图吃掉剩余高度 */
    .bento-side {
        grid-column: span 4;
    }
    .bento-side .bento-img {
        flex: 1;
        aspect-ratio: auto;
        min-height: 9rem;
    }
    /* 宽格：图在左，文字在右 */
    .bento-wide {
        grid-column: span 6;
        flex-direction: row;
    }
    .bento-wide .bento-img {
        flex: 0 0 48%;
        aspect-ratio: auto;
        border-bottom: 0;
        border-right: 3px solid var(--dv-ink);
    }
    .bento-small {
        grid-column: span 3;
    }
    .bento-third {
        grid-column: span 4;
    }

    @media (max-width: 1023px) {
        .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .bento-big,
        .bento-wide { grid-column: span 2; grid-row: auto; }
        .bento-side,
        .bento-small,
        .bento-third { grid-column: span 1; }
        .bento-big .bento-img,
        .bento-side .bento-img { flex: none; aspect-ratio: 16 / 9; min-height: 0; }
        .bento-big .bento-built ul { grid-template-columns: 1fr; }
    }
    @media (max-width: 639px) {
        .bento { grid-template-columns: 1fr; }
        .bento-big,
        .bento-wide,
        .bento-side,
        .bento-small,
        .bento-third { grid-column: auto; }
        .bento-wide { flex-direction: column; }
        .bento-wide .bento-img { flex: none; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 3px solid var(--dv-ink); }
    }
</style>
