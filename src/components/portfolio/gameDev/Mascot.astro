---
// Part 3 的吉祥物：手绘 SVG。头、身体、腿只有一份，所以任何姿势下都完全一致；
// 左右各两条手臂：叉腰（默认）和伸直指向。指向臂绕肩膀旋转，角度由 DevNineGrid 的脚本按选中格子的位置实时算出，
// 通过 CSS 变量 --ang-l / --ang-r 传进来；眼珠用 --eye-x / --eye-y 跟着看过去。
// data-point="left|right" 决定用哪一侧的手臂指。肩膀的旋转中心：左 (146, 314)，右 (254, 314)。

// 颜色：主蓝取站点调色板的 blue.dark，描边用深藏青，头发内侧阴影用更深的蓝
const BLUE = "#0058C0";
const INK = "#121A3F";
const WHITE = "#FFFFFF";
const SHADE = "#0A2C7A";
---

<svg class="mascot" viewBox="0 0 400 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" data-mascot
     style={`--m-blue: ${BLUE}; --m-ink: ${INK}; --m-white: ${WHITE}; --m-shade: ${SHADE};`}>
    <g class="m-body">
        <!-- ===== 头发（后层）：六边形的波波头轮廓 ===== -->
        <polygon class="f-blue" points="148,50 252,46 294,106 304,192 274,268 126,268 96,192 106,106" />
        <!-- 发片内侧阴影 -->
        <polygon class="f-shade s-none" points="112,200 138,196 146,262 128,262" />
        <polygon class="f-shade s-none" points="288,200 262,196 254,262 272,262" />

        <!-- ===== 腿、短裤、靴子 ===== -->
        <polygon class="f-white" points="162,444 186,444 183,500 163,500" />
        <polygon class="f-white" points="214,444 238,444 237,500 217,500" />
        <polygon class="f-ink" points="150,438 250,438 245,462 155,462" />
        <g>
            <path class="f-blue" d="M153,492 L186,492 L188,522 Q201,527 201,538 Q170,544 140,540 Q137,520 153,510 Z" />
            <path class="s-line" d="M160,506 L180,504 M160,517 L182,515" />
        </g>
        <g>
            <path class="f-blue" d="M247,492 L214,492 L212,522 Q199,527 199,538 Q230,544 260,540 Q263,520 247,510 Z" />
            <path class="s-line" d="M240,506 L220,504 M240,517 L218,515" />
        </g>

        <!-- ===== 裙子 ===== -->
        <polygon class="f-blue" points="148,364 252,364 274,444 126,444" />
        <path class="s-line" d="M205,370 L208,440" />
        <path class="s-line" d="M160,372 Q172,394 150,402 M240,372 Q228,394 250,402" />

        <!-- ===== 叉腰的手臂（肘向外，手落在腰侧） ===== -->
        <g class="arm-hip arm-hip-l">
            <path class="limb-out" d="M146,314 L110,348 L148,372" />
            <path class="limb-in" d="M146,314 L110,348 L148,372" />
            <path class="cuff-out" d="M128,360 L138,366" />
            <path class="cuff-in" d="M128,360 L138,366" />
        </g>
        <g class="arm-hip arm-hip-r">
            <path class="limb-out" d="M254,314 L290,348 L252,372" />
            <path class="limb-in" d="M254,314 L290,348 L252,372" />
            <path class="cuff-out" d="M272,360 L262,366" />
            <path class="cuff-in" d="M272,360 L262,366" />
        </g>

        <!-- ===== 上衣：短款，白领口，胸前白三角 ===== -->
        <polygon class="f-blue" points="156,292 244,292 250,354 150,354" />
        <path class="f-white" d="M184,292 Q200,306 216,292 Z" />
        <polygon class="tri" points="200,310 218,340 182,340" />
        <polygon class="f-white" points="150,354 250,354 252,366 148,366" />
        <!-- 叉腰的拳头 -->
        <circle class="fist arm-hip arm-hip-l" cx="150" cy="373" r="11" />
        <circle class="fist arm-hip arm-hip-r" cx="250" cy="373" r="11" />

        <!-- ===== 脖子与脸 ===== -->
        <rect class="f-white" x="189" y="262" width="22" height="32" />
        <path class="f-white" d="M146,150 L254,150 L258,206 C258,244 232,268 200,270 C168,268 142,244 142,206 Z" />

        <!-- 五官 -->
        <path class="s-brow" d="M162,184 L190,191 M238,184 L210,191" />
        <path class="s-thin" d="M164,204 L157,198 M236,204 L243,198" />
        <g class="eyes">
            <ellipse class="f-ink s-none" cx="178" cy="212" rx="13" ry="15" />
            <ellipse class="f-ink s-none" cx="222" cy="212" rx="13" ry="15" />
            <circle class="f-white s-none" cx="182" cy="205" r="4.5" />
            <circle class="f-white s-none" cx="226" cy="205" r="4.5" />
            <circle class="f-white s-none" cx="174" cy="219" r="2" />
            <circle class="f-white s-none" cx="218" cy="219" r="2" />
        </g>
        <path class="s-thin" d="M196,230 Q200,235 204,230" />
        <path class="s-mouth" d="M186,244 Q201,254 214,242" />

        <!-- ===== 头发（前层）：呆毛、锯齿刘海、两侧发片、耳朵 ===== -->
        <polygon class="f-blue" points="162,70 146,20 192,58" />
        <polygon class="f-blue" points="106,106 148,50 252,46 294,106 290,170 266,138 250,178 232,126 214,152 202,118 172,148 162,128 142,178 124,150 102,176" />
        <polygon class="f-blue" points="96,192 102,176 124,150 142,178 150,266 126,268" />
        <polygon class="f-blue" points="304,192 290,170 266,138 258,178 250,266 274,268" />
        <polygon class="f-shade s-none" points="104,196 124,160 140,184 146,262 128,264" opacity="0.55" />
        <polygon class="f-shade s-none" points="296,196 276,160 260,184 254,262 272,264" opacity="0.55" />
        <polygon class="f-white s-none" points="174,94 190,94 182,112" />
        <polygon class="f-white s-none" points="226,78 242,80 233,98" />
        <polygon class="f-white s-none" points="262,108 278,112 268,128" />
        <circle class="f-white" cx="147" cy="214" r="11" />
        <circle class="f-white" cx="253" cy="214" r="11" />
        <path class="s-thin" d="M150,208 Q144,214 150,220 M250,208 Q256,214 250,220" />
    </g>

    <!-- ===== 指向的手臂：压在头发上面，但在袖子下面；沿局部 +x 方向伸出 ===== -->
    <g class="arm-point arm-point-l" transform="translate(146 314)">
        <g class="arm-rot" style="transform: rotate(var(--ang-l, 180deg));">
            <path class="limb-out" d="M0,0 L80,0" />
            <path class="limb-in" d="M0,0 L80,0" />
            <path class="cuff-out" d="M64,0 L76,0" />
            <path class="cuff-in" d="M64,0 L76,0" />
            <rect class="finger" x="94" y="-5.5" width="28" height="11" rx="5.5" />
            <circle class="fist" cx="90" cy="0" r="12" />
        </g>
    </g>
    <g class="arm-point arm-point-r" transform="translate(254 314)">
        <g class="arm-rot" style="transform: rotate(var(--ang-r, 0deg));">
            <path class="limb-out" d="M0,0 L80,0" />
            <path class="limb-in" d="M0,0 L80,0" />
            <path class="cuff-out" d="M64,0 L76,0" />
            <path class="cuff-in" d="M64,0 L76,0" />
            <rect class="finger" x="94" y="-5.5" width="28" height="11" rx="5.5" />
            <circle class="fist" cx="90" cy="0" r="12" />
        </g>
    </g>

    <!-- ===== 袖子：白色短袖 + 蓝色袖口，盖住所有手臂的根部 ===== -->
    <g class="m-body">
        <polygon class="f-white" points="158,292 130,300 120,330 148,338 154,312" />
        <polygon class="f-blue" points="124,316 120,330 148,338 150,324" />
        <polygon class="f-white" points="242,292 270,300 280,330 252,338 246,312" />
        <polygon class="f-blue" points="276,316 280,330 252,338 250,324" />
    </g>
</svg>

<style>
    .mascot {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    .mascot * {
        stroke-linejoin: round;
        stroke-linecap: round;
    }
    /* 填色 + 统一描边 */
    .f-blue,
    .f-white,
    .f-ink,
    .f-shade {
        stroke: var(--m-ink);
        stroke-width: 5;
    }
    .f-blue { fill: var(--m-blue); }
    .f-white { fill: var(--m-white); }
    .f-ink { fill: var(--m-ink); }
    .f-shade { fill: var(--m-shade); }
    .s-none { stroke: none; }
    .s-line,
    .s-brow,
    .s-thin,
    .s-mouth {
        fill: none;
        stroke: var(--m-ink);
    }
    .s-line { stroke-width: 3; }
    .s-brow { stroke-width: 7; }
    .s-thin { stroke-width: 3.5; }
    .s-mouth { stroke-width: 4.5; }
    .tri {
        fill: none;
        stroke: var(--m-white);
        stroke-width: 5;
    }

    /* 手臂：先画一条粗的深色线当描边，再叠一条细的白线 */
    .limb-out { fill: none; stroke: var(--m-ink); stroke-width: 27; }
    .limb-in { fill: none; stroke: var(--m-white); stroke-width: 17; }
    .cuff-out { fill: none; stroke: var(--m-ink); stroke-width: 29; stroke-linecap: butt; }
    .cuff-in { fill: none; stroke: var(--m-blue); stroke-width: 19; stroke-linecap: butt; }
    .fist,
    .finger {
        fill: var(--m-white);
        stroke: var(--m-ink);
        stroke-width: 5;
    }

    /* 眼珠看向选中的格子 */
    .eyes {
        transform: translate(var(--eye-x, 0px), var(--eye-y, 0px));
        transition: transform 200ms ease;
    }

    /* 默认两手叉腰；指向时换成对应一侧的直臂，旋转带过渡，相邻格子之间会转过去 */
    .arm-point {
        visibility: hidden;
    }
    .arm-rot {
        transition: transform 240ms cubic-bezier(0.3, 1.35, 0.5, 1);
    }
    .mascot[data-point="left"] .arm-point-l,
    .mascot[data-point="right"] .arm-point-r {
        visibility: visible;
    }
    .mascot[data-point="left"] .arm-hip-l,
    .mascot[data-point="right"] .arm-hip-r {
        visibility: hidden;
    }

    /* 轻微的呼吸起伏（身体、袖子、手臂一起动） */
    .m-body,
    .arm-point {
        animation: mascot-bob 2.6s ease-in-out infinite;
    }
    @keyframes mascot-bob {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -3px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .m-body,
        .arm-point { animation: none; }
        .arm-rot,
        .eyes { transition: none; }
    }
</style>
