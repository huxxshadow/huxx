---
// 版式 C · 聚光目录：左边是全部项目的大字目录（名称 + 身份 + 技术栈），右边是跟随的预览面板，
// 悬停 / 聚焦哪一行就显示哪个项目的大图、一句话和亲手搭的系统。窄屏退化成卡片列表
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDevShowcase } from "./data";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";

interface Props {
    showcase: GameDevShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);
const works = [...showcase.featured, ...showcase.more];
---

<div class="spot" data-spotlight>
    <!-- 目录 -->
    <ul class="spot-list" data-reveal-children="left" data-reveal-once data-reveal-stagger="50">
        {works.map((w, i) => (
                <li>
                    <a href={href(w.id)} class:list={["spot-row", { "is-active": i === 0 }]} data-spot-index={i}>
                        <span class="spot-row-title">{w.title}</span>
                        <span class="spot-row-role">{w.role}</span>
                        <span class="spot-row-stack">{w.stack.join(" / ")}</span>
                        <!-- 窄屏：直接在行里放图和一句话 -->
                        <span class="spot-row-mobile">
                            <span class="spot-row-mobile-img"><WorkCover work={w} lang={lang} sizes="100vw" /></span>
                            <span class="spot-row-mobile-line">{w.line}</span>
                        </span>
                    </a>
                </li>
        ))}
    </ul>

    <!-- 预览面板（宽屏） -->
    <div class="spot-preview" data-reveal="fade" data-reveal-once>
        <div class="spot-preview-inner">
            {works.map((w, i) => (
                    <div class:list={["spot-pane", { "is-active": i === 0 }]} data-spot-pane={i} aria-hidden={i === 0 ? "false" : "true"}>
                        <div class="spot-pane-img">
                            <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 50vw, 1px" />
                        </div>
                        <div class="spot-pane-body">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="spot-chip spot-chip-solid">{w.role}</span>
                                <span class="spot-chip">{w.context}</span>
                            </div>
                            <h3 class="font-black text-3xl leading-tight tracking-tight">{w.title}</h3>
                            <p class="font-bold leading-[1.65]">{w.line}</p>
                            <div class="spot-built">
                                <span class="spot-label">{t(labels.built)}</span>
                                <ul>
                                    {w.systems.map((s) => <li>{s}</li>)}
                                </ul>
                            </div>
                            <ul class="spot-stack">
                                {w.stack.map((s) => <li>{s}</li>)}
                            </ul>
                        </div>
                    </div>
            ))}
        </div>
    </div>
</div>

<script>
    // 悬停 / 键盘聚焦目录里的一行，就切到对应的预览
    function initSpotlight() {
        document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((root) => {
            if (root.dataset.spotReady) return;
            root.dataset.spotReady = "1";
            const rows = [...root.querySelectorAll<HTMLElement>("[data-spot-index]")];
            const panes = [...root.querySelectorAll<HTMLElement>("[data-spot-pane]")];
            const activate = (i: number) => {
                rows.forEach((r, k) => r.classList.toggle("is-active", k === i));
                panes.forEach((p, k) => {
                    p.classList.toggle("is-active", k === i);
                    p.setAttribute("aria-hidden", k === i ? "false" : "true");
                });
            };
            rows.forEach((row, i) => {
                row.addEventListener("mouseenter", () => activate(i));
                row.addEventListener("focus", () => activate(i));
            });
        });
    }
    document.addEventListener("astro:page-load", initSpotlight);
</script>

<style>
    .spot {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 3rem;
        align-items: start;
    }

    /* 目录：大字行，当前行向右推出并压一条蓝色竖条 */
    .spot-list {
        display: flex;
        flex-direction: column;
        border-top: 3px solid var(--dv-ink);
    }
    .spot-row {
        position: relative;
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas:
            "title role"
            "title stack";
        align-items: center;
        column-gap: 1rem;
        padding: 0.8rem 0.5rem 0.8rem 0;
        border-bottom: 1.5px solid color-mix(in srgb, var(--dv-ink) 35%, transparent);
        transition: padding-left 220ms cubic-bezier(0.2, 0.8, 0.2, 1), color 160ms ease;
    }
    .spot-row::before {
        content: "";
        position: absolute;
        left: 0;
        top: 18%;
        bottom: 18%;
        width: 6px;
        background-color: var(--dv-accent);
        transform: scaleY(0);
        transition: transform 220ms ease;
    }
    .spot-row.is-active {
        padding-left: 1.2rem;
        color: var(--dv-accent);
    }
    .spot-row.is-active::before {
        transform: scaleY(1);
    }
    .spot-row-title {
        grid-area: title;
        font-weight: 900;
        font-size: clamp(1.3rem, 2vw, 1.85rem);
        line-height: 1.1;
        letter-spacing: -0.01em;
    }
    .spot-row-role {
        grid-area: role;
        justify-self: end;
        font-weight: 800;
        font-size: 0.75rem;
    }
    .spot-row-stack {
        grid-area: stack;
        justify-self: end;
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        opacity: 0.65;
    }
    .spot-row-mobile {
        display: none;
    }

    /* 预览面板：跟着滚动停在视口里，切换时交叉淡入 */
    .spot-preview {
        position: sticky;
        top: 6rem;
    }
    .spot-preview-inner {
        display: grid;
        background-color: var(--dv-paper);
        border: 3px solid var(--dv-ink);
        box-shadow: 10px 10px 0 var(--dv-accent);
    }
    .spot-pane {
        grid-area: 1 / 1;
        opacity: 0;
        visibility: hidden;
        transition: opacity 220ms ease, visibility 0s linear 220ms;
    }
    .spot-pane.is-active {
        opacity: 1;
        visibility: visible;
        transition: opacity 220ms ease;
    }
    .spot-pane-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--dv-ink);
        border-bottom: 3px solid var(--dv-ink);
    }
    .spot-pane-body {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        padding: 1.3rem 1.5rem 1.5rem;
    }
    .spot-chip {
        padding: 0.1rem 0.6rem;
        border: 2px solid var(--dv-ink);
        font-weight: 800;
        font-size: 0.78rem;
    }
    .spot-chip-solid {
        background-color: var(--dv-accent);
        border-color: var(--dv-accent);
        color: var(--dv-paper);
    }
    .spot-label {
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.6;
    }
    .spot-built {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .spot-built ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
    }
    .spot-built li {
        padding-top: 0.45rem;
        border-top: 4px solid var(--dv-accent);
        font-weight: 700;
        font-size: 0.85rem;
        line-height: 1.45;
    }
    .spot-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }
    .spot-stack li {
        padding: 0.05rem 0.5rem;
        border: 1.5px solid var(--dv-accent);
        color: var(--dv-accent);
        font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
        font-size: 0.72rem;
        font-weight: 700;
    }

    /* 窄屏：去掉预览面板，每行自带图和一句话 */
    @media (max-width: 1023px) {
        .spot {
            grid-template-columns: 1fr;
        }
        .spot-preview {
            display: none;
        }
        .spot-row {
            grid-template-areas:
                "title role"
                "title stack"
                "mobile mobile";
            padding: 1rem 0;
        }
        .spot-row.is-active {
            padding-left: 0;
            color: inherit;
        }
        .spot-row::before {
            display: none;
        }
        .spot-row-mobile {
            grid-area: mobile;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            padding-top: 0.8rem;
        }
        .spot-row-mobile-img {
            position: relative;
            display: block;
            aspect-ratio: 16 / 9;
            overflow: hidden;
            background-color: var(--dv-ink);
        }
        .spot-row-mobile-line {
            font-weight: 700;
            font-size: 0.9rem;
            line-height: 1.6;
        }
    }
</style>
