---
// Part 3 · 九宫格：中间是吉祥物，外圈 8 格是项目。悬停 / 聚焦某一格就「选中」它，吉祥物换成指向这一格的姿势；
// 没有选中时指向上方。姿势图在 src/assets/portfolio/mascot/，按方向命名（up-left / up / up-right / left / right /
// down-left / down / down-right）。
// 卡片有三套扁平风格（同一份结构，只换 CSS），dev 下用 Debug 面板切换，写在 .ng 的 data-variant-current 上：
//   A 色块：纸色卡 + 蓝色竖条，选中时整卡变蓝
//   B 构成主义：图角蓝色三角 + 斜压黑条，选中时三角放大、黑条摆平变蓝
//   C 瑞士极简：无底，只有图、粗黑线、标题和两栏小表格，选中时线和标题变蓝
// 切换姿势：八张图身体完全重合，只有手臂不同，所以在一次轻微的「压缩—弹起」里瞬间换图（配 80ms 淡入淡出），看不出跳变
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDevShowcase } from "./data";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";

interface Props {
    showcase: GameDevShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

// 外圈 8 格按 DOM 顺序对应的方向（中间一格插在第 4 个后面）
const DIRS = ["up-left", "up", "up-right", "left", "right", "down-left", "down", "down-right"] as const;
const poseFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/portfolio/mascot/*.{png,webp,jpg}", { eager: true });
const pose = (name: string) => Object.entries(poseFiles).find(([p]) => p.split("/").pop()!.replace(/\.\w+$/, "") === name)?.[1].default;
const DEFAULT_POSE = "up";
const poses = DIRS.map((dir) => ({ dir, img: pose(dir) })).filter((p) => p.img) as { dir: string; img: ImageMetadata }[];

const works = showcase.works.slice(0, 8);
const cells = works.map((w, i) => ({ w, dir: DIRS[i] }));
const before = cells.slice(0, 4);
const after = cells.slice(4);
---

<div class="ng" data-nine-grid data-variant-group="part3cards" data-variant-label="Part 3 · 卡片样式" data-variant-options="A,B,C" data-variant-current="A">
    {[before, null, after].map((group) => group === null ? (
            <!-- 中间：只有角色，透明底，无边框无文字 -->
            <div class="ng-center" aria-hidden="true">
                <div class="ng-mascot">
                    {poses.map((p) => (
                            <Image src={p.img} alt="" widths={[360, 600, 900]} sizes="(min-width: 1024px) 28vw, 60vw" loading="eager" data-pose={p.dir} class={p.dir === DEFAULT_POSE ? "is-active" : undefined} />
                    ))}
                </div>
            </div>
    ) : group.map(({ w, dir }) => (
            <a href={href(w.id)} class="ng-cell" data-dir={dir}>
                <span class="ng-corner ng-corner-tl"></span>
                <span class="ng-corner ng-corner-tr"></span>
                <span class="ng-corner ng-corner-bl"></span>
                <span class="ng-corner ng-corner-br"></span>
                <span class="ng-tag">▲ {t(labels.select)}</span>
                <span class="ng-shine" aria-hidden="true"></span>
                <div class="ng-img">
                    <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 28vw, 45vw" />
                    <p class="ng-line">{w.line}</p>
                </div>
                <div class="ng-body">
                    <div class="ng-head">
                        <h3 class="ng-title">{w.title}</h3>
                        <span class="ng-arrow" aria-hidden="true">→</span>
                    </div>
                    <dl class="ng-facts">
                        <div><dt>{t(labels.role)}</dt><dd>{w.role}</dd></div>
                        <div><dt>{t(labels.context)}</dt><dd>{w.context}</dd></div>
                    </dl>
                    <ul class="ng-stack">
                        {w.stack.map((s) => <li>{s}</li>)}
                    </ul>
                </div>
            </a>
    )))}
</div>

<script>
    // 选中某一格：吉祥物换成指向这一格的姿势；取消选中时回到指向上方。
    // 换姿势时整个角色以脚底为支点先压扁一点再弹起，图在压到最低时替换
    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function initNineGrid() {
        document.querySelectorAll<HTMLElement>("[data-nine-grid]").forEach((root) => {
            if (root.dataset.ngReady) return;
            root.dataset.ngReady = "1";
            const cells = [...root.querySelectorAll<HTMLElement>(".ng-cell")];
            const imgs = [...root.querySelectorAll<HTMLElement>("[data-pose]")];
            const mascot = root.querySelector<HTMLElement>(".ng-mascot");
            let current = imgs.find((i) => i.classList.contains("is-active"));
            let swapTimer = 0;
            const swapTo = (target: HTMLElement | undefined) => {
                if (!target || target === current) return;
                current = target;
                window.clearTimeout(swapTimer);
                const apply = () => imgs.forEach((i) => i.classList.toggle("is-active", i === target));
                if (!mascot || reduceMotion()) return apply();
                mascot.animate(
                    [
                        { transform: "translateY(0) scale(1, 1)" },
                        { transform: "translateY(2px) scale(1.03, 0.97)", offset: 0.28 },
                        { transform: "translateY(-6px) scale(0.985, 1.02)", offset: 0.62 },
                        { transform: "translateY(0) scale(1, 1)" },
                    ],
                    { duration: 320, easing: "ease-out" },
                );
                swapTimer = window.setTimeout(apply, 80);
            };
            const select = (cell: HTMLElement | null) => {
                cells.forEach((c) => c.classList.toggle("is-selected", c === cell));
                root.classList.toggle("has-selection", !!cell);
                const dir = cell?.dataset.dir ?? "up";
                swapTo(imgs.find((i) => i.dataset.pose === dir) ?? imgs.find((i) => i.dataset.pose === "up"));
            };
            cells.forEach((cell) => {
                cell.addEventListener("mouseenter", () => select(cell));
                cell.addEventListener("focus", () => select(cell));
            });
            root.addEventListener("mouseleave", () => select(null));
            root.addEventListener("focusout", (e) => {
                if (!root.contains(e.relatedTarget as Node)) select(null);
            });
        });
    }
    document.addEventListener("astro:page-load", initNineGrid);
</script>

<style>
    .ng {
        --mono: ui-monospace, "SFMono-Regular", Consolas, monospace;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
    }

    /* =========================================================
       共用骨架：各样式只改外观。三套都是纯平面：只用墨色、蓝、纸色，不用渐变、阴影、发光
       ========================================================= */
    .ng-cell {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        isolation: isolate;
    }
    .ng-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--dv-ink);
    }
    .ng-img :global(img) {
        transition: scale 400ms ease;
    }
    .ng-body {
        position: relative;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .ng-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
    }
    .ng-title {
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -0.01em;
    }
    .ng-facts dt,
    .ng-facts dd {
        margin: 0;
    }
    .ng-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.7rem;
        font-family: var(--mono);
        font-size: 0.64rem;
        font-weight: 700;
    }
    .ng-stack li::before {
        content: "/ ";
        opacity: 0.6;
    }
    .ng-line,
    .ng-corner,
    .ng-shine,
    .ng-tag,
    .ng-arrow {
        display: none;
    }

    /* =========================================================
       A · 色块：纸色卡片，左侧一根蓝色竖条；选中时整张卡变成纯蓝，字反白
       ========================================================= */
    .ng[data-variant-current="A"] .ng-cell {
        background-color: var(--dv-paper);
        transition: background-color 180ms ease, color 180ms ease;
    }
    .ng[data-variant-current="A"] .ng-body {
        gap: 0.4rem;
        padding: 0.85rem 1rem 0.95rem 1.35rem;
    }
    .ng[data-variant-current="A"] .ng-body::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.95rem;
        bottom: 0.95rem;
        width: 6px;
        background-color: var(--dv-accent);
        transition: background-color 180ms ease;
    }
    .ng[data-variant-current="A"] .ng-title {
        font-size: 1.25rem;
    }
    .ng[data-variant-current="A"] .ng-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.5rem;
        font-size: 0.74rem;
        font-weight: 800;
    }
    .ng[data-variant-current="A"] .ng-facts dt {
        display: none;
    }
    .ng[data-variant-current="A"] .ng-facts > div:first-child dd {
        color: var(--dv-accent);
    }
    .ng[data-variant-current="A"] .ng-facts > div + div::before {
        content: "·";
        margin-right: 0.5rem;
        opacity: 0.5;
    }
    .ng[data-variant-current="A"] .ng-facts > div {
        display: flex;
    }
    .ng[data-variant-current="A"] .ng-stack {
        margin-top: auto;
        opacity: 0.6;
    }
    .ng[data-variant-current="A"] .ng-cell.is-selected {
        background-color: var(--dv-accent);
        color: var(--dv-paper);
    }
    .ng[data-variant-current="A"] .ng-cell.is-selected .ng-body::before {
        background-color: var(--dv-paper);
    }
    .ng[data-variant-current="A"] .ng-cell.is-selected .ng-facts > div:first-child dd {
        color: inherit;
    }
    .ng[data-variant-current="A"] .ng-cell.is-selected .ng-stack {
        opacity: 0.85;
    }

    /* =========================================================
       B · 构成主义：图的左上角切进一块蓝色三角，一根略斜的黑条横压在图的下沿写身份与出处；
       选中时三角放大、黑条摆平并变蓝
       ========================================================= */
    .ng[data-variant-current="B"] .ng-cell {
        background-color: var(--dv-paper);
    }
    .ng[data-variant-current="B"] .ng-img::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background-color: var(--dv-accent);
        clip-path: polygon(0 0, 26% 0, 0 46%);
        transition: clip-path 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .ng[data-variant-current="B"] .ng-body {
        gap: 0.5rem;
        padding: 0 1rem 1rem;
    }
    .ng[data-variant-current="B"] .ng-facts {
        order: -1;
        align-self: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.9rem;
        margin: -0.85rem 0 0.2rem -0.3rem;
        padding: 0.3rem 0.8rem;
        background-color: var(--dv-ink);
        color: var(--dv-paper);
        font-size: 0.72rem;
        font-weight: 800;
        rotate: -4deg;
        transform-origin: left center;
        transition: rotate 260ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 200ms ease;
        position: relative;
        z-index: 2;
    }
    .ng[data-variant-current="B"] .ng-facts > div {
        display: flex;
        gap: 0.35rem;
    }
    .ng[data-variant-current="B"] .ng-facts dt {
        font-family: var(--mono);
        font-size: 0.58rem;
        letter-spacing: 0.1em;
        opacity: 0.6;
        align-self: center;
    }
    .ng[data-variant-current="B"] .ng-title {
        font-size: 1.45rem;
        letter-spacing: -0.03em;
    }
    .ng[data-variant-current="B"] .ng-stack {
        margin-top: auto;
        opacity: 0.65;
    }
    .ng[data-variant-current="B"] .ng-cell.is-selected .ng-img::before {
        clip-path: polygon(0 0, 48% 0, 0 86%);
    }
    .ng[data-variant-current="B"] .ng-cell.is-selected .ng-facts {
        rotate: 0deg;
        background-color: var(--dv-accent);
    }
    .ng[data-variant-current="B"] .ng-cell.is-selected .ng-title {
        color: var(--dv-accent);
    }

    /* =========================================================
       C · 瑞士极简：没有卡片底，只有图、一根粗黑线、标题和两栏小表格；
       选中时粗线变蓝、标题变蓝、右侧出现箭头
       ========================================================= */
    .ng[data-variant-current="C"] .ng-body {
        gap: 0.5rem;
        margin-top: 0.7rem;
        padding-top: 0.6rem;
        border-top: 6px solid var(--dv-ink);
        transition: border-color 180ms ease;
    }
    .ng[data-variant-current="C"] .ng-title {
        font-size: 1.3rem;
        transition: color 180ms ease;
    }
    .ng[data-variant-current="C"] .ng-arrow {
        display: block;
        font-weight: 900;
        font-size: 1.2rem;
        color: var(--dv-accent);
        opacity: 0;
        translate: -8px 0;
        transition: opacity 160ms ease, translate 200ms ease;
    }
    .ng[data-variant-current="C"] .ng-facts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }
    .ng[data-variant-current="C"] .ng-facts > div {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        padding-top: 0.3rem;
        border-top: 1px solid color-mix(in srgb, var(--dv-ink) 40%, transparent);
    }
    .ng[data-variant-current="C"] .ng-facts dt {
        font-family: var(--mono);
        font-size: 0.58rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.55;
    }
    .ng[data-variant-current="C"] .ng-facts dd {
        font-size: 0.75rem;
        font-weight: 800;
    }
    .ng[data-variant-current="C"] .ng-stack {
        opacity: 0.6;
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-body {
        border-top-color: var(--dv-accent);
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-title {
        color: var(--dv-accent);
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-arrow {
        opacity: 1;
        translate: 0 0;
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-img :global(img) {
        scale: 1.04;
    }


    /* ---------- 中间：角色 ---------- */
    .ng-center {
        position: relative;
        min-height: 16rem;
    }
    .ng-mascot {
        position: absolute;
        inset: -7% 0;
        pointer-events: none;
        transform-origin: 50% 100%;
    }
    .ng-mascot :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transition: opacity 80ms linear;
    }
    /* 姿势之间：短暂的淡入淡出，配合上面的弹跳 */
    .ng-mascot :global(img.is-active) {
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .ng-mascot :global(img),
        .ng-cell,
        .ng-img::before,
        .ng-facts { transition: none !important; }
    }

    /* 窄屏：吉祥物占一整行放在最上，项目两列 */
    @media (max-width: 1023px) {
        .ng {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ng-center {
            grid-column: 1 / -1;
            order: -1;
            min-height: 20rem;
        }
        .ng-mascot {
            inset: 0;
        }
    }
    @media (max-width: 639px) {
        .ng {
            grid-template-columns: 1fr;
        }
    }
</style>
