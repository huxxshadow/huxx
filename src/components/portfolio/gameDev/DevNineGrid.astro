---
// Part 3 · 九宫格：中间是吉祥物，外圈 8 格是项目。悬停 / 聚焦某一格就「选中」它，吉祥物换成指向这一格的姿势；
// 没有选中时指向上方。姿势图在 src/assets/portfolio/mascot/，按方向命名（up-left / up / up-right / left / right /
// down-left / down / down-right）。
// 卡片有三套 P3R 风格（同一份结构，只换 CSS），dev 下用 Debug 面板切换，写在 .ng 的 data-variant-current 上：
//   A 斜切面板：和 Part 2 同一套平行四边形满版图，选中时背后弹出蓝色错位层
//   B 倾斜叠层：卡片微倾，背后黑、蓝两层斜块，巨型斜体标题压出图外，选中时叠层扇开、卡片摆正
//   C 菜单条：图下接一条斜切白色菜单条，选中时黑色从左扫满、左侧出现蓝色三角光标
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDevShowcase } from "./data";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";

interface Props {
    showcase: GameDevShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

// 外圈 8 格按 DOM 顺序对应的方向（中间一格插在第 4 个后面）
const DIRS = ["up-left", "up", "up-right", "left", "right", "down-left", "down", "down-right"] as const;
const poseFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/portfolio/mascot/*.{png,webp,jpg}", { eager: true });
const pose = (name: string) => Object.entries(poseFiles).find(([p]) => p.split("/").pop()!.replace(/\.\w+$/, "") === name)?.[1].default;
const DEFAULT_POSE = "up";
const poses = DIRS.map((dir) => ({ dir, img: pose(dir) })).filter((p) => p.img) as { dir: string; img: ImageMetadata }[];

const works = showcase.works.slice(0, 8);
const cells = works.map((w, i) => ({ w, dir: DIRS[i] }));
const before = cells.slice(0, 4);
const after = cells.slice(4);
---

<div class="ng" data-nine-grid data-variant-group="part3cards" data-variant-label="Part 3 · 卡片样式" data-variant-options="A,B,C" data-variant-current="A">
    {[before, null, after].map((group) => group === null ? (
            <!-- 中间：只有角色，透明底，无边框无文字 -->
            <div class="ng-center" aria-hidden="true">
                <div class="ng-mascot">
                    {poses.map((p) => (
                            <Image src={p.img} alt="" widths={[360, 600, 900]} sizes="(min-width: 1024px) 28vw, 60vw" loading="eager" data-pose={p.dir} class={p.dir === DEFAULT_POSE ? "is-active" : undefined} />
                    ))}
                </div>
            </div>
    ) : group.map(({ w, dir }) => (
            <a href={href(w.id)} class="ng-cell" data-dir={dir}>
                <span class="ng-corner ng-corner-tl"></span>
                <span class="ng-corner ng-corner-tr"></span>
                <span class="ng-corner ng-corner-bl"></span>
                <span class="ng-corner ng-corner-br"></span>
                <span class="ng-tag">▲ {t(labels.select)}</span>
                <span class="ng-shine" aria-hidden="true"></span>
                <div class="ng-img">
                    <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 28vw, 45vw" />
                    <p class="ng-line">{w.line}</p>
                </div>
                <div class="ng-body">
                    <div class="ng-head">
                        <h3 class="ng-title">{w.title}</h3>
                        <span class="ng-arrow" aria-hidden="true">→</span>
                    </div>
                    <dl class="ng-facts">
                        <div><dt>{t(labels.role)}</dt><dd>{w.role}</dd></div>
                        <div><dt>{t(labels.context)}</dt><dd>{w.context}</dd></div>
                    </dl>
                    <ul class="ng-stack">
                        {w.stack.map((s) => <li>{s}</li>)}
                    </ul>
                </div>
            </a>
    )))}
</div>

<script>
    // 选中某一格：吉祥物换成指向这一格的姿势；取消选中时回到指向上方
    function initNineGrid() {
        document.querySelectorAll<HTMLElement>("[data-nine-grid]").forEach((root) => {
            if (root.dataset.ngReady) return;
            root.dataset.ngReady = "1";
            const cells = [...root.querySelectorAll<HTMLElement>(".ng-cell")];
            const imgs = [...root.querySelectorAll<HTMLElement>("[data-pose]")];
            const select = (cell: HTMLElement | null) => {
                cells.forEach((c) => c.classList.toggle("is-selected", c === cell));
                root.classList.toggle("has-selection", !!cell);
                const dir = cell?.dataset.dir ?? "up";
                const target = imgs.find((i) => i.dataset.pose === dir) ?? imgs.find((i) => i.dataset.pose === "up");
                imgs.forEach((i) => i.classList.toggle("is-active", i === target));
            };
            cells.forEach((cell) => {
                cell.addEventListener("mouseenter", () => select(cell));
                cell.addEventListener("focus", () => select(cell));
            });
            root.addEventListener("mouseleave", () => select(null));
            root.addEventListener("focusout", (e) => {
                if (!root.contains(e.relatedTarget as Node)) select(null);
            });
        });
    }
    document.addEventListener("astro:page-load", initNineGrid);
</script>

<style>
    .ng {
        --mono: ui-monospace, "SFMono-Regular", Consolas, monospace;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
    }

    /* =========================================================
       共用骨架：各样式只改外观
       ========================================================= */
    .ng-cell {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        isolation: isolate;
    }
    .ng-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--dv-ink);
    }
    .ng-img :global(img) {
        transition: scale 400ms ease;
    }
    .ng-cell.is-selected .ng-img :global(img) {
        scale: 1.06;
    }
    .ng-body {
        display: flex;
        flex-direction: column;
    }
    .ng-head {
        display: flex;
        align-items: center;
    }
    .ng-title {
        font-weight: 900;
        line-height: 1.05;
    }
    .ng-facts dt,
    .ng-facts dd {
        margin: 0;
    }
    .ng-stack {
        display: flex;
        flex-wrap: wrap;
        font-family: var(--mono);
        font-weight: 700;
    }
    .ng-line,
    .ng-corner,
    .ng-shine,
    .ng-arrow,
    .ng-tag {
        display: none;
    }
    /* SELECT 标签：斜切蓝底白字（A、B 用） */
    .ng-tag {
        position: absolute;
        z-index: 5;
        padding: 0.1rem 0.7rem;
        background-color: var(--dv-accent);
        color: #FFFFFF;
        font-family: var(--mono);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        transform: skewX(-14deg);
        opacity: 0;
        translate: -8px 0;
        transition: opacity 160ms ease, translate 200ms ease;
    }
    .ng-cell.is-selected .ng-tag {
        opacity: 1;
        translate: 0 0;
    }

    /* =========================================================
       A · 斜切面板：和 Part 2 同一套平行四边形满版图 + 底部压暗 + 白色斜描边标签；
       选中时背后弹出一块蓝色错位的平行四边形
       ========================================================= */
    .ng[data-variant-current="A"] .ng-cell {
        --slant: polygon(7% 0, 100% 0, 93% 100%, 0 100%);
        aspect-ratio: 16 / 10.5;
        color: #FFFFFF;
    }
    .ng[data-variant-current="A"] .ng-cell::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: var(--dv-accent);
        clip-path: var(--slant);
        transition: translate 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .ng[data-variant-current="A"] .ng-img {
        position: absolute;
        inset: 0;
        aspect-ratio: auto;
        clip-path: var(--slant);
    }
    .ng[data-variant-current="A"] .ng-img::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--dv-ink) 94%, transparent) 100%);
        transition: background 240ms ease;
    }
    .ng[data-variant-current="A"] .ng-body {
        position: absolute;
        left: 9%;
        right: 12%;
        bottom: 0.95rem;
        z-index: 2;
        gap: 0.45rem;
    }
    .ng[data-variant-current="A"] .ng-title {
        font-size: 1.45rem;
        letter-spacing: -0.01em;
    }
    .ng[data-variant-current="A"] .ng-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    .ng[data-variant-current="A"] .ng-facts dt {
        display: none;
    }
    .ng[data-variant-current="A"] .ng-facts dd {
        padding: 0.02rem 0.55rem;
        border: 2px solid #FFFFFF;
        font-size: 0.7rem;
        font-weight: 800;
        transform: skewX(-12deg);
    }
    .ng[data-variant-current="A"] .ng-stack {
        gap: 0 0.7rem;
        font-size: 0.64rem;
        opacity: 0.75;
    }
    .ng[data-variant-current="A"] .ng-stack li::before {
        content: "/ ";
    }
    .ng[data-variant-current="A"] .ng-tag {
        display: block;
        top: 0.7rem;
        left: 10%;
    }
    .ng[data-variant-current="A"] .ng-cell.is-selected::before {
        translate: 10px 10px;
    }
    .ng[data-variant-current="A"] .ng-cell.is-selected .ng-img::after {
        background: linear-gradient(180deg, transparent 25%, color-mix(in srgb, var(--dv-accent) 92%, transparent) 100%);
    }

    /* =========================================================
       B · 倾斜叠层：黑色斜块做卡底、蓝色斜块在后面错开，整张卡微倾；
       巨型斜体标题压在图的下沿，下面一条白色斜条写身份与出处；
       选中时卡片摆正、蓝色叠层扇开
       ========================================================= */
    .ng[data-variant-current="B"] .ng-cell {
        padding: 12px 14px 16px;
        color: #FFFFFF;
        rotate: -1.5deg;
        transition: rotate 260ms cubic-bezier(0.3, 1.4, 0.5, 1), scale 260ms ease;
    }
    .ng[data-variant-current="B"] .ng-cell::before,
    .ng[data-variant-current="B"] .ng-cell::after {
        content: "";
        position: absolute;
        inset: 0;
        clip-path: polygon(3% 2%, 100% 0, 97% 100%, 0 97%);
    }
    .ng[data-variant-current="B"] .ng-cell::before {
        z-index: -1;
        background-color: var(--dv-ink);
    }
    .ng[data-variant-current="B"] .ng-cell::after {
        z-index: -2;
        background-color: var(--dv-accent);
        rotate: 2.5deg;
        translate: 4px 4px;
        transition: rotate 260ms cubic-bezier(0.3, 1.4, 0.5, 1), translate 260ms ease;
    }
    .ng[data-variant-current="B"] .ng-img {
        clip-path: polygon(3% 0, 100% 2%, 97% 100%, 0 97%);
    }
    .ng[data-variant-current="B"] .ng-body {
        gap: 0.5rem;
    }
    .ng[data-variant-current="B"] .ng-head {
        position: relative;
        z-index: 3;
        margin-top: -1.35rem;
        padding-left: 4%;
    }
    .ng[data-variant-current="B"] .ng-title {
        font-size: 1.85rem;
        font-style: italic;
        letter-spacing: -0.02em;
        -webkit-text-stroke: 7px var(--dv-ink);
        paint-order: stroke fill;
    }
    .ng[data-variant-current="B"] .ng-facts {
        align-self: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 0.9rem;
        margin-left: 3%;
        padding: 0.2rem 1.1rem 0.2rem 0.8rem;
        background-color: #FFFFFF;
        color: var(--dv-ink);
        transform: skewX(-14deg);
    }
    .ng[data-variant-current="B"] .ng-facts > div {
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
        font-size: 0.72rem;
        font-weight: 800;
    }
    .ng[data-variant-current="B"] .ng-facts dt {
        font-family: var(--mono);
        font-size: 0.58rem;
        letter-spacing: 0.12em;
        color: var(--dv-accent);
    }
    .ng[data-variant-current="B"] .ng-stack {
        gap: 0 0.7rem;
        padding-left: 4%;
        font-size: 0.64rem;
        opacity: 0.75;
    }
    .ng[data-variant-current="B"] .ng-stack li::before {
        content: "/ ";
    }
    .ng[data-variant-current="B"] .ng-tag {
        display: block;
        top: -0.55rem;
        right: 1rem;
    }
    .ng[data-variant-current="B"] .ng-cell.is-selected {
        rotate: 0deg;
        scale: 1.03;
    }
    .ng[data-variant-current="B"] .ng-cell.is-selected::after {
        rotate: 5deg;
        translate: 10px 8px;
    }

    /* =========================================================
       C · 菜单条：斜切图下面接一条斜切白色菜单条（P3R 主菜单那样），
       选中时黑色从左扫满菜单条、字变白，左侧弹出蓝色三角光标
       ========================================================= */
    .ng[data-variant-current="C"] .ng-img {
        clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
    }
    /* 图底下一道蓝色斜线，选中时伸长 */
    .ng[data-variant-current="C"] .ng-img::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        height: 6px;
        width: 30%;
        background-color: var(--dv-accent);
        transform: skewX(-30deg);
        transform-origin: left;
        transition: width 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .ng[data-variant-current="C"] .ng-body {
        gap: 0.4rem;
        padding: 0.55rem 0.4rem 0 1.4rem;
    }
    .ng[data-variant-current="C"] .ng-head {
        position: relative;
        isolation: isolate;
        align-self: stretch;
        padding: 0.45rem 2rem 0.45rem 0.9rem;
        color: var(--dv-ink);
        transition: color 200ms ease;
    }
    .ng[data-variant-current="C"] .ng-head::before,
    .ng[data-variant-current="C"] .ng-head::after {
        content: "";
        position: absolute;
        inset: 0;
        clip-path: polygon(0 0, 100% 0, calc(100% - 1.3rem) 100%, 0 100%);
    }
    .ng[data-variant-current="C"] .ng-head::before {
        z-index: -2;
        background-color: #FFFFFF;
    }
    .ng[data-variant-current="C"] .ng-head::after {
        z-index: -1;
        background-color: var(--dv-ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .ng[data-variant-current="C"] .ng-title {
        font-size: 1.3rem;
        font-style: italic;
        letter-spacing: -0.01em;
    }
    /* 三角光标 */
    .ng[data-variant-current="C"] .ng-arrow {
        display: block;
        position: absolute;
        left: -1.3rem;
        top: 50%;
        width: 0;
        height: 0;
        margin-top: -0.6rem;
        border-top: 0.6rem solid transparent;
        border-bottom: 0.6rem solid transparent;
        border-left: 0.9rem solid var(--dv-accent);
        font-size: 0;
        opacity: 0;
        translate: -8px 0;
        transition: opacity 160ms ease, translate 220ms cubic-bezier(0.3, 1.4, 0.5, 1);
    }
    .ng[data-variant-current="C"] .ng-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 0.9rem;
        padding-left: 0.9rem;
    }
    .ng[data-variant-current="C"] .ng-facts > div {
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
        font-size: 0.74rem;
        font-weight: 800;
    }
    .ng[data-variant-current="C"] .ng-facts dt {
        font-family: var(--mono);
        font-size: 0.58rem;
        letter-spacing: 0.12em;
        color: var(--dv-accent);
    }
    .ng[data-variant-current="C"] .ng-stack {
        gap: 0 0.7rem;
        padding-left: 0.9rem;
        font-size: 0.64rem;
        opacity: 0.7;
    }
    .ng[data-variant-current="C"] .ng-stack li::before {
        content: "/ ";
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-head {
        color: #FFFFFF;
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-head::after {
        transform: scaleX(1);
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-arrow {
        opacity: 1;
        translate: 0 0;
    }
    .ng[data-variant-current="C"] .ng-cell.is-selected .ng-img::after {
        width: 75%;
    }


    /* ---------- 中间：角色 ---------- */
    .ng-center {
        position: relative;
        min-height: 16rem;
    }
    .ng-mascot {
        position: absolute;
        inset: -7% 0;
        pointer-events: none;
    }
    .ng-mascot :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transition: opacity 260ms ease;
    }
    /* 姿势之间淡入淡出 */
    .ng-mascot :global(img.is-active) {
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .ng-mascot :global(img),
        .ng-cell,
        .ng-shine { transition: none !important; }
        .ng-img::after { animation: none !important; }
    }

    /* 窄屏：吉祥物占一整行放在最上，项目两列 */
    @media (max-width: 1023px) {
        .ng {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ng-center {
            grid-column: 1 / -1;
            order: -1;
            min-height: 20rem;
        }
        .ng-mascot {
            inset: 0;
        }
    }
    @media (max-width: 639px) {
        .ng {
            grid-template-columns: 1fr;
        }
    }
</style>
