---
// Part 3 · 九宫格：中间是吉祥物，外圈 8 格是项目。悬停 / 聚焦某一格就「选中」它，吉祥物换成指向这一格的姿势；
// 没有选中时指向上方。八个姿势拼在一张横向精灵图里（src/assets/portfolio/mascot/sprite.webp，顺序同 DIRS），
// 切换时只移动背景位置：同一张已解码的图，不会出现空白帧。
// 卡片是卡通风格（参考中间的角色）：蓝色粗描边、白底圆角、底部一道实色边；内容只有 名字 + 一行说明 + 标签。
// 选中时卡片弹起、底边加厚，不反色。
// 切换姿势：八张图身体完全重合，只有手臂不同，所以在一次 Q 弹的「压扁—弹起—回弹」里瞬间换图，不做淡入淡出
import sprite from "@/assets/portfolio/mascot/sprite.webp";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n";
import type { GameDevShowcase } from "./data";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";

interface Props {
    showcase: GameDevShowcase;
    lang: Lang;
    labels: Record<string, any>;
}
const { showcase, lang, labels } = Astro.props;
const t = useTranslations(lang);
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

// 外圈 8 格按 DOM 顺序对应的方向（中间一格插在第 4 个后面）
const DIRS = ["up-left", "up", "up-right", "left", "right", "down-left", "down", "down-right"] as const;
const DEFAULT_POSE = "up";
// 精灵图单帧尺寸（729 × 900）
const FRAME_RATIO = `${sprite.width / DIRS.length} / ${sprite.height}`;

const works = showcase.works.slice(0, 8);
const cells = works.map((w, i) => ({ w, dir: DIRS[i] }));
const before = cells.slice(0, 4);
const after = cells.slice(4);
---

<div class="ng" data-nine-grid>
    {[before, null, after].map((group) => group === null ? (
            <!-- 中间：只有角色，透明底，无边框无文字 -->
            <div class="ng-center" aria-hidden="true">
                <div class="ng-mascot">
                    <div class="ng-sprite" data-sprite style={`background-image: url(${sprite.src}); aspect-ratio: ${FRAME_RATIO}; --frame: ${DIRS.indexOf(DEFAULT_POSE)};`}></div>
                </div>
            </div>
    ) : group.map(({ w, dir }) => (
            <a href={href(w.id)} class="ng-cell" data-dir={dir}>
                <div class="ng-img">
                    <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 28vw, 45vw" />
                </div>
                <div class="ng-body">
                    <h3 class="ng-title">{w.title}</h3>
                    <p class="ng-caption" title={w.line}>{w.line}</p>
                    <ul class="ng-tags">
                        <li>{w.role}</li>
                        {w.stack.map((s) => <li>{s}</li>)}
                    </ul>
                </div>
            </a>
    )))}
</div>

<script>
    // 选中某一格：吉祥物换成指向这一格的姿势；取消选中时回到指向上方。
    // 换姿势时整个角色以脚底为支点先压扁一点再弹起，图在压到最低时替换
    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function initNineGrid() {
        document.querySelectorAll<HTMLElement>("[data-nine-grid]").forEach((root) => {
            if (root.dataset.ngReady) return;
            root.dataset.ngReady = "1";
            const cells = [...root.querySelectorAll<HTMLElement>(".ng-cell")];
            const DIRS = ["up-left", "up", "up-right", "left", "right", "down-left", "down", "down-right"];
            const spriteEl = root.querySelector<HTMLElement>("[data-sprite]");
            const mascot = root.querySelector<HTMLElement>(".ng-mascot");
            let current = "up";
            let swapTimer = 0;
            const swapTo = (dir: string) => {
                if (!spriteEl || dir === current) return;
                current = dir;
                window.clearTimeout(swapTimer);
                const apply = () => spriteEl.style.setProperty("--frame", String(Math.max(0, DIRS.indexOf(dir))));
                if (!mascot || reduceMotion()) return apply();
                mascot.animate(
                    [
                        { transform: "translateY(0) scale(1, 1)" },
                        { transform: "translateY(3px) scale(1.09, 0.9)", offset: 0.18 },
                        { transform: "translateY(-16px) scale(0.93, 1.09)", offset: 0.42 },
                        { transform: "translateY(0) scale(1.05, 0.95)", offset: 0.62 },
                        { transform: "translateY(-4px) scale(0.98, 1.025)", offset: 0.78 },
                        { transform: "translateY(0) scale(1.01, 0.99)", offset: 0.9 },
                        { transform: "translateY(0) scale(1, 1)" },
                    ],
                    { duration: 560, easing: "cubic-bezier(0.3, 0, 0.3, 1)" },
                );
                // 在压到最扁的那一帧换图
                swapTimer = window.setTimeout(apply, 95);
            };
            const select = (cell: HTMLElement | null) => {
                cells.forEach((c) => c.classList.toggle("is-selected", c === cell));
                root.classList.toggle("has-selection", !!cell);
                const dir = cell?.dataset.dir ?? "up";
                swapTo(dir);
            };
            cells.forEach((cell) => {
                cell.addEventListener("mouseenter", () => select(cell));
                cell.addEventListener("focus", () => select(cell));
            });
            root.addEventListener("mouseleave", () => select(null));
            root.addEventListener("focusout", (e) => {
                if (!root.contains(e.relatedTarget as Node)) select(null);
            });
        });
    }
    document.addEventListener("astro:page-load", initNineGrid);
</script>

<style>
    .ng {
        --mono: ui-monospace, "SFMono-Regular", Consolas, monospace;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
    }

    /* ---------- 项目卡：卡通风格，蓝色粗描边、白底圆角 ---------- */
    .ng-cell {
        /* 这一页的蓝只用 #0058C0（--dv-accent）和浅蓝（--dv-tint） */
        --line: var(--dv-accent);
        --lw: 4px;
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background-color: #FFFFFF;
        color: var(--line);
        border: var(--lw) solid var(--line);
        border-radius: 18px;
        box-shadow: 0 6px 0 var(--line);
        transition: translate 240ms cubic-bezier(0.3, 1.5, 0.5, 1), box-shadow 200ms ease, background-color 180ms ease, color 180ms ease;
    }
    .ng-cell.is-selected {
        translate: 0 -6px;
        box-shadow: 0 12px 0 var(--line);
    }
    .ng-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--line);
        border-bottom: var(--lw) solid var(--line);
    }
    .ng-img :global(img) {
        transition: scale 400ms ease;
    }
    .ng-cell.is-selected .ng-img :global(img) {
        scale: 1.05;
    }
    .ng-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 0.45rem;
        padding: 0.8rem 1rem 1rem;
    }
    .ng-title {
        font-weight: 900;
        font-size: 1.4rem;
        line-height: 1.1;
        letter-spacing: -0.01em;
    }
    /* 一行说明，放不下就省略（悬停可看完整的 title） */
    .ng-caption {
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: 0.85;
    }
    .ng-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: auto;
        padding-top: 0.2rem;
    }
    .ng-tags li {
        padding: 0.05rem 0.6rem;
        background-color: #FFFFFF;
        color: var(--line);
        border: 3px solid var(--line);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 800;
    }

    /* ---------- 中间：角色 ---------- */
    .ng-center {
        position: relative;
        min-height: 16rem;
    }
    .ng-mascot {
        position: absolute;
        inset: -7% 0;
        pointer-events: none;
        transform-origin: 50% 100%;
    }
    /* 精灵图：单帧按比例居中，横向 8 帧，用背景位置切帧 */
    .ng-sprite {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        max-width: 100%;
        translate: -50% 0;
        background-repeat: no-repeat;
        background-size: 800% 100%;
        background-position: calc(var(--frame) * 100% / 7) 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .ng-cell { transition: none !important; }
    }

    /* 窄屏：吉祥物占一整行放在最上，项目两列 */
    @media (max-width: 1023px) {
        .ng {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .ng-center {
            grid-column: 1 / -1;
            order: -1;
            min-height: 20rem;
        }
        .ng-mascot {
            inset: 0;
        }
    }
    @media (max-width: 639px) {
        .ng {
            grid-template-columns: 1fr;
        }
    }
</style>
