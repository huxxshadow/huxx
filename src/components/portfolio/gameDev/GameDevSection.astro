---
// Part 3 · 游戏开发：写过代码的项目，突出每个项目里亲手搭的系统与技术栈。
// 版式：九宫格，中间是吉祥物，外圈 8 个项目，悬停即选中
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { gameDevLabels as L } from "@/i18n/components/portfolio/GameDevShowcase_i18";
import { getGameDevShowcase } from "./data";
import DevNineGrid from "./DevNineGrid.astro";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "game-dev")!;
const showcase = await getGameDevShowcase(lang);

const ink = COLORS.black;
const accent = COLORS.blue.dark;
const tint = COLORS.blue.light;
const layout = { showcase, lang, labels: L };
---

<section
        id={role.anchor}
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --dv-accent: ${accent}; --dv-tint: ${tint}; --dv-ink: ${ink}; --dv-paper: #FFFDF7;`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-6 lg:mb-8" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="dv-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <div class="flex flex-col pb-1">
                <span class="font-black text-xs tracking-[0.3em] uppercase" style={`color: ${accent};`}>{role.person.en}</span>
                <h2 class="dv-skew font-black leading-none tracking-tight text-4xl lg:text-5xl">{t(role.name)}</h2>
            </div>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{showcase.works.length} {t(L.projects)}</span>
    </header>

    <div data-reveal="fade" data-reveal-once>
        <DevNineGrid {...layout} />
    </div>
</section>

<style>
    .dv-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }
</style>
