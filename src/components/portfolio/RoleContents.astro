---
// 作品集总览的目录：书目录式列表，每个角色一行。标题行「编号 图标 名称 ···· N 个项目 →」，下面是该角色的介绍；悬停整行反色
import type { RoleContentsProps } from "./portfolioRolesData";
import Segments from "./intro/Segments.astro";

type Props = RoleContentsProps;
const { items, unit, theme } = Astro.props;
---

<ol class="border-t-[3px]" style={`border-color: ${theme.dark};`} data-reveal-children="left" data-reveal-once data-reveal-stagger="80">
    {items.map(({ role, name, segments }) => (
            <li class="border-b-[3px]" style={`border-color: ${theme.dark};`}>
                <a
                        href={`#${role.anchor}`}
                        class="toc-a-row block px-2 lg:px-4 py-6 lg:py-7"
                        style={`--row-bg: ${role.color.dark}; --row-text: ${role.color.light};`}
                >
                    <div class="flex items-center gap-4 lg:gap-6">
                        <span class="font-black text-2xl lg:text-4xl w-12 lg:w-16 shrink-0">{role.index}</span>
                        <i class={`${role.icon} text-2xl lg:text-3xl w-8 lg:w-10 text-center shrink-0`}></i>
                        <span class="font-black text-xl sm:text-2xl lg:text-4xl leading-tight">{name}</span>
                        <span class="toc-a-leader flex-1 hidden sm:block border-b-[3px] border-dotted self-center min-w-6"></span>
                        <span class="font-black text-base lg:text-xl whitespace-nowrap shrink-0 ml-auto sm:ml-0">{role.count} {unit}</span>
                        <i class="toc-a-arrow fa-solid fa-arrow-right text-xl shrink-0 transition-transform duration-200"></i>
                    </div>
                    <p class="mt-3 lg:mt-4 sm:pl-[6rem] lg:pl-[8.5rem] text-base lg:text-lg font-medium leading-[1.85]">
                        <Segments segments={segments} />
                    </p>
                </a>
            </li>
    ))}
</ol>

<style>
    .toc-a-row {
        transition: background-color 150ms ease, color 150ms ease;
    }
    .toc-a-row:hover,
    .toc-a-row:focus-visible {
        background-color: var(--row-bg);
        color: var(--row-text);
    }
    /* 反色后关键词的角色色会和底色撞色，跟随行文字颜色 */
    .toc-a-row:hover [data-kw],
    .toc-a-row:focus-visible [data-kw] {
        color: inherit !important;
    }
    .toc-a-row:hover .toc-a-arrow {
        transform: translateX(6px);
    }
    .toc-a-leader {
        border-color: currentColor;
        opacity: 0.5;
    }
</style>
