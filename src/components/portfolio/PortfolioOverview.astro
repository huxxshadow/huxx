---
// Part 1 · 总览（版式参考 P3R）：倾斜的大标题 + 打字机，总述放在倾斜的纸面板里，
// 四个角色是右侧逐级错开的平行四边形菜单，每行一段自我介绍，点击跳到对应板块；
// 左侧是角色插画舞台，悬停 / 聚焦哪一行就切换到哪个角色的插画
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { portfolioOverviewLabels as L } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { getOverviewData, parseIntro } from "./portfolioRolesData";
import Typewriter from "./intro/Typewriter.astro";
import Segments from "./intro/Segments.astro";
import gameDesignArt from "@/assets/portfolio/roles/game-design.svg";
import gameDevArt from "@/assets/portfolio/roles/game-dev.svg";
import aiAppArt from "@/assets/portfolio/roles/ai-app.svg";
import techArtArt from "@/assets/portfolio/roles/tech-art.svg";

const t = useTranslations((Astro.currentLocale as Lang) || "en");
const { roles } = await getOverviewData();
const theme = { light: COLORS.khakiMilan, dark: COLORS.black };

const { lead, roleParagraphs } = parseIntro(t(L.positioning), roles);
const title = t(L.title);
const prefix = t(L.iAmPrefix);
const suffix = t(L.iAmSuffix);
const words = roles.map((r) => ({ text: t(r.person), color: r.color.dark }));
const items = roleParagraphs.map(({ role, segments }) => ({ role, name: t(role.name), segments }));
const unit = t(L.projectsUnit);
const paper = "#FFFDF7";

// 角色插画（SVG 已去掉描摹背景，viewBox 裁到人物）
const roleArt: Record<string, ImageMetadata> = {
    "game-design": gameDesignArt,
    "game-dev": gameDevArt,
    "ai-app": aiAppArt,
    "tech-art": techArtArt,
};


// 插画框定位：抵消 section 左内边距紧贴屏幕左边，右边缘止于本栏右边缘
const artBox = "absolute left-0 lg:-left-20 xl:-left-28 inset-y-0 w-full lg:w-[calc(100%+5rem)] xl:w-[calc(100%+7rem)]";
---

<section
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-20 lg:py-24"
        style={`background-color: ${theme.light}; color: ${theme.dark}; --theme-bg: ${theme.light}; --theme-text: ${theme.dark};`}
        data-theme-bg={theme.light}
        data-theme-text={theme.dark}
>
    <div class="p3" style={`--paper: ${paper};`}>
        <div class="relative" data-reveal-children="left" data-reveal-once data-reveal-stagger="100">
            <h1 class="p3-title font-black leading-[0.85] tracking-tighter text-[4rem] sm:text-[6rem] lg:text-[8rem]">
                {title}
            </h1>

            <Typewriter words={words} prefix={prefix} suffix={suffix} class="mt-6 lg:mt-8 text-3xl sm:text-5xl lg:text-6xl min-h-[2.6em] lg:min-h-0" />
        </div>

        <!-- 总述：倾斜的纸面板，文字转回正 -->
        <div class="p3-panel relative mt-6 lg:mt-8 border-l-[10px]" style={`background-color: ${paper}; border-color: ${theme.dark};`} data-reveal="left" data-reveal-once>
            <div class="p3-unskew flex flex-col gap-4 px-6 lg:px-10 py-6 lg:py-8 text-base lg:text-lg font-medium leading-[1.85]">
                {lead.map((segments) => <p><Segments segments={segments} /></p>)}
            </div>
        </div>

        <div
                class="mt-12 lg:mt-16 grid lg:grid-cols-[3fr_7fr] gap-8 lg:gap-12 xl:gap-16"
                data-role-showcase
        >
            <!-- 左：角色插画舞台（只在宽屏显示，窄屏没有悬停）。插画抵消 section 左内边距、紧贴屏幕左边，按原比例放大，
                 右边缘止于本栏右边缘，任何屏宽下都不会压到右侧菜单 -->
            <div class="relative z-0 hidden lg:block min-h-[28rem]" data-reveal="fade" data-reveal-once aria-hidden="true">
                {items.map(({ role }, i) => {
                    const art = roleArt[role.id];
                    return (
                            <div
                                    class:list={["role-art flex items-center justify-start", artBox]}
                                    data-role-art={role.id}
                                    data-color={role.color.dark}
                                    data-active={i === 0 ? "" : undefined}
                            >
                                <!-- 框按插画原比例取「放得下的最大尺寸」，残影按它定位，和画面对齐 -->
                                <div class="art-frame relative" style={`aspect-ratio: ${art.width} / ${art.height}; width: min(100cqw, 100cqh * ${(art.width / art.height).toFixed(4)});`}>
                                    <img src={art.src} alt="" width={art.width} height={art.height} class="art-body absolute inset-0 w-full h-full" loading="lazy" decoding="async" />
                                </div>
                            </div>
                    );
                })}
            </div>

            <!-- 右：角色菜单，平行四边形，逐级向右错开。负右外边距把菜单推到离屏幕右边约 1rem，
                 行向右倾斜多出来的宽度由脚本按行高算出、留成右内边距（默认 3rem 兜底） -->
            <nav class="relative z-10 lg:-mr-16 xl:-mr-24 lg:pr-12 flex flex-col gap-5 lg:gap-6" data-role-menu data-reveal-children="left" data-reveal-once data-reveal-stagger="90">
                {items.map(({ role, name, segments }, i) => (
                        <a
                                href={`#${role.anchor}`}
                                class="p3-row group relative block border-l-[10px]"
                                style={`--step: ${i}; --role-dark: ${role.color.dark}; --role-light: ${role.color.light}; border-color: ${role.color.dark};`}
                                data-role-link={role.id}
                        >
                            <div class="p3-unskew flex flex-col gap-3 px-6 lg:px-8 py-5">
                                <div class="flex items-end gap-4">
                                    <span class="p3-num font-black leading-[0.8] text-6xl lg:text-7xl">{role.index}</span>
                                    <span class="font-black text-2xl lg:text-3xl leading-tight pb-1">{name}</span>
                                    <span class="ml-auto shrink-0 flex items-center gap-2 font-black whitespace-nowrap pb-1">
                                        {role.count} {unit}
                                        <i class="fa-solid fa-arrow-right transition-transform duration-200 group-hover:translate-x-1.5"></i>
                                    </span>
                                </div>
                                <p class="text-base lg:text-lg font-medium leading-[1.8]">
                                    <Segments segments={segments} />
                                </p>
                            </div>
                        </a>
                ))}
            </nav>
        </div>
    </div>
</section>

<style>
    .p3 {
        position: relative;
        --skew: -10deg;
    }
    .p3-title {
        transform: skewX(var(--skew));
        transform-origin: left bottom;
    }
    .p3-panel,
    .p3-row {
        transform: skewX(var(--skew));
        transform-origin: left top;
    }
    .p3-unskew {
        transform: skewX(calc(var(--skew) * -1));
    }
    .p3-row {
        /* 以左下角为基准倾斜：整行只向右倾，不会越过本栏左边缘压到左侧插画（行越高、越出越多） */
        transform-origin: left bottom;
        background-color: var(--paper);
        transition: transform 160ms ease, background-color 160ms ease, color 160ms ease;
    }
    .p3-num {
        color: var(--role-dark);
        transition: color 160ms ease;
    }
    .p3-row:hover,
    .p3-row:focus-visible {
        transform: skewX(var(--skew)) translateX(12px);
        background-color: var(--role-dark);
        color: var(--role-light);
    }
    .p3-row:hover .p3-num,
    .p3-row:focus-visible .p3-num {
        color: var(--paper);
    }
    .p3-row:hover :global([data-kw]),
    .p3-row:focus-visible :global([data-kw]) {
        color: #fff !important;
    }
    /* 宽屏上逐级错开，像 P3 的菜单 */
    @media (min-width: 1024px) {
        .p3-row {
            margin-left: calc(var(--step) * 1.5rem);
        }
    }
    /* 插画舞台：只显示当前角色；切换动画由下面的脚本用 Web Animations 播放 */
    .role-art {
        opacity: 0;
    }
    .role-art[data-active] {
        opacity: 1;
    }
    .role-art {
        container-type: size;
    }
    :global(.art-ghost) {
        position: absolute;
        pointer-events: none;
        -webkit-mask: var(--ghost-src) left top / 100% 100% no-repeat;
        mask: var(--ghost-src) left top / 100% 100% no-repeat;
    }
</style>

<script>
    // 悬停 / 聚焦菜单里的某一行，左侧插画切到该角色（残影拖尾）：新角色从屏幕左边缘外滑入，
    // 身后拖着几层角色色剪影，追上本体时淡掉；旧角色向右滑出淡出。离开菜单时保持最后一个，不回退。
    // 最终状态由 data-active 决定，动画只负责过程；每次切换前取消上一轮所有动画。
    const SKEW_TAN = Math.tan((10 * Math.PI) / 180);

    function initShowcase(root: HTMLElement) {
        const arts = new Map(
            Array.from(root.querySelectorAll<HTMLElement>('[data-role-art]')).map((el) => [el.dataset.roleArt!, el])
        );
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let current = Array.from(arts.keys()).find((id) => arts.get(id)!.hasAttribute('data-active'));

        const show = (id: string) => {
            if (id === current || !arts.has(id)) return;
            const incoming = arts.get(id)!;
            const outgoing = current ? arts.get(current) : undefined;
            current = id;

            outgoing?.removeAttribute('data-active');
            incoming.setAttribute('data-active', '');
            if (reduceMotion) return;

            arts.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
            root.querySelectorAll('.art-ghost').forEach((g) => g.remove());
            trail(incoming, outgoing);
        };

        root.querySelectorAll<HTMLElement>('[data-role-link]').forEach((link) => {
            const id = link.dataset.roleLink!;
            link.addEventListener('mouseenter', () => show(id));
            link.addEventListener('focus', () => show(id));
        });

        reserveSkewRoom(root);
    }

    // 几层角色色剪影（用插画当遮罩）比本体稍晚出发，追上本体时淡掉
    function trail(incoming: HTMLElement, outgoing: HTMLElement | undefined) {
        const easing = 'cubic-bezier(0.2, 1, 0.3, 1)';
        outgoing?.animate(
            [{ opacity: 1, translate: '0 0' }, { opacity: 0, translate: '160px 0' }],
            { duration: 280, easing: 'cubic-bezier(0.4, 0, 1, 1)' }
        );

        // 位置都要在本体开始位移之前量，否则起点偏移会被算进残影的静止位置
        const fromX = -Math.ceil(incoming.getBoundingClientRect().right);
        const stage = incoming.parentElement!;
        const frame = incoming.querySelector<HTMLElement>('.art-frame')!;
        const src = incoming.querySelector<HTMLImageElement>('.art-body')!.getAttribute('src')!; // currentSrc 在懒加载图未加载完时是空的
        const box = frame.getBoundingClientRect();
        const origin = stage.getBoundingClientRect();

        incoming.animate(
            [{ opacity: 0, translate: `${fromX}px 0` }, { opacity: 1, offset: 0.25 }, { opacity: 1, translate: '0 0' }],
            { duration: 620, easing }
        );

        [0.6, 0.4, 0.22].forEach((opacity, i) => {
            const ghost = document.createElement('div');
            ghost.className = 'art-ghost';
            Object.assign(ghost.style, {
                left: `${box.left - origin.left}px`, top: `${box.top - origin.top}px`,
                width: `${box.width}px`, height: `${box.height}px`,
                backgroundColor: incoming.dataset.color!,
            });
            ghost.style.setProperty('--ghost-src', `url("${src}")`);
            stage.append(ghost);
            ghost.animate(
                // 前半程保持浓度，快追上本体时才淡掉
                [{ opacity, translate: `${fromX}px 0` }, { opacity: opacity * 0.8, offset: 0.85 }, { opacity: 0, translate: '0 0' }],
                { duration: 620, delay: (i + 1) * 70, easing, fill: 'backwards' }
            ).finished.catch(() => {}).finally(() => ghost.remove());
        });
    }

    // 行以左下角为基准倾斜 10°，顶边会向右多出 行高 × tan10°；再加悬停时右移的 12px。
    // 把这段宽度留成菜单的右内边距，任何屏宽下行都不会被屏幕右边裁掉。
    const HOVER_SHIFT = 12;
    let skewObserver: ResizeObserver | undefined;

    function reserveSkewRoom(root: HTMLElement) {
        const menu = root.querySelector<HTMLElement>('[data-role-menu]');
        if (!menu || !('ResizeObserver' in window)) return;
        const wide = window.matchMedia('(min-width: 1024px)');
        const rows = Array.from(menu.querySelectorAll<HTMLElement>('.p3-row'));

        const update = () => {
            if (!wide.matches) { menu.style.paddingRight = ''; return; }
            const tallest = Math.max(...rows.map((row) => row.offsetHeight));
            menu.style.paddingRight = `${Math.ceil(tallest * SKEW_TAN) + HOVER_SHIFT}px`;
        };

        skewObserver?.disconnect();
        skewObserver = new ResizeObserver(update);
        rows.forEach((row) => skewObserver!.observe(row));
        update();
    }

    document.addEventListener('astro:before-swap', () => skewObserver?.disconnect());

    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLElement>('[data-role-showcase]').forEach(initShowcase);
    });
</script>
