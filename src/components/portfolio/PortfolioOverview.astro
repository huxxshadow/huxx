---
// Part 1 · 总览：打字机标题 + 总述 + 四个角色（每个角色一段自我介绍，点击跳到对应板块）
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { portfolioOverviewLabels as L } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { getOverviewData, parseIntro } from "./portfolioRolesData";
import OverviewA from "./overview/OverviewA.astro";
import OverviewB from "./overview/OverviewB.astro";
import OverviewC from "./overview/OverviewC.astro";

const t = useTranslations((Astro.currentLocale as Lang) || "en");
const { roles } = await getOverviewData();
const theme = { light: COLORS.khakiMilan, dark: COLORS.black };

const { lead, roleParagraphs } = parseIntro(t(L.positioning), roles);
const layout = {
    title: t(L.title),
    prefix: t(L.iAmPrefix),
    suffix: t(L.iAmSuffix),
    words: roles.map((r) => ({ text: t(r.person), color: r.color.dark })),
    wordsOnDark: roles.map((r) => ({ text: t(r.person), color: r.color.light })),
    lead,
    items: roleParagraphs.map(({ role, segments }) => ({ role, name: t(role.name), segments })),
    unit: t(L.projectsUnit),
    theme,
};
---

<section
        class="relative overflow-hidden w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-20 lg:py-24"
        style={`background-color: ${theme.light}; color: ${theme.dark}; --theme-bg: ${theme.light}; --theme-text: ${theme.dark};`}
        data-theme-bg={theme.light}
        data-theme-text={theme.dark}
>
    <!-- 三个候选版式，本地 dev 下用 DebugVariantSwitcher 切换；默认 / 生产显示 A -->
    <div data-variant-group="overview" data-variant-label="Overview">
        <div data-variant="A"><OverviewA {...layout} /></div>
        <div data-variant="B" hidden><OverviewB {...layout} /></div>
        <div data-variant="C" hidden><OverviewC {...layout} /></div>
    </div>
</section>
