---
// 自我介绍 · 变体 C：RPG 对话框。标题居中，正文装进带名牌的游戏对话框，角色段落以 ▶ 选项的样子排列
import Avatar from "@/assets/avater.svg";
import type { IntroProps } from "../portfolioRolesData";
import Typewriter from "./Typewriter.astro";
import Segments from "./Segments.astro";

type Props = IntroProps;
const { title, words, prefix, suffix, lead, roleParagraphs, theme } = Astro.props;
---

<div class="flex flex-col items-center">
    <div class="w-full text-center" data-reveal-children="up" data-reveal-once data-reveal-stagger="90">
        <h1 class="text-[3.5rem] sm:text-[4.5rem] lg:text-[5.5rem] font-black leading-[0.85] tracking-tighter mb-8">
            {title}
        </h1>
        <Typewriter words={words} prefix={prefix} suffix={suffix} class="text-3xl sm:text-5xl lg:text-6xl min-h-[2.6em] sm:min-h-[2.4em]" />
    </div>

    <div
            class="relative w-full max-w-5xl mt-12 rounded-xl border-[4px] px-5 sm:px-8 lg:px-10 pt-12 pb-10"
            style={`border-color: ${theme.dark}; background-color: #FFFDF7; box-shadow: 8px 8px 0 ${theme.dark};`}
            data-reveal="up"
            data-reveal-once
    >
        <!-- 名牌 -->
        <div
                class="absolute -top-6 left-5 sm:left-8 flex items-center gap-2 h-12 pl-1.5 pr-4 rounded-lg border-[4px] font-black text-xl"
                style={`border-color: ${theme.dark}; background-color: ${theme.dark}; color: #FFFDF7;`}
        >
            <span class="h-8 w-8 rounded-md overflow-hidden flex items-center justify-center" style={`background-color: #FFFDF7; color: ${theme.dark};`}>
                <Avatar class="h-full w-auto block" fill="currentColor" />
            </span>
            huxx
        </div>

        <div class="flex flex-col gap-4">
            {lead.map((segments) => (
                    <p class="text-base lg:text-lg font-bold leading-[1.85]">
                        <Segments segments={segments} />
                    </p>
            ))}
        </div>

        <ul class="mt-6 flex flex-col gap-4">
            {roleParagraphs.map(({ role, segments }) => (
                    <li class="flex gap-3 lg:gap-4">
                        <span class="shrink-0 font-black text-lg leading-[1.85]" style={`color: ${role.color.dark};`}>▶</span>
                        <p class="text-base lg:text-lg font-medium leading-[1.85]">
                            <Segments segments={segments} />
                        </p>
                    </li>
            ))}
        </ul>

        <span class="dialog-next absolute bottom-3 right-5 font-black text-xl" aria-hidden="true">▼</span>
    </div>
</div>

<style>
    .dialog-next {
        animation: dialog-bob 0.9s ease-in-out infinite alternate;
    }
    @keyframes dialog-bob {
        to { translate: 0 4px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .dialog-next { animation: none; }
    }
</style>
