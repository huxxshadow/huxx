---
// 自我介绍 · 变体 A：杂志式双栏。左栏标题 + 打字机，右栏总述大字 + 四段角色分节
import type { IntroProps } from "../portfolioRolesData";
import Typewriter from "./Typewriter.astro";
import Segments from "./Segments.astro";

type Props = IntroProps;
const { title, words, prefix, suffix, lead, roleParagraphs, theme } = Astro.props;
---

<div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
    <div class="lg:w-5/12 shrink-0">
        <div data-reveal-children="up" data-reveal-once data-reveal-stagger="90">
            <h1 class="text-[3.5rem] sm:text-[4.5rem] lg:text-[5.5rem] font-black leading-[0.85] tracking-tighter mb-8">
                {title}
            </h1>
            <Typewriter words={words} prefix={prefix} suffix={suffix} class="text-3xl sm:text-4xl lg:text-5xl min-h-[2.6em]" />
        </div>
    </div>

    <div class="lg:w-7/12 flex flex-col" data-reveal-children="up" data-reveal-once data-reveal-stagger="70">
        {lead.map((segments) => (
                <p class="text-lg lg:text-xl font-bold leading-[1.8] mb-5">
                    <Segments segments={segments} />
                </p>
        ))}

        {roleParagraphs.map(({ role, segments }) => (
                <div class="pt-5 mt-3 border-t-2" style={`border-color: color-mix(in srgb, ${theme.dark} 25%, transparent);`}>
                    <div class="flex items-center gap-3 mb-2 font-black" style={`color: ${role.color.dark};`}>
                        <span class="text-sm tracking-[0.2em]">{role.index}</span>
                        <i class={`${role.icon} text-lg`}></i>
                    </div>
                    <p class="text-base lg:text-lg font-medium leading-[1.9]">
                        <Segments segments={segments} />
                    </p>
                </div>
        ))}
    </div>
</div>
