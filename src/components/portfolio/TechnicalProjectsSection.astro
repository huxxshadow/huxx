---
// src/components/portfolio/TechnicalProjectsSection.astro
import { COLORS } from "@/consts.ts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { Lang } from "@/i18n.ts";
import { useTranslations } from "@/i18n.ts";
import { technicalProjectsLabels } from "@/i18n/components/portfolio/TechnicalProjectsSection_i18.ts";

const allProjects = await getCollection("projects");
// 只筛选 category 为 "technical" 的项目，并按 order 倒序排列
const technicalProjects = allProjects
    .filter((p) => p.data.category === "technical")
    .sort((a, b) => b.data.order - a.data.order);

// 将项目分为“有封面”和“无封面”两组
const withCoverProjects = technicalProjects.filter(p => !!p.data.coverImage);
const withoutCoverProjects = technicalProjects.filter(p => !p.data.coverImage);

const currentLang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(currentLang);

// 使用蓝色作为技术项目部分的主题色
const defaultTheme = COLORS.blue;

/**
 * 获取项目的主题色
 */
function getProjectColors(project: typeof technicalProjects[number]) {
    const textColor = project.data.colorText || defaultTheme.dark;
    const bgColor = project.data.colorBackground || defaultTheme.light;
    return { text: textColor, bg: bgColor };
}
---

<section
        class="relative overflow-hidden w-full px-4 sm:px-8 py-24"
        style={`background-color: ${defaultTheme.light}; color: ${defaultTheme.dark};`}
        data-theme-bg={defaultTheme.light}
        data-theme-text={defaultTheme.dark}
>
    {/* 背景装饰元素 - 保持与 Game 一致但微调位置丰富视觉 */}
    <div class="absolute -bottom-20 -left-24 w-96 lg:w-[40rem] h-96 lg:h-[40rem] rounded-full bg-current opacity-[0.04] pointer-events-none z-0"></div>
    <div class="absolute top-1/3 -right-10 w-full h-72 -translate-y-1/2 -rotate-12 bg-current opacity-[0.03] pointer-events-none z-0 rounded-[80px]"></div>

    <div class="w-full  p-4 sm:p-6 lg:p-12 relative z-10">

        {/* ===== 标题：顶部水平显示 ===== */}
        <div class="w-full flex items-center justify-center mb-12 lg:mb-16">
            <h2
                    class="flex items-center justify-center px-8 py-6 font-black text-4xl sm:text-5xl lg:text-6xl border-[3px] rounded-xl select-none  tracking-[0.1em] lg:tracking-[0.2em] uppercase text-center"
                    style={`background-color: ${defaultTheme.light}; color: ${defaultTheme.dark}; border-color: ${defaultTheme.dark}; box-shadow: 6px 6px 0px ${defaultTheme.dark};text-indent: 0.2em;`}
            >
                {t(technicalProjectsLabels.sectionTitle)}
            </h2>
        </div>

        {/* ===== 内容区域：非对称左右分栏，Full Width 布局 ===== */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 w-full">

            {/* 左侧：带图的 Technical 项目 (占 7 列) */}
            <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8 place-content-start">
                {withCoverProjects.map((project) => {
                    const colors = getProjectColors(project);
                    const displayTitle = project.data.title[currentLang] || project.data.title.en || project.data.title.zh || project.id;
                    const displayDesc = project.data.desc[currentLang] || project.data.desc.en || project.data.desc.zh || "";
                    const displayRoles = project.data.roles[currentLang] || project.data.roles.en || project.data.roles.zh || [];
                    const displayTags = project.data.tags[currentLang] || project.data.tags.en || project.data.tags.zh || [];

                    return (
                            <div
                                    class="tech-project-card group flex flex-col rounded-2xl overflow-hidden hover:-translate-y-1 transition-all duration-300 border-2"
                                    style={`--theme: ${colors.text}; border-color: ${colors.text}; background-color: ${colors.bg};`}
                            >
                                {/* Cover Image */}
                                <div
                                        class="relative w-full aspect-video border-b-2 overflow-hidden"
                                        style={`border-color: ${colors.text}; background-color: ${colors.bg};`}
                                >
                                    <Image
                                            src={project.data.coverImage!}
                                            alt={displayTitle}
                                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            loading="lazy"
                                            decoding="async"
                                    />
                                </div>

                                {/* Card Content */}
                                <div
                                        class="flex-1 p-5 sm:p-6 flex flex-col"
                                        style={`background-color: ${colors.bg}; color: ${colors.text};`}
                                >
                                    <h3 class="font-black text-xl sm:text-2xl leading-tight mb-4">
                                        {displayTitle}
                                    </h3>

                                    <div class="flex flex-wrap gap-2 mb-4">
                                        {/* Roles */}
                                        {displayRoles.map((role: string) => (
                                                <span
                                                        class="text-sm font-black px-3 py-1 border-2 rounded-lg"
                                                        style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}
                                                >
                                            <i class="fa-solid fa-code mr-1"></i> {role}
                                        </span>
                                        ))}

                                        {/* tags */}
                                        {displayTags.map((field: string) => (
                                                <span
                                                        class="text-sm font-bold px-3 py-1 border-2 rounded-lg bg-transparent backdrop-blur-sm"
                                                        style={`border-color: ${colors.text}; color: ${colors.text};`}
                                                >
                                            {field}
                                        </span>
                                        ))}
                                    </div>

                                    <p class="text-base font-bold opacity-90 leading-relaxed mb-6 flex-1">
                                        {displayDesc}
                                    </p>

                                    <button
                                            class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-black text-base border-2 active:translate-y-1 transition-transform cursor-pointer"
                                            style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}
                                    >
                                        <span>{t(technicalProjectsLabels.exploreButton)}</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                    );
                })}
            </div>

            {/* 右侧：不带图的 Technical 项目 (占 5 列) */}
            <div class="lg:col-span-4 flex flex-col gap-6 lg:gap-8">
                {withoutCoverProjects.map((project) => {
                    const colors = getProjectColors(project);
                    const displayTitle = project.data.title[currentLang] || project.data.title.en || project.data.title.zh || project.id;
                    const displayDesc = project.data.desc[currentLang] || project.data.desc.en || project.data.desc.zh || "";
                    const displayRoles = project.data.roles[currentLang] || project.data.roles.en || project.data.roles.zh || [];
                    const displayTags = project.data.tags[currentLang] || project.data.tags.en || project.data.tags.zh || [];

                    return (
                            <div
                                    class="tech-project-card relative flex flex-col rounded-2xl overflow-hidden hover:-translate-y-1 transition-all duration-300 border-2 p-6 sm:p-8"
                                    style={`--theme: ${colors.text}; border-color: ${colors.text}; background-color: ${colors.bg}; color: ${colors.text};`}
                            >
                                {/* 右上角跳转小圆钮 */}
                                <button
                                        class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center rounded-full border-2 hover:scale-110 active:scale-95 transition-transform cursor-pointer z-10"
                                        style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}
                                >
                                    <i class="fa-solid fa-arrow-right -rotate-45 text-lg"></i>
                                </button>

                                {/* 顶部：文案 */}
                                <div class="pr-16"> {/* 预留右侧按钮空间防止文字重叠 */}
                                    <h3 class="font-black text-2xl sm:text-3xl leading-tight mb-4">
                                        {displayTitle}
                                    </h3>
                                    <p class="text-base lg:text-lg font-bold opacity-90 leading-relaxed">
                                        {displayDesc}
                                    </p>
                                </div>

                                {/* 下划线 */}
                                <hr class="w-full border-t-[3px] my-6 opacity-40 border-dashed" style={`border-color: ${colors.text};`} />

                                {/* 底部：Role 和 Tags */}
                                <div class="flex flex-wrap gap-2 mt-auto">
                                    {/* Roles */}
                                    {displayRoles.map((role: string) => (
                                            <span
                                                    class="text-sm font-black px-3 py-1 border-2 rounded-lg"
                                                    style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}
                                            >
                                        <i class="fa-solid fa-screwdriver-wrench mr-1"></i> {role}
                                    </span>
                                    ))}

                                    {/* tags */}
                                    {displayTags.map((field: string) => (
                                            <span
                                                    class="text-sm font-bold px-3 py-1 border-2 rounded-lg bg-transparent"
                                                    style={`border-color: ${colors.text}; color: ${colors.text};`}
                                            >
                                        {field}
                                    </span>
                                    ))}
                                </div>
                            </div>
                    );
                })}
            </div>

        </div>
    </div>
</section>

<style>
    /* 统一样式的阴影效果 */
    .tech-project-card {
        box-shadow: 8px 8px 0px color(from var(--theme) srgb r g b / 1);
    }
    .tech-project-card:hover {
        box-shadow: 12px 12px 0px color(from var(--theme) srgb r g b / 1);
    }
</style>