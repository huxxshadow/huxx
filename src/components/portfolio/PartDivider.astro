---
// 作品集相邻两个 Part 之间的分界线：一条贯穿全宽的深色细线，颜色是下一个 Part 的深色主题色
interface Props {
    /** 下一个 Part 的深色主题色 */
    accent: string;
}
const { accent } = Astro.props;
---

<div class="pd" style={`background-color: ${accent};`} aria-hidden="true"></div>

<style>
    .pd {
        width: 100%;
        height: 4px;
    }
</style>
