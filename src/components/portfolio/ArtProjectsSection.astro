---
// src/components/portfolio/ArtProjectsSection.astro
import { COLORS } from "@/consts.ts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { Lang } from "@/i18n.ts";
import { useTranslations } from "@/i18n.ts";
import { artProjectsLabels } from "@/i18n/components/portfolio/ArtProjectsSection_i18.ts";
import { getRelativeLocaleUrl } from 'astro:i18n';

const allProjects = await getCollection("projects");
// 只筛选 category 为 "art" 的项目，并按 order 倒序排列
const artProjects = allProjects
    .filter((p) => p.data.category === "art")
    .sort((a, b) => b.data.order - a.data.order);

const currentLang = (Astro.currentLocale || "en") as Lang;
const t = useTranslations(currentLang);

// 使用橙色作为艺术项目部分的主题色
const defaultTheme = COLORS.orange;

// 分离出第一个项目作为"特色展示"，其余项目正常排列
const featuredProject = artProjects.length > 0 ? artProjects[0] : null;
const regularProjects = artProjects.length > 1 ? artProjects.slice(1) : [];


---

<section
        class="relative overflow-hidden w-full px-4 sm:px-8 py-24"
        style={`background-color: ${defaultTheme.light}; color: ${defaultTheme.dark};`}
        data-theme-bg={defaultTheme.light}
        data-theme-text={defaultTheme.dark}
>
    {/* 背景装饰元素 - 增加一些圆润的几何体体现艺术感 */}
    <div class="absolute -top-32 left-10 w-[30rem] lg:w-[50rem] h-[30rem] lg:h-[50rem] rounded-full bg-current opacity-[0.04] pointer-events-none z-0"></div>
    <div class="absolute bottom-20 -right-20 w-80 h-80 rotate-45 bg-current opacity-[0.03] pointer-events-none z-0 rounded-[100px]"></div>

    <div class="w-full  relative z-10">

        {/* ===== 标题：顶部水平显示 ===== */}
        <div class="w-full flex items-center justify-center mb-12 lg:mb-16">
            <h2
                    class="flex items-center justify-center px-8 py-6 font-black text-4xl sm:text-5xl lg:text-6xl border-[3px] rounded-xl select-none tracking-[0.1em] lg:tracking-[0.2em] uppercase text-center"
                    data-reveal="scale"
                    style={`background-color: ${defaultTheme.light}; color: ${defaultTheme.dark}; border-color: ${defaultTheme.dark}; box-shadow: 6px 6px 0px ${defaultTheme.dark};text-indent: 0.2em;`}
            >
                {t(artProjectsLabels.sectionTitle)}
            </h2>
        </div>

        {/* ===== 卡片区域 ===== */}
        <div>
            <div class="flex flex-col p-4 sm:p-6 lg:p-12 gap-8 lg:gap-12 w-full">

                {/* 1. 特色项目 (Featured Project) - 水平排版的大卡片 */}
                {featuredProject && (
                        <div class="w-full" data-reveal="up">
                            {(() => {
                                const project = featuredProject;
                                const colors = { text: defaultTheme.dark, bg: defaultTheme.light };
                                const displayTitle = project.data.title[currentLang] || project.data.title.en || project.data.title.zh || project.id;
                                const displayDesc = project.data.desc[currentLang] || project.data.desc.en || project.data.desc.zh || "";
                                const displayRoles = project.data.roles[currentLang] || project.data.roles.en || project.data.roles.zh || [];
                                const displayTags = project.data.tags[currentLang] || project.data.tags.en || project.data.tags.zh || [];

                                return (
                                        <div
                                                class="art-project-card group flex flex-col lg:flex-row rounded-2xl overflow-hidden transition-all duration-100 border-[3px]"
                                                style={`--theme: ${colors.text}; border-color: ${colors.text}; background-color: ${colors.bg};`}
                                        >
                                            {/* 大尺寸封面 (特色项目) */}
                                            <a
                                                    href={getRelativeLocaleUrl(currentLang, `projects/${project.id}`)}
                                                    class="relative block w-full lg:w-3/5 aspect-video border-b-[3px] lg:border-b-0 lg:border-r-[3px] overflow-hidden"
                                                    style={`border-color: ${colors.text}; background-color: ${colors.bg};`}
                                            >
                                                <Image src={project.data.coverImage!} alt={displayTitle} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
                                            </a>

                                            {/* 内容区 */}
                                            <div class="w-full lg:w-2/5 p-6 lg:p-10 flex flex-col justify-center" style={`background-color: ${colors.bg}; color: ${colors.text};`}>
                                                <h3 class="font-black text-2xl sm:text-3xl lg:text-4xl leading-tight mb-6">
                                                    {displayTitle}
                                                </h3>

                                                <div class="flex flex-wrap gap-2 mb-6">
                                                    {displayRoles.map((role: string) => (
                                                            <span class="text-sm font-black px-3 py-1 border-2 rounded-lg" style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}>
                                                    <i class="fa-solid fa-palette mr-1"></i> {role}
                                                </span>
                                                    ))}
                                                    {displayTags.map((field: string) => (
                                                            <span class="text-sm font-bold px-3 py-1 border-2 rounded-lg bg-transparent" style={`border-color: ${colors.text}; color: ${colors.text};`}>
                                                    {field}
                                                </span>
                                                    ))}
                                                </div>

                                                <p class="text-base lg:text-xl font-bold opacity-90 leading-relaxed mb-8 flex-1">
                                                    {displayDesc}
                                                </p>

                                                <a
                                                        href={`/${currentLang}/projects/${project.id}`}
                                                        class="w-full lg:w-auto flex items-center justify-center gap-2 py-4 px-8 rounded-xl font-black text-lg border-[3px] active:translate-y-1 transition-transform cursor-pointer hover:opacity-90"
                                                        style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}
                                                >
                                                    <span>{t(artProjectsLabels.exploreButton)}</span>
                                                    <i class="fa-solid fa-arrow-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                );
                            })()}
                        </div>
                )}

                {/* 2. 常规项目网格 (Regular Projects Grid) */}
                {regularProjects.length > 0 && (
                        <div
                                class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8 mt-4"
                                data-reveal-children="up"
                                data-reveal-order="columns"
                        >
                            {regularProjects.map((project) => {
                                const colors = { text: defaultTheme.dark, bg: defaultTheme.light };
                                const displayTitle = project.data.title[currentLang] || project.data.title.en || project.data.title.zh || project.id;
                                const displayDesc = project.data.desc[currentLang] || project.data.desc.en || project.data.desc.zh || "";
                                const displayRoles = project.data.roles[currentLang] || project.data.roles.en || project.data.roles.zh || [];
                                const displayTags = project.data.tags[currentLang] || project.data.tags.en || project.data.tags.zh || [];

                                return (
                                        <div
                                                class="art-project-card group flex flex-col rounded-2xl overflow-hidden transition-all duration-100 border-2"
                                                style={`--theme: ${colors.text}; border-color: ${colors.text}; background-color: ${colors.bg};`}
                                        >
                                            {/* Cover Image */}
                                            <a
                                                    href={getRelativeLocaleUrl(currentLang, `projects/${project.id}`)}
                                                    class="block relative w-full aspect-video border-b-2 overflow-hidden"
                                                    style={`border-color: ${colors.text}; background-color: ${colors.bg};`}
                                            >
                                                <Image
                                                        src={project.data.coverImage!}
                                                        alt={displayTitle}
                                                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                        loading="lazy"
                                                        decoding="async"
                                                />
                                            </a>

                                            {/* Card Content */}
                                            <div class="flex-1 p-5 sm:p-6 flex flex-col" style={`background-color: ${colors.bg}; color: ${colors.text};`}>
                                                <h3 class="font-black text-xl sm:text-2xl leading-tight mb-4">
                                                    {displayTitle}
                                                </h3>

                                                <div class="flex flex-wrap gap-2 mb-4">
                                                    {displayRoles.map((role: string) => (
                                                            <span class="text-xs font-black px-2 py-1 border-2 rounded-md" style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}>
                                                    {role}
                                                </span>
                                                    ))}
                                                </div>

                                                <p class="text-sm lg:text-base font-bold opacity-90 leading-relaxed mb-6 flex-1 ">
                                                    {displayDesc}
                                                </p>

                                                <a
                                                        href={getRelativeLocaleUrl(currentLang, `projects/${project.id}`)}
                                                        class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl font-black text-sm border-2 active:translate-y-1 transition-transform cursor-pointer"
                                                        style={`background-color: ${colors.text}; color: ${colors.bg}; border-color: ${colors.text};`}
                                                >
                                                    <span>{t(artProjectsLabels.exploreButton)}</span>
                                                </a>
                                            </div>
                                        </div>
                                );
                            })}
                        </div>
                )}
            </div>
        </div>
    </div>
</section>

<style>
    .art-project-card {
        box-shadow: 8px 8px 0px color(from var(--theme) srgb r g b / 1);
    }
    .art-project-card:hover {
        transform: translate(4px, 4px);
        box-shadow: 4px 4px 0px color(from var(--theme) srgb r g b / 1);
    }
    .art-project-card:active {
        transform: translate(8px, 8px);
        box-shadow: 0px 0px 0px color(from var(--theme) srgb r g b / 1);
    }
</style>