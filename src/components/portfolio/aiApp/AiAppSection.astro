---
// Part 4 · AI 应用开发：AI 项目 + 右侧 Transformer 结构图（透明底，不吸附）。
// 三个候选版式，本地 dev 下用 Debug 面板切换；默认 / 生产显示 A：
//   A 论文：结构图作为 Figure 1，项目像论文里的条目（缩略图 + 粗标题 + 正文 + 关键词）
//   B 笔记本：每个项目是一个 notebook 单元格（提示行、等宽名字、说明、输出区放封面）
//   C 管线节点：项目是圆角节点，一条虚线把它们串起来流向结构图
// 这一页只用 COLORS.purple 的深浅两档
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { aiWorks, aiAppLabels as L } from "@/i18n/components/portfolio/AiAppShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import transformer from "@/assets/portfolio/ai/transformer.webp";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "ai-app")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = aiWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        slug: w.projectId.replace(/^(technical|game)-project-/, ""),
        title: d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: d.colorText,
        colorBackground: d.colorBackground,
    }];
});

const ink = COLORS.black;
const accent = COLORS.purple.dark;
const tint = COLORS.purple.light;
const figSizes = "(min-width: 1024px) 30vw, 70vw";
---

<section
        id={role.anchor}
        class="relative w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ai-accent: ${accent}; --ai-tint: ${tint};`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2、3 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-8 lg:mb-10" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ai-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ai-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{works.length} {t(L.projects)}</span>
    </header>

    <div data-variant-group="part4" data-variant-label="Part 4 · AI">
        <!-- ================= A · 论文 ================= -->
        <div data-variant="A">
            <div class="pa">
                <ol class="pa-list" data-reveal-children="up" data-reveal-once data-reveal-stagger="60">
                    {works.map((w) => (
                            <li>
                                <a href={href(w.id)} class="pa-item">
                                    <div class="pa-thumb"><WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 14vw, 30vw" /></div>
                                    <div class="pa-text">
                                        <h3 class="pa-title">{w.title}</h3>
                                        <p class="pa-caption">{w.caption}</p>
                                        <p class="pa-keywords"><span>Keywords</span>{w.tags.join(" · ")}</p>
                                    </div>
                                </a>
                            </li>
                    ))}
                </ol>
                <figure class="pa-figure" data-reveal="fade" data-reveal-once>
                    <Image src={transformer} alt="Transformer" widths={[480, 800, 1200]} sizes={figSizes} />
                    <figcaption><b>Figure 1.</b> Transformer</figcaption>
                </figure>
            </div>
        </div>

        <!-- ================= B · 笔记本单元格 ================= -->
        <div data-variant="B" hidden>
            <div class="pb">
                <div class="pb-cells" data-reveal-children="up" data-reveal-once data-reveal-stagger="60">
                    {works.map((w) => (
                            <a href={href(w.id)} class="pb-cell">
                                <div class="pb-prompt">
                                    <span class="pb-run" aria-hidden="true">▶</span>
                                    <code>{w.slug}</code>
                                </div>
                                <div class="pb-main">
                                    <div class="pb-text">
                                        <h3 class="pb-title">{w.title}</h3>
                                        <p class="pb-caption">{w.caption}</p>
                                        <ul class="pb-tags">{w.tags.map((tag) => <li>{tag}</li>)}</ul>
                                    </div>
                                    <div class="pb-output"><WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 16vw, 40vw" /></div>
                                </div>
                            </a>
                    ))}
                </div>
                <div class="pb-figure" data-reveal="fade" data-reveal-once>
                    <Image src={transformer} alt="" widths={[480, 800, 1200]} sizes={figSizes} />
                </div>
            </div>
        </div>

        <!-- ================= C · 管线节点 ================= -->
        <div data-variant="C" hidden>
            <div class="pc">
                <ol class="pc-flow" data-reveal-children="left" data-reveal-once data-reveal-stagger="70">
                    {works.map((w) => (
                            <li class="pc-step">
                                <a href={href(w.id)} class="pc-node">
                                    <span class="pc-avatar"><WorkCover work={w} lang={lang} sizes="120px" /></span>
                                    <span class="pc-text">
                                        <span class="pc-title">{w.title}</span>
                                        <span class="pc-caption">{w.caption}</span>
                                        <span class="pc-tags">{w.tags.map((tag) => <span>{tag}</span>)}</span>
                                    </span>
                                </a>
                                <span class="pc-link" aria-hidden="true"></span>
                            </li>
                    ))}
                </ol>
                <div class="pc-figure" data-reveal="fade" data-reveal-once>
                    <Image src={transformer} alt="" widths={[480, 800, 1200]} sizes={figSizes} />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .ai-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }
    section {
        --mono: ui-monospace, "SFMono-Regular", Consolas, monospace;
    }

    /* =========================================================
       A · 论文：两栏，左边条目，右边 Figure 1
       ========================================================= */
    .pa {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        gap: 3.5rem;
        align-items: start;
    }
    .pa-list {
        display: flex;
        flex-direction: column;
        border-top: 3px solid var(--ai-accent);
    }
    .pa-item {
        display: grid;
        grid-template-columns: 11rem minmax(0, 1fr);
        gap: 1.4rem;
        align-items: start;
        padding: 1.2rem 0;
        border-bottom: 2px solid color-mix(in srgb, var(--ai-accent) 30%, transparent);
    }
    .pa-thumb {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background-color: #FFFFFF;
        border-radius: 6px;
    }
    .pa-thumb :global(img) {
        transition: scale 400ms ease;
    }
    .pa-item:hover .pa-thumb :global(img) {
        scale: 1.06;
    }
    .pa-text {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .pa-title {
        font-weight: 900;
        font-size: 1.3rem;
        line-height: 1.2;
        transition: color 160ms ease;
    }
    .pa-item:hover .pa-title {
        color: var(--ai-accent);
        text-decoration: underline;
        text-decoration-thickness: 3px;
        text-underline-offset: 4px;
    }
    .pa-caption {
        font-size: 0.95rem;
        line-height: 1.65;
    }
    .pa-keywords {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--ai-accent);
    }
    .pa-keywords span {
        margin-right: 0.6rem;
        font-style: italic;
        font-weight: 900;
    }
    .pa-figure {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.8rem;
    }
    .pa-figure :global(img) {
        width: 100%;
        max-width: 30rem;
        height: auto;
    }
    .pa-figure figcaption {
        font-size: 0.95rem;
        color: var(--ai-accent);
    }

    /* =========================================================
       B · 笔记本单元格：白底单元格，左侧一根紫色条，顶部提示行，右侧输出区放封面
       ========================================================= */
    .pb {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        gap: 3.5rem;
        align-items: start;
    }
    .pb-cells {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }
    .pb-cell {
        display: flex;
        flex-direction: column;
        background-color: #FFFFFF;
        border-left: 8px solid color-mix(in srgb, var(--ai-accent) 35%, transparent);
        border-radius: 10px;
        transition: border-color 160ms ease, translate 200ms ease;
    }
    .pb-cell:hover {
        border-left-color: var(--ai-accent);
        translate: 6px 0;
    }
    .pb-prompt {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 1rem;
        border-bottom: 2px solid var(--ai-tint);
        font-family: var(--mono);
        font-size: 0.85rem;
        color: var(--ai-accent);
    }
    .pb-run {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 999px;
        background-color: var(--ai-tint);
        font-size: 0.65rem;
        transition: background-color 160ms ease, color 160ms ease;
    }
    .pb-cell:hover .pb-run {
        background-color: var(--ai-accent);
        color: #FFFFFF;
    }
    .pb-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 12rem;
        gap: 1.2rem;
        padding: 0.9rem 1rem 1rem;
    }
    .pb-text {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .pb-title {
        font-weight: 900;
        font-size: 1.25rem;
        line-height: 1.2;
    }
    .pb-caption {
        font-size: 0.92rem;
        line-height: 1.6;
    }
    .pb-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: auto;
        padding-top: 0.2rem;
    }
    .pb-tags li {
        padding: 0.1rem 0.55rem;
        background-color: var(--ai-tint);
        color: var(--ai-accent);
        border-radius: 6px;
        font-family: var(--mono);
        font-size: 0.8rem;
        font-weight: 700;
    }
    .pb-output {
        position: relative;
        align-self: start;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 8px;
        background-color: var(--ai-tint);
    }
    .pb-figure {
        display: flex;
        justify-content: center;
    }
    .pb-figure :global(img) {
        width: 100%;
        max-width: 30rem;
        height: auto;
    }

    /* =========================================================
       C · 管线节点：圆角节点 + 圆形缩略图，节点之间一条紫色虚线串起来，最后流向结构图
       ========================================================= */
    .pc {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: 4rem;
        align-items: center;
    }
    .pc-flow {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        padding-left: 2.2rem;
    }
    /* 竖向的虚线主干 */
    .pc-flow::before {
        content: "";
        position: absolute;
        left: 0.9rem;
        top: 2rem;
        bottom: 2rem;
        border-left: 4px dashed color-mix(in srgb, var(--ai-accent) 45%, transparent);
    }
    .pc-step {
        position: relative;
    }
    /* 每个节点和主干之间的一小段连线 */
    .pc-link {
        position: absolute;
        left: -1.3rem;
        top: 50%;
        width: 1.3rem;
        height: 4px;
        margin-top: -2px;
        background-color: color-mix(in srgb, var(--ai-accent) 45%, transparent);
        transition: background-color 160ms ease;
    }
    .pc-link::before {
        content: "";
        position: absolute;
        left: -0.55rem;
        top: 50%;
        width: 0.9rem;
        height: 0.9rem;
        margin-top: -0.45rem;
        border-radius: 999px;
        background-color: var(--ai-tint);
        border: 4px solid color-mix(in srgb, var(--ai-accent) 45%, transparent);
        transition: border-color 160ms ease, background-color 160ms ease;
    }
    .pc-step:hover .pc-link,
    .pc-step:hover .pc-link::before {
        background-color: var(--ai-accent);
        border-color: var(--ai-accent);
    }
    .pc-node {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        padding: 0.8rem 1.4rem 0.8rem 0.8rem;
        background-color: #FFFFFF;
        border-radius: 999px;
        transition: translate 220ms cubic-bezier(0.3, 1.4, 0.5, 1), background-color 160ms ease, color 160ms ease;
    }
    .pc-step:hover .pc-node {
        translate: 8px 0;
        background-color: var(--ai-accent);
        color: #FFFFFF;
    }
    .pc-avatar {
        position: relative;
        flex: none;
        display: block;
        width: 5.5rem;
        height: 5.5rem;
        overflow: hidden;
        border-radius: 999px;
        background-color: var(--ai-tint);
    }
    .pc-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
    }
    .pc-title {
        font-weight: 900;
        font-size: 1.15rem;
        line-height: 1.2;
    }
    .pc-caption {
        font-size: 0.88rem;
        line-height: 1.5;
    }
    .pc-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.8rem;
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--ai-accent);
        transition: color 160ms ease;
    }
    .pc-step:hover .pc-tags {
        color: var(--ai-tint);
    }
    .pc-figure {
        display: flex;
        justify-content: center;
    }
    .pc-figure :global(img) {
        width: 100%;
        max-width: 30rem;
        height: auto;
    }

    /* 窄屏：结构图放到最上面，缩小 */
    @media (max-width: 1023px) {
        .pa,
        .pb,
        .pc {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .pa-figure,
        .pb-figure,
        .pc-figure {
            order: -1;
        }
        .pa-figure :global(img),
        .pb-figure :global(img),
        .pc-figure :global(img) {
            max-width: 18rem;
        }
    }
    @media (max-width: 639px) {
        .pa-item { grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; }
        .pb-main { grid-template-columns: 1fr; }
        .pc-node { border-radius: 24px; }
        .pc-avatar { width: 4rem; height: 4rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        .pa-thumb :global(img),
        .pb-cell,
        .pc-node { transition: none; }
    }
</style>
