---
// Part 4 · AI 应用开发：左边两列 AI 项目，最右边一条竖列放 Transformer 结构图（Encoder 在上、Decoder 在下，透明底，不吸附）。
// 卡片沿用页面下方「技术项目」板块的样式（描边、偏移实色阴影、圆角标签），去掉「探索更多」按钮，说明文字在标签上方。
// 这一页只用 COLORS.purple 的深浅两档
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { aiWorks, aiAppLabels as L } from "@/i18n/components/portfolio/AiAppShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import transformer from "@/assets/portfolio/ai/transformer-stack.webp";
import mascot from "@/assets/portfolio/ai/mascot-sitting.webp";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "ai-app")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = aiWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        title: w.title ? t(w.title) : d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        // 没有封面图的项目：用这一页的紫色做标题封面，而且它们都已完成，不显示「开发中」
        colorText: "purple",
        colorBackground: "purple",
        inDevelopment: !!d.inDevelopment,
    }];
});

const ink = COLORS.black;
const accent = COLORS.purple.dark;
const tint = COLORS.purple.light;
// 标语逐字拆开（空格也保留成一格），用来做「注意力」悬停效果
const mottoLeft = Array.from("Attention is");
const mottoRight = Array.from("all you need");
const figSizes = "(min-width: 1024px) 20rem, 40vw";
---

<section
        id={role.anchor}
        class="relative w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ai-accent: ${accent}; --ai-tint: ${tint};`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2、3 同一套紧凑标题：编号 · 名称 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-8 lg:mb-10" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ai-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ai-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
    </header>

    <div class="ai-layout" data-ai-layout style={`--fig-ratio: ${transformer.height / transformer.width};`}>
        <!-- 左：两列项目卡片 -->
        <div class="ai-cards" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
            {works.map((w) => (
                    <a href={href(w.id)} class="ai-card group">
                        <div class="ai-img">
                            <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw" />
                        </div>
                        <div class="ai-body">
                            <h3 class="ai-title">{w.title}</h3>
                            <p class="ai-caption">{w.caption}</p>
                            <ul class="flex flex-wrap gap-2">
                                {w.tags.map((tag) => <li class="ai-tag">{tag}</li>)}
                            </ul>
                        </div>
                    </a>
            ))}
        </div>

        <!-- 右：Transformer 结构图（Encoder 在上、Decoder 在下，透明底） -->
        <div class="ai-figure" data-reveal="fade" data-reveal-once>
            <span class="ai-figure-title">Transformer</span>
            <div class="ai-figure-box">
                <Image src={transformer} alt="Transformer" widths={[320, 480, 900]} sizes={figSizes} />
            </div>
        </div>
    </div>

    <!-- 最下方：大字标语，紫色小人坐在字上（字用 Roboto 排：深紫描边、浅紫填充，不倾斜，不用图片） -->
    <div class="ai-motto" data-reveal="up" data-reveal-once>
        <p class="ai-motto-text" aria-label="Attention is all you need" data-attention>
            <span aria-hidden="true">{mottoLeft.map((c) => <span class:list={["ai-ch", { "ai-sp": c === " " }]}>{c}</span>)}</span>
            <span class="ai-motto-seat" aria-hidden="true">
                <Image src={mascot} alt="" widths={[240, 480, 616]} sizes="(min-width: 1024px) 12rem, 30vw" />
            </span>
            <span aria-hidden="true">{mottoRight.map((c) => <span class:list={["ai-ch", { "ai-sp": c === " " }]}>{c}</span>)}</span>
        </p>
    </div>
</section>

<script>
    // 让右边结构图的高度正好等于左边卡片区：量出卡片区的真实高度，扣掉标题，按图的宽高比算出右栏宽度。
    // 右栏变宽会让卡片变窄、卡片区变矮，所以每次尺寸变化都重算，差距小于 1px 就停
    function fitAiFigure() {
        document.querySelectorAll<HTMLElement>("[data-ai-layout]").forEach((layout) => {
            if (layout.dataset.fitReady) return;
            layout.dataset.fitReady = "1";
            const cards = layout.querySelector<HTMLElement>(".ai-cards");
            const title = layout.querySelector<HTMLElement>(".ai-figure-title");
            const figure = layout.querySelector<HTMLElement>(".ai-figure");
            if (!cards || !title || !figure) return;
            const ratio = parseFloat(getComputedStyle(layout).getPropertyValue("--fig-ratio")) || 6;
            const wide = window.matchMedia("(min-width: 1024px)");
            const update = () => {
                if (!wide.matches) {
                    layout.style.removeProperty("--fig-w");
                    return;
                }
                const gap = parseFloat(getComputedStyle(figure).rowGap) || 0;
                const avail = cards.getBoundingClientRect().height - title.getBoundingClientRect().height - gap;
                if (avail <= 0) return;
                const w = avail / ratio;
                const current = parseFloat(layout.style.getPropertyValue("--fig-w")) || 0;
                if (Math.abs(w - current) > 1) layout.style.setProperty("--fig-w", w.toFixed(1) + "px");
            };
            new ResizeObserver(update).observe(cards);
            wide.addEventListener("change", update);
            update();
        });
    }
    document.addEventListener("astro:page-load", fitAiFigure);

    // 标语的「注意力」悬停：离鼠标越近的字母权重越高（高斯衰减），权重决定字母抬起多少、填充多深；
    // 注意力落到小人坐的位置时，小人也轻轻抬一下。离开后全部回到 0
    function initAttention() {
        document.querySelectorAll<HTMLElement>("[data-attention]").forEach((line) => {
            if (line.dataset.attnReady) return;
            line.dataset.attnReady = "1";
            const chars = [...line.querySelectorAll<HTMLElement>(".ai-ch")];
            const seat = line.querySelector<HTMLElement>(".ai-motto-seat");
            let raf = 0;
            let mouseX: number | null = null;
            const apply = () => {
                raf = 0;
                const em = parseFloat(getComputedStyle(line).fontSize) || 100;
                const sigma = em * 0.9;
                const weight = (el: HTMLElement) => {
                    if (mouseX === null) return 0;
                    const r = el.getBoundingClientRect();
                    const d = mouseX - (r.left + r.width / 2);
                    return Math.exp(-(d * d) / (2 * sigma * sigma));
                };
                chars.forEach((c) => c.style.setProperty("--w", weight(c).toFixed(3)));
                if (seat) seat.style.setProperty("--w", weight(seat).toFixed(3));
            };
            const schedule = () => { if (!raf) raf = requestAnimationFrame(apply); };
            line.addEventListener("pointermove", (e) => { mouseX = e.clientX; schedule(); });
            line.addEventListener("pointerleave", () => { mouseX = null; schedule(); });
        });
    }
    document.addEventListener("astro:page-load", initAttention);
</script>

<style>
    .ai-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    .ai-layout {
        display: grid;
        /* 右栏宽度由脚本按卡片区高度算出（--fig-w），让结构图正好和卡片区一样高；脚本生效前先用 20rem */
        grid-template-columns: minmax(0, 1fr) var(--fig-w, 20rem);
        gap: 3rem;
        /* 右边的结构图拉到和左边卡片区一样高 */
        align-items: stretch;
    }
    /* 卡片固定三列（只有很窄的屏幕才减列，免得字挤不下） */
    .ai-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
    }

    /* 卡片：和下面「技术项目」同一套——2px 描边、圆角、8px 偏移实色阴影，悬停时往阴影方向按下去 */
    .ai-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 2px solid var(--ai-accent);
        border-radius: 1rem;
        background-color: var(--ai-tint);
        color: var(--ai-accent);
        box-shadow: 8px 8px 0 var(--ai-accent);
        transition: transform 100ms ease, box-shadow 100ms ease;
    }
    .ai-card:hover {
        transform: translate(4px, 4px);
        box-shadow: 4px 4px 0 var(--ai-accent);
    }
    .ai-card:active {
        transform: translate(8px, 8px);
        box-shadow: 0 0 0 var(--ai-accent);
    }
    .ai-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-bottom: 2px solid var(--ai-accent);
        background-color: var(--ai-tint);
    }
    .ai-img :global(img) {
        transition: scale 500ms ease;
    }
    .ai-card:hover .ai-img :global(img) {
        scale: 1.05;
    }
    .ai-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 1rem;
        padding: 1.25rem 1.5rem 1.5rem;
    }
    .ai-title {
        font-weight: 900;
        font-size: 1.5rem;
        line-height: 1.25;
    }
    .ai-caption {
        flex: 1;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.625;
        opacity: 0.9;
    }
    .ai-tag {
        padding: 0.25rem 0.75rem;
        border: 2px solid var(--ai-accent);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 700;
    }

    /* ---------- 底部标语：小人坐在字上 ---------- */
    .ai-motto {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: clamp(6rem, 12vw, 11rem);
    }
    .ai-motto-text {
        display: flex;
        align-items: flex-end;
        flex-wrap: nowrap;
        font-family: 'Roboto', sans-serif;
        font-weight: 900;
        font-size: clamp(2.2rem, 7.4vw, 8.5rem);
        line-height: 1;
        letter-spacing: 0.02em;
        white-space: nowrap;
        /* 深紫描边、浅紫填充；描边画在填充下面，露出来的是外侧一半 */
        color: var(--ai-tint);
        -webkit-text-stroke: 0.07em var(--ai-accent);
        paint-order: stroke fill;
    }
    /* 两段字之间留出小人双腿的位置；小人比字高，手搭在字的顶端，脚垂到字的底部 */
    .ai-motto-seat {
        position: relative;
        width: 0.62em;
        height: 1em;
        flex: none;
    }
    .ai-motto-seat :global(img) {
        position: absolute;
        left: 50%;
        bottom: -0.06em;
        height: 2.15em;
        width: auto;
        max-width: none;
        /* 注意力到这儿时轻轻抬起 */
        translate: -50% calc(var(--w, 0) * -0.07em);
        pointer-events: none;
        transition: translate 220ms ease-out;
    }

    /* 「注意力」：权重 --w（0~1）让字母抬起、填充从浅紫过渡到深紫 */
    .ai-ch {
        display: inline-block;
        translate: 0 calc(var(--w, 0) * -0.14em);
        color: color-mix(in srgb, var(--ai-accent) calc(var(--w, 0) * 100%), var(--ai-tint));
        transition: translate 200ms ease-out, color 200ms ease-out;
    }
    .ai-sp {
        white-space: pre;
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-ch,
        .ai-motto-seat :global(img) {
            translate: 0 0;
        }
        .ai-motto-seat :global(img) {
            translate: -50% 0;
        }
    }

    .ai-figure {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }
    /* 结构图上方的小标题 */
    .ai-figure-title {
        font-weight: 900;
        font-size: clamp(1.6rem, 2.2vw, 2.4rem);
        line-height: 1;
        letter-spacing: 0.01em;
        color: var(--ai-accent);
        /* 结构图里 ENCODER 标签的中心在图宽 48.6% 处（左右的位置编码符号让图不对称），
           右边距 2.9% 让标题整体左移 1.45%，和标签对齐 */
        margin-right: 2.9%;
    }
    /* 图框吃掉标题下面剩下的高度，图在框里等比缩放、居中 */
    .ai-figure-box {
        position: relative;
        flex: 1;
        width: 100%;
        min-height: 0;
    }
    .ai-figure-box :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }

    /* 窄屏：结构图放到最上面，缩小；卡片单列 */
    @media (max-width: 1023px) {
        .ai-layout {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .ai-figure {
            order: -1;
        }
        .ai-figure-box {
            flex: none;
        }
        .ai-figure-box :global(img) {
            position: static;
            display: block;
            width: 100%;
            max-width: 12rem;
            height: auto;
            margin: 0 auto;
        }
    }
    @media (max-width: 767px) {
        .ai-cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.25rem;
        }
    }
    @media (max-width: 519px) {
        .ai-cards {
            grid-template-columns: 1fr;
        }
    }
    /* 分辨率低一些的屏幕（1600px 以下）：三列卡片更窄，字号和内边距都收一点 */
    @media (max-width: 1599px) {
        .ai-title { font-size: 1.2rem; }
        .ai-caption { font-size: 0.875rem; line-height: 1.55; }
        .ai-tag { font-size: 0.75rem; padding: 0.15rem 0.55rem; }
        .ai-body { gap: 0.75rem; padding: 1rem 1.1rem 1.15rem; }
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-card,
        .ai-img :global(img) { transition: none; }
    }
</style>
