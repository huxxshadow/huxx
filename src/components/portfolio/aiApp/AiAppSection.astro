---
// Part 4 · AI 应用开发：左边两列 AI 项目，最右边一条竖列放 Transformer 结构图（Encoder 在上、Decoder 在下，透明底，不吸附）。
// 卡片沿用页面下方「技术项目」板块的样式（描边、偏移实色阴影、圆角标签），去掉「探索更多」按钮，说明文字在标签上方。
// 这一页只用 COLORS.purple 的深浅两档
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { aiWorks, aiAppLabels as L } from "@/i18n/components/portfolio/AiAppShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import transformer from "@/assets/portfolio/ai/transformer-stack.webp";
import mascot from "@/assets/portfolio/ai/mascot-sitting.webp";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "ai-app")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = aiWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        title: d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: d.colorText,
        colorBackground: d.colorBackground,
    }];
});

const ink = COLORS.black;
const accent = COLORS.purple.dark;
const tint = COLORS.purple.light;
const figSizes = "(min-width: 1024px) 16rem, 40vw";
---

<section
        id={role.anchor}
        class="relative w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ai-accent: ${accent}; --ai-tint: ${tint};`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2、3 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-8 lg:mb-10" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ai-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ai-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{works.length} {t(L.projects)}</span>
    </header>

    <div class="ai-layout">
        <!-- 左：两列项目卡片 -->
        <div class="ai-cards" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
            {works.map((w) => (
                    <a href={href(w.id)} class="ai-card group">
                        <div class="ai-img">
                            <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw" />
                        </div>
                        <div class="ai-body">
                            <h3 class="font-black text-xl sm:text-2xl leading-tight">{w.title}</h3>
                            <p class="text-base font-bold opacity-90 leading-relaxed flex-1">{w.caption}</p>
                            <ul class="flex flex-wrap gap-2">
                                {w.tags.map((tag) => <li class="ai-tag">{tag}</li>)}
                            </ul>
                        </div>
                    </a>
            ))}
        </div>

        <!-- 右：Transformer 结构图（Encoder 在上、Decoder 在下，透明底） -->
        <div class="ai-figure" data-reveal="fade" data-reveal-once>
            <span class="ai-figure-title">Transformer</span>
            <Image src={transformer} alt="Transformer" widths={[320, 480, 900]} sizes={figSizes} />
        </div>
    </div>

    <!-- 最下方：大字标语，紫色小人坐在字上（字用 Roboto 排：深紫描边、浅紫填充，不倾斜，不用图片） -->
    <div class="ai-motto" data-reveal="up" data-reveal-once>
        <p class="ai-motto-text" aria-label="Attention is all you need">
            <span class="ai-water">Attention is</span>
            <span class="ai-motto-seat" aria-hidden="true">
                <Image src={mascot} alt="" widths={[240, 480, 616]} sizes="(min-width: 1024px) 12rem, 30vw" />
            </span>
            <span class="ai-water">all you need</span>
        </p>
        <cite class="ai-motto-cite">{t(L.mottoNote)} — Vaswani et al., <i>Attention Is All You Need</i>, NeurIPS 2017</cite>
    </div>
</section>

<style>
    .ai-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    .ai-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 16rem;
        gap: 3.5rem;
        align-items: start;
    }
    .ai-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;
    }

    /* 卡片：和下面「技术项目」同一套——2px 描边、圆角、8px 偏移实色阴影，悬停时往阴影方向按下去 */
    .ai-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 2px solid var(--ai-accent);
        border-radius: 1rem;
        background-color: var(--ai-tint);
        color: var(--ai-accent);
        box-shadow: 8px 8px 0 var(--ai-accent);
        transition: transform 100ms ease, box-shadow 100ms ease;
    }
    .ai-card:hover {
        transform: translate(4px, 4px);
        box-shadow: 4px 4px 0 var(--ai-accent);
    }
    .ai-card:active {
        transform: translate(8px, 8px);
        box-shadow: 0 0 0 var(--ai-accent);
    }
    .ai-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-bottom: 2px solid var(--ai-accent);
        background-color: var(--ai-tint);
    }
    .ai-img :global(img) {
        transition: scale 500ms ease;
    }
    .ai-card:hover .ai-img :global(img) {
        scale: 1.05;
    }
    .ai-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 1rem;
        padding: 1.25rem 1.5rem 1.5rem;
    }
    .ai-tag {
        padding: 0.25rem 0.75rem;
        border: 2px solid var(--ai-accent);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 700;
    }

    /* ---------- 底部标语：小人坐在字上 ---------- */
    .ai-motto {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: clamp(6rem, 12vw, 11rem);
    }
    .ai-motto-text {
        display: flex;
        align-items: flex-end;
        flex-wrap: nowrap;
        font-family: 'Roboto', sans-serif;
        font-weight: 900;
        font-size: clamp(2.2rem, 7.4vw, 8.5rem);
        line-height: 1;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }
    /* 文字：深紫描边、浅紫填充。填充用背景裁进字形里；悬停时深紫色的「水」从字底涨满整行，
       水面是两层波浪（宽度、速度、深浅都不同），一直在流动；移开后水退回去 */
    @property --lvl {
        syntax: "<length>";
        inherits: false;
        initial-value: 0px; /* 注册初始值不能用 em，元素上再设成 1.05em */
    }
    @property --x1 {
        syntax: "<length>";
        inherits: false;
        initial-value: 0px;
    }
    @property --x2 {
        syntax: "<length>";
        inherits: false;
        initial-value: 0px;
    }
    .ai-water {
        --lvl: 1.05em;
        color: transparent;
        -webkit-text-stroke: 0.035em var(--ai-accent);
        background-color: var(--ai-tint);
        background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'200'%20height%3D'400'%20viewBox%3D'0%200%20200%20400'%3E%3Cpath%20d%3D'M0%20100%20C%2030%2078%2070%2078%20100%20100%20S%20170%20122%20200%20100%20V400%20H0%20Z'%20fill%3D'%237B1897'%20fill-opacity%3D'1'%2F%3E%3C%2Fsvg%3E"), url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'200'%20height%3D'400'%20viewBox%3D'0%200%20200%20400'%3E%3Cpath%20d%3D'M0%20100%20C%2030%2078%2070%2078%20100%20100%20S%20170%20122%20200%20100%20V400%20H0%20Z'%20fill%3D'%237B1897'%20fill-opacity%3D'0.45'%2F%3E%3C%2Fsvg%3E");
        background-repeat: repeat-x;
        background-size: 1.6em 3em, 2.3em 3em;
        background-position: var(--x1) var(--lvl), var(--x2) calc(var(--lvl) - 0.07em);
        -webkit-background-clip: text;
        background-clip: text;
        transition: --lvl 1100ms cubic-bezier(0.25, 1.15, 0.4, 1);
        animation: ai-wave-1 1.6s linear infinite, ai-wave-2 2.7s linear infinite;
    }
    /* 悬停：水位涨过字顶，整行填满 */
    .ai-motto-text:hover .ai-water {
        --lvl: -0.95em;
    }
    @keyframes ai-wave-1 {
        from { --x1: 0em; }
        to { --x1: 1.6em; }
    }
    @keyframes ai-wave-2 {
        from { --x2: 0em; }
        to { --x2: -2.3em; }
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-water { animation: none; transition: none; }
    }
    /* 右下角：一句话说明 + 出处，同一行 */
    .ai-motto-cite {
        align-self: flex-end;
        margin-top: 1.4rem;
        text-align: right;
        font-style: normal;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--ai-accent);
        opacity: 0.85;
    }
    .ai-motto-cite i {
        font-style: italic;
    }
    /* 两段字之间留出小人双腿的位置；小人比字高，手搭在字的顶端，脚垂到字的底部 */
    .ai-motto-seat {
        position: relative;
        width: 0.62em;
        height: 1em;
        flex: none;
    }
    .ai-motto-seat :global(img) {
        position: absolute;
        left: 50%;
        bottom: -0.06em;
        height: 2.15em;
        width: auto;
        max-width: none;
        translate: -50% 0;
        pointer-events: none;
    }

    .ai-figure {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }
    /* 结构图上方的小标题 */
    .ai-figure-title {
        font-weight: 900;
        font-size: clamp(1.6rem, 2.2vw, 2.4rem);
        line-height: 1;
        letter-spacing: 0.01em;
        color: var(--ai-accent);
        /* 结构图里 ENCODER 标签的中心在图宽 48.6% 处（左右的位置编码符号让图不对称），
           右边距 2.9% 让标题整体左移 1.45%，和标签对齐 */
        margin-right: 2.9%;
    }
    .ai-figure :global(img) {
        width: 100%;
        height: auto;
    }

    /* 窄屏：结构图放到最上面，缩小；卡片单列 */
    @media (max-width: 1023px) {
        .ai-layout {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .ai-figure {
            order: -1;
        }
        .ai-figure :global(img) {
            max-width: 12rem;
        }
    }
    @media (max-width: 767px) {
        .ai-cards {
            grid-template-columns: 1fr;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-card,
        .ai-img :global(img) { transition: none; }
    }
</style>
