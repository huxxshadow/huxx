---
// Part 4 · AI 应用开发：左边是 AI 项目卡片（和 Part 3 同一套卡通卡片，换成紫色），右边是 Transformer 结构图，滚动时停在视口里。
// 这一页的紫色只用 COLORS.purple 的深浅两档
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { COLORS } from "@/consts";
import { useTranslations, type Lang } from "@/i18n";
import { PORTFOLIO_ROLES } from "@/i18n/components/portfolio/PortfolioRoles_i18";
import { aiWorks, aiAppLabels as L } from "@/i18n/components/portfolio/AiAppShowcase_i18";
import WorkCover from "@/components/portfolio/gameDesign/WorkCover.astro";
import transformer from "@/assets/portfolio/ai/transformer.webp";

const lang = (Astro.currentLocale as Lang) || "en";
const t = useTranslations(lang);
const role = PORTFOLIO_ROLES.find((r) => r.id === "ai-app")!;
const href = (id: string) => getRelativeLocaleUrl(lang, `projects/${id}`);

const projects = await getCollection("projects");
const byId = new Map(projects.map((p) => [p.id, p]));
const works = aiWorks.flatMap((w) => {
    const p = byId.get(w.projectId);
    if (!p) return [];
    const d = p.data;
    return [{
        id: w.projectId,
        title: d.title[lang] || d.title.en || d.title.zh || w.projectId,
        caption: t(w.caption),
        tags: t(w.tags).split(/\s*·\s*/).filter(Boolean),
        cover: d.coverImage || d.backupCoverImage,
        colorText: d.colorText,
        colorBackground: d.colorBackground,
    }];
});

const ink = COLORS.black;
const accent = COLORS.purple.dark;
const tint = COLORS.purple.light;
---

<section
        id={role.anchor}
        class="relative w-full px-6 sm:px-12 lg:px-20 xl:px-28 py-14 lg:py-16 scroll-mt-16"
        style={`background-color: ${tint}; color: ${ink}; --theme-bg: ${tint}; --theme-text: ${ink}; --ai-accent: ${accent}; --ai-tint: ${tint};`}
        data-theme-bg={tint}
        data-theme-text={ink}
>
    <!-- 和 Part 2、3 同一套紧凑标题：编号 · 名称 · 项目数 -->
    <header class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-6 lg:mb-8" data-reveal-children="up" data-reveal-once data-reveal-stagger="80">
        <div class="flex items-end gap-4">
            <span class="ai-skew font-black leading-[0.8] text-7xl lg:text-8xl" style={`color: ${accent};`}>{role.index}</span>
            <h2 class="ai-skew font-black leading-none tracking-tight text-4xl lg:text-5xl pb-1">{t(role.name)}</h2>
        </div>
        <span class="ml-auto font-black text-lg whitespace-nowrap pb-1">{works.length} {t(L.projects)}</span>
    </header>

    <div class="ai-layout">
        <!-- 左：项目卡片 -->
        <div class="ai-cards" data-ai-cards data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
            {works.map((w) => (
                    <a href={href(w.id)} class="ai-card">
                        <div class="ai-img">
                            <WorkCover work={w} lang={lang} sizes="(min-width: 1024px) 26vw, (min-width: 640px) 45vw, 100vw" />
                        </div>
                        <div class="ai-body">
                            <h3 class="ai-title">{w.title}</h3>
                            <p class="ai-caption">{w.caption}</p>
                            <ul class="ai-tags">
                                {w.tags.map((tag) => <li>{tag}</li>)}
                            </ul>
                        </div>
                    </a>
            ))}
        </div>

        <!-- 右：Transformer 结构图（透明底） -->
        <div class="ai-figure" data-reveal="fade" data-reveal-once aria-hidden="true">
            <Image src={transformer} alt="" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 30vw, 70vw" />
        </div>
    </div>
</section>

<script>
    // 悬停时卡片像果冻一样挤压回弹，标签依次蹦出来（和 Part 3 的卡片同一个手感）
    function initAiCards() {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.querySelectorAll<HTMLElement>("[data-ai-cards]").forEach((root) => {
            if (root.dataset.aiReady || reduce) return;
            root.dataset.aiReady = "1";
            root.querySelectorAll<HTMLElement>(".ai-card").forEach((card) => {
                card.addEventListener("mouseenter", () => {
                    card.animate(
                        [
                            { scale: "1 1" },
                            { scale: "1.05 0.94", offset: 0.22 },
                            { scale: "0.97 1.04", offset: 0.5 },
                            { scale: "1.01 0.99", offset: 0.75 },
                            { scale: "1 1" },
                        ],
                        { duration: 560, easing: "cubic-bezier(0.3, 0, 0.3, 1)" },
                    );
                    card.querySelectorAll<HTMLElement>(".ai-tags li").forEach((li, i) => {
                        li.animate(
                            [
                                { scale: "1", rotate: "0deg" },
                                { scale: "1.2", rotate: i % 2 ? "5deg" : "-5deg", offset: 0.4 },
                                { scale: "0.95", rotate: "0deg", offset: 0.7 },
                                { scale: "1", rotate: "0deg" },
                            ],
                            { duration: 420, delay: 60 + i * 50, easing: "ease-out" },
                        );
                    });
                });
            });
        });
    }
    document.addEventListener("astro:page-load", initAiCards);
</script>

<style>
    .ai-skew {
        transform: skewX(-10deg);
        transform-origin: left bottom;
    }

    .ai-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
        gap: 3rem;
        align-items: start;
    }
    .ai-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem 2rem;
    }

    /* 卡片：和 Part 3 同一套卡通样式，描边用深紫 */
    .ai-card {
        --line: var(--ai-accent);
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background-color: #FFFFFF;
        color: var(--line);
        border: 4px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 6px 0 var(--line);
        transform-origin: 50% 100%;
        transition: translate 240ms cubic-bezier(0.3, 1.5, 0.5, 1), box-shadow 200ms ease;
    }
    .ai-card:hover,
    .ai-card:focus-visible {
        translate: 0 -6px;
        box-shadow: 0 12px 0 var(--line);
    }
    .ai-card:active {
        scale: 0.96 0.94;
        transition: scale 90ms ease-out;
    }
    .ai-img {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background-color: var(--ai-tint);
        border-bottom: 4px solid var(--line);
    }
    .ai-img :global(img) {
        transition: scale 400ms ease;
    }
    .ai-card:hover .ai-img :global(img) {
        scale: 1.05;
    }
    .ai-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 0.45rem;
        padding: 0.8rem 1rem 1rem;
    }
    .ai-title {
        font-weight: 900;
        font-size: 1.3rem;
        line-height: 1.15;
    }
    .ai-caption {
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.5;
        opacity: 0.85;
    }
    .ai-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: auto;
        padding-top: 0.2rem;
    }
    .ai-tags li {
        padding: 0.05rem 0.6rem;
        background-color: #FFFFFF;
        color: var(--line);
        border: 3px solid var(--line);
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 800;
    }

    /* 右侧结构图：跟着滚动停在视口里，按视口高度缩放 */
    .ai-figure {
        position: sticky;
        top: 6rem;
        display: flex;
        justify-content: center;
    }
    .ai-figure :global(img) {
        width: auto;
        max-width: 100%;
        max-height: calc(100vh - 8rem);
        object-fit: contain;
    }

    @media (max-width: 1023px) {
        .ai-layout {
            grid-template-columns: 1fr;
        }
        .ai-figure {
            position: static;
            order: -1;
        }
        .ai-figure :global(img) {
            max-height: 26rem;
        }
    }
    @media (max-width: 639px) {
        .ai-cards {
            grid-template-columns: 1fr;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-card,
        .ai-img :global(img) { transition: none; }
    }
</style>
