---
// 总览 · 版式 B：参考明日方舟。细线网格、等宽小字编号、警示斜纹、切角档案卡
import type { OverviewLayoutProps } from "../portfolioRolesData";
import Typewriter from "../intro/Typewriter.astro";
import Segments from "../intro/Segments.astro";

type Props = OverviewLayoutProps;
const { title, prefix, suffix, words, lead, items, unit, theme } = Astro.props;
const paper = "#FFFDF7";
---

<div class="ark relative" style={`--ink: ${theme.dark}; --paper: ${paper};`}>
    <!-- 顶部档案信息条 -->
    <div class="flex items-center justify-between gap-4 pb-2 border-b font-mono text-[11px] sm:text-xs tracking-[0.25em] uppercase" style={`border-color: ${theme.dark};`} data-reveal="fade" data-reveal-once>
        <span>HUXX // PERSONAL FILE</span>
        <span class="hidden sm:inline">SELECTED WORKS · 4 ROLES</span>
    </div>

    <div class="relative grid lg:grid-cols-12 gap-8 lg:gap-10 pt-8 lg:pt-10">
        <!-- 左侧竖排标签 -->
        <div class="hidden lg:flex lg:col-span-1 flex-col items-center gap-4" aria-hidden="true">
            <span class="ark-vertical font-mono text-xs tracking-[0.4em] uppercase">Portfolio / 00</span>
            <span class="ark-hazard w-3 flex-1 min-h-24"></span>
        </div>

        <div class="lg:col-span-11" data-reveal-children="up" data-reveal-once data-reveal-stagger="90">
            <span class="block font-mono text-xs tracking-[0.3em] uppercase mb-3">// Archive · 01</span>
            <h1 class="font-black leading-[0.85] tracking-tighter text-[4rem] sm:text-[5.5rem] lg:text-[7rem]">
                {title}
            </h1>

            <div class="ark-bracket relative mt-8 inline-block max-w-full px-5 lg:px-7 py-3">
                <Typewriter words={words} prefix={prefix} suffix={suffix} class="text-2xl sm:text-4xl lg:text-5xl" />
            </div>

            <div class="mt-10 grid lg:grid-cols-2 gap-6 lg:gap-10">
                {lead.map((segments, i) => (
                        <div class="border-t pt-4" style={`border-color: ${theme.dark};`}>
                            <span class="block font-mono text-xs tracking-[0.3em] mb-3">0{i + 1} /</span>
                            <p class="text-base lg:text-lg font-medium leading-[1.85]"><Segments segments={segments} /></p>
                        </div>
                ))}
            </div>
        </div>
    </div>

    <!-- 角色档案卡 -->
    <nav class="mt-14 lg:mt-16 grid md:grid-cols-2 gap-6 lg:gap-8" data-reveal-children="up" data-reveal-order="columns" data-reveal-once>
        {items.map(({ role, name, segments }) => (
                <a
                        href={`#${role.anchor}`}
                        class="ark-card group block p-[2px]"
                        style={`--role-dark: ${role.color.dark}; --role-light: ${role.color.light};`}
                >
                    <div class="ark-card-inner relative h-full flex flex-col p-6 lg:p-7 overflow-hidden">
                        <span class="ark-watermark absolute -right-2 -bottom-8 font-black leading-none select-none pointer-events-none" aria-hidden="true">{role.index}</span>

                        <div class="relative flex items-center justify-between mb-5">
                            <span class="font-mono text-xs tracking-[0.3em] uppercase" style={`color: ${role.color.dark};`}>Role · 0{role.index}</span>
                            <span class="ark-hazard ark-hazard-role w-20 h-3"></span>
                        </div>

                        <h3 class="relative font-black text-3xl lg:text-4xl leading-tight" style={`color: ${role.color.dark};`}>{name}</h3>
                        <div class="relative my-4 h-px" style={`background-color: ${theme.dark};`}></div>

                        <p class="relative flex-1 text-base font-medium leading-[1.85]">
                            <Segments segments={segments} />
                        </p>

                        <div class="relative mt-6 flex items-end justify-between gap-4">
                            <span class="ark-barcode h-7 w-28" aria-hidden="true"></span>
                            <span class="flex items-center gap-2 font-black whitespace-nowrap" style={`color: ${role.color.dark};`}>
                                {role.count} {unit}
                                <i class="fa-solid fa-arrow-right transition-transform duration-200 group-hover:translate-x-1.5"></i>
                            </span>
                        </div>
                    </div>
                </a>
        ))}
    </nav>
</div>

<style>
    .ark-vertical {
        writing-mode: vertical-rl;
    }
    .ark-hazard {
        background-image: repeating-linear-gradient(-45deg, var(--ink) 0 6px, transparent 6px 12px);
    }
    .ark-hazard-role {
        background-image: repeating-linear-gradient(-45deg, var(--role-dark) 0 6px, transparent 6px 12px);
    }
    /* 打字机外的四角括号 */
    .ark-bracket {
        background:
            linear-gradient(var(--ink), var(--ink)) top left / 18px 3px,
            linear-gradient(var(--ink), var(--ink)) top left / 3px 18px,
            linear-gradient(var(--ink), var(--ink)) bottom right / 18px 3px,
            linear-gradient(var(--ink), var(--ink)) bottom right / 3px 18px;
        background-repeat: no-repeat;
    }
    .ark-barcode {
        background-image: repeating-linear-gradient(90deg,
            var(--ink) 0 2px, transparent 2px 4px,
            var(--ink) 4px 5px, transparent 5px 8px,
            var(--ink) 8px 11px, transparent 11px 13px);
        opacity: 0.7;
    }
    /* 切角卡片：外层是边框色，内层同形状缩进 2px */
    .ark-card,
    .ark-card-inner {
        clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 28px 100%, 0 calc(100% - 28px));
    }
    .ark-card {
        background-color: var(--role-dark);
    }
    .ark-card-inner {
        background-color: var(--paper);
        transition: background-color 160ms ease;
    }
    .ark-card:hover .ark-card-inner,
    .ark-card:focus-visible .ark-card-inner {
        background-color: var(--role-light);
    }
    .ark-watermark {
        font-size: 10rem;
        color: var(--role-dark);
        opacity: 0.08;
    }
</style>
