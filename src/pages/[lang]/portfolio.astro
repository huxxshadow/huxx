---
import Layout from "@/layouts/Base.astro";
import PortfolioOverview from "@/components/portfolio/PortfolioOverview.astro";
import DebugVariantSwitcher from "@/components/portfolio/DebugVariantSwitcher.astro";
import RoleSection from "@/components/portfolio/roles/RoleSection.astro";
import GameProjectsSection from "@/components/portfolio/GameProjectsSection.astro";
import TechnicalProjectsSection from "@/components/portfolio/TechnicalProjectsSection.astro";
import {LOCALES} from "@/i18n.ts";
import ArtProjectsSection from "@/components/portfolio/ArtProjectsSection.astro";
import AllProjectsSection from "@/components/portfolio/AllProjectsSection.astro";

export const getStaticPaths = () =>
    Object.keys(LOCALES).map((lang) => ({
        params: { lang },
    }));
---

<Layout>
    <PortfolioOverview />
    <RoleSection roleId="game-design" />
    {/* 临时锚点：Part 3–5 做好之前，总览里的角色卡先跳到现有的分类板块 */}
    <div id="role-game-dev"></div>
    <GameProjectsSection />
    <div id="role-ai-app"></div>
    <TechnicalProjectsSection/>
    <div id="role-tech-art"></div>
    <ArtProjectsSection/>
    <AllProjectsSection/>
    <DebugVariantSwitcher />
</Layout>
