---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import Avatar from "@/assets/avater.svg";
import { COLORS } from "@/consts";

import { indexTranslations } from "@/i18n/index_i18";
const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

import PongGame from "@/components/index/PongGame.astro";
import ExperienceSection from "@/components/index/ExperienceSection.astro";
// 贴纸区暂时隐藏（组件保留）
// import GameStickerSection from "@/components/index/GameStickerSection.astro";
// 作品集海报区暂时隐藏（组件保留，不要删）
// import PortfolioPosters from "@/components/index/PortfolioPosters.astro";
import BrickGame from "@/components/index/BrickGame.astro";

export const getStaticPaths = () =>
    Object.keys(LOCALES).map((lang) => ({
        params: { lang },
    }));
// 首页经历里的两款 Steam 游戏名：悬停浮出游戏封面（取自 projects.json 的封面图，缩成 360px 宽的 webp）
// 自我介绍的五段，正文里 **…** 标出的重点加粗
const INTRO = [
    indexTranslations.experience1Sub,
    indexTranslations.experience2,
    indexTranslations.experience3,
    indexTranslations.experience3Sub,
    indexTranslations.experience4,
];
const highlight = (text: string) => text.replace(/\*\*(.+?)\*\*/g, '<strong class="hl">$1</strong>');

// 「已完成项目」= 作品集项目库里的项目数
const projectCount = (await getCollection("projects")).length;

---

<Layout>
    <PongGame />

    <section
            id="hero-section"
            data-home-theme
            class="relative overflow-hidden w-full px-4 sm:px-6 py-8 lg:py-12 flex justify-center transition-colors duration-300"
            style={`background-color: ${COLORS.blue.light}; color: ${COLORS.blue.dark}; --theme-text: ${COLORS.blue.dark}; --theme-bg: ${COLORS.blue.light};`}
            data-theme-bg={COLORS.blue.light}
            data-theme-text={COLORS.blue.dark}
    >
        <div class="bg-orb-1 absolute -top-32 -left-24 w-[20rem] lg:w-[30rem] h-[20rem] lg:h-[30rem] rounded-full bg-current opacity-[0.04] pointer-events-none z-0"></div>
        <div class="bg-strip absolute top-1/2 -left-20 w-[120%] h-80 bg-current opacity-[0.02] pointer-events-none z-0 rounded-[100px]"></div>
        <div class="bg-square absolute -bottom-32 left-1/4 lg:left-1/3 w-64 lg:w-96 h-64 lg:h-96 bg-current opacity-[0.03] pointer-events-none z-0 rounded-3xl"></div>

        <div class="relative z-10 w-full min-h-[56vh] flex flex-col">
            <div class="w-full flex flex-col lg:flex-row gap-10 lg:gap-16 flex-1">
                <div
                        class="w-full lg:w-2/5 flex flex-col justify-end pb-4 font-sans text-center lg:text-left"
                        data-reveal-children="up"
                        data-reveal-once
                        data-reveal-stagger="90"
                >
                    <h1 class="text-[3.6rem] sm:text-[4.5rem] lg:text-[7rem] font-black leading-[0.85] tracking-tighter mb-4 whitespace-nowrap">
                        Jeffery Hu
                    </h1>

                    <h2
                            class="text-[2rem] lg:text-[3.5rem] font-bold leading-[1.05] tracking-tight mb-6"
                            set:html={t(indexTranslations.heroTitle)}
                    />

                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mt-2">
                        {t(indexTranslations.role).split('·').map((tag) => (
                                <span class="brutalist-tag ">
                                    {tag.trim()}
                                </span>
                        ))}
                    </div>
                </div>

                <div
                        class="w-full lg:w-3/5 flex flex-col items-center lg:items-start justify-start pt-4 pb-24 lg:pt-12 gap-5 lg:gap-6 text-center lg:text-left"
                        data-reveal-children="up"
                        data-reveal-once
                        data-reveal-stagger="80"
                >
                    <div class="w-full text-4xl lg:text-6xl font-black">
                        {t(indexTranslations.welcome)}
                    </div>

                    <div class="w-full text-2xl lg:text-4xl font-black">
                        {t(indexTranslations.loveGames)}<br />
                    </div>

                    <div class="w-full text-xl lg:text-3xl font-black">
                        {t(indexTranslations.experience1)}
                    </div>

                    <ul class="intro-list w-full text-lg lg:text-xl font-medium leading-relaxed text-center lg:text-left">
                        {INTRO.map((item) => (
                                <li class="intro-item">
                                    <p set:html={highlight(t(item))} />
                                </li>
                        ))}
                    </ul>
                </div>
            </div>

            <div
                    class="w-full mt-10 lg:mt-2 pt-4 border-current/10 flex flex-wrap gap-x-8 lg:gap-x-16 gap-y-6 lg:gap-y-8 justify-center lg:justify-start"
                    data-reveal-children="up"
                    data-reveal-once
                    data-reveal-stagger="60"
            >
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-diagram-project text-[2rem] lg:text-[2.5rem] opacity-90"></i>
                    <div class="flex flex-col">
                        <span class="text-xl lg:text-2xl font-black leading-none">{projectCount}</span>
                        <span class="text-sm lg:text-base font-bold opacity-80 mt-1">{t(indexTranslations.statProjects)}</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-gamepad text-[2rem] lg:text-[2.5rem] opacity-90"></i>
                    <div class="flex flex-col">
                        <span class="text-xl lg:text-2xl font-black leading-none">9</span>
                        <span class="text-sm lg:text-base font-bold opacity-80 mt-1">{t(indexTranslations.statGames)}</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-trophy text-[2rem] lg:text-[2.5rem] opacity-90"></i>
                    <div class="flex flex-col">
                        <span class="text-xl lg:text-2xl font-black leading-none">10</span>
                        <span class="text-sm lg:text-base font-bold opacity-80 mt-1">{t(indexTranslations.statAwards)}</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-graduation-cap text-[2rem] lg:text-[2.5rem] opacity-90"></i>
                    <div class="flex flex-col">
                        <span class="text-xl lg:text-2xl font-black leading-none">{t(indexTranslations.statEducationTitle)}</span>
                        <span class="text-sm lg:text-base font-bold opacity-80 mt-1">{t(indexTranslations.statEducationDesc)}</span>
                    </div>
                </div>
            </div>
        </div>

        <div
                class="pointer-events-none absolute bottom-0 right-0 z-0 opacity-20"
                data-reveal="scale"
                data-reveal-once
                data-reveal-delay="260"
                style="--reveal-opacity: 0.2;"
        >
            <Avatar class="w-[180px] lg:w-[320px] h-auto block" fill="currentColor" />
        </div>
    </section>

    <ExperienceSection />
    {/* 作品集海报区暂时隐藏（组件保留，不要删）
    <PortfolioPosters />
    */}

    <BrickGame />
</Layout>

<script>
    // 首页整页只用一种主题色：Hero、弹球、经历、技能打砖块（都标了 data-home-theme）以及 Header / Footer。
    // 两个游戏任意一个升级都会推进颜色，逻辑在 src/scripts/homeTheme.ts
    import { applyHomeTheme } from "@/scripts/homeTheme";
    document.addEventListener('astro:page-load', () => {
        if (document.getElementById('pong-container')) applyHomeTheme();
    });
</script>

<style>
    /* 自我介绍列表：电脑上左侧一条竖线串起五段，每段一个圆点 */
    .intro-list {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }
    .intro-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }
    .intro-item p {
        opacity: 0.92;
    }
    /* 重点：加粗 */
    .intro-item :global(.hl) {
        font-weight: 800;
    }
    @media (min-width: 1024px) {
        .intro-list {
            position: relative;
            gap: 1.6rem;
            padding-left: 1.6rem;
            border-left: 4px solid currentColor;
        }
        .intro-item {
            position: relative;
            align-items: flex-start;
        }
        /* 竖线上对应每段的小圆点 */
        .intro-item::before {
            content: "";
            position: absolute;
            left: calc(-1.6rem - 4px - 0.45rem + 2px);
            top: 0.5rem;
            width: 0.9rem;
            height: 0.9rem;
            border-radius: 999px;
            background: var(--theme-bg);
            border: 3px solid currentColor;
        }
    }

    .bg-orb-1 {
        animation: float-orb 8s ease-in-out infinite;
    }
    @keyframes float-orb {
        0%, 100% { transform: translateY(0px); }
        50%       { transform: translateY(-28px); }
    }

    .bg-strip {
        animation: drift-strip 13s ease-in-out -5s infinite;
    }
    @keyframes drift-strip {
        0%, 100% { transform: translateY(-50%) rotate(-6deg); }
        40%      { transform: translateY(-46%) rotate(-4deg) translateX(18px); }
        70%      { transform: translateY(-54%) rotate(-8deg) translateX(-12px); }
    }

    .bg-square {
        animation: spin-float 11s ease-in-out -2s infinite;
    }
    @keyframes spin-float {
        0%, 100% { transform: rotate(45deg) scale(1); }
        50%      { transform: rotate(53deg) scale(1.08) translateY(-14px); }
    }

    @media (prefers-reduced-motion: reduce) {
        .bg-orb-1, .bg-strip, .bg-square { animation: none; }
    }
</style>